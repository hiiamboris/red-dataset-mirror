        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "deva"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "deva" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [! ":"]
            ] 
            decimalFormats [
                #numberSystem "deva" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##,##0.###"]
                    ]
                ]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 हज़ार"] 
                        pattern [#type "1000" #count "other" ! "0 हज़ार"] 
                        pattern [#type "10000" #count "one" ! "00 हज़ार"] 
                        pattern [#type "10000" #count "other" ! "00 हज़ार"] 
                        pattern [#type "100000" #count "one" ! "0 लाख"] 
                        pattern [#type "100000" #count "other" ! "0 लाख"] 
                        pattern [#type "1000000" #count "one" ! "00 लाख"] 
                        pattern [#type "1000000" #count "other" ! "00 लाख"] 
                        pattern [#type "10000000" #count "one" ! "0 करोड़"] 
                        pattern [#type "10000000" #count "other" ! "0 करोड़"] 
                        pattern [#type "100000000" #count "one" ! "00 करोड़"] 
                        pattern [#type "100000000" #count "other" ! "00 करोड़"] 
                        pattern [#type "1000000000" #count "one" ! "0 अरब"] 
                        pattern [#type "1000000000" #count "other" ! "0 अरब"] 
                        pattern [#type "10000000000" #count "one" ! "00 अरब"] 
                        pattern [#type "10000000000" #count "other" ! "00 अरब"] 
                        pattern [#type "100000000000" #count "one" ! "0 खरब"] 
                        pattern [#type "100000000000" #count "other" ! "0 खरब"] 
                        pattern [#type "1000000000000" #count "one" ! "00 खरब"] 
                        pattern [#type "1000000000000" #count "other" ! "00 खरब"] 
                        pattern [#type "10000000000000" #count "one" ! "000 खरब"] 
                        pattern [#type "10000000000000" #count "other" ! "000 खरब"] 
                        pattern [#type "100000000000000" #count "one" ! "0000 खरब"] 
                        pattern [#type "100000000000000" #count "other" ! "0000 खरब"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 हज़ार"] 
                        pattern [#type "1000" #count "other" ! "0 हज़ार"] 
                        pattern [#type "10000" #count "one" ! "00 हज़ार"] 
                        pattern [#type "10000" #count "other" ! "00 हज़ार"] 
                        pattern [#type "100000" #count "one" ! "0 लाख"] 
                        pattern [#type "100000" #count "other" ! "0 लाख"] 
                        pattern [#type "1000000" #count "one" ! "00 लाख"] 
                        pattern [#type "1000000" #count "other" ! "00 लाख"] 
                        pattern [#type "10000000" #count "one" ! "0 क॰"] 
                        pattern [#type "10000000" #count "other" ! "0 क॰"] 
                        pattern [#type "100000000" #count "one" ! "00 क॰"] 
                        pattern [#type "100000000" #count "other" ! "00 क॰"] 
                        pattern [#type "1000000000" #count "one" ! "0 अ॰"] 
                        pattern [#type "1000000000" #count "other" ! "0 अ॰"] 
                        pattern [#type "10000000000" #count "one" ! "00 अ॰"] 
                        pattern [#type "10000000000" #count "other" ! "00 अ॰"] 
                        pattern [#type "100000000000" #count "one" ! "0 ख॰"] 
                        pattern [#type "100000000000" #count "other" ! "0 ख॰"] 
                        pattern [#type "1000000000000" #count "one" ! "00 ख॰"] 
                        pattern [#type "1000000000000" #count "other" ! "00 ख॰"] 
                        pattern [#type "10000000000000" #count "one" ! "0 नील"] 
                        pattern [#type "10000000000000" #count "other" ! "0 नील"] 
                        pattern [#type "100000000000000" #count "one" ! "00 नील"] 
                        pattern [#type "100000000000000" #count "other" ! "00 नील"]
                    ]
                ]
