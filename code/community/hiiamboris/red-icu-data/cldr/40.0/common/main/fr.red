                #type "unit" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} et {1}"] 
                listPatternPart [#type "2" ! "{0} et {1}"]
            ] 
            listPattern [
                #type "unit-narrow" 
                listPatternPart [#type "start" ! "{0} {1}"] 
                listPatternPart [#type "middle" ! "{0} {1}"] 
                listPatternPart [#type "end" ! "{0} {1}"] 
                listPatternPart [#type "2" ! "{0} {1}"]
            ] 
            listPattern [
                #type "unit-short" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} et {1}"] 
                listPatternPart [#type "2" ! "{0} et {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [! "oui:o"] 
                nostr [! "non:n"]
            ]
        ] 
