
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "se"] 
            territory [#type "SE"]
        ] 
        numbers [
            currencies [
                currency [
                    #type "NOK" 
                    symbol [! "Nkr"]
                ] 
                currency [
                    #type "SEK" 
                    symbol [! "kr"]
                ]
            ]
        ]
    ]

