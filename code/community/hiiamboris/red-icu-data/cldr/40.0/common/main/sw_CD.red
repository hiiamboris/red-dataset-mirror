
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "sw"] 
            territory [#type "CD"]
        ] 
        localeDisplayNames [
            languages [
                language [#type "ak" ! "Kiakan"] 
                language [#type "ar_001" ! "Kiarabu cha Dunia Kilichosanifishwa"] 
                language [#type "arq" ! "Kiarabu cha Aljeria"] 
                language [#type "az" ! "Kiazabajani"] 
                language [#type "gv" ! "Kimanksi"] 
                language [#type "gwi" ! "Kigwichiin"] 
                language [#type "hup" ! "Kihupa"] 
                language [#type "jbo" ! "Kilojban"] 
                language [#type "kac" ! "Kikachin"] 
                language [#type "kkj" ! "Kikako"] 
                language [#type "koi" ! "Kikomipermyak"] 
                language [#type "kru" ! "Kikurukh"] 
                language [#type "kum" ! "Kikumyk"] 
                language [#type "ky" ! "Kikirigizi"] 
                language [#type "lam" ! "Kilamba"] 
                language [#type "li" ! "Kilimburgi"] 
                language [#type "mdf" ! "Kimoksha"] 
                language [#type "mic" ! "Kimikmaki"] 
                language [#type "mk" ! "Kimasedonia"] 
                language [#type "moh" ! "Kimohoki"] 
                language [#type "mos" ! "Kimossi"] 
                language [#type "nnh" ! "Kingiemboon"] 
                language [#type "nqo" ! "Kiinko"] 
                language [#type "pcm" ! "Pijini ya Nijeria"] 
                language [#type "quc" ! "Kikiiche"] 
                language [#type "shu" ! "Kiarabu cha Chadi"] 
                language [#type "srn" ! "Kitongo cha Sranan"] 
                language [#type "swb" ! "Kikomoro"] 
                language [#type "syr" ! "Kisiria"] 
                language [#type "udm" ! "Kiudumurti"] 
                language [#type "yi" ! "Kiyidi"]
            ] 
            territories [
                territory [#type "030" ! "Asia Mashariki"] 
                territory [#type "AF" ! "Afuganistani"] 
                territory [#type "AZ" ! "Azabajani"] 
                territory [#type "BJ" ! "Benini"] 
                territory [#type "CI" ! "Kodivaa"] 
                territory [#type "CX" ! "Kisiwa cha Christmas"] 
                territory [#type "HR" ! "Kroeshia"] 
                territory [#type "JO" ! "Yordani"] 
                territory [#type "LB" ! "Lebanoni"] 
                territory [#type "LI" ! "Lishenteni"] 
                territory [#type "LU" ! "Lasembagi"] 
                territory [#type "LV" ! "Lativia"] 
                territory [#type "MA" ! "Moroko"] 
                territory [#type "MM" ! "Myama"] 
                territory [#type "NE" ! "Nijeri"] 
                territory [#type "NG" ! "Nijeria"] 
                territory [#type "NO" ! "Norwe"] 
                territory [#type "NP" ! "Nepali"] 
                territory [#type "OM" ! "Omani"] 
                territory [#type "PR" ! "Puetoriko"] 
                territory [#type "QA" ! "Katari"] 
                territory [#type "SD" ! "Sudani"] 
                territory [#type "ST" ! "Sao Tome na Prinsipe"] 
                territory [#type "TD" ! "Chadi"] 
                territory [#type "TL" ! "Timori ya Mashariki"]
            ]
        ] 
        characters [
            exemplarCharacters [! "[a b c d e f g h i j k l m n o p r s t u v w y z]"] 
            exemplarCharacters [#type "auxiliary" ! "[q x]"]
        ] 
        dates [
            calendars [
                calendar [
                    #type "generic" 
                    dateTimeFormats [
                        availableFormats [
                            dateFormatItem [#id "MMMEd" ! "E d MMM"] 
                            dateFormatItem [#id "ms" ! "m:ss"]
                        ]
                    ]
                ]
            ] 
            fields [
                field [
                    #type "era" 
                    displayName [! "Wakati"]
                ] 
                field [
                    #type "week" 
                    displayName [! "Juma"]
                ] 
                field [
                    #type "weekday" 
                    displayName [! "Siku ya juma"]
                ] 
                field [
                    #type "dayperiod" 
                    displayName [! "Muda wa siku"]
                ] 
                field [
                    #type "zone" 
                    displayName [! "Majira ya saa"]
                ]
            ]
        ] 
        numbers [
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."]
            ] 
            currencies [
                currency [
                    #type "CDF" 
                    symbol [! "FC"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "Yuan Renminbi ya China"]
                ] 
                currency [
                    #type "ETB" 
                    displayName [! "Bir ya Uhabeshi"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [! "Sarafu ya Kijapani"]
                ] 
                currency [
                    #type "MGA" 
                    displayName [! "Ariary ya Bukini"]
                ] 
                currency [
                    #type "MRO" 
                    displayName [! "Ugwiya ya Moritania (1973–2017)"]
                ] 
                currency [
                    #type "MRU" 
                    displayName [! "Ugwiya ya Moritania"]
                ] 
                currency [
                    #type "SCR" 
                    displayName [! "Rupia ya Shelisheli"]
                ] 
                currency [
                    #type "XAF" 
                    displayName [! "Faranga CFA BEAC"]
                ] 
                currency [
                    #type "XOF" 
                    displayName [! "Faranga CFA BCEAO"]
                ]
            ]
        ]
    ]

