
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ar"] 
            territory [#type "JO"]
        ] 
        dates [
            calendars [
                calendar [
                    #type "gregorian" 
                    months [
                        monthContext [
                            #type "format" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "كانون الثاني"] 
                                month [#type "2" ! "شباط"] 
                                month [#type "3" ! "آذار"] 
                                month [#type "4" ! "نيسان"] 
                                month [#type "5" ! "أيار"] 
                                month [#type "6" ! "حزيران"] 
                                month [#type "7" ! "تموز"] 
                                month [#type "8" ! "آب"] 
                                month [#type "9" ! "أيلول"] 
                                month [#type "10" ! "تشرين الأول"] 
                                month [#type "11" ! "تشرين الثاني"] 
                                month [#type "12" ! "كانون الأول"]
                            ] 
                            monthWidth [
                                #type "narrow" 
                                month [#type "1" ! "ك"] 
                                month [#type "2" ! "ش"] 
                                month [#type "3" ! "آ"] 
                                month [#type "4" ! "ن"] 
                                month [#type "5" ! "أ"] 
                                month [#type "6" ! "ح"] 
                                month [#type "7" ! "ت"] 
                                month [#type "8" ! "آ"] 
                                month [#type "9" ! "أ"] 
                                month [#type "10" ! "ت"] 
                                month [#type "11" ! "ت"] 
                                month [#type "12" ! "ك"]
                            ] 
                            monthWidth [
                                #type "wide" 
                                month [#type "1" ! "كانون الثاني"] 
                                month [#type "2" ! "شباط"] 
                                month [#type "3" ! "آذار"] 
                                month [#type "4" ! "نيسان"] 
                                month [#type "5" ! "أيار"] 
                                month [#type "6" ! "حزيران"] 
                                month [#type "7" ! "تموز"] 
                                month [#type "8" ! "آب"] 
                                month [#type "9" ! "أيلول"] 
                                month [#type "10" ! "تشرين الأول"] 
                                month [#type "11" ! "تشرين الثاني"] 
                                month [#type "12" ! "كانون الأول"]
                            ]
                        ] 
                        monthContext [
                            #type "stand-alone" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "كانون الثاني"] 
                                month [#type "2" ! "شباط"] 
                                month [#type "3" ! "آذار"] 
                                month [#type "4" ! "نيسان"] 
                                month [#type "5" ! "أيار"] 
                                month [#type "6" ! "حزيران"] 
                                month [#type "7" ! "تموز"] 
                                month [#type "8" ! "آب"] 
                                month [#type "9" ! "أيلول"] 
                                month [#type "10" ! "تشرين الأول"] 
                                month [#type "11" ! "تشرين الثاني"] 
                                month [#type "12" ! "كانون الأول"]
                            ] 
                            monthWidth [
                                #type "narrow" 
                                month [#type "1" ! "ك"] 
                                month [#type "2" ! "ش"] 
                                month [#type "3" ! "آ"] 
                                month [#type "4" ! "ن"] 
                                month [#type "5" ! "أ"] 
                                month [#type "6" ! "ح"] 
                                month [#type "7" ! "ت"] 
                                month [#type "8" ! "آ"] 
                                month [#type "9" ! "أ"] 
                                month [#type "10" ! "ت"] 
                                month [#type "11" ! "ت"] 
                                month [#type "12" ! "ك"]
                            ] 
                            monthWidth [
                                #type "wide" 
                                month [#type "1" ! "كانون الثاني"] 
                                month [#type "2" ! "شباط"] 
                                month [#type "3" ! "آذار"] 
                                month [#type "4" ! "نيسان"] 
                                month [#type "5" ! "أيار"] 
                                month [#type "6" ! "حزيران"] 
                                month [#type "7" ! "تموز"] 
                                month [#type "8" ! "آب"] 
                                month [#type "9" ! "أيلول"] 
                                month [#type "10" ! "تشرين الأول"] 
                                month [#type "11" ! "تشرين الثاني"] 
                                month [#type "12" ! "كانون الأول"]
                            ]
                        ]
                    ]
                ]
            ]
        ] 
        numbers [
            defaultNumberingSystem [! "arab"]
        ]
    ]

