        numbers [
            defaultNumberingSystem [#draft "contributed" ! "latn"] 
            otherNumberingSystems [
                native [#draft "contributed" ! "latn"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! " "] 
                percentSign [! "%"] 
                plusSign [#draft "contributed" ! "+"] 
                minusSign [#draft "contributed" ! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "сан емес"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [#draft "contributed" ! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 мың"] 
                        pattern [#type "1000" #count "other" ! "0 мың"] 
                        pattern [#type "10000" #count "one" ! "00 мың"] 
                        pattern [#type "10000" #count "other" ! "00 мың"] 
                        pattern [#type "100000" #count "one" ! "000 мың"] 
                        pattern [#type "100000" #count "other" ! "000 мың"] 
                        pattern [#type "1000000" #count "one" ! "0 миллион"] 
                        pattern [#type "1000000" #count "other" ! "0 миллион"] 
                        pattern [#type "10000000" #count "one" ! "00 миллион"] 
                        pattern [#type "10000000" #count "other" ! "00 миллион"] 
                        pattern [#type "100000000" #count "one" ! "000 миллион"] 
                        pattern [#type "100000000" #count "other" ! "000 миллион"] 
                        pattern [#type "1000000000" #count "one" ! "0 миллиард"] 
                        pattern [#type "1000000000" #count "other" ! "0 миллиард"] 
                        pattern [#type "10000000000" #count "one" ! "00 миллиард"] 
                        pattern [#type "10000000000" #count "other" ! "00 миллиард"] 
                        pattern [#type "100000000000" #count "one" ! "000 миллиард"] 
                        pattern [#type "100000000000" #count "other" ! "000 миллиард"] 
                        pattern [#type "1000000000000" #count "one" ! "0 триллион"] 
                        pattern [#type "1000000000000" #count "other" ! "0 триллион"] 
                        pattern [#type "10000000000000" #count "one" ! "00 триллион"] 
                        pattern [#type "10000000000000" #count "other" ! "00 триллион"] 
                        pattern [#type "100000000000000" #count "one" ! "000 триллион"] 
                        pattern [#type "100000000000000" #count "other" ! "000 триллион"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 мың"] 
                        pattern [#type "1000" #count "other" ! "0 мың"] 
                        pattern [#type "10000" #count "one" ! "00 мың"] 
                        pattern [#type "10000" #count "other" ! "00 мың"] 
                        pattern [#type "100000" #count "one" ! "000 м'.'"] 
                        pattern [#type "100000" #count "other" ! "000 м'.'"] 
                        pattern [#type "1000000" #count "one" ! "0 млн"] 
                        pattern [#type "1000000" #count "other" ! "0 млн"] 
                        pattern [#type "10000000" #count "one" ! "00 млн"] 
                        pattern [#type "10000000" #count "other" ! "00 млн"] 
                        pattern [#type "100000000" #count "one" ! "000 млн"] 
                        pattern [#type "100000000" #count "other" ! "000 млн"] 
                        pattern [#type "1000000000" #count "one" ! "0 млрд"] 
                        pattern [#type "1000000000" #count "other" ! "0 млрд"] 
                        pattern [#type "10000000000" #count "one" ! "00 млрд"] 
                        pattern [#type "10000000000" #count "other" ! "00 млрд"] 
                        pattern [#type "100000000000" #count "one" ! "000 млрд"] 
                        pattern [#type "100000000000" #count "other" ! "000 млрд"] 
                        pattern [#type "1000000000000" #count "one" ! "0 трлн"] 
                        pattern [#type "1000000000000" #count "other" ! "0 трлн"] 
                        pattern [#type "10000000000000" #count "one" ! "00 трлн"] 
                        pattern [#type "10000000000000" #count "other" ! "00 трлн"] 
                        pattern [#type "100000000000000" #count "one" ! "000 трлн"] 
                        pattern [#type "100000000000000" #count "other" ! "000 трлн"]
                    ]
                ]
            ] 
            scientificFormats [
