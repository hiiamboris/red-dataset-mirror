                        pattern [#type "1000000000" #count "one" ! "0 млрд ¤"] 
                        pattern [#type "1000000000" #count "other" ! "0 млрд ¤"] 
                        pattern [#type "10000000000" #count "one" ! "00 млрд ¤"] 
                        pattern [#type "10000000000" #count "other" ! "00 млрд ¤"] 
                        pattern [#type "100000000000" #count "one" ! "000 млрд ¤"] 
                        pattern [#type "100000000000" #count "other" ! "000 млрд ¤"] 
                        pattern [#type "1000000000000" #count "one" ! "0 трлн ¤"] 
