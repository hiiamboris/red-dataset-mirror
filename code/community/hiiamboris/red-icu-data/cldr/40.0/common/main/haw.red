                            intervalFormatItem [
                                #id "yMMMEd" 
                                greatestDifference [#id "d" ! "y MMM d, E – MMM d, E"] 
                                greatestDifference [#id "M" ! "y MMM d, E – MMM d, E"] 
                                greatestDifference [#id "y" ! "y MMM d, E – y MMM d, E"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMM" 
                                greatestDifference [#id "M" ! "y MMMM–MMMM"] 
                                greatestDifference [#id "y" ! "y MMMM – y MMMM"]
                            ]
                        ]
                    ]
                ]
            ] 
            timeZoneNames [
                zone [
                    #type "Pacific/Honolulu" 
                    short [
                        generic [! "HST"] 
                        standard [! "HST"] 
                        daylight [! "HDT"]
                    ]
                ] 
                metazone [
                    #type "Alaska" 
                    short [
                        generic [! "AKT"] 
                        standard [! "AKST"] 
                        daylight [! "AKDT"]
                    ]
                ] 
                metazone [
                    #type "Hawaii_Aleutian" 
                    short [
                        generic [! "HAT"] 
                        standard [! "HAST"] 
                        daylight [! "HADT"]
                    ]
                ]
            ]
        ] 
        numbers [
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##0.00"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "¤#,##0.00;(¤#,##0.00)"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "one" #draft "provisional" ! "¤0K"] 
                        pattern [#type "1000" #count "other" #draft "provisional" ! "¤0K"] 
                        pattern [#type "10000" #count "one" #draft "provisional" ! "¤00K"] 
                        pattern [#type "10000" #count "other" #draft "provisional" ! "¤00K"] 
                        pattern [#type "100000" #count "one" #draft "provisional" ! "¤000K"] 
                        pattern [#type "100000" #count "other" #draft "provisional" ! "¤000K"] 
                        pattern [#type "1000000" #count "one" #draft "provisional" ! "¤0M"] 
                        pattern [#type "1000000" #count "other" #draft "provisional" ! "¤0M"] 
                        pattern [#type "10000000" #count "one" #draft "provisional" ! "¤00M"] 
                        pattern [#type "10000000" #count "other" #draft "provisional" ! "¤00M"] 
                        pattern [#type "100000000" #count "one" #draft "provisional" ! "¤000M"] 
                        pattern [#type "100000000" #count "other" #draft "provisional" ! "¤000M"] 
                        pattern [#type "1000000000" #count "one" #draft "provisional" ! "¤0G"] 
                        pattern [#type "1000000000" #count "other" #draft "provisional" ! "¤0G"] 
                        pattern [#type "10000000000" #count "one" #draft "provisional" ! "¤00G"] 
                        pattern [#type "10000000000" #count "other" #draft "provisional" ! "¤00G"] 
                        pattern [#type "100000000000" #count "one" #draft "provisional" ! "¤000G"] 
                        pattern [#type "100000000000" #count "other" #draft "provisional" ! "¤000G"] 
                        pattern [#type "1000000000000" #count "one" #draft "provisional" ! "¤0T"] 
                        pattern [#type "1000000000000" #count "other" #draft "provisional" ! "¤0T"] 
                        pattern [#type "10000000000000" #count "one" #draft "provisional" ! "¤00T"] 
                        pattern [#type "10000000000000" #count "other" #draft "provisional" ! "¤00T"] 
                        pattern [#type "100000000000000" #count "one" #draft "provisional" ! "¤000T"] 
                        pattern [#type "100000000000000" #count "other" #draft "provisional" ! "¤000T"]
                    ]
                ] 
                unitPattern [#count "one" ! "{0} {1}"] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencies [
                currency [
                    #type "USD" 
                    symbol [! "$"]
                ]
            ] 
            miscPatterns [
                #numberSystem "latn" 
                pattern [#type "atLeast" ! "≥{0}"] 
                pattern [#type "range" ! "{0}–{1}"]
            ]
        ] 
        units [
            unitLength [
                #type "long" 
                unit [
                    #type "duration-year" 
                    displayName [#draft "provisional" ! "makahiki"] 
                    unitPattern [#count "one" ! "{0} makahiki"] 
                    unitPattern [#count "other" ! "{0} makahiki"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "provisional" ! "mahina"] 
                    unitPattern [#count "one" ! "{0} mahina"] 
                    unitPattern [#count "other" ! "{0} mahina"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [#draft "provisional" ! "pule"] 
                    unitPattern [#count "one" ! "{0} pule"] 
                    unitPattern [#count "other" ! "{0} pule"]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [#draft "provisional" ! "lā"] 
                    unitPattern [#count "one" ! "{0} lā"] 
                    unitPattern [#count "other" ! "{0} lā"]
                ] 
                unit [
                    #type "duration-hour" 
                    displayName [#draft "provisional" ! "hola"] 
                    unitPattern [#count "one" ! "{0} hola"] 
                    unitPattern [#count "other" ! "{0} hola"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [#draft "provisional" ! "minuke"] 
                    unitPattern [#count "one" ! "{0} minuke"] 
                    unitPattern [#count "other" ! "{0} minuke"]
                ] 
                unit [
                    #type "duration-second" 
                    displayName [#draft "provisional" ! "kekona"] 
                    unitPattern [#count "one" ! "{0} kekona"] 
                    unitPattern [#count "other" ! "{0} kekona"]
                ]
            ] 
            unitLength [
                #type "short" 
                unit [
                    #type "duration-year" 
                    displayName [#draft "provisional" ! "makahiki"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "provisional" ! "mahina"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [#draft "provisional" ! "pule"]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [#draft "provisional" ! "lā"]
                ] 
                unit [
                    #type "duration-hour" 
                    displayName [#draft "provisional" ! "hola"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [#draft "provisional" ! "minuke"]
                ] 
                unit [
                    #type "duration-second" 
                    displayName [#draft "provisional" ! "kekona"]
                ]
            ] 
            unitLength [
                #type "narrow" 
                unit [
                    #type "temperature-celsius" 
                    unitPattern [#count "one" ! "{0}°C"] 
                    unitPattern [#count "other" ! "{0}°C"]
                ] 
                unit [
                    #type "temperature-fahrenheit" 
                    unitPattern [#count "one" ! "{0}°"] 
                    unitPattern [#count "other" ! "{0}°"]
                ]
            ]
        ]
    ]

