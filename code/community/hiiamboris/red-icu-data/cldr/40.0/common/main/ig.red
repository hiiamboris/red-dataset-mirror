        numbers [
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "arab" 
                decimal [! "٫"] 
                group [! "٬"] 
                list [! "؛"] 
                percentSign [! "٪‏"] 
                plusSign [! "‏+"] 
                minusSign [! "‏-"] 
                superscriptingExponent [! "×"] 
                perMille [! "؉"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            symbols [
                #numberSystem "arabext" 
                decimal [! "٫"] 
                group [! "٬"] 
                list [! "؛"] 
                percentSign [! "٪"] 
                plusSign [! "‎+‎"] 
                minusSign [! "‎-‎"] 
                superscriptingExponent [! "×"] 
                perMille [! "؉"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! "٫"]
            ] 
            symbols [
                #numberSystem "bali" 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            symbols [
                #numberSystem "beng" 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            symbols [
                #numberSystem "brah" 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            symbols [
                #numberSystem "cakm" 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            percentFormats [
                #numberSystem "arab" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0 %"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "arab" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##0.00"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "bali" 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencyFormats [
                #numberSystem "beng" 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencyFormats [
                #numberSystem "brah" 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##0.00"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "¤#,##0.00;(¤#,##0.00)"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "other" ! "¤0K"] 
                        pattern [#type "10000" #count "other" ! "¤00K"] 
                        pattern [#type "100000" #count "other" ! "¤000K"] 
                        pattern [#type "1000000" #count "other" ! "¤0M"] 
                        pattern [#type "10000000" #count "other" ! "¤00M"] 
                        pattern [#type "100000000" #count "other" ! "¤000M"] 
                        pattern [#type "1000000000" #count "other" ! "¤0G"] 
                        pattern [#type "10000000000" #count "other" ! "¤00G"] 
                        pattern [#type "100000000000" #count "other" ! "¤000G"] 
                        pattern [#type "1000000000000" #count "other" ! "¤0T"] 
                        pattern [#type "10000000000000" #count "other" ! "¤00T"] 
                        pattern [#type "100000000000000" #count "other" ! "¤000T"]
                    ]
                ]
            ] 
