
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "sat"]
        ] 
        localeDisplayNames [
            localeDisplayPattern [
                localeKeyTypePattern [! "{0}: {1}"]
            ] 
            languages [
                language [#type "de" ! "ᱡᱟᱨᱢᱟᱱ"] 
                language [#type "de_AT" ! "ᱚᱥᱴᱨᱤᱭᱟ ᱡᱟᱨᱢᱟᱱ"] 
                language [#type "de_CH" ! "ᱥᱩᱣᱤᱥ ᱦᱟᱤ ᱡᱟᱨᱢᱟᱱ"] 
                language [#type "en" ! "ᱟᱝᱜᱽᱨᱮᱡᱤ"] 
                language [#type "en_AU" ! "ᱚᱥᱴᱨᱮᱞᱤᱭᱟᱱ ᱟᱝᱜᱽᱨᱮᱡᱤ"] 
                language [#type "en_CA" ! "ᱠᱟᱱᱟᱰᱤᱭᱟᱱ ᱟᱝᱜᱽᱨᱮᱡᱤ"] 
                language [#type "en_GB" ! "ᱵᱨᱤᱴᱤᱥ ᱟᱝᱜᱽᱨᱮᱡᱤ"] 
                language [#type "en_GB" #alt "short" ! "ᱭᱩᱠᱮ ᱟᱝᱜᱽᱨᱮᱡᱤ"] 
                language [#type "en_US" ! "ᱟᱢᱮᱨᱤᱠᱟᱱ ᱟᱝᱜᱽᱨᱮᱡᱤ"] 
                language [#type "en_US" #alt "short" ! "ᱭᱩᱮᱥ ᱟᱝᱜᱽᱨᱮᱡᱤ"] 
                language [#type "es" ! "ᱮᱥᱯᱮᱱᱤᱥ"] 
                language [#type "es_419" ! "ᱞᱮᱴᱤᱱ ᱟᱢᱮᱨᱤᱠᱟᱱ ᱮᱥᱯᱮᱱᱤᱥ"] 
                language [#type "es_ES" ! "ᱨᱩᱥᱤᱭᱟᱱ ᱮᱥᱯᱮᱱᱤᱥ"] 
                language [#type "es_MX" ! "ᱢᱮᱠᱥᱤᱠᱟᱱ ᱮᱥᱯᱮᱱᱤᱥ"] 
                language [#type "fr" ! "ᱯᱷᱨᱮᱧᱪ"] 
                language [#type "fr_CA" ! "ᱠᱟᱱᱟᱰᱤᱭᱟᱱ ᱯᱷᱨᱮᱧᱪ"] 
                language [#type "fr_CH" ! "ᱥᱩᱣᱤᱥ ᱯᱷᱨᱮᱧᱪ"] 
                language [#type "it" ! "ᱤᱴᱟᱞᱤᱟᱱ"] 
                language [#type "ja" ! "ᱡᱟᱯᱟᱱᱤ"] 
                language [#type "pt" ! "ᱯᱩᱨᱛᱜᱟᱞᱤ"] 
                language [#type "pt_BR" ! "ᱵᱨᱟᱡᱤᱞᱤᱭᱟᱱ ᱯᱩᱨᱛᱜᱟᱞᱤ"] 
                language [#type "pt_PT" ! "ᱭᱩᱨᱚᱯᱤᱭᱟᱱ ᱯᱩᱨᱛᱜᱟᱞᱤ"] 
                language [#type "ru" ! "ᱨᱩᱥᱤᱭᱟᱱ"] 
                language [#type "sat" ! "ᱥᱟᱱᱛᱟᱲᱤ"] 
                language [#type "und" ! "ᱵᱟᱝ ᱩᱨᱩᱢ ᱯᱟᱹᱨᱥᱤ"] 
                language [#type "zh" ! "ᱪᱟᱭᱱᱤᱡᱽ"] 
                language [#type "zh" #alt "menu" ! "ᱪᱟᱭᱱᱤᱡᱽ, ᱢᱟᱱᱰᱟᱨᱤᱱ"] 
                language [#type "zh_Hans" ! "ᱟᱞᱜᱟᱣᱟᱠᱟᱱ ᱪᱟᱭᱱᱤᱡᱽ"] 
                language [#type "zh_Hans" #alt "long" ! "ᱟᱞᱜᱟᱣᱟᱠᱟᱱ ᱢᱟᱫᱟᱨᱤᱱ ᱪᱟᱭᱱᱤᱡᱽ"] 
                language [#type "zh_Hant" ! "ᱴᱨᱮᱰᱤᱥᱱᱟᱞ ᱪᱟᱭᱱᱤᱡᱽ"] 
                language [#type "zh_Hant" #alt "long" ! "ᱴᱨᱮᱰᱤᱥᱱᱟᱞ ᱢᱟᱫᱟᱨᱤᱱ ᱪᱟᱭᱱᱤᱡᱽ"]
            ] 
            scripts [
                script [#type "Arab" ! "ᱟᱨᱵᱤᱠ"] 
                script [#type "Cyrl" ! "ᱥᱤᱨᱤᱞᱤᱠ"] 
                script [#type "Deva" #draft "contributed" ! "ᱫᱮᱣᱟᱱᱟᱜᱟᱨᱤ"] 
                script [#type "Hans" ! "ᱥᱤᱢᱯᱞᱤᱯᱟᱭᱤᱰ"] 
                script [#type "Hans" #alt "stand-alone" ! "ᱥᱤᱢᱯᱞᱤᱯᱟᱭᱤᱰ ᱦᱟᱱ"] 
                script [#type "Hant" ! "ᱴᱨᱮᱰᱤᱥᱚᱱ"] 
                script [#type "Hant" #alt "stand-alone" ! "ᱴᱨᱮᱰᱤᱥᱚᱱ ᱦᱟᱱ"] 
                script [#type "Latn" ! "ᱞᱮᱴᱤᱱ"] 
                script [#type "Olck" ! "ᱚᱞ ᱪᱤᱠᱤ"] 
                script [#type "Zxxx" ! "ᱵᱟᱝ ᱚᱞ ᱟᱠᱟᱱ"] 
                script [#type "Zzzz" ! "ᱵᱟᱝ ᱩᱨᱩᱢ ᱪᱤᱠᱤ"]
            ] 
            territories [
                territory [#type "BR" ! "ᱵᱨᱟᱡᱤᱞ"] 
                territory [#type "CN" ! "ᱪᱤᱱ"] 
                territory [#type "DE" ! "ᱡᱟᱨᱢᱟᱱᱤ"] 
                territory [#type "FR" ! "ᱯᱷᱨᱟᱱᱥ"] 
                territory [#type "GB" ! "ᱭᱩᱱᱤᱭᱴᱮᱰ ᱠᱤᱝᱰᱚᱢ"] 
                territory [#type "IN" ! "ᱤᱱᱰᱤᱭᱟ"] 
                territory [#type "IT" ! "ᱤᱴᱞᱤ"] 
                territory [#type "JP" ! "ᱡᱟᱯᱟᱱ"] 
                territory [#type "RU" ! "ᱨᱩᱥ"] 
                territory [#type "US" ! "ᱭᱩᱱᱟᱭᱴᱮᱰ ᱮᱥᱴᱮᱴ"] 
                territory [#type "ZZ" ! "ᱵᱟᱝᱩᱨᱩᱢ ᱴᱚᱴᱷᱟ"]
            ] 
            types [
                type [#key "calendar" #type "gregorian" ! "ᱜᱨᱮᱜᱚᱨᱤᱭᱟᱱ ᱠᱟᱞᱮᱱᱰᱟᱨ"] 
                type [#key "collation" #type "standard" ! "ᱮᱥᱴᱮᱱᱰᱟᱨᱰ ᱛᱷᱟᱨ ᱟᱸᱫᱮ"] 
                type [#key "numbers" #type "latn" ! "ᱣᱮᱥᱴᱟᱨᱱ ᱮᱞ"]
            ] 
            measurementSystemNames [
                measurementSystemName [#type "metric" ! "ᱢᱮᱴᱨᱤᱠ"] 
                measurementSystemName [#type "UK" ! "ᱭᱩᱠᱮ"] 
                measurementSystemName [#type "US" ! "ᱭᱩᱮᱥ"]
            ] 
            codePatterns [
                codePattern [#type "language" ! "ᱯᱟᱹᱨᱥᱤ: {0}"] 
                codePattern [#type "script" ! "ᱪᱤᱠᱤ/ᱦᱟᱨᱚᱯᱺ {0}"] 
                codePattern [#type "territory" ! "ᱴᱚᱴᱷᱟᱺ {0}"]
            ]
        ] 
        characters [
            exemplarCharacters [#draft "contributed" ! {[ᱚ ᱛ ᱜ ᱝ ᱞ ᱟ ᱠ ᱡ ᱢ ᱣ ᱤ ᱥ ᱦ ᱧ ᱨ ᱩ ᱪ ᱫ ᱬ ᱭ ᱮ ᱯ ᱰ ᱱ ᱲ ᱳ ᱴ ᱵ ᱶ ᱷ ᱸ ᱹ ᱺ ᱻ ᱼ ᱽ]}] 
            exemplarCharacters [#type "numbers" #draft "contributed" ! "[\- ‑ , . % + 0᱐ 1᱑ 2᱒ 3᱓ 4᱔ 5᱕ 6᱖ 7᱗ 8᱘ 9᱙]"]
        ] 
        delimiters [
            quotationStart [! "“"] 
            quotationEnd [! "”"] 
            alternateQuotationStart [! "‘"] 
            alternateQuotationEnd [! "’"]
        ] 
        dates [
            calendars [
                calendar [
                    #type "generic" 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
                            dateFormat [
                                pattern [! "G y MMMM d, EEEE"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [! "G y MMMM d"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "medium" 
                            dateFormat [
                                pattern [! "G y MMM d"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "short" 
                            dateFormat [
                                pattern [! "GGGGG y-MM-dd"]
                            ]
                        ]
                    ] 
                    dateTimeFormats [
                        dateTimeFormatLength [
                            #type "full" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "long" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "medium" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "short" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ]
                    ]
                ] 
                calendar [
                    #type "gregorian" 
                    months [
                        monthContext [
                            #type "format" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "ᱡᱟᱱ"] 
                                month [#type "2" ! "ᱯᱷᱟ"] 
                                month [#type "3" ! "ᱢᱟᱨ"] 
                                month [#type "4" ! "ᱟᱯᱨ"] 
                                month [#type "5" ! "ᱢᱮ"] 
                                month [#type "6" ! "ᱡᱩᱱ"] 
                                month [#type "7" ! "ᱡᱩᱞ"] 
                                month [#type "8" ! "ᱟᱜᱟ"] 
                                month [#type "9" ! "ᱥᱮᱯ"] 
                                month [#type "10" ! "ᱚᱠᱴ"] 
                                month [#type "11" ! "ᱱᱟᱣ"] 
                                month [#type "12" ! "ᱫᱤᱥ"]
                            ] 
                            monthWidth [
                                #type "narrow" 
                                month [#type "1" ! "ᱡ"] 
                                month [#type "2" ! "ᱯ"] 
                                month [#type "3" ! "ᱢ"] 
                                month [#type "4" ! "ᱟ"] 
                                month [#type "5" ! "ᱢ"] 
                                month [#type "6" ! "ᱡ"] 
                                month [#type "7" ! "ᱡ"] 
                                month [#type "8" ! "ᱟ"] 
                                month [#type "9" ! "ᱥ"] 
                                month [#type "10" ! "ᱚ"] 
                                month [#type "11" ! "ᱱ"] 
                                month [#type "12" ! "ᱫ"]
                            ] 
                            monthWidth [
                                #type "wide" 
                                month [#type "1" ! "ᱡᱟᱱᱣᱟᱨᱤ"] 
                                month [#type "2" ! "ᱯᱷᱟᱨᱣᱟᱨᱤ"] 
                                month [#type "3" ! "ᱢᱟᱨᱪ"] 
                                month [#type "4" ! "ᱟᱯᱨᱮᱞ"] 
                                month [#type "5" ! "ᱢᱮ"] 
                                month [#type "6" ! "ᱡᱩᱱ"] 
                                month [#type "7" ! "ᱡᱩᱞᱟᱭ"] 
                                month [#type "8" ! "ᱟᱜᱟᱥᱛ"] 
                                month [#type "9" ! "ᱥᱮᱯᱴᱮᱢᱵᱟᱨ"] 
                                month [#type "10" ! "ᱚᱠᱴᱚᱵᱟᱨ"] 
                                month [#type "11" ! "ᱱᱟᱣᱟᱢᱵᱟᱨ"] 
                                month [#type "12" ! "ᱫᱤᱥᱟᱢᱵᱟᱨ"]
                            ]
                        ] 
                        monthContext [
                            #type "stand-alone" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "ᱡᱟᱱ"] 
                                month [#type "2" ! "ᱯᱷᱟ"] 
                                month [#type "3" ! "ᱢᱟᱨ"] 
                                month [#type "4" ! "ᱟᱯᱨ"] 
                                month [#type "5" ! "ᱢᱮ"] 
                                month [#type "6" ! "ᱡᱩᱱ"] 
                                month [#type "7" ! "ᱡᱩᱞ"] 
                                month [#type "8" ! "ᱟᱜᱟ"] 
                                month [#type "9" ! "ᱥᱮᱯ"] 
                                month [#type "10" ! "ᱚᱠᱴ"] 
                                month [#type "11" ! "ᱱᱟᱣ"] 
                                month [#type "12" ! "ᱫᱤᱥ"]
                            ] 
                            monthWidth [
                                #type "narrow" 
                                month [#type "1" ! "ᱡ"] 
                                month [#type "2" ! "ᱯ"] 
                                month [#type "3" ! "ᱢ"] 
                                month [#type "4" ! "ᱟ"] 
                                month [#type "5" ! "ᱢ"] 
                                month [#type "6" ! "ᱡ"] 
                                month [#type "7" ! "ᱡ"] 
                                month [#type "8" ! "ᱟ"] 
                                month [#type "9" ! "ᱥ"] 
                                month [#type "10" ! "ᱚ"] 
                                month [#type "11" ! "ᱱ"] 
                                month [#type "12" ! "ᱫ"]
                            ]
                        ]
                    ] 
                    days [
                        dayContext [
                            #type "format" 
                            dayWidth [
                                #type "abbreviated" 
                                day [#type "sun" ! "ᱥᱤᱸ"] 
                                day [#type "mon" ! "ᱚᱛ"] 
                                day [#type "tue" ! "ᱵᱟ"] 
                                day [#type "wed" ! "ᱥᱟᱹ"] 
                                day [#type "thu" ! "ᱥᱟᱹᱨ"] 
                                day [#type "fri" ! "ᱡᱟᱹ"] 
                                day [#type "sat" ! "ᱧᱩ"]
                            ] 
                            dayWidth [
                                #type "narrow" 
                                day [#type "sun" ! "ᱥ"] 
                                day [#type "mon" ! "ᱚ"] 
                                day [#type "tue" ! "ᱵ"] 
                                day [#type "wed" ! "ᱥ"] 
                                day [#type "thu" ! "ᱥ"] 
                                day [#type "fri" ! "ᱡ"] 
                                day [#type "sat" ! "ᱧ"]
                            ] 
                            dayWidth [
                                #type "wide" 
                                day [#type "sun" ! "ᱥᱤᱸᱜᱮ"] 
                                day [#type "mon" ! "ᱚᱛᱮ"] 
                                day [#type "tue" ! "ᱵᱟᱞᱮ"] 
                                day [#type "wed" ! "ᱥᱟᱹᱜᱩᱱ"] 
                                day [#type "thu" ! "ᱥᱟᱹᱨᱫᱤ"] 
                                day [#type "fri" ! "ᱡᱟᱹᱨᱩᱢ"] 
                                day [#type "sat" ! "ᱧᱩᱦᱩᱢ"]
                            ]
                        ] 
                        dayContext [
                            #type "stand-alone" 
                            dayWidth [
                                #type "abbreviated" 
                                day [#type "sun" ! "ᱥᱤᱸ"] 
                                day [#type "mon" ! "ᱚᱛ"] 
                                day [#type "tue" ! "ᱵᱟ"] 
                                day [#type "wed" ! "ᱥᱟᱹ"] 
                                day [#type "thu" ! "ᱥᱟᱹᱨ"] 
                                day [#type "fri" ! "ᱡᱟᱹ"] 
                                day [#type "sat" ! "ᱧᱩ"]
                            ] 
                            dayWidth [
                                #type "narrow" 
                                day [#type "sun" ! "ᱥ"] 
                                day [#type "mon" ! "ᱚ"] 
                                day [#type "tue" ! "ᱵ"] 
                                day [#type "wed" ! "ᱥ"] 
                                day [#type "thu" ! "ᱥ"] 
                                day [#type "fri" ! "ᱡ"] 
                                day [#type "sat" ! "ᱧ"]
                            ]
                        ]
                    ] 
                    quarters [
                        quarterContext [
                            #type "format" 
                            quarterWidth [
                                #type "abbreviated" 
                                quarter [#type "1" ! "᱑ᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"] 
                                quarter [#type "2" ! "᱒ᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"] 
                                quarter [#type "3" ! "᱓ᱭᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"] 
                                quarter [#type "4" ! "᱔ᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"]
                            ] 
                            quarterWidth [
                                #type "narrow" 
                                quarter [#type "1" ! "᱑"] 
                                quarter [#type "2" ! "᱒"] 
                                quarter [#type "3" ! "᱓"] 
                                quarter [#type "4" ! "᱔"]
                            ] 
                            quarterWidth [
                                #type "wide" 
                                quarter [#type "1" ! "᱑ᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"] 
                                quarter [#type "2" ! "᱒ᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"] 
                                quarter [#type "3" ! "᱓ᱭᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"] 
                                quarter [#type "4" ! "᱔ᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"]
                            ]
                        ] 
                        quarterContext [
                            #type "stand-alone" 
                            quarterWidth [
                                #type "narrow" 
                                quarter [#type "1" ! "᱑"] 
                                quarter [#type "2" ! "᱒"] 
                                quarter [#type "3" ! "᱓"] 
                                quarter [#type "4" ! "᱔"]
                            ] 
                            quarterWidth [
                                #type "wide" 
                                quarter [#type "1" ! "᱑ᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"] 
                                quarter [#type "2" ! "᱒ᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"] 
                                quarter [#type "3" ! "᱓ᱭᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"] 
                                quarter [#type "4" ! "᱔ᱟᱜ ᱯᱮ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ"]
                            ]
                        ]
                    ] 
                    dayPeriods [
                        dayPeriodContext [
                            #type "format" 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "am" ! "ᱥᱮᱛᱟᱜ"] 
                                dayPeriod [#type "pm" ! "ᱧᱤᱫᱟᱹ"]
                            ]
                        ]
                    ] 
                    eras [
                        eraAbbr [
                            era [#type "0" ! "ᱥᱮᱨᱢᱟ ᱞᱟᱦᱟ"] 
                            era [#type "1" ! "ᱤᱥᱣᱤ"]
                        ]
                    ] 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
                            dateFormat [
                                pattern [! "EEEE, d MMMM y"] 
                                datetimeSkeleton [! "yMMMMEEEEd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [! "d MMMM y"] 
                                datetimeSkeleton [! "yMMMMd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "medium" 
                            dateFormat [
                                pattern [! "d MMM y"] 
                                datetimeSkeleton [! "yMMMd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "short" 
                            dateFormat [
                                pattern [! "d/M/yy"] 
                                datetimeSkeleton [! "yyMd"]
                            ]
                        ]
                    ] 
                    timeFormats [
                        timeFormatLength [
                            #type "full" 
                            timeFormat [
                                pattern [! "h:mm:ss a zzzz"] 
                                datetimeSkeleton [! "ahmmsszzzz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "long" 
                            timeFormat [
                                pattern [! "h:mm:ss a z"] 
                                datetimeSkeleton [! "ahmmssz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "medium" 
                            timeFormat [
                                pattern [! "h:mm:ss a"] 
                                datetimeSkeleton [! "ahmmss"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "short" 
                            timeFormat [
                                pattern [! "h:mm a"] 
                                datetimeSkeleton [! "ahmm"]
                            ]
                        ]
                    ] 
                    dateTimeFormats [
                        dateTimeFormatLength [
                            #type "full" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "long" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "medium" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "short" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ]
                    ]
                ]
            ] 
            fields [
                field [
                    #type "era" 
                    displayName [! "ᱡᱩᱜᱽ"]
                ] 
                field [
                    #type "year" 
                    displayName [! "ᱥᱮᱨᱢᱟ/ᱵᱚᱪᱷᱚᱞᱨ"]
                ] 
                field [
                    #type "year-short" 
                    displayName [! "ᱥᱮᱨᱢᱟ"]
                ] 
                field [
                    #type "quarter" 
                    displayName [! "ᱯᱮᱪᱟᱸᱫᱚ"]
                ] 
                field [
                    #type "quarter-short" 
                    displayName [! "ᱯᱮᱪᱟᱸᱫᱚ"]
                ] 
                field [
                    #type "quarter-narrow" 
                    displayName [! "ᱯᱮᱪᱟᱸᱫᱚ"]
                ] 
                field [
                    #type "month" 
                    displayName [! "ᱪᱟᱸᱫᱚ"]
                ] 
                field [
                    #type "month-short" 
                    displayName [! "ᱪᱟᱸᱫᱚ"]
                ] 
                field [
                    #type "month-narrow" 
                    displayName [! "ᱪᱟᱸᱫᱚ"]
                ] 
                field [
                    #type "week" 
                    displayName [! "ᱦᱟᱯᱛᱟ/ᱮᱢᱦᱟ"]
                ] 
                field [
                    #type "week-short" 
                    displayName [! "ᱦᱟᱯᱛᱟ/ᱮᱢᱦᱟ"]
                ] 
                field [
                    #type "week-narrow" 
                    displayName [! "ᱦᱟᱯᱛᱟ/ᱮᱢᱦᱟ"]
                ] 
                field [
                    #type "day" 
                    displayName [! "ᱢᱟᱦᱟ"] 
                    relative [#type "-1" ! "ᱦᱚᱞᱟ"] 
                    relative [#type "0" ! "ᱛᱮᱦᱮᱧ"] 
                    relative [#type "1" ! "ᱜᱟᱯᱟ"]
                ] 
                field [
                    #type "day-short" 
                    displayName [! "ᱢᱟᱦᱟ"]
                ] 
                field [
                    #type "day-narrow" 
                    displayName [! "ᱢᱟᱦᱟ"]
                ] 
                field [
                    #type "weekday" 
                    displayName [! "ᱦᱟᱯᱛᱟ ᱨᱮᱭᱟᱜ ᱢᱟᱦᱟ"]
                ] 
                field [
                    #type "dayperiod" 
                    displayName [! "ᱥᱮᱛᱟᱜ/ᱟᱹᱭᱩᱵ"]
                ] 
                field [
                    #type "hour" 
                    displayName [! "ᱴᱟᱲᱟᱝ"]
                ] 
                field [
                    #type "minute" 
                    displayName [! "ᱴᱤᱯᱤᱡ"]
                ] 
                field [
                    #type "second" 
                    displayName [! "ᱴᱤᱨᱤᱡ"]
                ] 
                field [
                    #type "second-short" 
                    displayName [! "ᱴᱤᱨᱤᱡ"]
                ] 
                field [
                    #type "second-narrow" 
                    displayName [! "ᱴᱤᱨᱤᱡ"]
                ] 
                field [
                    #type "zone" 
                    displayName [! "ᱴᱚᱴᱷᱟ"]
                ]
            ] 
            timeZoneNames [
                gmtFormat [! "ᱡᱤᱮᱢᱴᱤ{0}"] 
                gmtZeroFormat [! "ᱡᱤᱮᱢᱴᱤ"] 
                regionFormat [! "{0} ᱚᱠᱛᱚ"] 
                regionFormat [#type "daylight" ! "{0} ᱫᱤᱱᱵᱮᱲᱟ ᱚᱠᱛᱚ"] 
                regionFormat [#type "standard" ! "{0} ᱮᱴᱮᱱᱰᱟᱨᱰ ᱚᱠᱛᱚ"] 
                zone [
                    #type "Etc/UTC" 
                    long [
                        standard [! "ᱠᱚᱨᱰᱤᱱᱮᱴᱮᱰ ᱭᱩᱱᱤᱣᱟᱨᱥᱟᱞ ᱚᱠᱛᱚ"]
                    ]
                ] 
                zone [
                    #type "Etc/Unknown" 
                    exemplarCity [! "ᱵᱟᱝ ᱪᱤᱱᱦᱟᱹᱣ ᱵᱟᱡᱟᱨ"]
                ] 
                metazone [
                    #type "America_Central" 
                    long [
                        generic [! "ᱛᱟᱱᱟᱞᱟ ᱚᱠᱛᱚ"] 
                        standard [! "ᱛᱟᱱᱟᱞᱟ ᱮᱥᱴᱮᱱᱰᱟᱨᱰ ᱚᱠᱛᱚ"] 
                        daylight [! "ᱛᱟᱱᱟᱞᱟ ᱥᱤᱧᱟᱜ ᱚᱠᱛᱚ"]
                    ]
                ] 
                metazone [
                    #type "America_Eastern" 
                    long [
                        generic [! "ᱤᱥᱴᱟᱨᱱ ᱚᱠᱛᱚ"] 
                        standard [! "ᱤᱥᱴᱟᱨᱱ ᱮᱥᱴᱮᱱᱰᱟᱨᱰ ᱚᱠᱛᱚ"] 
                        daylight [! "ᱤᱥᱴᱟᱨᱱ ᱥᱤᱧᱟᱜ ᱵᱚᱠᱛᱚ"]
                    ]
                ] 
                metazone [
                    #type "America_Mountain" 
                    long [
                        generic [! "ᱢᱟᱩᱱᱴᱮᱱ ᱚᱠᱛᱚ"] 
                        standard [! "ᱢᱟᱩᱱᱴᱮᱱ ᱮᱥᱴᱮᱱᱰᱟᱨᱰ ᱚᱠᱛᱚ"] 
                        daylight [! "ᱢᱟᱩᱱᱴᱮᱱ ᱥᱤᱧᱟᱜ ᱚᱠᱛᱚ"]
                    ]
                ] 
                metazone [
                    #type "America_Pacific" 
                    long [
                        generic [! "ᱯᱮᱥᱤᱯᱷᱤᱠ ᱚᱠᱛᱚ"] 
                        standard [! "ᱯᱮᱥᱤᱯᱷᱤᱠ ᱮᱥᱴᱮᱱᱰᱟᱨᱰ ᱚᱠᱛᱚ"] 
                        daylight [! "ᱯᱮᱥᱤᱯᱷᱤᱠ ᱥᱤᱧᱟᱜ ᱚᱠᱛᱚ"]
                    ]
                ] 
                metazone [
                    #type "Atlantic" 
                    long [
                        generic [! "ᱮᱴᱞᱟᱱᱴᱤᱠ ᱚᱠᱛᱚ"] 
                        standard [! "ᱮᱴᱞᱟᱱᱴᱤᱠ ᱮᱥᱴᱮᱱᱰᱟᱨᱰ ᱚᱠᱛᱚ"] 
                        daylight [! "ᱮᱴᱞᱟᱱᱴᱤᱠ ᱥᱤᱧᱟᱜ ᱚᱠᱛᱚ"]
                    ]
                ] 
                metazone [
                    #type "Europe_Central" 
                    long [
                        generic [! "ᱥᱮᱱᱴᱨᱟᱞ ᱩᱨᱚᱯᱤᱭᱟᱱ ᱚᱠᱛᱚ"] 
                        standard [! "ᱥᱮᱱᱴᱨᱟᱞ ᱩᱨᱚᱯᱤᱭᱟᱱ ᱮᱥᱴᱮᱱᱰᱟᱨᱰ ᱚᱠᱛᱚ"] 
                        daylight [! "ᱥᱮᱱᱴᱨᱟᱞ ᱩᱨᱚᱯᱤᱭᱟᱱ ᱥᱟᱢᱟᱨ ᱚᱠᱛᱚ"]
                    ]
                ] 
                metazone [
                    #type "Europe_Eastern" 
                    long [
                        generic [! "ᱤᱥᱴᱟᱨᱱ ᱩᱨᱚᱯᱤᱭᱟᱱ ᱚᱠᱛᱚ"] 
                        standard [! "ᱤᱥᱴᱟᱨᱱ ᱩᱨᱚᱯᱤᱭᱟᱱ ᱮᱥᱴᱮᱱᱰᱟᱨᱰ ᱚᱠᱛᱚ"] 
                        daylight [! "ᱤᱥᱴᱟᱨᱱ ᱩᱨᱚᱯᱤᱭᱟᱱ ᱥᱟᱢᱟᱨ ᱚᱠᱛᱚ"]
                    ]
                ] 
                metazone [
                    #type "Europe_Western" 
                    long [
                        generic [! "ᱣᱮᱥᱴᱟᱨᱱ ᱩᱨᱚᱯᱤᱭᱟᱱ ᱚᱠᱛᱚ"] 
                        standard [! "ᱣᱮᱥᱴᱟᱨᱱ ᱩᱨᱚᱯᱤᱭᱟᱱ ᱮᱥᱴᱮᱱᱰᱟᱨᱰ ᱚᱠᱛᱚ"] 
                        daylight [! "ᱣᱮᱥᱴᱟᱨᱱ ᱩᱨᱚᱯᱤᱭᱟᱱ ᱥᱟᱢᱟᱨ ᱚᱠᱛᱚ"]
                    ]
                ] 
                metazone [
                    #type "GMT" 
                    long [
                        standard [! "ᱜᱨᱤᱱᱣᱤᱪ ᱢᱤᱱ ᱚᱠᱛᱚ"]
                    ]
                ]
            ]
        ] 
        numbers [
            defaultNumberingSystem [! "olck"] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"]
            ] 
            currencies [
                currency [
                    #type "BRL" 
                    displayName [! "ᱵᱨᱟᱡᱤᱞᱤᱭᱟᱱ ᱨᱤᱭᱟᱹᱞ"] 
                    displayName [#count "one" ! "ᱵᱨᱟᱡᱤᱞᱤᱭᱟᱱ ᱨᱤᱭᱟᱹᱞ"] 
                    displayName [#count "two" ! "ᱵᱨᱟᱡᱤᱞᱤᱭᱟᱱ ᱨᱤᱭᱟᱹᱞᱥ"] 
                    displayName [#count "other" ! "ᱵᱨᱟᱡᱤᱞᱤᱭᱟᱱ ᱨᱤᱭᱟᱹᱞᱥ"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "ᱪᱤᱱᱤ ᱭᱩᱣᱟᱱ"]
                ] 
                currency [
                    #type "EUR" 
                    displayName [! "ᱭᱩᱨᱚ"] 
                    displayName [#count "one" ! "ᱭᱩᱨᱚ"] 
                    displayName [#count "two" ! "ᱭᱩᱨᱚ"] 
                    displayName [#count "other" ! "ᱭᱩᱨᱚ"]
                ] 
                currency [
                    #type "GBP" 
                    displayName [! "ᱵᱨᱤᱴᱤᱥ ᱯᱟᱣᱩᱸᱰ"] 
                    displayName [#count "one" ! "ᱵᱨᱤᱴᱤᱥ ᱯᱟᱣᱩᱸᱰ"] 
                    displayName [#count "two" ! "ᱵᱨᱤᱴᱤᱥ ᱯᱟᱣᱩᱸᱰᱥ"] 
                    displayName [#count "other" ! "ᱵᱨᱤᱴᱤᱥ ᱯᱟᱣᱩᱸᱰᱥ"]
                ] 
                currency [
                    #type "INR" 
                    displayName [! "ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱴᱟᱠᱟ"] 
                    displayName [#count "one" ! "ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱴᱟᱠᱟ"] 
                    displayName [#count "two" ! "ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱴᱟᱠᱟ"] 
                    displayName [#count "other" ! "ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱴᱟᱠᱟ"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [! "ᱡᱟᱯᱟᱱᱤ ᱭᱮᱱ"] 
                    displayName [#count "one" ! "ᱡᱟᱯᱟᱱᱤ ᱭᱮᱱ"] 
                    displayName [#count "two" ! "ᱡᱟᱯᱟᱱᱤ ᱭᱮᱱ"] 
                    displayName [#count "other" ! "ᱡᱟᱯᱟᱱᱤ ᱭᱮᱱ"]
                ] 
                currency [
                    #type "RUB" 
                    displayName [! "ᱨᱩᱥᱤ ᱨᱩᱵᱟᱹᱞ"] 
                    displayName [#count "one" ! "ᱨᱩᱥᱤ ᱨᱩᱵᱟᱹᱞ"] 
                    displayName [#count "two" ! "ᱨᱩᱥᱤ ᱨᱩᱵᱟᱹᱞᱥ"] 
                    displayName [#count "other" ! "ᱨᱩᱥᱤ ᱨᱩᱵᱟᱹᱞᱥ"]
                ] 
                currency [
                    #type "USD" 
                    displayName [! "ᱭᱩᱮᱥ ᱰᱚᱞᱟᱨ"] 
                    displayName [#count "one" ! "ᱭᱩᱮᱥ ᱰᱚᱞᱟᱨ"] 
                    displayName [#count "two" ! "ᱭᱩᱮᱥ ᱰᱚᱞᱟᱨ"] 
                    displayName [#count "other" ! "ᱭᱩᱮᱥ ᱰᱚᱞᱟᱨ"]
                ] 
                currency [
                    #type "XXX" 
                    displayName [! "ᱵᱟᱝᱩᱨᱩᱢ ᱠᱟᱨᱮᱱᱥᱤ"] 
                    displayName [#count "one" ! "ᱵᱟᱝᱩᱨᱩᱢ ᱠᱟᱨᱮᱱᱥᱤ"] 
                    displayName [#count "two" ! "ᱵᱟᱝᱩᱨᱩᱢ ᱠᱟᱨᱮᱱᱥᱤ"] 
                    displayName [#count "other" ! "ᱵᱟᱝᱩᱨᱩᱢ ᱠᱟᱨᱮᱱᱥᱤ"]
                ]
            ]
        ] 
        units [
            unitLength [
                #type "narrow" 
                unit [
                    #type "volume-dessert-spoon-imperial" 
                    unitPattern [#count "one" ! "{0}dsp-Imp"] 
                    unitPattern [#count "two" ! "{0} dstspn Imp"] 
                    unitPattern [#count "other" ! "{0} dstspn Imp"]
                ]
            ] 
            durationUnit [
                #type "hm" 
                durationUnitPattern [! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        posix [
            messages [
                yesstr [! "ᱦᱚᱸᱺᱦ"] 
                nostr [! "ᱵᱟᱝᱺᱵ"]
            ]
        ]
    ]

