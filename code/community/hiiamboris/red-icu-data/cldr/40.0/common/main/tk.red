            parseLenients [
                #scope "date" 
                #level "lenient" 
                parseLenient [#sample "-" ! "[\--/]"] 
                parseLenient [#sample ":" ! "[\:∶]"]
            ] 
            parseLenients [
                #scope "general" 
                #level "lenient" 
                parseLenient [#sample "." ! "[.․。︒﹒．｡]"] 
                parseLenient [#sample "$" ! "[\$﹩＄$]"] 
                parseLenient [#sample "£" ! "[£₤]"] 
                parseLenient [#sample "₹" ! "[₨₹{Rp}{Rs}]"]
            ] 
            parseLenients [
                #scope "number" 
                #level "lenient" 
                parseLenient [#sample "-" ! "[\-‒⁻₋−➖﹣－]"] 
                parseLenient [#sample "," ! "[,،٫、︐︑﹐﹑，､]"] 
                parseLenient [#sample "+" ! "[+⁺₊➕﬩﹢＋]"]
            ] 
            parseLenients [
                #scope "number" 
                #level "stricter" 
                parseLenient [#sample "," ! "[,٫︐﹐，]"] 
                parseLenient [#sample "." ! "[.․﹒．｡]"]
            ]
        ] 
        delimiters [
            quotationStart [! "“"] 
            quotationEnd [! "”"] 
            alternateQuotationStart [! "“"] 
            alternateQuotationEnd [! "”"]
        ] 
        dates [
            calendars [
                calendar [
                    #type "generic" 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
                            dateFormat [
                                pattern [! "d MMMM y G EEEE"] 
                                datetimeSkeleton [! "GyMMMMEEEEd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [! "d MMMM y G"] 
                                datetimeSkeleton [! "GyMMMMd"]
