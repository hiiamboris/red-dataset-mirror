                    unitPattern [#count "one" ! "{0} mi³"] 
                    unitPattern [#count "two" ! "{0} mi³"] 
                    unitPattern [#count "many" ! "{0} mi³"] 
                    unitPattern [#count "other" ! "{0} mi³"]
                ] 
                unit [
                    #type "volume-liter" 
                    displayName [! "ליטר"] 
                    unitPattern [#count "one" ! "{0} ל׳"] 
                    unitPattern [#count "two" ! "{0} ל׳"] 
                    unitPattern [#count "many" ! "{0} ל׳"] 
                    unitPattern [#count "other" ! "{0} ל׳"]
                ] 
                unit [
                    #type "volume-gallon-imperial" 
                    unitPattern [#count "one" ! "{0}/galIm"] 
                    unitPattern [#count "two" ! "{0}/galIm"] 
                    unitPattern [#count "many" ! "{0}/galIm"] 
                    unitPattern [#count "other" ! "{0}/galIm"] 
                    perUnitPattern [! "{0}/galIm"]
                ] 
                unit [
                    #type "volume-dessert-spoon-imperial" 
                    unitPattern [#count "one" ! "{0}dsp-Imp"] 
                    unitPattern [#count "two" ! "{0}dsp-Imp"] 
                    unitPattern [#count "many" ! "{0} dstspn"] 
                    unitPattern [#count "other" ! "{0}dsp-Imp"]
                ] 
                coordinateUnit [
                    displayName [! "כיוון"] 
                    coordinateUnitPattern [#type "east" ! "{0} מז׳"] 
                    coordinateUnitPattern [#type "north" ! "{0} צפ׳"] 
                    coordinateUnitPattern [#type "south" ! "{0} דר׳"] 
                    coordinateUnitPattern [#type "west" ! "{0} מע׳"]
                ]
            ] 
            durationUnit [
                #type "hm" 
                durationUnitPattern [! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
