                        relativeTimePattern [#count "other" ! "פֿאַר {0} חדשים"]
                    ]
                ] 
                field [
                    #type "month-narrow" 
                    displayName [! "מאנאַט"] 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" ! "איבער {0} חודש"] 
                        relativeTimePattern [#count "other" ! "איבער {0} חדשים"]
                    ] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" ! "פֿאַר {0} חודש"] 
                        relativeTimePattern [#count "other" ! "פֿאַר {0} חדשים"]
                    ]
                ] 
                field [
                    #type "week" 
                    displayName [! "וואך"] 
                    relative [#type "-1" ! "last week"] 
                    relative [#type "0" ! "this week"] 
                    relative [#type "1" ! "איבער אַכט טאָג"]
                ] 
                field [
                    #type "week-short" 
                    displayName [! "וואך"]
                ] 
                field [
                    #type "week-narrow" 
                    displayName [! "וואך"]
                ] 
                field [
                    #type "day" 
                    displayName [! "טאָג"] 
                    relative [#type "-1" ! "נעכטן"] 
                    relative [#type "0" ! "היינט"] 
                    relative [#type "1" ! "מארגן"] 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" ! "אין {0} טאָג אַרום"] 
                        relativeTimePattern [#count "other" ! "אין {0} טעג אַרום"]
                    ]
                ] 
                field [
                    #type "day-short" 
                    displayName [! "טאָג"]
                ] 
                field [
                    #type "day-narrow" 
                    displayName [! "טאָג"]
                ] 
                field [
                    #type "weekday" 
                    displayName [! "טאָג אין דער וואך"]
                ] 
                field [
                    #type "hour" 
                    displayName [! "שעה"]
                ] 
                field [
                    #type "hour-short" 
                    displayName [! "שעה"]
                ] 
                field [
                    #type "hour-narrow" 
                    displayName [! "שעה"]
                ] 
                field [
                    #type "minute" 
                    displayName [! "מינוט"]
                ] 
                field [
                    #type "minute-short" 
                    displayName [! "מינוט"]
                ] 
                field [
                    #type "minute-narrow" 
                    displayName [! "מינוט"]
                ] 
                field [
                    #type "second" 
                    displayName [! "סעקונדע"]
                ] 
                field [
                    #type "second-short" 
                    displayName [! "סעקונדע"]
                ] 
                field [
                    #type "second-narrow" 
                    displayName [! "סעקונדע"]
                ] 
                field [
                    #type "zone" 
                    displayName [! "צײַטזאנע"]
                ]
            ] 
            timeZoneNames [
                zone [
                    #type "Etc/Unknown" 
                    exemplarCity [! "אומבאַוואוסטע שטאָט"]
                ] 
                zone [
                    #type "Africa/Abidjan" 
                    exemplarCity [! "אַבידזשאַן"]
                ] 
                zone [
                    #type "Africa/Asmera" 
                    exemplarCity [! "אַסמאַראַ"]
                ] 
                zone [
                    #type "Africa/Windhoek" 
                    exemplarCity [! "ווינטהוק"]
                ] 
                zone [
                    #type "Africa/Tunis" 
                    exemplarCity [! "טוניס"]
                ] 
                zone [
                    #type "Asia/Saigon" 
                    exemplarCity [! "הא טשי מין שטאָט"]
                ]
            ]
        ] 
        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"] 
                traditional [! "hebr"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [#draft "contributed" ! "."] 
                group [#draft "contributed" ! ","] 
                list [#draft "contributed" ! ";"] 
                percentSign [#draft "contributed" ! "%"] 
                plusSign [#draft "contributed" ! "+"] 
                minusSign [#draft "contributed" ! "-"] 
                exponential [#draft "contributed" ! "E"] 
                perMille [#draft "contributed" ! "‰"] 
                infinity [#draft "contributed" ! "∞"] 
                nan [#draft "contributed" ! "NaN"]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "one" #draft "provisional" ! "¤ 0K"] 
                        pattern [#type "1000" #count "other" #draft "provisional" ! "¤ 0K"] 
                        pattern [#type "10000" #count "one" #draft "provisional" ! "¤ 00K"] 
                        pattern [#type "10000" #count "other" #draft "provisional" ! "¤ 00K"] 
                        pattern [#type "100000" #count "one" #draft "provisional" ! "¤ 000K"] 
                        pattern [#type "100000" #count "other" #draft "provisional" ! "¤ 000K"] 
                        pattern [#type "1000000" #count "one" #draft "provisional" ! "¤ 0M"] 
                        pattern [#type "1000000" #count "other" #draft "provisional" ! "¤ 0M"] 
                        pattern [#type "10000000" #count "one" #draft "provisional" ! "¤ 00M"] 
                        pattern [#type "10000000" #count "other" #draft "provisional" ! "¤ 00M"] 
                        pattern [#type "100000000" #count "one" #draft "provisional" ! "¤ 000M"] 
                        pattern [#type "100000000" #count "other" #draft "provisional" ! "¤ 000M"] 
                        pattern [#type "1000000000" #count "one" #draft "provisional" ! "¤ 0G"] 
                        pattern [#type "1000000000" #count "other" #draft "provisional" ! "¤ 0G"] 
                        pattern [#type "10000000000" #count "one" #draft "provisional" ! "¤ 00G"] 
                        pattern [#type "10000000000" #count "other" #draft "provisional" ! "¤ 00G"] 
                        pattern [#type "100000000000" #count "one" #draft "provisional" ! "¤ 000G"] 
                        pattern [#type "100000000000" #count "other" #draft "provisional" ! "¤ 000G"] 
                        pattern [#type "1000000000000" #count "one" #draft "provisional" ! "¤ 0T"] 
                        pattern [#type "1000000000000" #count "other" #draft "provisional" ! "¤ 0T"] 
                        pattern [#type "10000000000000" #count "one" #draft "provisional" ! "¤ 00T"] 
                        pattern [#type "10000000000000" #count "other" #draft "provisional" ! "¤ 00T"] 
                        pattern [#type "100000000000000" #count "one" #draft "provisional" ! "¤ 000T"] 
                        pattern [#type "100000000000000" #count "other" #draft "provisional" ! "¤ 000T"]
                    ]
                ]
            ] 
            currencies [
                currency [
                    #type "BRL" 
                    displayName [! "בראזיל רעאל"] 
                    displayName [#count "one" ! "בראזיל רעאל"] 
                    displayName [#count "other" ! "בראזיל רעאלן"]
                ] 
                currency [
                    #type "BZD" 
                    displayName [! "בעליז דאלאַר"]
                ] 
                currency [
                    #type "CHF" 
                    displayName [! "שווייצער פֿראַנק"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "כינעזישער יואן"] 
                    displayName [#count "one" ! "כינעזישער יואן"] 
                    displayName [#count "other" ! "כינעזישע יואן"]
                ] 
                currency [
                    #type "EUR" 
                    displayName [! "איירא"] 
                    displayName [#count "one" ! "איירא"] 
                    displayName [#count "other" ! "איירא"] 
                    symbol [#draft "contributed" ! "€"] 
                    symbol [#alt "narrow" #draft "contributed" ! "€"]
                ] 
                currency [
                    #type "GBP" 
                    displayName [! "פֿונט שטערלינג"] 
                    displayName [#count "one" ! "פֿונט שטערלינג"] 
                    displayName [#count "other" ! "פֿונט שטערלינג"] 
                    symbol [#draft "contributed" ! "£"] 
                    symbol [#alt "narrow" #draft "contributed" ! "£"]
                ] 
                currency [
                    #type "INR" 
                    displayName [! "אינדישער רופי"] 
                    displayName [#count "one" ! "אינדישער רופי"] 
                    displayName [#count "other" ! "אינדישע רופי"] 
                    symbol [#draft "contributed" ! "₹"] 
                    symbol [#alt "narrow" #draft "contributed" ! "₹"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [! "יאפאנעזישער יען"] 
                    displayName [#count "one" ! "יאפאנעזישער יען"] 
                    displayName [#count "other" ! "יאפאנעזישע יען"] 
                    symbol [#draft "contributed" ! "JP¥"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "RUB" 
                    displayName [! "רוסישער רובל"] 
                    displayName [#count "one" ! "רוסישער רובל"] 
                    displayName [#count "other" ! "רוסישע רובל"] 
                    symbol [#draft "contributed" ! "RUB"] 
                    symbol [#alt "narrow" #draft "contributed" ! "₽"]
                ] 
                currency [
                    #type "SEK" 
                    displayName [! "שוועדישע קראנע"]
                ] 
                currency [
                    #type "USD" 
                    displayName [! "אמעריקאנער דאלאר"] 
                    displayName [#count "one" ! "אמעריקאנער דאלאר"] 
                    displayName [#count "other" ! "אמעריקאנער דאלארן"] 
                    symbol [#alt "narrow" #draft "contributed" ! "$"]
                ] 
                currency [
                    #type "XAG" 
                    displayName [! "זילבער"]
                ] 
                currency [
                    #type "XAU" 
                    displayName [! "גאלד"]
                ] 
                currency [
                    #type "XXX" 
                    displayName [! "אומבאַוואוסטע וואַלוטע"] 
                    displayName [#count "one" ! "אומבאַוואוסטע וואַלוטע"] 
                    displayName [#count "other" ! "אומבאַוואוסטע וואַלוטע"]
                ]
            ]
        ] 
        units [
            durationUnit [
                #type "hm" 
                durationUnitPattern [! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} און {1}"] 
                listPatternPart [#type "2" ! "{0} און {1}"]
            ]
        ]
    ]

