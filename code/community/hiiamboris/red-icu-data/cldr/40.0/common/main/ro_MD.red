
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ro"] 
            territory [#type "MD"]
        ] 
        localeDisplayNames [
            languages [
                language [#type "sw_CD" #draft "contributed" ! "swahili (R. D. Congo)"] 
                language [#type "wal" #draft "contributed" ! "wolaytta"]
            ] 
            territories [
                territory [#type "MM" #draft "contributed" ! "Myanmar"]
            ]
        ] 
        dates [
            calendars [
                calendar [
                    #type "gregorian" 
                    days [
                        dayContext [
                            #type "format" 
                            dayWidth [
                                #type "abbreviated" 
                                day [#type "sun" #draft "contributed" ! "Dum"] 
                                day [#type "mon" #draft "contributed" ! "Lun"] 
                                day [#type "tue" #draft "contributed" ! "Mar"] 
                                day [#type "wed" #draft "contributed" ! "Mie"] 
                                day [#type "thu" #draft "contributed" ! "Joi"] 
                                day [#type "fri" #draft "contributed" ! "Vin"] 
                                day [#type "sat" #draft "contributed" ! "Sâm"]
                            ] 
                            dayWidth [
                                #type "narrow" 
                                day [#type "sun" #draft "contributed" ! "D"] 
                                day [#type "mon" #draft "contributed" ! "L"] 
                                day [#type "tue" #draft "contributed" ! "Ma"] 
                                day [#type "wed" #draft "contributed" ! "Mi"] 
                                day [#type "thu" #draft "contributed" ! "J"] 
                                day [#type "fri" #draft "contributed" ! "V"] 
                                day [#type "sat" #draft "contributed" ! "S"]
                            ] 
                            dayWidth [
                                #type "short" 
                                day [#type "sun" #draft "contributed" ! "Du"] 
                                day [#type "mon" #draft "contributed" ! "Lu"] 
                                day [#type "tue" #draft "contributed" ! "Ma"] 
                                day [#type "wed" #draft "contributed" ! "Mi"] 
                                day [#type "thu" #draft "contributed" ! "Jo"] 
                                day [#type "fri" #draft "contributed" ! "Vi"] 
                                day [#type "sat" #draft "contributed" ! "Sâ"]
                            ]
                        ] 
                        dayContext [
                            #type "stand-alone" 
                            dayWidth [
                                #type "abbreviated" 
                                day [#type "sun" #draft "contributed" ! "Dum"] 
                                day [#type "mon" #draft "contributed" ! "Lun"] 
                                day [#type "tue" #draft "contributed" ! "Mar"] 
                                day [#type "wed" #draft "contributed" ! "Mie"] 
                                day [#type "thu" #draft "contributed" ! "Joi"] 
                                day [#type "fri" #draft "contributed" ! "Vin"] 
                                day [#type "sat" #draft "contributed" ! "Sâm"]
                            ] 
                            dayWidth [
                                #type "narrow" 
                                day [#type "sun" #draft "contributed" ! "D"] 
                                day [#type "mon" #draft "contributed" ! "L"] 
                                day [#type "tue" #draft "contributed" ! "Ma"] 
                                day [#type "wed" #draft "contributed" ! "Mi"] 
                                day [#type "thu" #draft "contributed" ! "J"] 
                                day [#type "fri" #draft "contributed" ! "V"] 
                                day [#type "sat" #draft "contributed" ! "S"]
                            ] 
                            dayWidth [
                                #type "short" 
                                day [#type "sun" #draft "contributed" ! "Du"] 
                                day [#type "mon" #draft "contributed" ! "Lu"] 
                                day [#type "tue" #draft "contributed" ! "Ma"] 
                                day [#type "wed" #draft "contributed" ! "Mi"] 
                                day [#type "thu" #draft "contributed" ! "Jo"] 
                                day [#type "fri" #draft "contributed" ! "Vi"] 
                                day [#type "sat" #draft "contributed" ! "Sâ"]
                            ]
                        ]
                    ] 
                    quarters [
                        quarterContext [
                            #type "format" 
                            quarterWidth [
                                #type "abbreviated" 
                                quarter [#type "1" #draft "contributed" ! "trim. 1"] 
                                quarter [#type "2" #draft "contributed" ! "trim. 2"] 
                                quarter [#type "3" #draft "contributed" ! "trim. 3"] 
                                quarter [#type "4" #draft "contributed" ! "trim. 4"]
                            ] 
                            quarterWidth [
                                #type "wide" 
                                quarter [#type "1" #draft "contributed" ! "trimestrul 1"] 
                                quarter [#type "2" #draft "contributed" ! "trimestrul 2"] 
                                quarter [#type "3" #draft "contributed" ! "trimestrul 3"] 
                                quarter [#type "4" #draft "contributed" ! "trimestrul 4"]
                            ]
                        ] 
                        quarterContext [
                            #type "stand-alone" 
                            quarterWidth [
                                #type "abbreviated" 
                                quarter [#type "1" #draft "contributed" ! "Trim. 1"] 
                                quarter [#type "2" #draft "contributed" ! "Trim. 2"] 
                                quarter [#type "3" #draft "contributed" ! "Trim. 3"] 
                                quarter [#type "4" #draft "contributed" ! "Trim. 4"]
                            ] 
                            quarterWidth [
                                #type "wide" 
                                quarter [#type "1" #draft "contributed" ! "Trimestrul 1"] 
                                quarter [#type "2" #draft "contributed" ! "Trimestrul 2"] 
                                quarter [#type "3" #draft "contributed" ! "Trimestrul 3"] 
                                quarter [#type "4" #draft "contributed" ! "Trimestrul 4"]
                            ]
                        ]
                    ] 
                    dayPeriods [
                        dayPeriodContext [
                            #type "format" 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "midnight" #draft "contributed" ! "miezul nopții"] 
                                dayPeriod [#type "noon" #draft "contributed" ! "amiază"] 
                                dayPeriod [#type "morning1" #draft "contributed" ! "dimineață"] 
                                dayPeriod [#type "afternoon1" #draft "contributed" ! "după-amiază"] 
                                dayPeriod [#type "evening1" #draft "contributed" ! "seară"] 
                                dayPeriod [#type "night1" #draft "contributed" ! "noapte"]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "midnight" #draft "contributed" ! "miezul nopții"] 
                                dayPeriod [#type "noon" #draft "contributed" ! "amiază"] 
                                dayPeriod [#type "morning1" #draft "contributed" ! "dimineața"] 
                                dayPeriod [#type "afternoon1" #draft "contributed" ! "după-amiaza"] 
                                dayPeriod [#type "evening1" #draft "contributed" ! "seara"] 
                                dayPeriod [#type "night1" #draft "contributed" ! "noaptea"]
                            ]
                        ] 
                        dayPeriodContext [
                            #type "stand-alone" 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "morning1" #draft "contributed" ! "dimineață"] 
                                dayPeriod [#type "afternoon1" #draft "contributed" ! "după-amiază"] 
                                dayPeriod [#type "evening1" #draft "contributed" ! "seară"] 
                                dayPeriod [#type "night1" #draft "contributed" ! "noapte"]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "midnight" #draft "contributed" ! "miezul nopții"] 
                                dayPeriod [#type "noon" #draft "contributed" ! "amiază"]
                            ]
                        ]
                    ] 
                    eras [
                        eraAbbr [
                            era [#type "0" #alt "variant" #draft "contributed" ! "î.e.n."]
                        ]
                    ]
                ]
            ]
        ] 
        numbers [
            currencies [
                currency [
                    #type "MDL" 
                    symbol [! "L"]
                ]
            ]
        ] 
        units [
            unitLength [
                #type "short" 
                unit [
                    #type "duration-millisecond" 
                    displayName [#draft "contributed" ! "milisec."]
                ]
            ] 
            unitLength [
                #type "narrow" 
                unit [
                    #type "duration-year" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} an"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} ani"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} ani"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "contributed" ! "lună"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} lună"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} luni"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} luni"]
                ] 
                unit [
                    #type "duration-day" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} zi"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} zile"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} zile"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [#draft "contributed" ! "min"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} min."] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} min."] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} min."]
                ] 
                unit [
                    #type "duration-millisecond" 
                    displayName [#draft "contributed" ! "msec"]
                ]
            ]
        ]
    ]

