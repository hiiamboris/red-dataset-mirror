                            appendItem [#request "Second" ! "{0} ({2}: {1})"] 
                            appendItem [#request "Timezone" ! "{0} {1}"] 
                            appendItem [#request "Week" ! "{0} ({2}: {1})"] 
                            appendItem [#request "Year" ! "{1} {0}"]
                        ]
                    ]
                ]
            ] 
