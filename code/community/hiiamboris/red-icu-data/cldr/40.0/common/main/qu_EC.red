
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "qu"] 
            territory [#type "EC"]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "Ecuador" 
                    short [
                        standard [! "ECT"]
                    ]
                ] 
                metazone [
                    #type "Peru" 
                    short [
                        generic [! "∅∅∅"] 
                        standard [! "∅∅∅"] 
                        daylight [! "∅∅∅"]
                    ]
                ]
            ]
        ] 
        numbers [
            currencies [
                currency [
                    #type "PEN" 
                    symbol [! "PEN"]
                ] 
                currency [
                    #type "USD" 
                    symbol [! "$"]
                ]
            ]
        ]
    ]

