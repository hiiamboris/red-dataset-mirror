                                #type "narrow" 
                                dayPeriod [#type "am" ! "AM"] 
                                dayPeriod [#type "pm" ! "PM"]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "am" ! "AM"] 
                                dayPeriod [#type "pm" ! "PM"]
                            ]
                        ]
                    ] 
                    eras [
                        eraNames [
                            era [#type "0" ! "BCE"] 
                            era [#type "1" ! "CE"]
                        ] 
                        eraAbbr [
                            era [#type "0" ! "BCE"] 
                            era [#type "0" #alt "variant" ! "इ.स.पू."] 
                            era [#type "1" #alt "variant" ! "संवत्"]
                        ]
                    ] 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
                            dateFormat [
                                pattern [! "EEEE, d MMMM y"] 
                                datetimeSkeleton [! "yMMMMEEEEd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [! "d MMMM y"] 
                                datetimeSkeleton [! "yMMMMd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "medium" 
                            dateFormat [
                                pattern [! "d MMM y"] 
                                datetimeSkeleton [! "yMMMd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "short" 
                            dateFormat [
                                pattern [! "d/M/yy"] 
                                datetimeSkeleton [! "yyMd"]
                            ]
                        ]
                    ] 
                    timeFormats [
                        timeFormatLength [
                            #type "full" 
                            timeFormat [
                                pattern [! "h:mm:ss a zzzz"] 
                                datetimeSkeleton [! "ahmmsszzzz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "long" 
                            timeFormat [
                                pattern [! "h:mm:ss a z"] 
                                datetimeSkeleton [! "ahmmssz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "medium" 
                            timeFormat [
                                pattern [! "h:mm:ss a"] 
                                datetimeSkeleton [! "ahmmss"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "short" 
                            timeFormat [
                                pattern [! "h:mm a"] 
                                datetimeSkeleton [! "ahmm"]
                            ]
                        ]
                    ] 
                    dateTimeFormats [
                        dateTimeFormatLength [
                            #type "full" 
                            dateTimeFormat [
                                pattern [! "{1} तदा {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "long" 
                            dateTimeFormat [
                                pattern [! "{1} तदा {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "medium" 
                            dateTimeFormat [
                                pattern [! "{1}, {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "short" 
                            dateTimeFormat [
                                pattern [! "{1}, {0}"]
                            ]
                        ] 
                        availableFormats [
                            dateFormatItem [#id "Bh" ! "B h"] 
                            dateFormatItem [#id "Bhm" ! "B h:mm"] 
                            dateFormatItem [#id "Bhms" ! "B h:mm:ss"] 
                            dateFormatItem [#id "d" ! "d"] 
                            dateFormatItem [#id "E" ! "ccc"] 
                            dateFormatItem [#id "EBhm" ! "E B h:mm"] 
                            dateFormatItem [#id "EBhms" ! "E B h:mm:ss"] 
                            dateFormatItem [#id "Ed" ! "E d"] 
                            dateFormatItem [#id "Ehm" ! "E h:mm a"] 
                            dateFormatItem [#id "EHm" ! "E HH:mm"] 
                            dateFormatItem [#id "Ehms" ! "E h:mm:ss a"] 
                            dateFormatItem [#id "EHms" ! "E HH:mm:ss"] 
                            dateFormatItem [#id "Gy" ! "y G"] 
                            dateFormatItem [#id "GyMMM" ! "MMM G y"] 
                            dateFormatItem [#id "GyMMMd" ! "d MMM y G"] 
                            dateFormatItem [#id "GyMMMEd" ! "E, d MMM y G"] 
                            dateFormatItem [#id "h" ! "h a"] 
                            dateFormatItem [#id "H" ! "HH"] 
                            dateFormatItem [#id "hm" ! "h:mm a"] 
                            dateFormatItem [#id "Hm" ! "HH:mm"] 
                            dateFormatItem [#id "hms" ! "h:mm:ss a"] 
                            dateFormatItem [#id "Hms" ! "HH:mm:ss"] 
                            dateFormatItem [#id "hmsv" ! "h:mm:ss a v"] 
                            dateFormatItem [#id "Hmsv" ! "HH:mm:ss v"] 
                            dateFormatItem [#id "hmv" ! "h:mm a v"] 
                            dateFormatItem [#id "Hmv" ! "HH:mm v"] 
                            dateFormatItem [#id "M" ! "L"] 
                            dateFormatItem [#id "Md" ! "d/M"] 
                            dateFormatItem [#id "MEd" ! "E, d/M"] 
                            dateFormatItem [#id "MMM" ! "LLL"] 
                            dateFormatItem [#id "MMMd" ! "d MMM"] 
                            dateFormatItem [#id "MMMEd" ! "E, d MMM"] 
                            dateFormatItem [#id "MMMMd" ! "d MMMM"] 
                            dateFormatItem [#id "MMMMW" #count "other" ! "'week' W 'of' MMM"] 
                            dateFormatItem [#id "ms" ! "mm:ss"] 
                            dateFormatItem [#id "y" ! "y"] 
                            dateFormatItem [#id "yM" ! "M/y"] 
                            dateFormatItem [#id "yMd" ! "d/M/y"] 
                            dateFormatItem [#id "yMEd" ! "E, d/M/y"] 
                            dateFormatItem [#id "yMMM" ! "MMM y"] 
                            dateFormatItem [#id "yMMMd" ! "d MMM y"] 
                            dateFormatItem [#id "yMMMEd" ! "E, d MMM y"] 
                            dateFormatItem [#id "yMMMM" ! "MMMM y"] 
                            dateFormatItem [#id "yQQQ" ! "QQQ y"] 
                            dateFormatItem [#id "yQQQQ" ! "QQQQ y"] 
                            dateFormatItem [#id "yw" #count "other" ! "'week' w 'of' Y"]
                        ] 
                        appendItems [
                            appendItem [#request "Timezone" ! "{0} {1}"]
                        ] 
                        intervalFormats [
                            intervalFormatFallback [! "{0} – {1}"] 
                            intervalFormatItem [
                                #id "d" 
                                greatestDifference [#id "d" ! "d–d"]
                            ] 
                            intervalFormatItem [
                                #id "h" 
                                greatestDifference [#id "a" ! "h a – h a"] 
                                greatestDifference [#id "h" ! "h–h a"]
                            ] 
                            intervalFormatItem [
                                #id "H" 
                                greatestDifference [#id "H" ! "HH–HH"]
                            ] 
                            intervalFormatItem [
                                #id "hm" 
                                greatestDifference [#id "a" ! "h:mm a – h:mm a"] 
                                greatestDifference [#id "h" ! "h:mm–h:mm a"] 
                                greatestDifference [#id "m" ! "h:mm–h:mm a"]
                            ] 
                            intervalFormatItem [
                                #id "Hm" 
                                greatestDifference [#id "H" ! "HH:mm–HH:mm"] 
                                greatestDifference [#id "m" ! "HH:mm–HH:mm"]
                            ] 
                            intervalFormatItem [
                                #id "hmv" 
                                greatestDifference [#id "a" ! "h:mm a – h:mm a v"] 
                                greatestDifference [#id "h" ! "h:mm–h:mm a v"] 
                                greatestDifference [#id "m" ! "h:mm–h:mm a v"]
                            ] 
                            intervalFormatItem [
                                #id "Hmv" 
                                greatestDifference [#id "H" ! "HH:mm–HH:mm v"] 
                                greatestDifference [#id "m" ! "HH:mm–HH:mm v"]
                            ] 
                            intervalFormatItem [
                                #id "hv" 
                                greatestDifference [#id "a" ! "h a – h a v"] 
                                greatestDifference [#id "h" ! "h–h a v"]
                            ] 
                            intervalFormatItem [
                                #id "Hv" 
                                greatestDifference [#id "H" ! "HH–HH v"]
                            ] 
                            intervalFormatItem [
                                #id "M" 
                                greatestDifference [#id "M" ! "MM–MM"]
                            ] 
                            intervalFormatItem [
                                #id "Md" 
                                greatestDifference [#id "d" ! "MM-dd – MM-dd"] 
                                greatestDifference [#id "M" ! "MM-dd – MM-dd"]
                            ] 
                            intervalFormatItem [
                                #id "MEd" 
                                greatestDifference [#id "d" ! "MM-dd, E – MM-dd, E"] 
                                greatestDifference [#id "M" ! "MM-dd, E – MM-dd, E"]
                            ] 
                            intervalFormatItem [
                                #id "MMM" 
                                greatestDifference [#id "M" ! "LLL–LLL"]
                            ] 
                            intervalFormatItem [
                                #id "MMMd" 
                                greatestDifference [#id "d" ! "MMM d–d"] 
                                greatestDifference [#id "M" ! "MMM d – MMM d"]
                            ] 
                            intervalFormatItem [
                                #id "MMMEd" 
                                greatestDifference [#id "d" ! "MMM d, E – MMM d, E"] 
                                greatestDifference [#id "M" ! "MMM d, E – MMM d, E"]
                            ] 
                            intervalFormatItem [
                                #id "y" 
                                greatestDifference [#id "y" ! "y–y"]
                            ] 
                            intervalFormatItem [
                                #id "yM" 
                                greatestDifference [#id "M" ! "y-MM – y-MM"] 
                                greatestDifference [#id "y" ! "y-MM – y-MM"]
                            ] 
                            intervalFormatItem [
                                #id "yMd" 
                                greatestDifference [#id "d" ! "y-MM-dd – y-MM-dd"] 
                                greatestDifference [#id "M" ! "y-MM-dd – y-MM-dd"] 
                                greatestDifference [#id "y" ! "y-MM-dd – y-MM-dd"]
                            ] 
                            intervalFormatItem [
                                #id "yMEd" 
                                greatestDifference [#id "d" ! "y-MM-dd, E – y-MM-dd, E"] 
                                greatestDifference [#id "M" ! "y-MM-dd, E – y-MM-dd, E"] 
                                greatestDifference [#id "y" ! "y-MM-dd, E – y-MM-dd, E"]
                            ] 
                            intervalFormatItem [
                                #id "yMMM" 
                                greatestDifference [#id "M" ! "y MMM–MMM"] 
                                greatestDifference [#id "y" ! "y MMM – y MMM"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMd" 
                                greatestDifference [#id "d" ! "y MMM d–d"] 
                                greatestDifference [#id "M" ! "y MMM d – MMM d"] 
                                greatestDifference [#id "y" ! "y MMM d – y MMM d"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMEd" 
                                greatestDifference [#id "d" ! "y MMM d, E – MMM d, E"] 
                                greatestDifference [#id "M" ! "y MMM d, E – MMM d, E"] 
                                greatestDifference [#id "y" ! "y MMM d, E – y MMM d, E"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMM" 
                                greatestDifference [#id "M" ! "y MMMM–MMMM"] 
                                greatestDifference [#id "y" ! "y MMMM – y MMMM"]
                            ]
                        ]
                    ]
                ]
            ] 
            fields [
                field [
                    #type "era" 
                    displayName [! "युग"]
                ] 
                field [
                    #type "year" 
                    displayName [! "वर्ष:"]
                ] 
                field [
                    #type "year-short" 
                    displayName [! "वर्ष:"]
                ] 
                field [
                    #type "year-narrow" 
                    displayName [! "वर्ष"]
                ] 
                field [
                    #type "quarter" 
                    displayName [! "त्रेमासिक"]
                ] 
                field [
                    #type "quarter-short" 
                    displayName [! "त्रेमासिक"]
                ] 
                field [
                    #type "quarter-narrow" 
                    displayName [! "त्रेमासिक"]
                ] 
                field [
                    #type "month" 
                    displayName [! "मास:"]
                ] 
                field [
                    #type "month-short" 
                    displayName [! "मास"]
                ] 
                field [
                    #type "month-narrow" 
                    displayName [! "मास"]
                ] 
                field [
                    #type "week" 
                    displayName [! "सप्ताह:"]
                ] 
                field [
                    #type "week-short" 
                    displayName [! "सप्ताह"]
                ] 
                field [
                    #type "week-narrow" 
                    displayName [! "सप्ताह"]
                ] 
                field [
                    #type "day" 
                    displayName [! "वासर:"] 
                    relative [#type "-1" ! "गतदिनम्"] 
                    relative [#type "0" ! "अद्य"] 
                    relative [#type "1" ! "श्वः"]
                ] 
                field [
                    #type "day-short" 
                    relative [#type "-1" ! "ह्यः"] 
                    relative [#type "0" ! "अद्य"] 
                    relative [#type "1" ! "श्वः"]
                ] 
                field [
                    #type "day-narrow" 
                    displayName [! "दिनम्"] 
                    relative [#type "-1" ! "ह्यः"] 
                    relative [#type "0" ! "अद्य"] 
                    relative [#type "1" ! "श्वः"]
                ] 
                field [
                    #type "weekday" 
                    displayName [! "सप्ताहस्य दिनं"]
                ] 
                field [
                    #type "dayperiod" 
                    displayName [! "पूर्वाह्न/अपराह्न"]
                ] 
                field [
                    #type "hour" 
                    displayName [! "होरा"]
                ] 
                field [
                    #type "hour-short" 
                    displayName [! "होरा"]
                ] 
                field [
                    #type "hour-narrow" 
                    displayName [! "होरा"]
                ] 
                field [
                    #type "minute" 
                    displayName [! "निमेष"]
                ] 
                field [
                    #type "minute-short" 
                    displayName [! "निमेष"]
                ] 
                field [
                    #type "minute-narrow" 
                    displayName [! "निमेष"]
                ] 
                field [
                    #type "second" 
                    displayName [! "क्षण"]
                ] 
                field [
                    #type "second-short" 
                    displayName [! "पल"]
                ] 
                field [
                    #type "second-narrow" 
                    displayName [! "पल"]
                ] 
                field [
                    #type "zone" 
                    displayName [! "समय मण्डल"]
                ]
            ] 
            timeZoneNames [
                regionFormat [! "{0} समय:"] 
                regionFormat [#type "daylight" ! "{0} डेलाइट समय:"] 
                regionFormat [#type "standard" ! "{0} मानक समय:"] 
                zone [
                    #type "Etc/UTC" 
                    long [
                        standard [! "समन्वितः वैश्विक समय:"]
                    ]
                ] 
                zone [
                    #type "Etc/Unknown" 
                    exemplarCity [! "अज्ञात नगरी"]
                ] 
                metazone [
                    #type "America_Central" 
                    long [
                        generic [! "उत्तर अमेरिका: मध्य समयः"] 
                        standard [! "उत्तर अमेरिका: मध्य आदर्श समयः"] 
                        daylight [! "उत्तर अमेरिका: मध्य अयाम समयः"]
                    ]
                ] 
                metazone [
                    #type "America_Eastern" 
                    long [
                        generic [! "उत्तर अमेरिका: पौर्व समयः"] 
                        standard [! "उत्तर अमेरिका: पौर्व आदर्श समयः"] 
                        daylight [! "उत्तर अमेरिका: पौर्व अयाम समय:"]
                    ]
                ] 
                metazone [
                    #type "America_Mountain" 
                    long [
                        generic [! "उत्तर अमेरिका: शैल समयः"] 
                        standard [! "उत्तर अमेरिका: शैल आदर्श समयः"] 
                        daylight [! "उत्तर अमेरिका: शैल अयाम समयः"]
                    ]
                ] 
                metazone [
                    #type "America_Pacific" 
                    long [
                        generic [! "उत्तर अमेरिका: सन्धिप्रिय समयः"] 
                        standard [! "उत्तर अमेरिका: सन्धिप्रिय आदर्श समयः"] 
                        daylight [! "उत्तर अमेरिका: सन्धिप्रिय अयाम समयः"]
                    ]
                ] 
                metazone [
                    #type "Atlantic" 
                    long [
                        generic [! "अटलाण्टिक समयः"] 
                        standard [! "अटलाण्टिक आदर्श समयः"] 
                        daylight [! "अटलाण्टिक अयाम समयः"]
                    ]
                ] 
                metazone [
                    #type "Europe_Central" 
                    long [
                        generic [! "मध्य यूरोपीय समयः"] 
                        standard [! "मध्य यूरोपीय आदर्श समयः"] 
                        daylight [! "मध्य यूरोपीय ग्रीष्म समयः"]
                    ]
                ] 
                metazone [
                    #type "Europe_Eastern" 
                    long [
                        generic [! "पौर्व यूरोपीय समयः"] 
                        standard [! "पौर्व यूरोपीय आदर्श समयः"] 
                        daylight [! "पौर्व यूरोपीय ग्रीष्म समयः"]
                    ]
                ] 
                metazone [
                    #type "Europe_Western" 
                    long [
                        generic [! "पाश्चात्य यूरोपीय समयः"] 
                        standard [! "पाश्चात्य यूरोपीय आदर्श समयः"] 
                        daylight [! "पाश्चात्य यूरोपीय ग्रीष्म समयः"]
                    ]
                ] 
                metazone [
                    #type "GMT" 
                    long [
                        standard [! "ग्रीनविच मीन समयः"]
                    ]
                ]
            ]
        ] 
        numbers [
            defaultNumberingSystem [! "deva"] 
            otherNumberingSystems [
                native [#draft "contributed" ! "deva"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                decimalFormatLength [
                    decimalFormat [
                        pattern [#draft "unconfirmed" ! "#,##,##0.###"]
                    ]
                ]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##,##0.###"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "[#E0]"]
                    ]
                ]
            ] 
            percentFormats [
                percentFormatLength [
                    percentFormat [
                        pattern [#draft "unconfirmed" ! "#,##,##0%"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [#draft "unconfirmed" ! "¤#,##,##0.00"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##,##0.00"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "¤ #,##0.00"]
                    ]
                ] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencies [
                currency [
                    #type "BRL" 
                    displayName [! "ब्राजीली रियाल"] 
                    displayName [#count "other" ! "ब्राजीली रियाल"] 
                    symbol [#draft "contributed" ! "R$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "R$"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "चीनी युआन"] 
                    displayName [#count "other" ! "चीनी युआन"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "EUR" 
                    displayName [! "फिरङ्गिन् मुद्रा"] 
                    displayName [#count "other" ! "फिरङ्गिन् मुद्रा"]
                ] 
                currency [
                    #type "GBP" 
                    displayName [! "आङ्ग्लदेशीयः पाउंड"] 
                    displayName [#count "other" ! "आङ्ग्लदेशीयः पाउंड"] 
                    symbol [#draft "contributed" ! "£"] 
                    symbol [#alt "narrow" #draft "contributed" ! "£"]
                ] 
                currency [
                    #type "INR" 
                    displayName [! "भारतीय रूप्यकम्"] 
                    displayName [#count "other" ! "भारतीय रूप्यकम्"] 
                    symbol [! "₹"] 
                    symbol [#alt "narrow" #draft "contributed" ! "₹"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [! "जापानी येन"] 
                    displayName [#count "other" ! "जापानी येन"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "RUB" 
                    displayName [! "रष्यदेशीय रूबल"] 
                    displayName [#count "other" ! "रष्यदेशीय रूबल"]
                ] 
                currency [
                    #type "USD" 
                    displayName [! "यूएस डॉलर"] 
                    displayName [#count "other" ! "अमेरिकादेशः डॉलर"] 
                    symbol [#draft "contributed" ! "US$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "$"]
                ] 
                currency [
                    #type "XXX" 
                    displayName [! "अज्ञात मुद्रा"] 
                    displayName [#count "other" ! "(अज्ञात मुद्रा)"]
                ]
            ] 
            miscPatterns [
                #numberSystem "latn" 
                pattern [#type "atLeast" ! "≥{0}"] 
                pattern [#type "range" ! "{0}–{1}"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "end" ! "{0}, तथा {1}"] 
                listPatternPart [#type "2" ! "{0} तथा {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [! "आम्"] 
                nostr [! "न"]
            ]
        ]
    ]

