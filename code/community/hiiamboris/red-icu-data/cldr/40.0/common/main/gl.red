        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                approximatelySign [! "~"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0"] 
                        pattern [#type "1000" #count "other" ! "0"] 
                        pattern [#type "10000" #count "one" ! "0"] 
                        pattern [#type "10000" #count "other" ! "0"] 
                        pattern [#type "100000" #count "one" ! "0"] 
                        pattern [#type "100000" #count "other" ! "0"] 
                        pattern [#type "1000000" #count "one" ! "0 millón"] 
                        pattern [#type "1000000" #count "other" ! "0 millóns"] 
                        pattern [#type "10000000" #count "one" ! "00 millóns"] 
                        pattern [#type "10000000" #count "other" ! "00 millóns"] 
                        pattern [#type "100000000" #count "one" ! "000 millóns"] 
                        pattern [#type "100000000" #count "other" ! "000 millóns"] 
                        pattern [#type "1000000000" #count "one" ! "0000 millóns"] 
                        pattern [#type "1000000000" #count "other" ! "0000 millóns"] 
                        pattern [#type "10000000000" #count "one" ! "00000 millóns"] 
                        pattern [#type "10000000000" #count "other" ! "00000 millóns"] 
                        pattern [#type "100000000000" #count "one" ! "000000 millóns"] 
                        pattern [#type "100000000000" #count "other" ! "000000 millóns"] 
                        pattern [#type "1000000000000" #count "one" ! "0 billón"] 
