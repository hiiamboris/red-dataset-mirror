        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 bin"] 
                        pattern [#type "1000" #count "other" ! "0 bin"] 
                        pattern [#type "10000" #count "one" ! "00 bin"] 
                        pattern [#type "10000" #count "other" ! "00 bin"] 
                        pattern [#type "100000" #count "one" ! "000 bin"] 
                        pattern [#type "100000" #count "other" ! "000 bin"] 
                        pattern [#type "1000000" #count "one" ! "0 milyon"] 
                        pattern [#type "1000000" #count "other" ! "0 milyon"] 
                        pattern [#type "10000000" #count "one" ! "00 milyon"] 
                        pattern [#type "10000000" #count "other" ! "00 milyon"] 
                        pattern [#type "100000000" #count "one" ! "000 milyon"] 
                        pattern [#type "100000000" #count "other" ! "000 milyon"] 
                        pattern [#type "1000000000" #count "one" ! "0 milyar"] 
                        pattern [#type "1000000000" #count "other" ! "0 milyar"] 
                        pattern [#type "10000000000" #count "one" ! "00 milyar"] 
                        pattern [#type "10000000000" #count "other" ! "00 milyar"] 
                        pattern [#type "100000000000" #count "one" ! "000 milyar"] 
                        pattern [#type "100000000000" #count "other" ! "000 milyar"] 
                        pattern [#type "1000000000000" #count "one" ! "0 trilyon"] 
                        pattern [#type "1000000000000" #count "other" ! "0 trilyon"] 
                        pattern [#type "10000000000000" #count "one" ! "00 trilyon"] 
                        pattern [#type "10000000000000" #count "other" ! "00 trilyon"] 
                        pattern [#type "100000000000000" #count "one" ! "000 trilyon"] 
                        pattern [#type "100000000000000" #count "other" ! "000 trilyon"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 B"] 
                        pattern [#type "1000" #count "other" ! "0 B"] 
                        pattern [#type "10000" #count "one" ! "00 B"] 
                        pattern [#type "10000" #count "other" ! "00 B"] 
                        pattern [#type "100000" #count "one" ! "000 B"] 
                        pattern [#type "100000" #count "other" ! "000 B"] 
                        pattern [#type "1000000" #count "one" ! "0 Mn"] 
                        pattern [#type "1000000" #count "other" ! "0 Mn"] 
                        pattern [#type "10000000" #count "one" ! "00 Mn"] 
                        pattern [#type "10000000" #count "other" ! "00 Mn"] 
                        pattern [#type "100000000" #count "one" ! "000 Mn"] 
                        pattern [#type "100000000" #count "other" ! "000 Mn"] 
                        pattern [#type "1000000000" #count "one" ! "0 Mr"] 
                        pattern [#type "1000000000" #count "other" ! "0 Mr"] 
                        pattern [#type "10000000000" #count "one" ! "00 Mr"] 
                        pattern [#type "10000000000" #count "other" ! "00 Mr"] 
                        pattern [#type "100000000000" #count "one" ! "000 Mr"] 
                        pattern [#type "100000000000" #count "other" ! "000 Mr"] 
                        pattern [#type "1000000000000" #count "one" ! "0 Tn"] 
                        pattern [#type "1000000000000" #count "other" ! "0 Tn"] 
                        pattern [#type "10000000000000" #count "one" ! "00 Tn"] 
                        pattern [#type "10000000000000" #count "other" ! "00 Tn"] 
                        pattern [#type "100000000000000" #count "one" ! "000 Tn"] 
                        pattern [#type "100000000000000" #count "other" ! "000 Tn"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "%#,##0"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
