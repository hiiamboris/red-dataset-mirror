                        pattern [#type "1000" #count "one" ! "0 þ'.'"] 
                        pattern [#type "1000" #count "other" ! "0 þ'.'"] 
                        pattern [#type "10000" #count "one" ! "00 þ'.'"] 
                        pattern [#type "10000" #count "other" ! "00 þ'.'"] 
                        pattern [#type "100000" #count "one" ! "000 þ'.'"] 
                        pattern [#type "100000" #count "other" ! "000 þ'.'"] 
                        pattern [#type "1000000" #count "one" ! "0 m'.'"] 
                        pattern [#type "1000000" #count "other" ! "0 m'.'"] 
                        pattern [#type "10000000" #count "one" ! "00 m'.'"] 
                        pattern [#type "10000000" #count "other" ! "00 m'.'"] 
