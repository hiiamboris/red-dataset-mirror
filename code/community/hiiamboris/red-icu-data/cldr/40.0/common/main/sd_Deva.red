                field [
                    #type "month-narrow" 
                    displayName [! "महिनो"]
                ] 
                field [
                    #type "week" 
                    displayName [! "हफ्तो"]
                ] 
                field [
                    #type "day" 
                    displayName [! "दीं॒हुं"] 
                    relative [#type "-1" ! "कल"] 
                    relative [#type "0" ! "अॼु"] 
                    relative [#type "1" ! "सुभाणे"]
                ] 
                field [
                    #type "day-short" 
                    displayName [! "दीं॒हुं"]
                ] 
                field [
                    #type "day-narrow" 
                    displayName [! "दीं॒हुं"]
                ] 
                field [
                    #type "weekday" 
                    displayName [! "हफ्ते जो दीं॒हुं"]
                ] 
                field [
                    #type "dayperiod" 
                    displayName [! "दीं॒हुं/ रातु"]
                ] 
                field [
                    #type "hour" 
                    displayName [! "कलाक"]
                ] 
                field [
                    #type "minute" 
                    displayName [! "मिंटु"]
                ] 
                field [
                    #type "minute-short" 
                    displayName [! "मिंटु"]
                ] 
                field [
                    #type "minute-narrow" 
                    displayName [! "मिंटु"]
                ] 
                field [
                    #type "second" 
                    displayName [! "सेकिंडु"]
                ] 
                field [
                    #type "zone" 
                    displayName [! "वक्तु जो दायरो"]
                ]
            ] 
            timeZoneNames [
                regionFormat [! "{0} वक्त"] 
                regionFormat [#type "daylight" ! "{0} दीं॒ह जो वक्त"] 
                regionFormat [#type "standard" ! "{0} मअयारी वक्त"] 
                fallbackFormat [! "{1} ({0})"] 
                zone [
                    #type "Etc/UTC" 
                    long [
                        standard [! "गदि॒यल आलमी वक्तु"]
                    ]
                ] 
                zone [
                    #type "Etc/Unknown" 
                    exemplarCity [! "अणजा॒तल शहरु"]
                ] 
                metazone [
                    #type "America_Central" 
                    long [
                        generic [! "मरकज़ी वक्त"] 
                        standard [! "मरकज़ी मअयारी वक्त"] 
                        daylight [! "मरकज़ी दीं॒ह जो वक्त"]
                    ]
                ] 
                metazone [
                    #type "America_Eastern" 
                    long [
                        generic [! "ओभरी वक्त"] 
                        standard [! "ओभरी मअयारी वक्त"] 
                        daylight [! "ओभरी दीं॒ह जो वक्त"]
                    ]
                ] 
                metazone [
                    #type "America_Mountain" 
                    long [
                        generic [! "पहाड़ी वक्त"] 
                        standard [! "पहाड़ी मअयारी वक्त"] 
                        daylight [! "पहाड़ी दीं॒ह जो वक्त"]
                    ]
                ] 
                metazone [
                    #type "America_Pacific" 
                    long [
                        generic [! "पेसिफिक वक्त"] 
                        standard [! "पेसिफिक मअयारी वक्त"] 
                        daylight [! "पेसिफिक दीं॒ह जो वक्त"]
                    ]
                ] 
                metazone [
                    #type "Atlantic" 
                    long [
                        generic [! "अटलांटिक वक्त"] 
                        standard [! "अटलांटिक मअयारी वक्त"] 
                        daylight [! "अटलांटिक दीं॒ह जो वक्त"]
                    ]
                ] 
                metazone [
                    #type "Europe_Central" 
                    long [
                        generic [! "मरकज़ी यूरोपी वक्त"] 
                        standard [! "मरकज़ी यूरोपी मअयारी वक्तु"] 
                        daylight [! "मरकज़ी यूरोपी उनहारे जो वक्तु"]
                    ]
                ] 
                metazone [
                    #type "Europe_Eastern" 
                    long [
                        generic [! "ओभरी यूरोपी वक्तु"] 
                        standard [! "ओभरी यूरोपी मअयारी वक्तु"] 
                        daylight [! "ओभरी यूरोपी उनहारे जो वक्तु"]
                    ]
                ] 
                metazone [
                    #type "Europe_Western" 
                    long [
                        generic [! "उलहंदो यूरोपी वक्तु"] 
                        standard [! "उलहंदो यूरोपी मअयारी वक्तु"] 
                        daylight [! "उलहंदो यूरोपी उनहारे जो वक्तु"]
                    ]
                ] 
                metazone [
                    #type "GMT" 
                    long [
                        standard [! "ग्रीनविच मीन वक्तु"]
                    ]
                ]
            ]
        ] 
        numbers [
            defaultNumberingSystem [#draft "contributed" ! "latn"] 
            otherNumberingSystems [
                native [#draft "contributed" ! "latn"]
            ] 
            currencies [
                currency [
                    #type "BRL" 
                    displayName [! "ब्राज़ीली रियालु"] 
                    displayName [#count "one" ! "ब्राज़ीली रियालु"] 
                    displayName [#count "other" ! "ब्राज़ीली रियाल"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "चीनी युआनु"] 
                    displayName [#count "one" ! "चीनी युआनु"] 
                    displayName [#count "other" ! "चीनी युआन"] 
                    symbol [#draft "contributed" ! "CN¥"]
                ] 
                currency [
                    #type "EUR" 
                    displayName [! "यूरो"]
                ] 
                currency [
                    #type "GBP" 
                    displayName [! "बरतानवी पाउंडु"] 
                    displayName [#count "one" ! "बरतानवी पाउंडु"] 
                    displayName [#count "other" ! "बरतानवी पाउंड"] 
                    symbol [#draft "contributed" ! "£"] 
                    symbol [#alt "narrow" #draft "contributed" ! "£"]
                ] 
                currency [
                    #type "INR" 
                    displayName [! "हिंदुस्तानी रुपयो"] 
                    displayName [#count "one" ! "हिंदुस्तानी रुपया"] 
                    displayName [#count "other" ! "हिंदुस्तानी रुपया"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [! "जापानी येनु"] 
                    displayName [#count "one" ! "जापानी येनु"] 
                    displayName [#count "other" ! "जापानी येन"] 
                    symbol [#draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "RUB" 
                    displayName [! "रशियनु रुबलु"] 
                    displayName [#count "one" ! "रशियनु रुबलु"] 
                    displayName [#count "other" ! "रशियनु रुबल"] 
                    symbol [#alt "narrow" #draft "contributed" ! "₽"]
                ] 
                currency [
                    #type "USD" 
                    displayName [! "यूएस जो डॉलर"] 
                    displayName [#count "one" ! "यूएस जो डॉलर"] 
                    displayName [#count "other" ! "यूएस जा डॉलर"] 
                    symbol [#draft "contributed" ! "$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "$"]
                ] 
                currency [
                    #type "XXX" 
                    displayName [! "अणजा॒तल सिको"] 
                    displayName [#count "one" ! "(सिके जो अणजा॒तल एको)"] 
                    displayName [#count "other" ! "अणजा॒तल सिको"]
                ]
            ]
        ] 
        units [
            durationUnit [
                #type "hm" 
                durationUnitPattern [! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        posix [
            messages [
                yesstr [! "हा:हा"] 
                nostr [! "न:न"]
            ]
        ]
    ]

