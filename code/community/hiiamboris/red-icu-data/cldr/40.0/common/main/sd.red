                ] 
                unit [
                    #type "mass-kilogram" 
                    displayName [! "kg"] 
                    unitPattern [#count "one" ! "{0}kg"] 
                    unitPattern [#count "other" ! "{0} kg"] 
                    perUnitPattern [! "{0}/ڪ.گـ."]
                ] 
                unit [
                    #type "mass-gram" 
