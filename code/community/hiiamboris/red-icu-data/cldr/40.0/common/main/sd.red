                    #type "duration-hour" 
                    displayName [! "ڪلاڪ"] 
                    unitPattern [#count "one" ! "{0} ڪلاڪ"] 
                    unitPattern [#count "other" ! "{0} ڪلاڪ"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [! "منٽ"] 
                    unitPattern [#count "one" ! "{0} منٽ"] 
                    unitPattern [#count "other" ! "{0} منٽ"]
                ] 
                unit [
                    #type "duration-second" 
