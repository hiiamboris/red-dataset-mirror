                    unitPattern [#count "other" #draft "contributed" ! "{0} W"]
                ] 
                unit [
                    #type "power-horsepower" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} pk"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} pk"]
                ] 
                unit [
                    #type "pressure-inch-ofhg" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} inHg"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} inHg"]
                ] 
                unit [
                    #type "pressure-millibar" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} mbar"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} mbar"]
                ] 
                unit [
                    #type "pressure-hectopascal" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} hPa"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} hPa"]
                ] 
                unit [
                    #type "speed-kilometer-per-hour" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} km/h"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} km/h"]
                ] 
                unit [
                    #type "speed-meter-per-second" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} m/s"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} m/s"]
                ] 
                unit [
                    #type "speed-mile-per-hour" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} mi/h"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} mi/h"]
                ] 
                unit [
                    #type "temperature-celsius" 
                    unitPattern [#count "one" #draft "contributed" ! "{0}°"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0}°"]
                ] 
                unit [
                    #type "temperature-fahrenheit" 
                    unitPattern [#count "one" #draft "contributed" ! "{0}°F"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0}°F"]
                ] 
                unit [
                    #type "volume-cubic-kilometer" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} km³"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} km³"]
                ] 
                unit [
                    #type "volume-cubic-mile" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} mi³"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} mi³"]
                ] 
                unit [
                    #type "volume-liter" 
                    unitPattern [#count "one" #draft "contributed" ! "{0} l"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} l"]
                ]
            ] 
            durationUnit [
                #type "hm" 
                durationUnitPattern [#draft "contributed" ! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [#draft "contributed" ! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [#draft "contributed" ! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "middle" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "end" #draft "contributed" ! "{0} en {1}"] 
                listPatternPart [#type "2" #draft "contributed" ! "{0} en {1}"]
            ] 
            listPattern [
                #type "unit" 
                listPatternPart [#type "start" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "middle" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "end" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "2" #draft "contributed" ! "{0} en {1}"]
            ] 
            listPattern [
                #type "unit-narrow" 
                listPatternPart [#type "start" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "middle" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "end" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "2" #draft "contributed" ! "{0}, {1}"]
            ] 
            listPattern [
                #type "unit-short" 
                listPatternPart [#type "start" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "middle" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "end" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "2" #draft "contributed" ! "{0}, {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [#draft "contributed" ! "ja:j"] 
                nostr [#draft "contributed" ! "nee:n"]
            ]
        ]
    ]

