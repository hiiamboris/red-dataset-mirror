
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ar"] 
            territory [#type "SS"]
        ] 
        numbers [
            defaultNumberingSystem [! "arab"] 
            currencies [
                currency [
                    #type "GBP" 
                    symbol [! "GB£"]
                ] 
                currency [
                    #type "SSP" 
                    symbol [! "£"]
                ]
            ]
        ]
    ]

