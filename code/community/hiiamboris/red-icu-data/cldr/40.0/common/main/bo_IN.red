
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "bo"] 
            territory [#type "IN"]
        ] 
        localeDisplayNames [
            territories [
                territory [#type "009" ! "ཨོཤི་ཡཱན་ན།"]
            ]
        ] 
        dates [
            calendars [
                calendar [
                    #type "gregorian" 
                    timeFormats [
                        timeFormatLength [
                            #type "full" 
                            timeFormat [
                                pattern [! "h:mm:ss a zzzz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "long" 
                            timeFormat [
                                pattern [! "h:mm:ss a z"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "medium" 
                            timeFormat [
                                pattern [! "h:mm:ss a"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "short" 
                            timeFormat [
                                pattern [! "h:mm a"]
                            ]
                        ]
                    ]
                ]
            ]
        ] 
        numbers [
            currencies [
                currency [
                    #type "CNY" 
                    symbol [! "CN¥"]
                ]
            ]
        ]
    ]

