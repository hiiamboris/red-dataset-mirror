                    #type "length-parsec" 
                    displayName [#draft "unconfirmed" ! "pc"] 
                    unitPattern [#count "one" #draft "unconfirmed" ! "{0}pc"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}pc"]
                ] 
                unit [
                    #type "length-light-year" 
                    displayName [#draft "unconfirmed" ! "lj"] 
                    unitPattern [#count "one" #draft "unconfirmed" ! "{0}lj"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}lj"]
                ] 
                unit [
                    #type "length-astronomical-unit" 
                    displayName [#draft "unconfirmed" ! "au"] 
                    unitPattern [#count "one" #draft "unconfirmed" ! "{0}au"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}au"]
                ] 
                unit [
                    #type "mass-kilogram" 
                    displayName [#draft "unconfirmed" ! "kg"] 
                    unitPattern [#count "one" #draft "unconfirmed" ! "{0}kg"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}kg"]
                ] 
                unit [
                    #type "mass-gram" 
                    displayName [#draft "unconfirmed" ! "g"] 
                    unitPattern [#count "one" #draft "unconfirmed" ! "{0}g"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}g"]
                ] 
                unit [
                    #type "speed-kilometer-per-hour" 
                    displayName [#draft "unconfirmed" ! "km/h"] 
                    unitPattern [#count "one" #draft "unconfirmed" ! "{0}km/h"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}km/h"]
                ] 
                unit [
                    #type "temperature-celsius" 
                    displayName [#draft "unconfirmed" ! "°C"] 
                    unitPattern [#count "one" #draft "unconfirmed" ! "{0}°C"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}°C"]
                ] 
                unit [
                    #type "volume-liter" 
                    displayName [#draft "unconfirmed" ! "L"] 
                    unitPattern [#count "one" #draft "unconfirmed" ! "{0}L"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}L"]
                ]
            ] 
            durationUnit [
                #type "hm" 
                durationUnitPattern [#draft "unconfirmed" ! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [#draft "unconfirmed" ! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [#draft "unconfirmed" ! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" #draft "unconfirmed" ! "{0}, {1}"] 
                listPatternPart [#type "middle" #draft "unconfirmed" ! "{0}, {1}"] 
                listPatternPart [#type "end" #draft "unconfirmed" ! "{0} kaj {1}"] 
                listPatternPart [#type "2" #draft "unconfirmed" ! "{0} kaj {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [#draft "unconfirmed" ! "jes:j"] 
                nostr [#draft "unconfirmed" ! "ne:n"]
            ]
        ]
    ]

