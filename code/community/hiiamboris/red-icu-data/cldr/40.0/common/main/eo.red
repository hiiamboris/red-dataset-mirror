                            ]
                        ]
                    ] 
                    dateTimeFormats [
                        intervalFormats [
                            intervalFormatFallback [#draft "unconfirmed" ! "{0} – {1}"] 
                            intervalFormatItem [
                                #id "d" 
                                greatestDifference [#id "d" #draft "unconfirmed" ! "d–d"]
                            ] 
                            intervalFormatItem [
                                #id "h" 
