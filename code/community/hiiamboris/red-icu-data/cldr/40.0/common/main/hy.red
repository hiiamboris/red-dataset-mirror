        numbers [
            defaultNumberingSystem [#draft "contributed" ! "latn"] 
            otherNumberingSystems [
                native [#draft "contributed" ! "latn"] 
                traditional [! "armn"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! " "] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "ՈչԹ"] 
                timeSeparator [! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 հազար"] 
                        pattern [#type "1000" #count "other" ! "0 հազար"] 
                        pattern [#type "10000" #count "one" ! "00 հազար"] 
                        pattern [#type "10000" #count "other" ! "00 հազար"] 
                        pattern [#type "100000" #count "one" ! "000 հազար"] 
                        pattern [#type "100000" #count "other" ! "000 հազար"] 
                        pattern [#type "1000000" #count "one" ! "0 միլիոն"] 
                        pattern [#type "1000000" #count "other" ! "0 միլիոն"] 
                        pattern [#type "10000000" #count "one" ! "00 միլիոն"] 
                        pattern [#type "10000000" #count "other" ! "00 միլիոն"] 
                        pattern [#type "100000000" #count "one" ! "000 միլիոն"] 
                        pattern [#type "100000000" #count "other" ! "000 միլիոն"] 
                        pattern [#type "1000000000" #count "one" ! "0 միլիարդ"] 
                        pattern [#type "1000000000" #count "other" ! "0 միլիարդ"] 
                        pattern [#type "10000000000" #count "one" ! "00 միլիարդ"] 
                        pattern [#type "10000000000" #count "other" ! "00 միլիարդ"] 
                        pattern [#type "100000000000" #count "one" ! "000 միլիարդ"] 
                        pattern [#type "100000000000" #count "other" ! "000 միլիարդ"] 
                        pattern [#type "1000000000000" #count "one" ! "0 տրիլիոն"] 
                        pattern [#type "1000000000000" #count "other" ! "0 տրիլիոն"] 
                        pattern [#type "10000000000000" #count "one" ! "00 տրիլիոն"] 
                        pattern [#type "10000000000000" #count "other" ! "00 տրիլիոն"] 
                        pattern [#type "100000000000000" #count "one" ! "000 տրիլիոն"] 
                        pattern [#type "100000000000000" #count "other" ! "000 տրիլիոն"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 հզր"] 
                        pattern [#type "1000" #count "other" ! "0 հզր"] 
                        pattern [#type "10000" #count "one" ! "00 հզր"] 
                        pattern [#type "10000" #count "other" ! "00 հզր"] 
                        pattern [#type "100000" #count "one" ! "000 հզր"] 
                        pattern [#type "100000" #count "other" ! "000 հզր"] 
                        pattern [#type "1000000" #count "one" ! "0 մլն"] 
                        pattern [#type "1000000" #count "other" ! "0 մլն"] 
                        pattern [#type "10000000" #count "one" ! "00 մլն"] 
                        pattern [#type "10000000" #count "other" ! "00 մլն"] 
                        pattern [#type "100000000" #count "one" ! "000 մլն"] 
                        pattern [#type "100000000" #count "other" ! "000 մլն"] 
                        pattern [#type "1000000000" #count "one" ! "0 մլրդ"] 
                        pattern [#type "1000000000" #count "other" ! "0 մլրդ"] 
                        pattern [#type "10000000000" #count "one" ! "00 մլրդ"] 
                        pattern [#type "10000000000" #count "other" ! "00 մլրդ"] 
                        pattern [#type "100000000000" #count "one" ! "000 մլրդ"] 
                        pattern [#type "100000000000" #count "other" ! "000 մլրդ"] 
                        pattern [#type "1000000000000" #count "one" ! "0 տրլն"] 
                        pattern [#type "1000000000000" #count "other" ! "0 տրլն"] 
                        pattern [#type "10000000000000" #count "one" ! "00 տրլն"] 
