
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "de"] 
            territory [#type "IT"]
        ] 
        dates [
            calendars [
                calendar [
                    #type "gregorian" 
                    months [
                        monthContext [
                            #type "format" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "Jän."] 
                                month [#type "2" ! "Feb."] 
                                month [#type "3" ! "März"] 
                                month [#type "4" ! "Apr."] 
                                month [#type "5" ! "Mai"] 
                                month [#type "6" ! "Juni"] 
                                month [#type "7" ! "Juli"] 
                                month [#type "8" ! "Aug."] 
                                month [#type "9" ! "Sep."] 
                                month [#type "10" ! "Okt."] 
                                month [#type "11" ! "Nov."] 
                                month [#type "12" ! "Dez."]
                            ] 
                            monthWidth [
                                #type "wide" 
                                month [#type "1" ! "Jänner"] 
                                month [#type "2" ! "Februar"] 
                                month [#type "3" ! "März"] 
                                month [#type "4" ! "April"] 
                                month [#type "5" ! "Mai"] 
                                month [#type "6" ! "Juni"] 
                                month [#type "7" ! "Juli"] 
                                month [#type "8" ! "August"] 
                                month [#type "9" ! "September"] 
                                month [#type "10" ! "Oktober"] 
                                month [#type "11" ! "November"] 
                                month [#type "12" ! "Dezember"]
                            ]
                        ] 
                        monthContext [
                            #type "stand-alone" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "Jän"] 
                                month [#type "2" ! "Feb"] 
                                month [#type "3" ! "Mär"] 
                                month [#type "4" ! "Apr"] 
                                month [#type "5" ! "Mai"] 
                                month [#type "6" ! "Jun"] 
                                month [#type "7" ! "Jul"] 
                                month [#type "8" ! "Aug"] 
                                month [#type "9" ! "Sep"] 
                                month [#type "10" ! "Okt"] 
                                month [#type "11" ! "Nov"] 
                                month [#type "12" ! "Dez"]
                            ] 
                            monthWidth [
                                #type "wide" 
                                month [#type "1" ! "Jänner"] 
                                month [#type "2" ! "Februar"] 
                                month [#type "3" ! "März"] 
                                month [#type "4" ! "April"] 
                                month [#type "5" ! "Mai"] 
                                month [#type "6" ! "Juni"] 
                                month [#type "7" ! "Juli"] 
                                month [#type "8" ! "August"] 
                                month [#type "9" ! "September"] 
                                month [#type "10" ! "Oktober"] 
                                month [#type "11" ! "November"] 
                                month [#type "12" ! "Dezember"]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]

