                    currencyFormat [
                        #type "accounting" 
                        pattern [! "#,##0.00 ¤"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "other" ! "0 ҳзр'.' ¤"] 
                        pattern [#type "10000" #count "other" ! "00 ҳзр'.' ¤"] 
                        pattern [#type "100000" #count "other" ! "000 ҳзр'.' ¤"] 
                        pattern [#type "1000000" #count "other" ! "0 млн'.' ¤"] 
                        pattern [#type "10000000" #count "other" ! "00 млн'.' ¤"] 
                        pattern [#type "100000000" #count "other" ! "000 млн'.' ¤"] 
                        pattern [#type "1000000000" #count "other" ! "0 млрд'.' ¤"] 
                        pattern [#type "10000000000" #count "other" ! "00 млрд'.' ¤"] 
                        pattern [#type "100000000000" #count "other" ! "000 млрд'.' ¤"] 
                        pattern [#type "1000000000000" #count "other" ! "0 трлн'.' ¤"] 
                        pattern [#type "10000000000000" #count "other" ! "00 трлн'.' ¤"] 
                        pattern [#type "100000000000000" #count "other" ! "000 трлн'.' ¤"]
                    ]
                ] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencies [
                currency [
                    #type "BRL" 
                    displayName [! "Реали бразилиягӣ"] 
                    displayName [#count "other" ! "реали бразилиягӣ"] 
                    symbol [#draft "contributed" ! "R$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "R$"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "Иенаи хитоӣ"] 
                    displayName [#count "other" ! "иенаи хитоӣ"] 
                    symbol [#draft "contributed" ! "CN¥"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "EUR" 
                    displayName [! "Евро"] 
                    displayName [#count "other" ! "евро"] 
                    symbol [#draft "contributed" ! "€"] 
                    symbol [#alt "narrow" #draft "contributed" ! "€"]
                ] 
                currency [
                    #type "GBP" 
                    displayName [! "Фунт стерлинги британӣ"] 
                    displayName [#count "other" ! "фунт стерлинги британӣ"] 
                    symbol [#draft "contributed" ! "£"] 
                    symbol [#alt "narrow" #draft "contributed" ! "£"]
                ] 
                currency [
                    #type "INR" 
                    displayName [! "Рупияи ҳиндустонӣ"] 
                    displayName [#count "other" ! "рупияи ҳиндустонӣ"] 
                    symbol [#draft "contributed" ! "₹"] 
                    symbol [#alt "narrow" #draft "contributed" ! "₹"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [! "Иенаи японӣ"] 
                    displayName [#count "other" ! "иенаи японӣ"] 
                    symbol [#draft "contributed" ! "JP¥"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "RUB" 
                    displayName [! "Рубли русӣ"] 
                    displayName [#count "other" ! "рубли русӣ"] 
                    symbol [#draft "contributed" ! "RUB"] 
                    symbol [#alt "narrow" #draft "contributed" ! "₽"]
                ] 
                currency [
                    #type "TJS" 
                    displayName [! "Сомонӣ"] 
                    displayName [#count "other" ! "Сомонӣ"] 
                    symbol [#draft "contributed" ! "сом."]
                ] 
                currency [
                    #type "USD" 
                    displayName [! "Доллари ИМА"] 
                    displayName [#count "other" ! "доллари ИМА"] 
                    symbol [#draft "contributed" ! "$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "$"]
                ] 
                currency [
                    #type "XXX" 
                    displayName [! "Асъори номаълум"] 
                    displayName [#count "other" ! "(асъори номаълум)"]
                ]
            ] 
            miscPatterns [
                #numberSystem "latn" 
                pattern [#type "atLeast" ! "⩾{0}"] 
                pattern [#type "range" ! "{0}–{1}"]
            ]
        ] 
        units [
            durationUnit [
                #type "hm" 
                durationUnitPattern [! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0}, {1}"] 
                listPatternPart [#type "2" ! "{0}, {1}"]
            ]
        ]
    ]

