                            dateFormatItem [#id "MMMd" ! "d MMM"] 
                            dateFormatItem [#id "MMMEd" ! "E d MMM"] 
                            dateFormatItem [#id "ms" ! "m:ss"] 
                            dateFormatItem [#id "y" ! "y"] 
                            dateFormatItem [#id "yM" ! "M/y"] 
                            dateFormatItem [#id "yMd" ! "d/M/y"] 
                            dateFormatItem [#id "yMEd" ! "E d/M/y"] 
                            dateFormatItem [#id "yMMM" ! "MMM y"] 
                            dateFormatItem [#id "yMMMd" ! "d MMM y"] 
                            dateFormatItem [#id "yMMMEd" ! "E d MMM y"] 
                            dateFormatItem [#id "yQQQ" ! "QQQ y"] 
                            dateFormatItem [#id "yQQQQ" ! "QQQQ y"]
                        ]
                    ]
                ]
            ] 
            fields [
                field [
                    #type "era" 
                    displayName [! "kipéŋén"]
                ] 
                field [
                    #type "year" 
                    displayName [! "yɔɔŋ"]
                ] 
                field [
                    #type "month" 
                    displayName [! "oóli"]
                ] 
                field [
                    #type "week" 
                    displayName [! "sɔ́ndiɛ"]
                ] 
                field [
                    #type "day" 
                    displayName [! "puɔ́sɛ́"] 
                    relative [#type "-1" ! "púyoó"] 
                    relative [#type "0" ! "ínaan"] 
                    relative [#type "1" ! "nakinyám"]
                ] 
                field [
                    #type "weekday" 
                    displayName [! "metúk mɔ́sɔ́ndiɛ"]
                ] 
                field [
                    #type "dayperiod" 
                    displayName [! "kiɛmɛ́ɛm,kisɛ́ndɛ"]
                ] 
                field [
                    #type "hour" 
                    displayName [! "kisikɛl,"]
                ] 
                field [
                    #type "minute" 
                    displayName [! "minít"]
                ] 
                field [
                    #type "second" 
                    displayName [! "síkɛn"]
                ] 
                field [
                    #type "zone" 
                    displayName [! "kinúki kisikɛl ɔ́ pitɔŋ"]
                ]
            ]
        ] 
        numbers [
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! " "]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "#,##0.00 ¤"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "#,##0.00 ¤;(#,##0.00 ¤)"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "other" #draft "provisional" ! "0K ¤"] 
                        pattern [#type "10000" #count "other" #draft "provisional" ! "00K ¤"] 
                        pattern [#type "100000" #count "other" #draft "provisional" ! "000K ¤"] 
                        pattern [#type "1000000" #count "other" #draft "provisional" ! "0M ¤"] 
                        pattern [#type "10000000" #count "other" #draft "provisional" ! "00M ¤"] 
                        pattern [#type "100000000" #count "other" #draft "provisional" ! "000M ¤"] 
                        pattern [#type "1000000000" #count "other" #draft "provisional" ! "0G ¤"] 
                        pattern [#type "10000000000" #count "other" #draft "provisional" ! "00G ¤"] 
                        pattern [#type "100000000000" #count "other" #draft "provisional" ! "000G ¤"] 
                        pattern [#type "1000000000000" #count "other" #draft "provisional" ! "0T ¤"] 
                        pattern [#type "10000000000000" #count "other" #draft "provisional" ! "00T ¤"] 
                        pattern [#type "100000000000000" #count "other" #draft "provisional" ! "000T ¤"]
                    ]
                ]
            ] 
            currencies [
                currency [
                    #type "AOA" 
                    displayName [! "kuansa wu angolá"]
                ] 
                currency [
                    #type "AUD" 
                    displayName [! "toláal wu ostalalí"]
                ] 
                currency [
                    #type "BHD" 
                    displayName [! "tináal wu paaléen"]
                ] 
                currency [
                    #type "BIF" 
                    displayName [! "faláŋɛ u pulundí"]
                ] 
                currency [
                    #type "BWP" 
                    displayName [! "pula pu posuána"]
                ] 
                currency [
                    #type "CAD" 
                    displayName [! "toláal u kanáta"]
                ] 
                currency [
                    #type "CDF" 
                    displayName [! "́faláŋɛ u kongó"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "yuan ɛlɛnmimbí"]
                ] 
                currency [
                    #type "CVE" 
                    displayName [! "ɛskúdo u kápfɛ́ɛl"]
                ] 
                currency [
                    #type "DJF" 
                    displayName [! "́faláŋɛ u síputí"]
                ] 
                currency [
                    #type "DZD" 
                    displayName [! "tináal wu alselí"]
                ] 
                currency [
                    #type "EGP" 
                    displayName [! "lífilɛ wu isípit"]
                ] 
                currency [
