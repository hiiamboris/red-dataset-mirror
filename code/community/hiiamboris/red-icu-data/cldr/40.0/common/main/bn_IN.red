
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "bn"] 
            territory [#type "IN"]
        ] 
        localeDisplayNames [
            languages [
                language [#type "ksh" ! "কোলোনিয়ান"]
            ] 
            territories [
                territory [#type "CD" #alt "variant" ! "কঙ্গো (DRC)"] 
                territory [#type "UM" ! "মার্কিন যুক্তরাষ্ট্রের পার্শ্ববর্তী দ্বীপপুঞ্জ"]
            ]
        ]
    ]

