            styleName [#type "wght" #subtype "950" #alt "ultraheavy" ! "izredno močno"] 
            featureName [#type "afrc" ! "navpični ulomki"] 
            featureName [#type "cpsp" ! "razmik velikih črk"] 
            featureName [#type "dlig" ! "izbirne ligature"] 
            featureName [#type "frac" ! "diagonalni ulomki"] 
            featureName [#type "lnum" ! "sodobne številke"] 
            featureName [#type "onum" ! "starodobne številke"] 
            featureName [#type "ordn" ! "vrstilni števniki"] 
            featureName [#type "pnum" ! "sorazmerna števila"] 
            featureName [#type "smcp" ! "pomanjšane velike črke"] 
            featureName [#type "tnum" ! "tabelarne številke"] 
            featureName [#type "zero" ! "prečrtana ničla"]
        ]
    ]

