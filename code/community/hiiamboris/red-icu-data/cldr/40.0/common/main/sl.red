                parseLenient [#sample "¥" ! "[¥￥]"] 
                parseLenient [#sample "₩" ! "[₩￦]"] 
                parseLenient [#sample "₹" ! "[₨₹{Rs}]"]
            ] 
            parseLenients [
                #scope "number" 
                #level "lenient" 
                parseLenient [#sample "-" ! "[\-‒⁻₋−➖﹣－]"] 
                parseLenient [#sample "," ! "[,،٫、︐︑﹐﹑，､]"] 
                parseLenient [#sample "+" ! "[+⁺₊➕﹢＋]"]
            ] 
            parseLenients [
                #scope "number" 
