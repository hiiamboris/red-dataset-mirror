            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                list [#draft "contributed" ! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                approximatelySign [! "~"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [! ":"]
