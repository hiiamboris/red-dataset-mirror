
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "sr"] 
            script [#type "Cyrl"] 
            territory [#type "ME"]
        ] 
        localeDisplayNames [
            languages [
                language [#type "arn" #draft "contributed" ! "мапудунгун"] 
                language [#type "be" #draft "contributed" ! "бјелоруски"] 
                language [#type "bm" #draft "contributed" ! "бамананкан"] 
                language [#type "bn" #draft "contributed" ! "бангла"] 
                language [#type "ff" #draft "contributed" ! "фулах"] 
                language [#type "ht" #draft "contributed" ! "хаићански креолски"] 
                language [#type "lo" #draft "contributed" ! "лаошки"] 
                language [#type "moh" #draft "contributed" ! "мохок"] 
                language [#type "nqo" #draft "contributed" ! "н’ко"] 
                language [#type "shi" #draft "contributed" ! "јужни шилха"] 
                language [#type "tzm" #draft "contributed" ! "централноатласки тамашек"] 
                language [#type "xh" #draft "contributed" ! "исикоса"] 
                language [#type "zgh" #draft "contributed" ! "стандардни марокански тамашек"] 
                language [#type "zu" #draft "contributed" ! "исизулу"]
            ] 
            territories [
                territory [#type "BY" #draft "contributed" ! "Бјелорусија"] 
                territory [#type "CG" #draft "contributed" ! "Конго"] 
                territory [#type "CZ" #draft "contributed" ! "Чешка Република"] 
                territory [#type "DE" #draft "contributed" ! "Њемачка"] 
                territory [#type "KN" #draft "contributed" ! "Свети Китс и Невис"] 
                territory [#type "PM" #draft "contributed" ! "Свети Пјер и Микелон"] 
                territory [#type "RE" #draft "contributed" ! "Реунион"] 
                territory [#type "UM" #draft "contributed" ! "Мања удаљена острва САД"] 
                territory [#type "VC" #draft "contributed" ! "Свети Винсент и Гренадини"] 
                territory [#type "VG" #draft "contributed" ! "Британска Дјевичанска Острва"] 
                territory [#type "VI" #draft "contributed" ! "Америчка Дјевичанска Острва"]
            ]
        ] 
        dates [
            calendars [
                calendar [
                    #type "generic" 
                    dateTimeFormats [
                        intervalFormats [
                            intervalFormatItem [
                                #id "MMMEd" 
                                greatestDifference [#id "d" #draft "contributed" ! "E, d. MMM – E, d. MMM"] 
                                greatestDifference [#id "M" #draft "contributed" ! "E, d. MMM – E, d. MMM"]
                            ]
                        ]
                    ]
                ] 
                calendar [
                    #type "gregorian" 
                    months [
                        monthContext [
                            #type "format" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "јан"] 
                                month [#type "2" ! "феб"] 
                                month [#type "3" #draft "contributed" ! "март"] 
                                month [#type "4" ! "апр"] 
                                month [#type "5" #draft "contributed" ! "мај"] 
                                month [#type "6" #draft "contributed" ! "јун"] 
                                month [#type "7" #draft "contributed" ! "јул"] 
                                month [#type "8" ! "авг"] 
                                month [#type "9" ! "септ"] 
                                month [#type "10" ! "окт"] 
                                month [#type "11" ! "нов"] 
                                month [#type "12" ! "дец"]
                            ]
                        ] 
                        monthContext [
                            #type "stand-alone" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "јан"] 
                                month [#type "2" ! "феб"] 
                                month [#type "3" #draft "contributed" ! "март"] 
                                month [#type "4" ! "апр"] 
                                month [#type "5" #draft "contributed" ! "мај"] 
                                month [#type "6" #draft "contributed" ! "јун"] 
                                month [#type "7" #draft "contributed" ! "јул"] 
                                month [#type "8" ! "авг"] 
                                month [#type "9" ! "септ"] 
                                month [#type "10" ! "окт"] 
                                month [#type "11" ! "нов"] 
                                month [#type "12" ! "дец"]
                            ]
                        ]
                    ] 
                    days [
                        dayContext [
                            #type "format" 
                            dayWidth [
                                #type "wide" 
                                day [#type "sun" #draft "contributed" ! "недјеља"] 
                                day [#type "mon" #draft "contributed" ! "понедељак"] 
                                day [#type "tue" #draft "contributed" ! "уторак"] 
                                day [#type "wed" #draft "contributed" ! "сриједа"] 
                                day [#type "thu" #draft "contributed" ! "четвртак"] 
                                day [#type "fri" #draft "contributed" ! "петак"] 
                                day [#type "sat" #draft "contributed" ! "субота"]
                            ]
                        ] 
                        dayContext [
                            #type "stand-alone" 
                            dayWidth [
                                #type "wide" 
                                day [#type "sun" #draft "contributed" ! "недјеља"] 
                                day [#type "mon" #draft "contributed" ! "понедељак"] 
                                day [#type "tue" #draft "contributed" ! "уторак"] 
                                day [#type "wed" #draft "contributed" ! "сриједа"] 
                                day [#type "thu" #draft "contributed" ! "четвртак"] 
                                day [#type "fri" #draft "contributed" ! "петак"] 
                                day [#type "sat" #draft "contributed" ! "субота"]
                            ]
                        ]
                    ] 
                    dayPeriods [
                        dayPeriodContext [
                            #type "format" 
                            dayPeriodWidth [
                                #type "abbreviated" 
                                dayPeriod [#type "midnight" #draft "contributed" ! "поноћ"] 
                                dayPeriod [#type "am" #draft "contributed" ! "прије подне"] 
                                dayPeriod [#type "noon" #draft "contributed" ! "подне"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "по подне"] 
                                dayPeriod [#type "morning1" #draft "contributed" ! "јутро"] 
                                dayPeriod [#type "afternoon1" #draft "contributed" ! "по под."] 
                                dayPeriod [#type "evening1" #draft "contributed" ! "вече"] 
                                dayPeriod [#type "night1" #draft "contributed" ! "ноћу"]
                            ] 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "midnight" #draft "contributed" ! "поноћ"] 
                                dayPeriod [#type "noon" #draft "contributed" ! "подне"] 
                                dayPeriod [#type "morning1" #draft "contributed" ! "јутро"] 
                                dayPeriod [#type "afternoon1" #draft "contributed" ! "по под."] 
                                dayPeriod [#type "evening1" #draft "contributed" ! "вече"] 
                                dayPeriod [#type "night1" #draft "contributed" ! "ноћ"]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "am" #draft "contributed" ! "прије подне"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "по подне"]
                            ]
                        ] 
                        dayPeriodContext [
                            #type "stand-alone" 
                            dayPeriodWidth [
                                #type "abbreviated" 
                                dayPeriod [#type "am" #draft "contributed" ! "прије подне"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "по подне"]
                            ] 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "am" #draft "contributed" ! "a"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "p"]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "am" #draft "contributed" ! "прије подне"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "по подне"]
                            ]
                        ]
                    ] 
                    eras [
                        eraNames [
                            era [#type "0" #draft "contributed" ! "прије нове ере"]
                        ]
                    ] 
                    dateTimeFormats [
                        availableFormats [
                            dateFormatItem [#id "MMMMW" #count "one" #draft "contributed" ! "W. 'сједмица' 'у' MMMM"] 
                            dateFormatItem [#id "MMMMW" #count "few" #draft "contributed" ! "W. 'сједмица' 'у' MMMM"] 
                            dateFormatItem [#id "MMMMW" #count "other" #draft "contributed" ! "W. 'сједмица' 'у' MMMM"] 
                            dateFormatItem [#id "yw" #count "one" #draft "contributed" ! "w. 'сједмица' 'у' Y."] 
                            dateFormatItem [#id "yw" #count "few" #draft "contributed" ! "w. 'сједмица' 'у' Y."] 
                            dateFormatItem [#id "yw" #count "other" #draft "contributed" ! "w. 'сједмица' 'у' Y."]
                        ]
                    ]
                ]
            ]
        ]
    ]

