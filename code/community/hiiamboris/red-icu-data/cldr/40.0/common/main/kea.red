                ] 
                unit [
                    #type "volume-quart-imperial" 
                    displayName [! "qt brit."] 
                    unitPattern [#count "other" ! "{0} qt brit."]
                ] 
                coordinateUnit [
                    displayName [! "direson"] 
                    coordinateUnitPattern [#type "east" ! "{0} E"] 
                    coordinateUnitPattern [#type "north" ! "{0} N"] 
                    coordinateUnitPattern [#type "south" ! "{0} S"] 
                    coordinateUnitPattern [#type "west" ! "{0} W"]
                ]
            ] 
            unitLength [
                #type "narrow" 
                unit [
                    #type "consumption-liter-per-100-kilometer" 
                    displayName [! "l/100km"] 
                    unitPattern [#count "other" ! "{0} l/100km"]
                ] 
                unit [
                    #type "duration-year" 
                    displayName [! "anu"] 
                    unitPattern [#count "other" ! "{0} anu"]
                ] 
                unit [
