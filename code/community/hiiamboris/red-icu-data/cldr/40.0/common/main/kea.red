        numbers [
            defaultNumberingSystem [#draft "contributed" ! "latn"] 
            otherNumberingSystems [
                native [#draft "contributed" ! "latn"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! " "] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0 mil"] 
                        pattern [#type "10000" #count "other" ! "00 mil"] 
                        pattern [#type "100000" #count "other" ! "000 mil"] 
                        pattern [#type "1000000" #count "other" ! "0 milhãu"] 
                        pattern [#type "10000000" #count "other" ! "00 milhãu"] 
                        pattern [#type "100000000" #count "other" ! "000 milhãu"] 
                        pattern [#type "1000000000" #count "other" ! "0 mil milhãu"] 
                        pattern [#type "10000000000" #count "other" ! "00 mil milhãu"] 
                        pattern [#type "100000000000" #count "other" ! "000 mil milhãu"] 
                        pattern [#type "1000000000000" #count "other" ! "0 bilhãu"] 
                        pattern [#type "10000000000000" #count "other" ! "00 bilhãu"] 
                        pattern [#type "100000000000000" #count "other" ! "000 bilhãu"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0 mil"] 
                        pattern [#type "10000" #count "other" ! "00 mil"] 
                        pattern [#type "100000" #count "other" ! "000 mil"] 
                        pattern [#type "1000000" #count "other" ! "0 M"] 
                        pattern [#type "10000000" #count "other" ! "00 M"] 
                        pattern [#type "100000000" #count "other" ! "000 M"] 
                        pattern [#type "1000000000" #count "other" ! "0 MM"] 
                        pattern [#type "10000000000" #count "other" ! "00 MM"] 
                        pattern [#type "100000000000" #count "other" ! "000 MM"] 
                        pattern [#type "1000000000000" #count "other" ! "0 Bi"] 
                        pattern [#type "10000000000000" #count "other" ! "00 Bi"] 
                        pattern [#type "100000000000000" #count "other" ! "000 Bi"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "#,##0.00 ¤"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "#,##0.00 ¤;(#,##0.00 ¤)"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "other" #draft "provisional" ! "0 mil ¤"] 
                        pattern [#type "10000" #count "other" #draft "provisional" ! "00 mil ¤"] 
                        pattern [#type "100000" #count "other" #draft "provisional" ! "000 mil ¤"] 
                        pattern [#type "1000000" #count "other" #draft "provisional" ! "0 M ¤"] 
                        pattern [#type "10000000" #count "other" #draft "provisional" ! "00 M ¤"] 
                        pattern [#type "100000000" #count "other" #draft "provisional" ! "000 M ¤"] 
                        pattern [#type "1000000000" #count "other" #draft "provisional" ! "0 MM ¤"] 
                        pattern [#type "10000000000" #count "other" #draft "provisional" ! "00 MM ¤"] 
                        pattern [#type "100000000000" #count "other" #draft "provisional" ! "000 MM ¤"] 
                        pattern [#type "1000000000000" #count "other" #draft "provisional" ! "0 Bi ¤"] 
                        pattern [#type "10000000000000" #count "other" #draft "provisional" ! "00 Bi ¤"] 
                        pattern [#type "100000000000000" #count "other" #draft "provisional" ! "000 Bi ¤"]
                    ]
                ] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
