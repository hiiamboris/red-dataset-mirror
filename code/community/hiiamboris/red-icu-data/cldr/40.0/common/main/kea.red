                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} i {1}"] 
                listPatternPart [#type "2" ! "{0} i {1}"]
            ] 
            listPattern [
                #type "or" 
                listPatternPart [#type "end" ! "{0} o {1}"] 
                listPatternPart [#type "2" ! "{0} o {1}"]
            ] 
            listPattern [
                #type "or-narrow" 
                listPatternPart [#type "end" ! "{0} o {1}"] 
                listPatternPart [#type "2" ! "{0} o {1}"]
            ] 
            listPattern [
                #type "or-short" 
                listPatternPart [#type "end" ! "{0} o {1}"] 
                listPatternPart [#type "2" ! "{0} o {1}"]
            ] 
            listPattern [
                #type "unit" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} i {1}"] 
                listPatternPart [#type "2" ! "{0} i {1}"]
            ] 
            listPattern [
                #type "unit-narrow" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0}, {1}"] 
                listPatternPart [#type "2" ! "{0}, {1}"]
            ] 
            listPattern [
                #type "unit-short" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0}, {1}"] 
                listPatternPart [#type "2" ! "{0}, {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [! "Sin:S"] 
                nostr [! "Nãu:N"]
            ]
        ]
