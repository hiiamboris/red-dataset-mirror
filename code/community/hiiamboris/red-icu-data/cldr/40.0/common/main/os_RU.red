
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "os"] 
            territory [#type "RU"]
        ] 
        numbers [
            currencies [
                currency [
                    #type "GEL" 
                    symbol [! "GEL"]
                ] 
                currency [
                    #type "RUB" 
                    symbol [! "₽"]
                ]
            ]
        ]
    ]

