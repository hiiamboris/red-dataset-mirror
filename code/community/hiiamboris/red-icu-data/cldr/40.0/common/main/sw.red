        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                approximatelySign [! "~"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
