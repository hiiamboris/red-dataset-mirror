
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "en"] 
            territory [#type "MO"]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "Hong_Kong" 
                    short [
                        generic [! "HKT"] 
                        standard [! "HKT"] 
                        daylight [! "HKST"]
                    ]
                ] 
                metazone [
                    #type "Macau" 
                    short [
                        generic [! "MST"] 
                        standard [! "MST"] 
                        daylight [! "MDT"]
                    ]
                ]
            ]
        ] 
        numbers [
            currencies [
                currency [
                    #type "MOP" 
                    symbol [! "MOP$"]
                ]
            ]
        ]
    ]

