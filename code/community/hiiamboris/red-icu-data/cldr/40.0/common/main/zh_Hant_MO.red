
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "zh"] 
            script [#type "Hant"] 
            territory [#type "MO"]
        ] 
        numbers [
            currencies [
                currency [
                    #type "MOP" 
                    symbol [! "MOP$"]
                ]
            ]
        ]
    ]

