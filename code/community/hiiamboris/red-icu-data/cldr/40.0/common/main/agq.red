                                dayPeriod [#type "am" ! "a.g"] 
                                dayPeriod [#type "pm" ! "a.k"]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "am" ! "a.g"] 
                                dayPeriod [#type "pm" ! "a.k"]
                            ]
                        ]
