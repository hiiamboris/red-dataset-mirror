
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "en"] 
            territory [#type "GM"]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "Africa_Central" 
                    short [
                        standard [! "CAT"]
                    ]
                ] 
                metazone [
                    #type "Africa_Eastern" 
                    short [
                        standard [! "EAT"]
                    ]
                ] 
                metazone [
                    #type "Africa_Southern" 
                    short [
                        standard [! "SAST"]
                    ]
                ] 
                metazone [
                    #type "Africa_Western" 
                    short [
                        generic [! "WAT"] 
                        standard [! "WAT"] 
                        daylight [! "WAST"]
                    ]
                ]
            ]
        ] 
        numbers [
            currencies [
                currency [
                    #type "GMD" 
                    symbol [! "D"]
                ]
            ]
        ]
    ]

