                        pattern [#type "10000000000" #count "one" ! "00 milijarda"] 
                        pattern [#type "10000000000" #count "few" ! "00 milijarde"] 
                        pattern [#type "10000000000" #count "other" ! "00 milijardi"] 
                        pattern [#type "100000000000" #count "one" ! "000 milijarda"] 
                        pattern [#type "100000000000" #count "few" ! "000 milijarde"] 
                        pattern [#type "100000000000" #count "other" ! "000 milijardi"] 
                        pattern [#type "1000000000000" #count "one" ! "0 bilion"] 
                        pattern [#type "1000000000000" #count "few" ! "0 biliona"] 
                        pattern [#type "1000000000000" #count "other" ! "0 biliona"] 
                        pattern [#type "10000000000000" #count "one" ! "00 bilion"] 
                        pattern [#type "10000000000000" #count "few" ! "00 biliona"] 
                        pattern [#type "10000000000000" #count "other" ! "00 biliona"] 
                        pattern [#type "100000000000000" #count "one" ! "000 bilion"] 
