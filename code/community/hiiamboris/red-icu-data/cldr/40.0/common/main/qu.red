                    displayName [! "Imp cuarta"] 
                    unitPattern [#count "other" ! "{0} Imp. cuarta"]
                ]
            ] 
            unitLength [
                #type "narrow" 
                unit [
                    #type "duration-year" 
                    displayName [! "wata"] 
                    unitPattern [#count "other" ! "{0} w"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [! "killa"] 
                    unitPattern [#count "other" ! "{0} k"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [! "semana"] 
                    unitPattern [#count "other" ! "{0} s"]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [! "punchaw"] 
                    unitPattern [#count "other" ! "{0} p"]
                ] 
                unit [
                    #type "duration-hour" 
                    displayName [! "hora"] 
                    unitPattern [#count "other" ! "{0} h"]
                ] 
                unit [
                    #type "duration-second" 
                    displayName [! "segundo"] 
                    unitPattern [#count "other" ! "{0} s"]
                ] 
                unit [
                    #type "duration-millisecond" 
                    displayName [! "milisegundo"] 
                    unitPattern [#count "other" ! "{0} ms"]
                ] 
                unit [
                    #type "length-kilometer" 
                    displayName [! "km"] 
                    unitPattern [#count "other" ! "{0}km"]
                ] 
                unit [
                    #type "length-meter" 
                    displayName [! "metro"] 
                    unitPattern [#count "other" ! "{0} m"]
                ] 
                unit [
                    #type "length-centimeter" 
                    displayName [! "cm"] 
                    unitPattern [#count "other" ! "{0} cm"]
                ] 
                unit [
                    #type "length-millimeter" 
                    displayName [! "mm"] 
                    unitPattern [#count "other" ! "{0} mm"]
                ] 
                unit [
                    #type "volume-liter" 
                    displayName [! "litro"] 
                    unitPattern [#count "other" ! "{0} litro"]
                ]
            ] 
            durationUnit [
                #type "hm" 
                durationUnitPattern [! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                #type "or" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0}, utaq {1}"] 
                listPatternPart [#type "2" ! "{0} utaq {1}"]
            ] 
            listPattern [
                #type "or-narrow" 
                listPatternPart [#type "end" ! "{0}, utaq {1}"] 
                listPatternPart [#type "2" ! "{0} utaq {1}"]
            ] 
            listPattern [
                #type "or-short" 
                listPatternPart [#type "end" ! "{0}, utaq {1}"] 
                listPatternPart [#type "2" ! "{0} utaq {1}"]
            ]
        ]
    ]

