
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ff"] 
            script [#type "Adlm"] 
            territory [#type "NG"]
        ] 
        numbers [
            currencies [
                currency [
                    #type "GNF" 
                    symbol [! "GNF"]
                ] 
                currency [
                    #type "NGN" 
                    symbol [! "₦"]
                ]
            ]
        ]
    ]

