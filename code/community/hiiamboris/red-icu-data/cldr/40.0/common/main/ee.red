                    unitPattern [#count "other" ! "kɔsiɖa {0}"]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [! "ŋkekewo"] 
                    unitPattern [#count "one" ! "ŋkeke {0}"] 
                    unitPattern [#count "other" ! "ŋkeke {0}"]
                ] 
                unit [
                    #type "duration-hour" 
                    displayName [! "gaƒoƒowo"] 
                    unitPattern [#count "one" ! "gaƒoƒo {0}"] 
                    unitPattern [#count "other" ! "gaƒoƒo {0}"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [! "aɖabaƒoƒowo"] 
                    unitPattern [#count "one" ! "a {0}"] 
                    unitPattern [#count "other" ! "a {0}"]
                ] 
                unit [
                    #type "duration-second" 
                    unitPattern [#count "one" ! "sekend {0}"] 
                    unitPattern [#count "other" ! "sekend {0}"]
                ]
            ] 
            unitLength [
                #type "narrow" 
                unit [
                    #type "duration-year" 
                    displayName [! "ƒe"] 
                    unitPattern [#count "one" ! "ƒe {0}"] 
                    unitPattern [#count "other" ! "ƒe {0}"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [! "ɣletiwo"] 
                    unitPattern [#count "one" ! "ɣleti {0}"] 
                    unitPattern [#count "other" ! "ɣleti {0}"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [! "kɔsiɖa"] 
                    unitPattern [#count "one" ! "kɔsiɖa {0}"] 
                    unitPattern [#count "other" ! "kɔsiɖa {0}"]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [! "ŋkeke"] 
                    unitPattern [#count "one" ! "ŋkeke {0}"] 
                    unitPattern [#count "other" ! "ŋkeke {0}"]
                ] 
                unit [
                    #type "duration-hour" 
                    displayName [! "gaƒoƒo"] 
                    unitPattern [#count "one" ! "gaƒoƒo {0}"] 
                    unitPattern [#count "other" ! "gaƒoƒo {0}"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [! "aɖabaƒoƒo"] 
                    unitPattern [#count "one" ! "a {0}"] 
                    unitPattern [#count "other" ! "a {0}"]
                ] 
                unit [
                    #type "duration-second" 
                    unitPattern [#count "one" ! "s {0}"] 
                    unitPattern [#count "other" ! "s {0}"]
                ]
            ] 
            durationUnit [
                #type "hm" 
                durationUnitPattern [#draft "unconfirmed" ! "'ga' h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [#draft "unconfirmed" ! "'ga' h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [#draft "unconfirmed" ! "aɖabaƒoƒo m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0}, kple {1}"] 
                listPatternPart [#type "2" ! "{0} kple {1}"]
            ] 
            listPattern [
                #type "unit" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0}, kple {1}"] 
                listPatternPart [#type "2" ! "{0} kple {1}"]
            ] 
            listPattern [
                #type "unit-narrow" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0}, kple {1}"] 
                listPatternPart [#type "2" ! "{0} kple {1}"]
            ] 
            listPattern [
