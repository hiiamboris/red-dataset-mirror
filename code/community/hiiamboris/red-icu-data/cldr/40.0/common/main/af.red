        numbers [
            defaultNumberingSystem [#draft "contributed" ! "latn"] 
            otherNumberingSystems [
                native [#draft "contributed" ! "latn"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! " "] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [#draft "contributed" ! "+"] 
                minusSign [#draft "contributed" ! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [#draft "contributed" ! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 duisend"] 
                        pattern [#type "1000" #count "other" ! "0 duisend"] 
                        pattern [#type "10000" #count "one" ! "00 duisend"] 
                        pattern [#type "10000" #count "other" ! "00 duisend"] 
                        pattern [#type "100000" #count "one" ! "000 duisend"] 
                        pattern [#type "100000" #count "other" ! "000 duisend"] 
                        pattern [#type "1000000" #count "one" ! "0 miljoen"] 
                        pattern [#type "1000000" #count "other" ! "0 miljoen"] 
                        pattern [#type "10000000" #count "one" ! "00 miljoen"] 
                        pattern [#type "10000000" #count "other" ! "00 miljoen"] 
                        pattern [#type "100000000" #count "one" ! "000 miljoen"] 
                        pattern [#type "100000000" #count "other" ! "000 miljoen"] 
                        pattern [#type "1000000000" #count "one" ! "0 miljard"] 
                        pattern [#type "1000000000" #count "other" ! "0 miljard"] 
                        pattern [#type "10000000000" #count "one" ! "00 miljard"] 
                        pattern [#type "10000000000" #count "other" ! "00 miljard"] 
                        pattern [#type "100000000000" #count "one" ! "000 miljard"] 
                        pattern [#type "100000000000" #count "other" ! "000 miljard"] 
                        pattern [#type "1000000000000" #count "one" ! "0 biljoen"] 
                        pattern [#type "1000000000000" #count "other" ! "0 biljoen"] 
                        pattern [#type "10000000000000" #count "one" ! "00 biljoen"] 
                        pattern [#type "10000000000000" #count "other" ! "00 biljoen"] 
                        pattern [#type "100000000000000" #count "one" ! "000 biljoen"] 
                        pattern [#type "100000000000000" #count "other" ! "000 biljoen"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 k"] 
                        pattern [#type "1000" #count "other" ! "0 k"] 
                        pattern [#type "10000" #count "one" ! "00 k"] 
                        pattern [#type "10000" #count "other" ! "00 k"] 
                        pattern [#type "100000" #count "one" ! "000 k"] 
                        pattern [#type "100000" #count "other" ! "000 k"] 
                        pattern [#type "1000000" #count "one" ! "0 m"] 
                        pattern [#type "1000000" #count "other" ! "0 m"] 
                        pattern [#type "10000000" #count "one" ! "00 m"] 
                        pattern [#type "10000000" #count "other" ! "00 m"] 
                        pattern [#type "100000000" #count "one" ! "000 m"] 
                        pattern [#type "100000000" #count "other" ! "000 m"] 
                        pattern [#type "1000000000" #count "one" ! "0 mjd"] 
                        pattern [#type "1000000000" #count "other" ! "0 mjd"] 
                        pattern [#type "10000000000" #count "one" ! "00 mjd"] 
                        pattern [#type "10000000000" #count "other" ! "00 mjd"] 
                        pattern [#type "100000000000" #count "one" ! "000 mjd"] 
                        pattern [#type "100000000000" #count "other" ! "000 mjd"] 
                        pattern [#type "1000000000000" #count "one" ! "0 bn"] 
                        pattern [#type "1000000000000" #count "other" ! "0 bn"] 
                        pattern [#type "10000000000000" #count "one" ! "00 bn"] 
                        pattern [#type "10000000000000" #count "other" ! "00 bn"] 
                        pattern [#type "100000000000000" #count "one" ! "000 bn"] 
                        pattern [#type "100000000000000" #count "other" ! "000 bn"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##0.00"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "¤#,##0.00;(¤#,##0.00)"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "one" ! "¤0 k"] 
                        pattern [#type "1000" #count "other" ! "¤0 k"] 
                        pattern [#type "10000" #count "one" ! "¤00 k"] 
