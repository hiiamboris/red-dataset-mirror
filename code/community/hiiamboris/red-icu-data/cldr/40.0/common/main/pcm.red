                parseLenient [#sample "¥" #draft "contributed" ! "[¥￥]"] 
                parseLenient [#sample "₩" #draft "contributed" ! "[₩￦]"] 
                parseLenient [#sample "₹" #draft "contributed" ! "[₨₹{Rp}{Rs}]"]
            ] 
            parseLenients [
                #scope "number" 
                #level "lenient" 
                parseLenient [#sample "-" #draft "contributed" ! "[\-‐‒–⁻₋−➖﹣－]"] 
                parseLenient [#sample "," #draft "contributed" ! "[,،٫、︐︑﹐﹑，､]"] 
                parseLenient [#sample "+" #draft "contributed" ! "[+⁺₊➕﬩﹢＋]"]
            ] 
            parseLenients [
                #scope "number" 
                #level "stricter" 
                parseLenient [#sample "," #draft "contributed" ! "[,٫︐﹐，]"] 
                parseLenient [#sample "." #draft "contributed" ! "[.․﹒．｡]"]
            ]
