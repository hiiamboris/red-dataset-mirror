        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "mille"] 
                        pattern [#type "1000" #count "other" ! "0 mila"] 
                        pattern [#type "10000" #count "one" ! "00 mila"] 
                        pattern [#type "10000" #count "other" ! "00 mila"] 
                        pattern [#type "100000" #count "one" ! "000 mila"] 
                        pattern [#type "100000" #count "other" ! "000 mila"] 
                        pattern [#type "1000000" #count "one" ! "0 milione"] 
                        pattern [#type "1000000" #count "other" ! "0 milioni"] 
                        pattern [#type "10000000" #count "one" ! "00 milioni"] 
                        pattern [#type "10000000" #count "other" ! "00 milioni"] 
                        pattern [#type "100000000" #count "one" ! "000 milioni"] 
                        pattern [#type "100000000" #count "other" ! "000 milioni"] 
                        pattern [#type "1000000000" #count "one" ! "0 miliardo"] 
                        pattern [#type "1000000000" #count "other" ! "0 miliardi"] 
                        pattern [#type "10000000000" #count "one" ! "00 miliardi"] 
                        pattern [#type "10000000000" #count "other" ! "00 miliardi"] 
                        pattern [#type "100000000000" #count "one" ! "000 miliardi"] 
                        pattern [#type "100000000000" #count "other" ! "000 miliardi"] 
                        pattern [#type "1000000000000" #count "one" ! "0 mille miliardi"] 
                        pattern [#type "1000000000000" #count "other" ! "0 mila miliardi"] 
                        pattern [#type "10000000000000" #count "one" ! "00 mila miliardi"] 
                        pattern [#type "10000000000000" #count "other" ! "00 mila miliardi"] 
                        pattern [#type "100000000000000" #count "one" ! "000 mila miliardi"] 
                        pattern [#type "100000000000000" #count "other" ! "000 mila miliardi"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0"] 
                        pattern [#type "1000" #count "other" ! "0"] 
                        pattern [#type "10000" #count "one" ! "0"] 
                        pattern [#type "10000" #count "other" ! "0"] 
                        pattern [#type "100000" #count "one" ! "0"] 
                        pattern [#type "100000" #count "other" ! "0"] 
                        pattern [#type "1000000" #count "one" ! "0 Mln"] 
                        pattern [#type "1000000" #count "other" ! "0 Mln"] 
                        pattern [#type "10000000" #count "one" ! "00 Mln"] 
                        pattern [#type "10000000" #count "other" ! "00 Mln"] 
                        pattern [#type "100000000" #count "one" ! "000 Mln"] 
                        pattern [#type "100000000" #count "other" ! "000 Mln"] 
                        pattern [#type "1000000000" #count "one" ! "0 Mrd"] 
                        pattern [#type "1000000000" #count "other" ! "0 Mrd"] 
                        pattern [#type "10000000000" #count "one" ! "00 Mrd"] 
                        pattern [#type "10000000000" #count "other" ! "00 Mrd"] 
                        pattern [#type "100000000000" #count "one" ! "000 Mrd"] 
                        pattern [#type "100000000000" #count "other" ! "000 Mrd"] 
                        pattern [#type "1000000000000" #count "one" ! "0 Bln"] 
                        pattern [#type "1000000000000" #count "other" ! "0 Bln"] 
                        pattern [#type "10000000000000" #count "one" ! "00 Bln"] 
                        pattern [#type "10000000000000" #count "other" ! "00 Bln"] 
                        pattern [#type "100000000000000" #count "one" ! "000 Bln"] 
                        pattern [#type "100000000000000" #count "other" ! "000 Bln"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "#,##0.00 ¤"]
