                                month [#type "10" #draft "contributed" ! "പവോണ"] 
                                month [#type "11" #draft "contributed" ! "ഈപെപ്"] 
                                month [#type "12" #draft "contributed" ! "മെസ്ര"] 
                                month [#type "13" #draft "contributed" ! "നസീ"]
                            ] 
                            monthWidth [
                                #type "narrow" 
                                month [#type "1" #draft "contributed" ! "ടൗ."] 
                                month [#type "2" #draft "contributed" ! "ബാ."] 
                                month [#type "3" #draft "contributed" ! "ഹാ."] 
                                month [#type "4" #draft "contributed" ! "കി."] 
                                month [#type "5" #draft "contributed" ! "ടോ."] 
                                month [#type "6" #draft "contributed" ! "ആം."] 
                                month [#type "7" #draft "contributed" ! "ബാ."] 
                                month [#type "8" #draft "contributed" ! "ബാ."] 
                                month [#type "9" #draft "contributed" ! "ബാ."] 
                                month [#type "10" #draft "contributed" ! "പ."] 
                                month [#type "11" #draft "contributed" ! "ഈ."] 
                                month [#type "12" #draft "contributed" ! "മെ."] 
                                month [#type "13" #draft "contributed" ! "ന."]
                            ] 
