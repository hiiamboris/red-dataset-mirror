                measurementSystemName [#type "US" ! "യുഎസ്"]
            ] 
            codePatterns [
                codePattern [#type "language" ! "ഭാഷ: {0}"] 
                codePattern [#type "script" ! "ലിപി: {0}"] 
                codePattern [#type "territory" ! "പ്രദേശം: {0}"]
            ]
