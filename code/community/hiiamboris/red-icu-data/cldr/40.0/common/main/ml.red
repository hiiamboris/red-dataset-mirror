                calendar [
                    #type "coptic" 
                    months [
                        monthContext [
                            #type "format" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" #draft "contributed" ! "ടൗട്ട്"] 
                                month [#type "2" #draft "contributed" ! "ബാബ"] 
                                month [#type "3" #draft "contributed" ! "ഹാറ്റർ"] 
                                month [#type "4" #draft "contributed" ! "കിയാക്ക്"] 
                                month [#type "5" #draft "contributed" ! "ടോബ"] 
