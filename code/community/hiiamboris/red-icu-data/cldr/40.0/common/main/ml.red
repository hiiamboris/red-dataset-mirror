        characters [
            exemplarCharacters [! {[\u200C\u200D ഃ അ ആ ഇ ഈ ഉ ഊ ഋ ൠ ഌ ൡ എ ഏ ഐ ഒ ഓ ഔ ക ൿ ഖ ഗ ഘ ങ ച ഛ ജ ഝ ഞ ട ഠ ഡ ഢ ണ ൺ ത ഥ ദ ധ ന ൻ പ ഫ ബ ഭ മ ം യ ര ർ ല ൽ വ ശ ഷ സ ഹ ള ൾ ഴ റ ാ ി ീ \u0D41 \u0D42 \u0D43 െ േ ൈ ൊ ോ ൌ ൗ \u0D4D]}] 
            exemplarCharacters [#type "auxiliary" ! "[]"] 
            exemplarCharacters [#type "index" ! {[അ ആ ഇ ഈ ഉ ഊ ഋ എ ഏ ഐ ഒ ഓ ഔ ക ഖ ഗ ഘ ങ ച ഛ ജ ഝ ഞ ട ഠ ഡ ഢ ണ ത ഥ ദ ധ ന പ ഫ ബ ഭ മ യ ര ല വ ശ ഷ സ ഹ ള ഴ റ]}] 
            exemplarCharacters [#type "numbers" ! "[\- ‑ , . % ‰ + 0൦ 1൧ 2൨ 3൩ 4൪ 5൫ 6൬ 7൭ 8൮ 9൯]"] 
            exemplarCharacters [#type "punctuation" #draft "contributed" ! {[\- ‐ ‑ – — , ; \: ! ? . … ' ‘ ’ &quot; “ ” ( ) \[ \] § @ * / \&amp; # † ‡ ′ ″]}] 
            ellipsis [#type "final" ! "{0}…"] 
            ellipsis [#type "initial" ! "…{0}"] 
            ellipsis [#type "medial" ! "{0}…{1}"] 
            ellipsis [#type "word-final" ! "{0} …"] 
            ellipsis [#type "word-initial" ! "… {0}"] 
            ellipsis [#type "word-medial" ! "{0} … {1}"] 
            moreInformation [! "?"] 
            parseLenients [
                #scope "date" 
                #level "lenient" 
                parseLenient [#sample "-" ! "[\--/]"] 
                parseLenient [#sample ":" ! "[\:∶]"]
            ] 
            parseLenients [
                #scope "general" 
                #level "lenient" 
                parseLenient [#sample "." ! "[.․。︒﹒．｡]"] 
                parseLenient [#sample "$" ! "[\$﹩＄$]"] 
                parseLenient [#sample "£" ! "[£₤]"] 
                parseLenient [#sample "₹" ! "[₨₹{Rp}{Rs}]"]
            ] 
            parseLenients [
                #scope "number" 
                #level "lenient" 
                parseLenient [#sample "-" ! "[\-‒⁻₋−➖﹣－]"] 
                parseLenient [#sample "," ! "[,،٫、︐︑﹐﹑，､]"] 
                parseLenient [#sample "+" ! "[+⁺₊➕﬩﹢＋]"]
            ] 
            parseLenients [
                #scope "number" 
                #level "stricter" 
                parseLenient [#sample "," ! "[,٫︐﹐，]"] 
                parseLenient [#sample "." ! "[.․﹒．｡]"]
            ]
        ] 
        delimiters [
            quotationStart [! "“"] 
            quotationEnd [! "”"] 
            alternateQuotationStart [! "‘"] 
            alternateQuotationEnd [! "’"]
        ] 
        dates [
            calendars [
                calendar [
                    #type "buddhist" 
                    eras [
                        eraNames [
