                ] 
                field [
                    #type "day" 
                    displayName [! "Zah’nane/ Comme"] 
                    relative [#type "-1" ! "Tǝsoo"] 
                    relative [#type "0" ! "Tǝ’nahko"] 
                    relative [#type "1" ! "Tǝ’nane"]
                ] 
                field [
                    #type "weekday" 
