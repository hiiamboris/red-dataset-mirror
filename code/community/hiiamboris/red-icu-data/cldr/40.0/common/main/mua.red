                            dateFormatItem [#id "yQQQ" ! "QQQ y"] 
                            dateFormatItem [#id "yQQQQ" ! "QQQQ y"]
                        ]
                    ]
                ]
            ] 
            fields [
                field [
                    #type "era" 
                    displayName [! "Syii ma tãa"]
                ] 
                field [
                    #type "year" 
                    displayName [! "Syii"]
                ] 
                field [
                    #type "month" 
