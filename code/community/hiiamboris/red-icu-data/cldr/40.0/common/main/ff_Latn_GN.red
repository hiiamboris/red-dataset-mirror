
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ff"] 
            script [#type "Latn"] 
            territory [#type "GN"]
        ] 
        numbers [
            currencies [
                currency [
                    #type "GNF" 
                    symbol [! "FG"]
                ]
            ]
        ]
    ]

