        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 mie"] 
                        pattern [#type "1000" #count "few" ! "0 mii"] 
                        pattern [#type "1000" #count "other" ! "0 de mii"] 
                        pattern [#type "10000" #count "one" ! "00 mie"] 
                        pattern [#type "10000" #count "few" ! "00 mii"] 
                        pattern [#type "10000" #count "other" ! "00 de mii"] 
                        pattern [#type "100000" #count "one" ! "000 mie"] 
                        pattern [#type "100000" #count "few" ! "000 mii"] 
                        pattern [#type "100000" #count "other" ! "000 de mii"] 
                        pattern [#type "1000000" #count "one" ! "0 milion"] 
                        pattern [#type "1000000" #count "few" ! "0 milioane"] 
