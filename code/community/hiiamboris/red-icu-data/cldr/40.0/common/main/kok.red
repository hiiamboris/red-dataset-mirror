        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "deva"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "deva" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                #numberSystem "deva" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0 हजार"] 
                        pattern [#type "10000" #count "other" ! "00 हजार"] 
                        pattern [#type "100000" #count "other" ! "000 हजार"] 
                        pattern [#type "1000000" #count "other" ! "0 दशलक्ष"] 
                        pattern [#type "10000000" #count "other" ! "00 दशलक्ष"] 
                        pattern [#type "100000000" #count "other" ! "000 दशलक्ष"] 
                        pattern [#type "1000000000" #count "other" ! "0 अब्ज"] 
                        pattern [#type "10000000000" #count "other" ! "00 अब्ज"] 
                        pattern [#type "100000000000" #count "other" ! "000 अब्ज"] 
                        pattern [#type "1000000000000" #count "other" ! "0 ट्रिलियन"] 
                        pattern [#type "10000000000000" #count "other" ! "00 ट्रिलियन"] 
                        pattern [#type "100000000000000" #count "other" ! "000 ट्रिलियन"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0K"] 
                        pattern [#type "10000" #count "other" ! "00K"] 
                        pattern [#type "100000" #count "other" ! "000K"] 
                        pattern [#type "1000000" #count "other" ! "0M"] 
                        pattern [#type "10000000" #count "other" ! "00M"] 
                        pattern [#type "100000000" #count "other" ! "000M"] 
                        pattern [#type "1000000000" #count "other" ! "0B"] 
                        pattern [#type "10000000000" #count "other" ! "00B"] 
                        pattern [#type "100000000000" #count "other" ! "000B"] 
                        pattern [#type "1000000000000" #count "other" ! "0T"] 
                        pattern [#type "10000000000000" #count "other" ! "00T"] 
                        pattern [#type "100000000000000" #count "other" ! "000T"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "deva" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "deva" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "deva" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##0.00"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤ #,##0.00"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "¤#,##0.00;(¤#,##0.00)"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "other" ! "¤0K"] 
                        pattern [#type "10000" #count "other" ! "¤00K"] 
                        pattern [#type "100000" #count "other" ! "¤000K"] 
                        pattern [#type "1000000" #count "other" ! "¤0M"] 
                        pattern [#type "10000000" #count "other" ! "¤00M"] 
