                            dateFormatItem [#id "yMMMd" ! "dی MMMی y"] 
                            dateFormatItem [#id "yMMMEd" ! "E، dی MMMی y"] 
                            dateFormatItem [#id "yMMMM" ! "y MMMM"] 
                            dateFormatItem [#id "yQQQ" ! "y QQQ"] 
                            dateFormatItem [#id "yQQQQ" ! "y QQQQ"] 
                            dateFormatItem [#id "yw" #count "one" ! "هەفتەی w ی Y"] 
                            dateFormatItem [#id "yw" #count "other" ! "هەفتەی w ی Y"]
                        ] 
                        appendItems [
                            appendItem [#request "Timezone" ! "{0} {1}"]
                        ] 
                        intervalFormats [
                            intervalFormatItem [
                                #id "MEd" 
                                greatestDifference [#id "d" #draft "unconfirmed" ! "E، M/d – E، M/d"] 
                                greatestDifference [#id "M" #draft "unconfirmed" ! "E، M/d – E، M/d"]
                            ] 
                            intervalFormatItem [
                                #id "MMM" 
                                greatestDifference [#id "M" #draft "unconfirmed" ! "MMM–MMM"]
                            ] 
                            intervalFormatItem [
                                #id "MMMd" 
                                greatestDifference [#id "d" #draft "unconfirmed" ! "d–dی MMM"]
                            ] 
                            intervalFormatItem [
                                #id "MMMEd" 
                                greatestDifference [#id "d" #draft "unconfirmed" ! "E، dی MMM – E، dی MMM"]
                            ] 
                            intervalFormatItem [
                                #id "yMd" 
                                greatestDifference [#id "y" #draft "unconfirmed" ! "d/M/y – d/M/y"]
                            ] 
                            intervalFormatItem [
                                #id "yMEd" 
                                greatestDifference [#id "d" #draft "unconfirmed" ! "E، d/M/y – E، d/M/y"] 
                                greatestDifference [#id "M" #draft "unconfirmed" ! "E، d/M/y – E، d/M/y"] 
                                greatestDifference [#id "y" #draft "unconfirmed" ! "E، d/M/y – E، d/M/y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMM" 
                                greatestDifference [#id "M" #draft "unconfirmed" ! "MMM–MMMی y"] 
                                greatestDifference [#id "y" #draft "unconfirmed" ! "MMMی y – MMMی y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMd" 
                                greatestDifference [#id "d" #draft "unconfirmed" ! "d–dی MMMی y"] 
                                greatestDifference [#id "M" #draft "unconfirmed" ! "dی MMM – dی MMMی y"] 
                                greatestDifference [#id "y" #draft "unconfirmed" ! "dی MMMMی y – dی MMMMی y"]
                            ]
                        ]
                    ]
                ] 
                calendar [
                    #type "persian" 
                    months [
                        monthContext [
                            #type "format" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" #draft "unconfirmed" ! "خاکەلێوە"] 
                                month [#type "2" #draft "unconfirmed" ! "بانەمەڕ"] 
                                month [#type "3" #draft "unconfirmed" ! "جۆزەردان"] 
                                month [#type "4" #draft "unconfirmed" ! "پووشپەڕ"] 
                                month [#type "5" #draft "unconfirmed" ! "گەلاوێژ"] 
                                month [#type "6" #draft "unconfirmed" ! "خەرمانان"] 
                                month [#type "7" #draft "unconfirmed" ! "ڕەزبەر"] 
                                month [#type "8" #draft "unconfirmed" ! "خەزەڵوەر"] 
                                month [#type "9" #draft "unconfirmed" ! "سەرماوەز"] 
                                month [#type "10" #draft "unconfirmed" ! "بەفرانبار"] 
                                month [#type "11" #draft "unconfirmed" ! "ڕێبەندان"] 
                                month [#type "12" #draft "unconfirmed" ! "رەشەمێ"]
                            ] 
                            monthWidth [
                                #type "wide" 
                                month [#type "1" #draft "unconfirmed" ! "خاکەلێوە"] 
                                month [#type "2" #draft "unconfirmed" ! "بانەمەڕ"] 
                                month [#type "3" #draft "unconfirmed" ! "جۆزەردان"] 
                                month [#type "4" #draft "unconfirmed" ! "پووشپەڕ"] 
                                month [#type "5" #draft "unconfirmed" ! "گەلاوێژ"] 
                                month [#type "6" #draft "unconfirmed" ! "خەرمانان"] 
                                month [#type "7" #draft "unconfirmed" ! "ڕەزبەر"] 
                                month [#type "8" #draft "unconfirmed" ! "خەزەڵوەر"] 
                                month [#type "9" #draft "unconfirmed" ! "سەرماوەز"] 
                                month [#type "10" #draft "unconfirmed" ! "بەفرانبار"] 
                                month [#type "11" #draft "unconfirmed" ! "ڕێبەندان"] 
                                month [#type "12" #draft "unconfirmed" ! "رەشەمێ"]
                            ]
                        ] 
                        monthContext [
                            #type "stand-alone" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" #draft "unconfirmed" ! "خاکەلێوە"] 
                                month [#type "2" #draft "unconfirmed" ! "بانەمەڕ"] 
                                month [#type "3" #draft "unconfirmed" ! "جۆزەردان"] 
                                month [#type "4" #draft "unconfirmed" ! "پووشپەڕ"] 
                                month [#type "5" #draft "unconfirmed" ! "گەلاوێژ"] 
                                month [#type "6" #draft "unconfirmed" ! "خەرمانان"] 
                                month [#type "7" #draft "unconfirmed" ! "ڕەزبەر"] 
                                month [#type "8" #draft "unconfirmed" ! "خەزەڵوەر"] 
                                month [#type "9" #draft "unconfirmed" ! "سەرماوەز"] 
                                month [#type "10" #draft "unconfirmed" ! "بەفرانبار"] 
                                month [#type "11" #draft "unconfirmed" ! "ڕێبەندان"] 
                                month [#type "12" #draft "unconfirmed" ! "رەشەمێ"]
                            ] 
                            monthWidth [
                                #type "wide" 
                                month [#type "1" #draft "unconfirmed" ! "خاکەلێوە"] 
                                month [#type "2" #draft "unconfirmed" ! "بانەمەڕ"] 
                                month [#type "3" #draft "unconfirmed" ! "جۆزەردان"] 
                                month [#type "4" #draft "unconfirmed" ! "پووشپەڕ"] 
                                month [#type "5" #draft "unconfirmed" ! "گەلاوێژ"] 
                                month [#type "6" #draft "unconfirmed" ! "خەرمانان"] 
                                month [#type "7" #draft "unconfirmed" ! "ڕەزبەر"] 
                                month [#type "8" #draft "unconfirmed" ! "خەزەڵوەر"] 
                                month [#type "9" #draft "unconfirmed" ! "سەرماوەز"] 
                                month [#type "10" #draft "unconfirmed" ! "بەفرانبار"] 
                                month [#type "11" #draft "unconfirmed" ! "ڕێبەندان"] 
                                month [#type "12" #draft "unconfirmed" ! "رەشەمێ"]
                            ]
                        ]
                    ]
                ]
            ] 
            fields [
                field [
                    #type "era" 
                    displayName [#draft "unconfirmed" ! "دەم"]
                ] 
                field [
                    #type "year" 
                    displayName [#draft "unconfirmed" ! "ساڵ"] 
                    relative [#type "-1" #draft "unconfirmed" ! "ساڵێ پێسوو"] 
                    relative [#type "0" #draft "unconfirmed" ! "ئەم ساڵ"] 
                    relative [#type "1" #draft "unconfirmed" ! "ساڵی داهاتوو"]
                ] 
                field [
                    #type "quarter" 
                    displayName [#draft "unconfirmed" ! "چارەگ"]
                ] 
                field [
                    #type "month" 
                    displayName [#draft "unconfirmed" ! "مانگ"] 
                    relative [#type "-1" #draft "unconfirmed" ! "مانگی پێشوو"] 
                    relative [#type "0" #draft "unconfirmed" ! "ئەم مانگە"] 
                    relative [#type "1" #draft "unconfirmed" ! "مانگی داهاتوو"]
                ] 
                field [
                    #type "month-short" 
                    relative [#type "-1" #draft "unconfirmed" ! "مانگی پێشوو"] 
                    relative [#type "0" #draft "unconfirmed" ! "ئەم مانگە"] 
                    relative [#type "1" #draft "unconfirmed" ! "مانگی داهاتوو"]
                ] 
                field [
                    #type "week" 
                    displayName [#draft "unconfirmed" ! "ھەفتە"] 
                    relative [#type "-1" #draft "unconfirmed" ! "هەفتەی پێشوو"] 
                    relative [#type "0" #draft "unconfirmed" ! "ئەم هەفتەیە"] 
                    relative [#type "1" #draft "unconfirmed" ! "هەفتەی داهاتوو"] 
                    relativePeriod [#draft "unconfirmed" ! "هەفتەی {0}"]
                ] 
                field [
                    #type "day" 
                    displayName [#draft "unconfirmed" ! "ڕۆژ"] 
                    relative [#type "-1" #draft "unconfirmed" ! "دوێنێ"] 
                    relative [#type "0" #draft "unconfirmed" ! "ئەمڕۆ"] 
                    relative [#type "1" #draft "unconfirmed" ! "سبەی"]
                ] 
                field [
                    #type "weekday" 
                    displayName [#draft "unconfirmed" ! "ڕۆژی ھەفتە"]
                ] 
                field [
                    #type "dayperiod" 
                    displayName [#draft "unconfirmed" ! "پ.ن/د.ن"]
                ] 
                field [
                    #type "hour" 
                    displayName [#draft "unconfirmed" ! "کاتژمێر"]
                ] 
                field [
                    #type "minute" 
                    displayName [#draft "unconfirmed" ! "خولەک"]
                ] 
                field [
                    #type "second" 
                    displayName [#draft "unconfirmed" ! "چرکە"]
                ] 
                field [
                    #type "zone" 
                    displayName [#draft "unconfirmed" ! "کاتی هەرێمی"]
                ]
            ]
        ] 
        numbers [
            defaultNumberingSystem [! "arab"] 
            otherNumberingSystems [
                native [! "arab"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "arab" 
                decimal [! "٫"] 
                group [! "٬"] 
                percentSign [! "٪"] 
                plusSign [! "‏+"] 
                minusSign [! "‏-"] 
                exponential [! "اس"] 
                superscriptingExponent [! "×"] 
                perMille [! "؉"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "‎+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                #numberSystem "arab" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "arab" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "arab" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0 %"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "arab" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "#,##0.00 ¤"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤ #,##0.00"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "¤ #,##0.00"]
                    ]
                ] 
                unitPattern [#count "one" ! "{0} {1}"] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencies [
                currency [
                    #type "AFN" 
                    displayName [#draft "unconfirmed" ! "ئەفغانیی ئەفغانستان"]
                ] 
                currency [
                    #type "BHD" 
                    displayName [#draft "unconfirmed" ! "دیناری بەحرەینی"]
                ] 
                currency [
                    #type "BZD" 
                    displayName [#draft "unconfirmed" ! "دۆلاری بەلیزی"]
                ] 
                currency [
                    #type "CAD" 
                    displayName [#draft "unconfirmed" ! "دۆلاری کەنەدی"] 
                    displayName [#count "one" #draft "unconfirmed" ! "دۆلاری کەنەدی"] 
                    displayName [#count "other" #draft "unconfirmed" ! "دۆلاری کەنەدی"]
                ] 
                currency [
                    #type "DZD" 
                    displayName [#draft "unconfirmed" ! "دیناری جەزائیری"]
                ] 
                currency [
