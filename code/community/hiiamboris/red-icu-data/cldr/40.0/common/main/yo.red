                    displayName [! "Gílídà Netherlands Antillean"] 
                    displayName [#count "other" ! "àwọn gílídà Netherlands Antillean"]
                ] 
                currency [
                    #type "AOA" 
                    displayName [! "kíwánsà Angola"] 
                    displayName [#count "other" ! "àwọn kíwánsà Angola"]
                ] 
                currency [
