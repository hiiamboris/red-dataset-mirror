        numbers [
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                approximatelySign [! "dáàṣì"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0 ẹgbẹ̀rún"] 
                        pattern [#type "10000" #count "other" ! "00 ẹgbẹ̀rún"] 
                        pattern [#type "100000" #count "other" ! "000 ẹgbẹ̀rún"] 
                        pattern [#type "1000000" #count "other" ! "0 mílíọ̀nù"] 
                        pattern [#type "10000000" #count "other" ! "00 mílíọ̀nù"] 
                        pattern [#type "100000000" #count "other" ! "000 mílíọ̀nù"] 
                        pattern [#type "1000000000" #count "other" ! "0 bilíọ̀nù"] 
                        pattern [#type "10000000000" #count "other" ! "00 bilíọ̀nù"] 
                        pattern [#type "100000000000" #count "other" ! "000 bilíọ̀nù"] 
                        pattern [#type "1000000000000" #count "other" ! "0 tiriliọ̀nù"] 
                        pattern [#type "10000000000000" #count "other" ! "00 tiriliọ̀nù"] 
                        pattern [#type "100000000000000" #count "other" ! "000 tiriliọ̀nù"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##0.00"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "¤#,##0.00;(¤#,##0.00)"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "other" #draft "provisional" ! "¤0K"] 
                        pattern [#type "10000" #count "other" #draft "provisional" ! "¤00K"] 
                        pattern [#type "100000" #count "other" #draft "provisional" ! "¤000K"] 
                        pattern [#type "1000000" #count "other" #draft "provisional" ! "¤0M"] 
                        pattern [#type "10000000" #count "other" #draft "provisional" ! "¤00M"] 
                        pattern [#type "100000000" #count "other" #draft "provisional" ! "¤000M"] 
                        pattern [#type "1000000000" #count "other" #draft "provisional" ! "¤0G"] 
                        pattern [#type "10000000000" #count "other" #draft "provisional" ! "¤00G"] 
                        pattern [#type "100000000000" #count "other" #draft "provisional" ! "¤000G"] 
                        pattern [#type "1000000000000" #count "other" #draft "provisional" ! "¤0T"] 
                        pattern [#type "10000000000000" #count "other" #draft "provisional" ! "¤00T"] 
                        pattern [#type "100000000000000" #count "other" #draft "provisional" ! "¤000T"]
                    ]
                ] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencies [
                currency [
                    #type "AED" 
                    displayName [! "Diami ti Awon Orílẹ́ède Arabu"]
                ] 
                currency [
                    #type "AFN" 
                    displayName [! "Afugánì Afuganísítàànì"]
                ] 
                currency [
                    #type "ALL" 
                    displayName [! "Lẹ́ẹ̀kì Àlìbáníà"] 
                    displayName [#count "other" ! "lẹ́kè Àlìbéníà"]
                ] 
                currency [
                    #type "AMD" 
                    displayName [! "Dírààmù Àmẹ́níà"]
                ] 
                currency [
