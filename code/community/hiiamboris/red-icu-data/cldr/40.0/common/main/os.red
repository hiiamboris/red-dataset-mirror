        ] 
        delimiters [
            quotationStart [#draft "contributed" ! "«"] 
            quotationEnd [#draft "contributed" ! "»"] 
            alternateQuotationStart [#draft "contributed" ! "„"] 
            alternateQuotationEnd [#draft "contributed" ! "“"]
        ] 
        dates [
            calendars [
