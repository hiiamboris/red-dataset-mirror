                unit [
                    #type "duration-hour" 
                    displayName [#draft "contributed" ! "сахаты"] 
                    unitPattern [#count "one" ! "{0} с."] 
                    unitPattern [#count "other" ! "{0} с."]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [#draft "contributed" ! "минуты"] 
                    unitPattern [#count "one" ! "{0} мин."] 
                    unitPattern [#count "other" ! "{0} мин."]
                ] 
                unit [
                    #type "duration-second" 
                    displayName [#draft "contributed" ! "секунды"]
                ]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "middle" #draft "contributed" ! "{0}, {1}"] 
                listPatternPart [#type "end" #draft "contributed" ! "{0} ӕмӕ {1}"] 
                listPatternPart [#type "2" #draft "contributed" ! "{0} ӕмӕ {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [#draft "contributed" ! "уойы:у"] 
                nostr [#draft "contributed" ! "нӕйы:н"]
            ]
        ]
    ]

