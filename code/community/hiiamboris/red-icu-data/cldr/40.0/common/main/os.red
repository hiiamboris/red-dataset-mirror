                            dateFormat [
                                pattern [#draft "contributed" ! "EEEE, d MMMM, y 'аз' G"] 
                                datetimeSkeleton [#draft "contributed" ! "GyMMMMEEEEd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [#draft "contributed" ! "d MMMM, y 'аз' G"] 
