
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ar"] 
            territory [#type "EG"]
        ] 
        localeDisplayNames [
            languages [
                language [#type "da" #draft "contributed" ! "الدنماركية"]
            ]
        ] 
        numbers [
            defaultNumberingSystem [! "arab"]
        ]
    ]

