                                #type "abbreviated" 
                                day [#type "sun" ! "Б."] 
                                day [#type "mon" ! "Б.Е."] 
                                day [#type "tue" ! "Ч.А."] 
                                day [#type "wed" ! "Ч."] 
                                day [#type "thu" ! "Ҹ.А."] 
                                day [#type "fri" ! "Ҹ."] 
                                day [#type "sat" ! "Ш."]
                            ] 
                            dayWidth [
                                #type "narrow" 
                                day [#type "sun" ! "7"] 
                                day [#type "mon" ! "1"] 
                                day [#type "tue" ! "2"] 
                                day [#type "wed" ! "3"] 
                                day [#type "thu" ! "4"] 
                                day [#type "fri" ! "5"] 
                                day [#type "sat" ! "6"]
                            ] 
                            dayWidth [
                                #type "short" 
                                day [#type "sun" ! "Б."] 
                                day [#type "mon" ! "Б.Е."] 
                                day [#type "tue" ! "Ч.А."] 
                                day [#type "wed" ! "Ч."] 
                                day [#type "thu" ! "Ҹ.А."] 
                                day [#type "fri" ! "Ҹ."] 
                                day [#type "sat" ! "Ш."]
                            ] 
                            dayWidth [
                                #type "wide" 
                                day [#type "sun" ! "базар"] 
                                day [#type "mon" ! "базар ертәси"] 
                                day [#type "tue" ! "чәршәнбә ахшамы"] 
                                day [#type "wed" ! "чәршәнбә"] 
                                day [#type "thu" ! "ҹүмә ахшамы"] 
                                day [#type "fri" ! "ҹүмә"] 
                                day [#type "sat" ! "шәнбә"]
                            ]
                        ]
                    ] 
                    quarters [
                        quarterContext [
                            #type "format" 
                            quarterWidth [
                                #type "abbreviated" 
                                quarter [#type "1" ! "1-ҹи кв."] 
                                quarter [#type "2" ! "2-ҹи кв."] 
                                quarter [#type "3" ! "3-ҹү кв."] 
                                quarter [#type "4" ! "4-ҹү кв."]
                            ] 
                            quarterWidth [
                                #type "wide" 
                                quarter [#type "1" ! "1-ҹи квартал"] 
                                quarter [#type "2" ! "2-ҹи квартал"] 
                                quarter [#type "3" ! "3-ҹү квартал"] 
                                quarter [#type "4" ! "4-ҹү квартал"]
                            ]
                        ]
                    ] 
                    dayPeriods [
                        dayPeriodContext [
                            #type "format" 
                            dayPeriodWidth [
                                #type "abbreviated" 
                                dayPeriod [#type "midnight" ! "ҝеҹәјары"] 
                                dayPeriod [#type "am" ! "АМ"] 
                                dayPeriod [#type "noon" ! "ҝүнорта"] 
                                dayPeriod [#type "pm" ! "ПМ"] 
                                dayPeriod [#type "morning1" ! "сүбһ"] 
                                dayPeriod [#type "morning2" ! "сәһәр"] 
                                dayPeriod [#type "afternoon1" ! "ҝүндүз"] 
                                dayPeriod [#type "evening1" ! "ахшамүстү"] 
                                dayPeriod [#type "night1" ! "ахшам"] 
                                dayPeriod [#type "night2" ! "ҝеҹә"]
                            ] 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "midnight" ! "ҝеҹәјары"] 
                                dayPeriod [#type "am" ! "а"] 
                                dayPeriod [#type "noon" ! "ҝ"] 
                                dayPeriod [#type "pm" ! "п"] 
                                dayPeriod [#type "morning1" ! "сүбһ"] 
                                dayPeriod [#type "morning2" ! "сәһәр"] 
                                dayPeriod [#type "afternoon1" ! "ҝүндүз"] 
                                dayPeriod [#type "evening1" ! "ахшамүстү"] 
                                dayPeriod [#type "night1" ! "ахшам"] 
                                dayPeriod [#type "night2" ! "ҝеҹә"]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "midnight" ! "ҝеҹәјары"] 
                                dayPeriod [#type "am" ! "АМ"] 
                                dayPeriod [#type "noon" ! "ҝүнорта"] 
                                dayPeriod [#type "pm" ! "ПМ"] 
                                dayPeriod [#type "morning1" ! "сүбһ"] 
                                dayPeriod [#type "morning2" ! "сәһәр"] 
                                dayPeriod [#type "afternoon1" ! "ҝүндүз"] 
                                dayPeriod [#type "evening1" ! "ахшамүстү"] 
                                dayPeriod [#type "night1" ! "ахшам"] 
                                dayPeriod [#type "night2" ! "ҝеҹә"]
                            ]
                        ] 
                        dayPeriodContext [
                            #type "stand-alone" 
                            dayPeriodWidth [
                                #type "abbreviated" 
                                dayPeriod [#type "midnight" ! "ҝеҹәјары"] 
                                dayPeriod [#type "noon" ! "ҝүнорта"] 
                                dayPeriod [#type "morning1" ! "сүбһ"] 
                                dayPeriod [#type "morning2" ! "сәһәр"] 
                                dayPeriod [#type "afternoon1" ! "ҝүндүз"] 
                                dayPeriod [#type "evening1" ! "ахшамүстү"] 
                                dayPeriod [#type "night1" ! "ахшам"] 
                                dayPeriod [#type "night2" ! "ҝеҹә"]
                            ] 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "midnight" ! "ҝеҹәјары"] 
                                dayPeriod [#type "noon" ! "ҝүнорта"] 
                                dayPeriod [#type "morning1" ! "сүбһ"] 
                                dayPeriod [#type "morning2" ! "сәһәр"] 
                                dayPeriod [#type "afternoon1" ! "ҝүндүз"] 
                                dayPeriod [#type "evening1" ! "ахшамүстү"] 
                                dayPeriod [#type "night1" ! "ахшам"] 
                                dayPeriod [#type "night2" ! "ҝеҹә"]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "midnight" ! "ҝеҹәјары"] 
                                dayPeriod [#type "am" ! "АМ"] 
                                dayPeriod [#type "noon" ! "ҝүнорта"] 
                                dayPeriod [#type "pm" ! "ПМ"] 
                                dayPeriod [#type "morning1" ! "сүбһ"] 
                                dayPeriod [#type "morning2" ! "сәһәр"] 
                                dayPeriod [#type "afternoon1" ! "ҝүндүз"] 
                                dayPeriod [#type "evening1" ! "ахшамүстү"] 
                                dayPeriod [#type "night1" ! "ахшам"] 
                                dayPeriod [#type "night2" ! "ҝеҹә"]
                            ]
                        ]
                    ] 
                    eras [
                        eraNames [
                            era [#type "0" ! "ерамыздан әввәл"] 
                            era [#type "0" #alt "variant" ! "бизим ерадан әввәл"] 
                            era [#type "1" ! "јени ера"] 
                            era [#type "1" #alt "variant" ! "бизим ера"]
                        ] 
                        eraAbbr [
                            era [#type "0" ! "е.ә."] 
                            era [#type "0" #alt "variant" ! "б.е.ә."] 
                            era [#type "1" ! "ј.е."] 
                            era [#type "1" #alt "variant" ! "б.е."]
                        ]
                    ] 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
                            dateFormat [
                                pattern [! "d MMMM y, EEEE"] 
                                datetimeSkeleton [! "yMMMMEEEEd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [! "d MMMM y"] 
                                datetimeSkeleton [! "yMMMMd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "medium" 
                            dateFormat [
                                pattern [! "d MMM y"] 
                                datetimeSkeleton [! "yMMMd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "short" 
                            dateFormat [
                                pattern [! "dd.MM.yy"] 
                                datetimeSkeleton [! "yyMMdd"]
                            ]
                        ]
                    ] 
                    timeFormats [
                        timeFormatLength [
                            #type "full" 
                            timeFormat [
                                pattern [! "HH:mm:ss zzzz"] 
                                datetimeSkeleton [! "HHmmsszzzz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "long" 
                            timeFormat [
                                pattern [! "HH:mm:ss z"] 
                                datetimeSkeleton [! "HHmmssz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "medium" 
                            timeFormat [
                                pattern [! "HH:mm:ss"] 
                                datetimeSkeleton [! "HHmmss"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "short" 
                            timeFormat [
                                pattern [! "HH:mm"] 
                                datetimeSkeleton [! "HHmm"]
                            ]
                        ]
                    ] 
                    dateTimeFormats [
                        availableFormats [
                            dateFormatItem [#id "Ed" ! "d E"] 
                            dateFormatItem [#id "GyMMM" ! "G MMM y"] 
                            dateFormatItem [#id "GyMMMd" ! "G d MMM y"] 
                            dateFormatItem [#id "GyMMMEd" ! "G d MMM y, E"] 
                            dateFormatItem [#id "Md" ! "dd.MM"] 
                            dateFormatItem [#id "MEd" ! "dd.MM, E"] 
                            dateFormatItem [#id "MMM" ! "LLL"] 
                            dateFormatItem [#id "MMMd" ! "d MMM"] 
                            dateFormatItem [#id "MMMEd" ! "d MMM, E"] 
                            dateFormatItem [#id "MMMMW" #count "one" ! "MMMM, W 'һәфтә'"] 
                            dateFormatItem [#id "MMMMW" #count "other" ! "MMMM, W 'һәфтә'"] 
                            dateFormatItem [#id "yM" ! "MM.y"] 
                            dateFormatItem [#id "yMd" ! "dd.MM.y"] 
                            dateFormatItem [#id "yMEd" ! "dd.MM.y, E"] 
                            dateFormatItem [#id "yMMM" ! "MMM, y"] 
                            dateFormatItem [#id "yMMMd" ! "d MMM y"] 
                            dateFormatItem [#id "yMMMEd" ! "d MMM y, E"] 
                            dateFormatItem [#id "yw" #count "one" ! "Y, w 'һәфтә'"] 
                            dateFormatItem [#id "yw" #count "other" ! "Y, w 'һәфтә'"]
                        ] 
                        intervalFormats [
                            intervalFormatItem [
                                #id "Md" 
                                greatestDifference [#id "d" ! "dd.MM – dd.MM"] 
                                greatestDifference [#id "M" ! "dd.MM – dd.MM"]
                            ] 
                            intervalFormatItem [
                                #id "MEd" 
                                greatestDifference [#id "d" ! "dd.MM, E – dd.MM, E"] 
                                greatestDifference [#id "M" ! "dd.MM, E – dd.MM, E"]
                            ] 
                            intervalFormatItem [
                                #id "MMMd" 
                                greatestDifference [#id "d" ! "d–d MMM"] 
                                greatestDifference [#id "M" ! "d MMM – d MMM"]
                            ] 
                            intervalFormatItem [
                                #id "MMMEd" 
                                greatestDifference [#id "d" ! "d MMM, E – d MMM, E"] 
                                greatestDifference [#id "M" ! "d MMM, E – d MMM, E"]
                            ] 
                            intervalFormatItem [
                                #id "yM" 
                                greatestDifference [#id "M" ! "MM.y – MM.y"] 
                                greatestDifference [#id "y" ! "MM.y – MM.y"]
                            ] 
                            intervalFormatItem [
                                #id "yMd" 
                                greatestDifference [#id "d" ! "dd.MM.y – dd.MM.y"] 
                                greatestDifference [#id "M" ! "dd.MM.y – dd.MM.y"] 
                                greatestDifference [#id "y" ! "dd.MM.y – dd.MM.y"]
                            ] 
                            intervalFormatItem [
                                #id "yMEd" 
                                greatestDifference [#id "d" ! "dd.MM.y, E – dd.MM.y, E"] 
                                greatestDifference [#id "M" ! "dd.MM.y, E – dd.MM.y, E"] 
                                greatestDifference [#id "y" ! "dd.MM.y, E – dd.MM.y, E"]
                            ] 
                            intervalFormatItem [
                                #id "yMMM" 
                                greatestDifference [#id "M" ! "MMM – MMM y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMd" 
                                greatestDifference [#id "d" ! "y MMM d–d"] 
                                greatestDifference [#id "M" ! "d MMM y – d MMM"] 
                                greatestDifference [#id "y" ! "d MMM y – d MMM y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMEd" 
                                greatestDifference [#id "d" ! "d MMM y, E – d MMM, E"] 
                                greatestDifference [#id "M" ! "d MMM y, E – d MMM, E"] 
                                greatestDifference [#id "y" ! "d MMM y, E – d MMM y, E"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMM" 
                                greatestDifference [#id "M" ! "MMMM – MMMM y"] 
                                greatestDifference [#id "y" ! "MMMM y – MMMM y"]
                            ]
                        ]
                    ]
                ]
            ]
        ] 
        numbers [
            symbols [
                #numberSystem "latn" 
                decimal [#draft "contributed" ! ","] 
                group [#draft "contributed" ! "."] 
                list [#draft "contributed" ! ";"] 
                percentSign [! "%"] 
                plusSign [#draft "contributed" ! "+"] 
                minusSign [#draft "contributed" ! "-"] 
                exponential [! "E"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [#draft "contributed" ! "#,##0.###"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "#,##0.00 ¤"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "#,##0.00 ¤"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "one" #draft "provisional" ! "0K ¤"] 
                        pattern [#type "1000" #count "other" #draft "provisional" ! "0K ¤"] 
                        pattern [#type "10000" #count "one" #draft "provisional" ! "00K ¤"] 
                        pattern [#type "10000" #count "other" #draft "provisional" ! "00K ¤"] 
                        pattern [#type "100000" #count "one" #draft "provisional" ! "000K ¤"] 
                        pattern [#type "100000" #count "other" #draft "provisional" ! "000K ¤"] 
                        pattern [#type "1000000" #count "one" #draft "provisional" ! "0M ¤"] 
                        pattern [#type "1000000" #count "other" #draft "provisional" ! "0M ¤"] 
                        pattern [#type "10000000" #count "one" #draft "provisional" ! "00M ¤"] 
                        pattern [#type "10000000" #count "other" #draft "provisional" ! "00M ¤"] 
                        pattern [#type "100000000" #count "one" #draft "provisional" ! "000M ¤"] 
                        pattern [#type "100000000" #count "other" #draft "provisional" ! "000M ¤"] 
                        pattern [#type "1000000000" #count "one" #draft "provisional" ! "0G ¤"] 
                        pattern [#type "1000000000" #count "other" #draft "provisional" ! "0G ¤"] 
                        pattern [#type "10000000000" #count "one" #draft "provisional" ! "00G ¤"] 
                        pattern [#type "10000000000" #count "other" #draft "provisional" ! "00G ¤"] 
                        pattern [#type "100000000000" #count "one" #draft "provisional" ! "000G ¤"] 
                        pattern [#type "100000000000" #count "other" #draft "provisional" ! "000G ¤"] 
                        pattern [#type "1000000000000" #count "one" #draft "provisional" ! "0T ¤"] 
                        pattern [#type "1000000000000" #count "other" #draft "provisional" ! "0T ¤"] 
                        pattern [#type "10000000000000" #count "one" #draft "provisional" ! "00T ¤"] 
                        pattern [#type "10000000000000" #count "other" #draft "provisional" ! "00T ¤"] 
                        pattern [#type "100000000000000" #count "one" #draft "provisional" ! "000T ¤"] 
                        pattern [#type "100000000000000" #count "other" #draft "provisional" ! "000T ¤"]
                    ]
                ]
            ] 
            currencies [
                currency [
                    #type "AZN" 
                    displayName [#draft "unconfirmed" ! "манат"] 
                    symbol [! "₼"] 
                    symbol [#alt "variant" ! "ман."]
                ]
            ]
        ]
    ]

