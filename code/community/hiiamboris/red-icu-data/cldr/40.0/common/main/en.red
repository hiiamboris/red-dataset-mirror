            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##0.00"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "¤#,##0.00;(¤#,##0.00)"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "one" ! "¤0K"] 
                        pattern [#type "1000" #count "other" ! "¤0K"] 
                        pattern [#type "10000" #count "one" ! "¤00K"] 
                        pattern [#type "10000" #count "other" ! "¤00K"] 
