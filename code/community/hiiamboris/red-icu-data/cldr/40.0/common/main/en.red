        numbers [
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 thousand"] 
                        pattern [#type "1000" #count "other" ! "0 thousand"] 
                        pattern [#type "10000" #count "one" ! "00 thousand"] 
                        pattern [#type "10000" #count "other" ! "00 thousand"] 
                        pattern [#type "100000" #count "one" ! "000 thousand"] 
                        pattern [#type "100000" #count "other" ! "000 thousand"] 
                        pattern [#type "1000000" #count "one" ! "0 million"] 
                        pattern [#type "1000000" #count "other" ! "0 million"] 
                        pattern [#type "10000000" #count "one" ! "00 million"] 
                        pattern [#type "10000000" #count "other" ! "00 million"] 
                        pattern [#type "100000000" #count "one" ! "000 million"] 
                        pattern [#type "100000000" #count "other" ! "000 million"] 
                        pattern [#type "1000000000" #count "one" ! "0 billion"] 
                        pattern [#type "1000000000" #count "other" ! "0 billion"] 
                        pattern [#type "10000000000" #count "one" ! "00 billion"] 
                        pattern [#type "10000000000" #count "other" ! "00 billion"] 
                        pattern [#type "100000000000" #count "one" ! "000 billion"] 
                        pattern [#type "100000000000" #count "other" ! "000 billion"] 
                        pattern [#type "1000000000000" #count "one" ! "0 trillion"] 
                        pattern [#type "1000000000000" #count "other" ! "0 trillion"] 
                        pattern [#type "10000000000000" #count "one" ! "00 trillion"] 
                        pattern [#type "10000000000000" #count "other" ! "00 trillion"] 
                        pattern [#type "100000000000000" #count "one" ! "000 trillion"] 
                        pattern [#type "100000000000000" #count "other" ! "000 trillion"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0K"] 
                        pattern [#type "1000" #count "other" ! "0K"] 
                        pattern [#type "10000" #count "one" ! "00K"] 
                        pattern [#type "10000" #count "other" ! "00K"] 
                        pattern [#type "100000" #count "one" ! "000K"] 
                        pattern [#type "100000" #count "other" ! "000K"] 
                        pattern [#type "1000000" #count "one" ! "0M"] 
                        pattern [#type "1000000" #count "other" ! "0M"] 
                        pattern [#type "10000000" #count "one" ! "00M"] 
                        pattern [#type "10000000" #count "other" ! "00M"] 
                        pattern [#type "100000000" #count "one" ! "000M"] 
                        pattern [#type "100000000" #count "other" ! "000M"] 
                        pattern [#type "1000000000" #count "one" ! "0B"] 
                        pattern [#type "1000000000" #count "other" ! "0B"] 
                        pattern [#type "10000000000" #count "one" ! "00B"] 
                        pattern [#type "10000000000" #count "other" ! "00B"] 
                        pattern [#type "100000000000" #count "one" ! "000B"] 
                        pattern [#type "100000000000" #count "other" ! "000B"] 
                        pattern [#type "1000000000000" #count "one" ! "0T"] 
                        pattern [#type "1000000000000" #count "other" ! "0T"] 
                        pattern [#type "10000000000000" #count "one" ! "00T"] 
                        pattern [#type "10000000000000" #count "other" ! "00T"] 
                        pattern [#type "100000000000000" #count "one" ! "000T"] 
                        pattern [#type "100000000000000" #count "other" ! "000T"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
