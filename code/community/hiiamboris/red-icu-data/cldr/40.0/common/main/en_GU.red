
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "en"] 
            territory [#type "GU"]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "Chamorro" 
                    short [
                        standard [! "ChST"]
                    ]
                ]
            ]
        ]
    ]

