        numbers [
            symbols [
                #numberSystem "latn" 
                approximatelySign [! "≈"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000000" #count "one" ! "0 million"] 
                        pattern [#type "1000000" #count "other" ! "0 millionar"] 
                        pattern [#type "10000000" #count "one" ! "00 million"] 
                        pattern [#type "10000000" #count "other" ! "00 millionar"] 
                        pattern [#type "100000000" #count "one" ! "000 million"] 
                        pattern [#type "100000000" #count "other" ! "000 millionar"] 
                        pattern [#type "1000000000" #count "one" ! "0 milliard"] 
                        pattern [#type "1000000000" #count "other" ! "0 milliardar"] 
                        pattern [#type "10000000000" #count "one" ! "00 milliard"] 
                        pattern [#type "10000000000" #count "other" ! "00 milliardar"] 
                        pattern [#type "100000000000" #count "one" ! "000 milliard"] 
                        pattern [#type "100000000000" #count "other" ! "000 milliardar"] 
                        pattern [#type "1000000000000" #count "one" ! "0 billion"] 
                        pattern [#type "1000000000000" #count "other" ! "0 billionar"] 
                        pattern [#type "10000000000000" #count "one" ! "00 billion"] 
                        pattern [#type "10000000000000" #count "other" ! "00 billionar"] 
                        pattern [#type "100000000000000" #count "one" ! "000 billion"] 
                        pattern [#type "100000000000000" #count "other" ! "000 billionar"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "#,##0.00 ¤"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "#,##0.00 ¤"]
                    ]
                ]
            ] 
            currencies [
                currency [
                    #type "ADP" 
                    displayName [! "andorranske peseta"]
                ] 
                currency [
                    #type "AFA" 
                    displayName [! "afghani (1927–2002)"]
                ] 
                currency [
                    #type "AOK" 
                    displayName [! "angolske kwanza (1977–1990)"]
                ] 
                currency [
                    #type "AON" 
                    displayName [! "angolske nye kwanza (1990–2000)"]
                ] 
                currency [
