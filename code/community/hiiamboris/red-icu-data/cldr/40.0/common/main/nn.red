        characters [
            exemplarCharacters [#type "auxiliary" ! "[á ǎ č ç đ è ê ń ñ ŋ š ŧ ü ž ä ö]"] 
            exemplarCharacters [#type "punctuation" #draft "contributed" ! {[\- ‐ ‑ – — , ; \: ! ? . … ' ‘ ’ &quot; “ ” ( ) \[ \] § @ * / \&amp; # † ‡ ′ ″]}]
        ] 
        dates [
            calendars [
                calendar [
                    #type "generic" 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
                            dateFormat [
                                pattern [! "EEEE d. MMMM y G"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [! "d. MMMM y G"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "medium" 
                            dateFormat [
                                pattern [! "d. MMM y G"]
                            ]
                        ] 
                        dateFormatLength [
