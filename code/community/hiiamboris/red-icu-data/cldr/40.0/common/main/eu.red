        numbers [
            symbols [
                #numberSystem "arab" 
                percentSign [! "٪؜"] 
                plusSign [#draft "contributed" ! "+"] 
                minusSign [#draft "contributed" ! "-"]
            ] 
            symbols [
                #numberSystem "arabext" 
                plusSign [#draft "contributed" ! "‎+‎"] 
                minusSign [#draft "contributed" ! "‎-‎"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                list [! ";"] 
                percentSign [! "%"] 
                minusSign [! "−"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0"] 
                        pattern [#type "1000" #count "other" ! "0"] 
                        pattern [#type "10000" #count "one" ! "0"] 
                        pattern [#type "10000" #count "other" ! "0"] 
                        pattern [#type "100000" #count "one" ! "0"] 
