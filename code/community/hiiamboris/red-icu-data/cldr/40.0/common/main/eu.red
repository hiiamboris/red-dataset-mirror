                        pattern [#type "10000000" #count "other" ! "00 milioi"] 
                        pattern [#type "100000000" #count "one" ! "000 milioi"] 
                        pattern [#type "100000000" #count "other" ! "000 milioi"] 
                        pattern [#type "1000000000" #count "one" ! "0000 milioi"] 
                        pattern [#type "1000000000" #count "other" ! "0000 milioi"] 
                        pattern [#type "10000000000" #count "one" ! "00000 milioi"] 
                        pattern [#type "10000000000" #count "other" ! "00000 milioi"] 
                        pattern [#type "100000000000" #count "one" ! "000000 milioi"] 
                        pattern [#type "100000000000" #count "other" ! "000000 milioi"] 
                        pattern [#type "1000000000000" #count "one" ! "0 bilioi"] 
                        pattern [#type "1000000000000" #count "other" ! "0 bilioi"] 
                        pattern [#type "10000000000000" #count "one" ! "00 bilioi"] 
                        pattern [#type "10000000000000" #count "other" ! "00 bilioi"] 
                        pattern [#type "100000000000000" #count "one" ! "000 bilioi"] 
                        pattern [#type "100000000000000" #count "other" ! "000 bilioi"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0"] 
                        pattern [#type "1000" #count "other" ! "0"] 
                        pattern [#type "10000" #count "one" ! "0"] 
                        pattern [#type "10000" #count "other" ! "0"] 
                        pattern [#type "100000" #count "one" ! "0"] 
                        pattern [#type "100000" #count "other" ! "0"] 
                        pattern [#type "1000000" #count "one" ! "0 M"] 
                        pattern [#type "1000000" #count "other" ! "0 M"] 
                        pattern [#type "10000000" #count "one" ! "00 M"] 
                        pattern [#type "10000000" #count "other" ! "00 M"] 
                        pattern [#type "100000000" #count "one" ! "000 M"] 
                        pattern [#type "100000000" #count "other" ! "000 M"] 
                        pattern [#type "1000000000" #count "one" ! "0000 M"] 
                        pattern [#type "1000000000" #count "other" ! "0000 M"] 
                        pattern [#type "10000000000" #count "one" ! "00000 M"] 
                        pattern [#type "10000000000" #count "other" ! "00000 M"] 
                        pattern [#type "100000000000" #count "one" ! "000000 M"] 
                        pattern [#type "100000000000" #count "other" ! "000000 M"] 
                        pattern [#type "1000000000000" #count "one" ! "0 B"] 
