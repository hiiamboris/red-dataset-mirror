
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "pt"] 
            territory [#type "AO"]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "Azores" 
                    short [
                        generic [! "∅∅∅"] 
                        standard [! "∅∅∅"] 
                        daylight [! "∅∅∅"]
                    ]
                ] 
                metazone [
                    #type "Europe_Central" 
                    short [
                        generic [! "∅∅∅"] 
                        standard [! "∅∅∅"] 
                        daylight [! "∅∅∅"]
                    ]
                ] 
                metazone [
                    #type "Europe_Eastern" 
                    short [
                        generic [! "∅∅∅"] 
                        standard [! "∅∅∅"] 
                        daylight [! "∅∅∅"]
                    ]
                ] 
                metazone [
                    #type "Europe_Western" 
                    short [
                        generic [! "∅∅∅"] 
                        standard [! "∅∅∅"] 
                        daylight [! "∅∅∅"]
                    ]
                ]
            ]
        ] 
        numbers [
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            currencies [
                currency [
                    #type "AOA" 
                    symbol [! "Kz"]
                ]
            ]
        ]
    ]

