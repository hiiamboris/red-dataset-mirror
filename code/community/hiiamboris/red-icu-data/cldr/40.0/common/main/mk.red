                    #type "volume-pint" 
                    displayName [! "pt"]
                ] 
                unit [
                    #type "volume-cup" 
                    displayName [! "чаша"]
                ] 
                unit [
                    #type "volume-fluid-ounce" 
                    unitPattern [#count "one" ! "{0} fl oz"] 
                    unitPattern [#count "other" ! "{0} fl oz"]
                ] 
                unit [
                    #type "volume-fluid-ounce-imperial" 
                    displayName [! "Imp fl oz"] 
                    unitPattern [#count "one" ! "{0} fl oz Im"] 
                    unitPattern [#count "other" ! "{0} fl oz Im"]
                ] 
                unit [
                    #type "volume-dessert-spoon" 
                    displayName [! "dsp"] 
                    unitPattern [#count "one" ! "{0} dsp"] 
                    unitPattern [#count "other" ! "{0} dsp"]
                ] 
                unit [
                    #type "volume-dessert-spoon-imperial" 
                    displayName [! "dsp Imp"] 
                    unitPattern [#count "one" ! "{0} dsp-Imp"] 
                    unitPattern [#count "other" ! "{0} dsp-Imp"]
                ] 
                unit [
                    #type "volume-drop" 
                    displayName [! "dr"] 
                    unitPattern [#count "one" ! "{0} dr"] 
                    unitPattern [#count "other" ! "{0} dr"]
                ] 
                unit [
                    #type "volume-dram" 
                    displayName [! "fl.dr."] 
                    unitPattern [#count "one" ! "{0} fl.dr."] 
                    unitPattern [#count "other" ! "{0} fl.dr."]
                ] 
                unit [
                    #type "volume-pinch" 
                    displayName [! "pn"] 
                    unitPattern [#count "one" ! "{0} pn"] 
                    unitPattern [#count "other" ! "{0} pn"]
                ] 
                unit [
                    #type "volume-quart-imperial" 
                    unitPattern [#count "one" ! "{0} qt-Imp."] 
                    unitPattern [#count "other" ! "{0} qt-Imp."]
                ] 
                coordinateUnit [
                    displayName [! "насока"] 
                    coordinateUnitPattern [#type "east" ! "{0}И"] 
                    coordinateUnitPattern [#type "north" ! "{0}С"] 
                    coordinateUnitPattern [#type "south" ! "{0}Ј"] 
                    coordinateUnitPattern [#type "west" ! "{0}З"]
                ]
            ] 
            durationUnit [
                #type "hm" 
                durationUnitPattern [! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} и {1}"] 
                listPatternPart [#type "2" ! "{0} и {1}"]
            ] 
            listPattern [
                #type "or" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} или {1}"] 
                listPatternPart [#type "2" ! "{0} или {1}"]
            ] 
            listPattern [
                #type "standard-narrow" 
                listPatternPart [#type "2" ! "{0} и {1}"]
            ] 
            listPattern [
                #type "standard-short" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} и {1}"] 
                listPatternPart [#type "2" ! "{0} и {1}"]
