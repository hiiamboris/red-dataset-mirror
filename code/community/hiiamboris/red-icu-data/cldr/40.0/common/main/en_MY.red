
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "en"] 
            territory [#type "MY"]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "Malaysia" 
                    short [
                        standard [! "MYT"]
                    ]
                ]
            ]
        ] 
        numbers [
            currencies [
                currency [
                    #type "MYR" 
                    symbol [! "RM"]
                ]
            ]
        ]
    ]

