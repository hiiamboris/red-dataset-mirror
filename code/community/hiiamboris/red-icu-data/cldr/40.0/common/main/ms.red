            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "arabext" 
                decimal [#draft "contributed" ! "."]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                list [#draft "contributed" ! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0 ribu"] 
                        pattern [#type "10000" #count "other" ! "00 ribu"] 
                        pattern [#type "100000" #count "other" ! "000 ribu"] 
                        pattern [#type "1000000" #count "other" ! "0 juta"] 
                        pattern [#type "10000000" #count "other" ! "00 juta"] 
                        pattern [#type "100000000" #count "other" ! "000 juta"] 
                        pattern [#type "1000000000" #count "other" ! "0 bilion"] 
                        pattern [#type "10000000000" #count "other" ! "00 bilion"] 
                        pattern [#type "100000000000" #count "other" ! "000 bilion"] 
                        pattern [#type "1000000000000" #count "other" ! "0 trilion"] 
                        pattern [#type "10000000000000" #count "other" ! "00 trilion"] 
                        pattern [#type "100000000000000" #count "other" ! "000 trilion"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0K"] 
                        pattern [#type "10000" #count "other" ! "00K"] 
                        pattern [#type "100000" #count "other" ! "000K"] 
                        pattern [#type "1000000" #count "other" ! "0J"] 
                        pattern [#type "10000000" #count "other" ! "00J"] 
                        pattern [#type "100000000" #count "other" ! "000J"] 
                        pattern [#type "1000000000" #count "other" ! "0B"] 
                        pattern [#type "10000000000" #count "other" ! "00B"] 
                        pattern [#type "100000000000" #count "other" ! "000B"] 
                        pattern [#type "1000000000000" #count "other" ! "0T"] 
                        pattern [#type "10000000000000" #count "other" ! "00T"] 
                        pattern [#type "100000000000000" #count "other" ! "000T"]
                    ]
                ]
            ] 
