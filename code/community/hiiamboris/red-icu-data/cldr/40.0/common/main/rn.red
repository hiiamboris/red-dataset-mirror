                                month [#type "11" ! "Munyonyo"] 
                                month [#type "12" ! "Kigarama"]
                            ]
                        ]
                    ] 
                    days [
                        dayContext [
                            #type "format" 
                            dayWidth [
                                #type "abbreviated" 
                                day [#type "sun" ! "cu."] 
                                day [#type "mon" ! "mbe."] 
                                day [#type "tue" ! "kab."] 
                                day [#type "wed" ! "gtu."] 
                                day [#type "thu" ! "kan."] 
                                day [#type "fri" ! "gnu."] 
                                day [#type "sat" ! "gnd."]
                            ] 
                            dayWidth [
                                #type "wide" 
                                day [#type "sun" ! "Ku w’indwi"] 
                                day [#type "mon" ! "Ku wa mbere"] 
                                day [#type "tue" ! "Ku wa kabiri"] 
                                day [#type "wed" ! "Ku wa gatatu"] 
