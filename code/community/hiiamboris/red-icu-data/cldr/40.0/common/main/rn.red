                                quarter [#type "2" ! "I2"] 
                                quarter [#type "3" ! "I3"] 
                                quarter [#type "4" ! "I4"]
                            ] 
                            quarterWidth [
                                #type "wide" 
                                quarter [#type "1" ! "Igice ca mbere c’umwaka"] 
                                quarter [#type "2" ! "Igice ca kabiri c’umwaka"] 
                                quarter [#type "3" ! "Igice ca gatatu c’umwaka"] 
                                quarter [#type "4" ! "Igice ca kane c’umwaka"]
                            ]
                        ]
                    ] 
                    dayPeriods [
                        dayPeriodContext [
                            #type "format" 
                            dayPeriodWidth [
                                #type "abbreviated" 
                                dayPeriod [#type "am" ! "Z.MU."] 
                                dayPeriod [#type "pm" ! "Z.MW."]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "am" ! "Z.MU."] 
                                dayPeriod [#type "pm" ! "Z.MW."]
                            ]
                        ]
                    ] 
                    eras [
                        eraNames [
                            era [#type "0" ! "Mbere ya Yezu"] 
                            era [#type "1" ! "Nyuma ya Yezu"]
                        ] 
                        eraAbbr [
                            era [#type "0" ! "Mb.Y."] 
                            era [#type "1" ! "Ny.Y"]
                        ]
                    ] 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
                            dateFormat [
                                pattern [! "EEEE d MMMM y"] 
                                datetimeSkeleton [! "yMMMMEEEEd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [! "d MMMM y"] 
                                datetimeSkeleton [! "yMMMMd"]
                            ]
                        ] 
                        dateFormatLength [
