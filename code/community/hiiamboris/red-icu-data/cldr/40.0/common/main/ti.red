                listPatternPart [#type "end" ! "{0}ን {1}ን"] 
                listPatternPart [#type "2" ! "{0}ን {1}ን"]
            ] 
            listPattern [
                #type "or" 
                listPatternPart [#type "start" ! "{0}፣ {1}"] 
                listPatternPart [#type "middle" ! "{0}፣ {1}"] 
                listPatternPart [#type "end" ! "{0} ወይ {1}"] 
