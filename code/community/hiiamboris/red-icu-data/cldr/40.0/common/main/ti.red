                    displayName [#count "other" ! "ዩዋን ቻይና"] 
                    symbol [#draft "contributed" ! "CNY"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "ERN" 
                    displayName [! "ናቕፋ"] 
                    displayName [#count "one" ! "ናቕፋ"] 
                    displayName [#count "other" ! "ናቕፋ"] 
                    symbol [#draft "contributed" ! "ERN"]
                ] 
                currency [
                    #type "ETB" 
                    displayName [! "ብር"] 
                    displayName [#count "one" ! "ብር"] 
                    displayName [#count "other" ! "ብር"] 
                    symbol [! "Br"]
                ] 
                currency [
                    #type "EUR" 
                    displayName [! "ዩሮ"] 
                    displayName [#count "one" ! "ዩሮ"] 
                    displayName [#count "other" ! "ዩሮ"] 
                    symbol [#draft "contributed" ! "€"] 
                    symbol [#alt "narrow" #draft "contributed" ! "€"]
                ] 
                currency [
                    #type "GBP" 
                    displayName [! "የእንግሊዝ ፓውንድ ስተርሊንግ"]
                ] 
                currency [
                    #type "INR" 
                    displayName [! "የሕንድ ሩፒ"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [! "የን ጃፓን"] 
                    displayName [#count "one" ! "የን ጃፓን"] 
                    displayName [#count "other" ! "የን ጃፓን"] 
                    symbol [#draft "contributed" ! "JPY"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "RUB" 
                    displayName [! "የራሻ ሩብል"]
                ] 
                currency [
                    #type "USD" 
                    displayName [! "ዶላር ኣመሪካ"] 
                    displayName [#count "one" ! "ዶላር ኣመሪካ"] 
                    displayName [#count "other" ! "ዶላር ኣመሪካ"] 
                    symbol [#draft "contributed" ! "US$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "$"]
                ] 
                currency [
                    #type "XAG" 
                    displayName [! "ብሩር"] 
                    displayName [#count "one" ! "ብሩር"] 
                    displayName [#count "other" ! "ብሩር"]
                ] 
                currency [
                    #type "XAU" 
                    displayName [! "ወርቂ"] 
                    displayName [#count "one" ! "ወርቂ"] 
                    displayName [#count "other" ! "ወርቂ"]
                ] 
                currency [
                    #type "XXX" 
                    displayName [! "ዘይተፈልጠ ባጤራ"] 
                    displayName [#count "one" ! "(ዘይተፈልጠ ባጤራ)"] 
                    displayName [#count "other" ! "(ዘይተፈልጠ ባጤራ)"]
                ]
            ] 
            miscPatterns [
                #numberSystem "latn" 
                pattern [#type "approximately" ! "~{0}"] 
                pattern [#type "atLeast" ! "⩾{0}"] 
                pattern [#type "atMost" ! "≤{0}"] 
                pattern [#type "range" ! "{0}–{1}"]
            ] 
            minimalPairs [
                pluralMinimalPairs [#count "one" #draft "contributed" ! "{0} መዓልቲ"] 
                pluralMinimalPairs [#count "other" #draft "contributed" ! "{0} መዓልታት"]
            ]
        ] 
        units [
            unitLength [
                #type "long" 
                unit [
                    #type "duration-century" 
                    displayName [! "ዘመናት"] 
                    unitPattern [#count "one" ! "{0} ዘመን"] 
                    unitPattern [#count "other" ! "{0} ዘመናት"]
                ] 
                unit [
                    #type "duration-decade" 
                    displayName [! "ዓሰርተታት ዓመታት"] 
                    unitPattern [#count "one" ! "{0} ዓሰርተ ዓመት"] 
                    unitPattern [#count "other" ! "{0} ዓሰርተታት ዓመታት"]
                ] 
                unit [
                    #type "duration-year" 
                    displayName [! "ዓመታት"]
                ]
            ] 
            unitLength [
                #type "short" 
                unit [
                    #type "duration-century" 
                    displayName [! "ዘመን"] 
