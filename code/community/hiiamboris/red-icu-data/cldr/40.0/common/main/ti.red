        ] 
        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"] 
                traditional [! "ethi"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                approximatelySign [! "~"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 ሽሕ"] 
                        pattern [#type "1000" #count "other" ! "0 ሽሕ"] 
                        pattern [#type "10000" #count "one" ! "00 ሽሕ"] 
                        pattern [#type "10000" #count "other" ! "00 ሽሕ"] 
                        pattern [#type "100000" #count "one" ! "000 ሽሕ"] 
                        pattern [#type "100000" #count "other" ! "000 ሽሕ"] 
                        pattern [#type "1000000" #count "one" ! "0 ሚልዮን"] 
                        pattern [#type "1000000" #count "other" ! "0 ሚልዮን"] 
                        pattern [#type "10000000" #count "one" ! "00 ሚልዮን"] 
                        pattern [#type "10000000" #count "other" ! "00 ሚልዮን"] 
                        pattern [#type "100000000" #count "one" ! "000 ሚልዮን"] 
                        pattern [#type "100000000" #count "other" ! "000 ሚልዮን"] 
                        pattern [#type "1000000000" #count "one" ! "0 ቢልዮን"] 
                        pattern [#type "1000000000" #count "other" ! "0 ቢልዮን"] 
                        pattern [#type "10000000000" #count "one" ! "00 ቢልዮን"] 
                        pattern [#type "10000000000" #count "other" ! "00 ቢልዮን"] 
                        pattern [#type "100000000000" #count "one" ! "000 ቢልዮን"] 
                        pattern [#type "100000000000" #count "other" ! "000 ቢልዮን"] 
                        pattern [#type "1000000000000" #count "one" ! "0 ትሪልዮን"] 
                        pattern [#type "1000000000000" #count "other" ! "0 ትሪልዮን"] 
                        pattern [#type "10000000000000" #count "one" ! "00 ትሪልዮን"] 
                        pattern [#type "10000000000000" #count "other" ! "00 ትሪልዮን"] 
                        pattern [#type "100000000000000" #count "one" ! "000 ትሪልዮን"] 
                        pattern [#type "100000000000000" #count "other" ! "000 ትሪልዮን"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 ሽ"] 
                        pattern [#type "1000" #count "other" ! "0 ሽ"] 
                        pattern [#type "10000" #count "one" ! "00 ሽ"] 
                        pattern [#type "10000" #count "other" ! "00 ሽ"] 
                        pattern [#type "100000" #count "one" ! "000 ሽ"] 
                        pattern [#type "100000" #count "other" ! "000 ሽ"] 
                        pattern [#type "1000000" #count "one" ! "0 ሚ"] 
                        pattern [#type "1000000" #count "other" ! "0 ሚ"] 
                        pattern [#type "10000000" #count "one" ! "00 ሚ"] 
                        pattern [#type "10000000" #count "other" ! "00 ሚ"] 
                        pattern [#type "100000000" #count "one" ! "000 ሚ"] 
                        pattern [#type "100000000" #count "other" ! "000 ሚ"] 
                        pattern [#type "1000000000" #count "one" ! "0 ቢ"] 
                        pattern [#type "1000000000" #count "other" ! "0 ቢ"] 
                        pattern [#type "10000000000" #count "one" ! "00 ቢ"] 
                        pattern [#type "10000000000" #count "other" ! "00 ቢ"] 
                        pattern [#type "100000000000" #count "one" ! "000 ቢ"] 
                        pattern [#type "100000000000" #count "other" ! "000 ቢ"] 
                        pattern [#type "1000000000000" #count "one" ! "0 ት"] 
                        pattern [#type "1000000000000" #count "other" ! "0 ት"] 
                        pattern [#type "10000000000000" #count "one" ! "00 ት"] 
                        pattern [#type "10000000000000" #count "other" ! "00 ት"] 
                        pattern [#type "100000000000000" #count "one" ! "000 ት"] 
                        pattern [#type "100000000000000" #count "other" ! "000 ት"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##0.00"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "¤#,##0.00"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "one" ! "¤0 ሽ"] 
                        pattern [#type "1000" #count "other" ! "¤0 ሽ"] 
                        pattern [#type "10000" #count "one" ! "¤00 ሽ"] 
                        pattern [#type "10000" #count "other" ! "¤00 ሽ"] 
                        pattern [#type "100000" #count "one" ! "¤000 ሽ"] 
                        pattern [#type "100000" #count "other" ! "¤000 ሽ"] 
                        pattern [#type "1000000" #count "one" ! "¤0 ሚ"] 
                        pattern [#type "1000000" #count "other" ! "¤0 ሚ"] 
                        pattern [#type "10000000" #count "one" ! "¤00 ሚ"] 
                        pattern [#type "10000000" #count "other" ! "¤00 ሚ"] 
                        pattern [#type "100000000" #count "one" ! "¤000 ሚ"] 
                        pattern [#type "100000000" #count "other" ! "¤000 ሚ"] 
                        pattern [#type "1000000000" #count "one" ! "¤0 ቢ"] 
                        pattern [#type "1000000000" #count "other" ! "¤0 ቢ"] 
                        pattern [#type "10000000000" #count "one" ! "¤00 ቢ"] 
                        pattern [#type "10000000000" #count "other" ! "¤00 ቢ"] 
                        pattern [#type "100000000000" #count "one" ! "¤000 ቢ"] 
                        pattern [#type "100000000000" #count "other" ! "¤000 ቢ"] 
                        pattern [#type "1000000000000" #count "one" ! "¤0 ት"] 
                        pattern [#type "1000000000000" #count "other" ! "¤0 ት"] 
                        pattern [#type "10000000000000" #count "one" ! "¤00 ት"] 
                        pattern [#type "10000000000000" #count "other" ! "¤00 ት"] 
                        pattern [#type "100000000000000" #count "one" ! "¤000 ት"] 
                        pattern [#type "100000000000000" #count "other" ! "¤000 ት"]
                    ]
                ] 
                unitPattern [#count "one" ! "{0} {1}"] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencies [
                currency [
                    #type "BMD" 
                    symbol [#alt "narrow" #draft "contributed" ! "$"]
                ] 
                currency [
                    #type "BRL" 
                    displayName [! "የብራዚል ሪል"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "ዩዋን ቻይና"] 
