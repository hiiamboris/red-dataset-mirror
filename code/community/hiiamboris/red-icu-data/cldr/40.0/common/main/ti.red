                        generic [! "ግዜ ፈርናንዶ ደ ኖሮንያ"] 
                        standard [! "ምዱብ ግዜ ፈርናንዶ ደ ኖሮንያ"] 
                        daylight [! "ግዜ ክረምቲ ፈርናንዶ ደ ኖሮንያ"]
                    ]
                ] 
                metazone [
                    #type "Paraguay" 
                    long [
                        generic [! "ግዜ ፓራጓይ"] 
                        standard [! "ምዱብ ግዜ ፓራጓይ"] 
                        daylight [! "ግዜ ክረምቲ ፓራጓይ"]
                    ]
                ] 
                metazone [
                    #type "Peru" 
                    long [
                        generic [! "ግዜ ፔሩ"] 
                        standard [! "ምዱብ ግዜ ፔሩ"] 
                        daylight [! "ግዜ ክረምቲ ፔሩ"]
                    ]
                ] 
                metazone [
                    #type "Reunion" 
                    long [
                        standard [! "ግዜ ርዩንየን"]
                    ]
                ] 
                metazone [
                    #type "Seychelles" 
                    long [
                        standard [! "ግዜ ሲሸልስ"]
                    ]
                ] 
                metazone [
                    #type "Singapore" 
                    long [
                        standard [! "ግዜ ሲንጋፖር"]
                    ]
                ] 
                metazone [
                    #type "South_Georgia" 
                    long [
                        standard [! "ግዜ ደቡብ ጆርጅያ"]
                    ]
                ] 
                metazone [
                    #type "Suriname" 
                    long [
                        standard [! "ግዜ ሱሪናም"]
                    ]
                ] 
                metazone [
                    #type "Uruguay" 
                    long [
                        generic [! "ግዜ ኡራጓይ"] 
                        standard [! "ምዱብ ግዜ ኡራጓይ"] 
                        daylight [! "ግዜ ክረምቲ ኡራጓይ"]
                    ]
                ] 
                metazone [
                    #type "Venezuela" 
                    long [
                        standard [! "ግዜ ቬኔዝዌላ"]
                    ]
                ]
