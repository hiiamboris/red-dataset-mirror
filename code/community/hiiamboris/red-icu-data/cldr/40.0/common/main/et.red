        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"]
            ] 
            minimumGroupingDigits [! "2"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! " "] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "−"] 
                approximatelySign [! "≈"] 
                exponential [! "×10^^"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 tuhat"] 
                        pattern [#type "1000" #count "other" ! "0 tuhat"] 
                        pattern [#type "10000" #count "one" ! "00 tuhat"] 
                        pattern [#type "10000" #count "other" ! "00 tuhat"] 
                        pattern [#type "100000" #count "one" ! "000 tuhat"] 
                        pattern [#type "100000" #count "other" ! "000 tuhat"] 
                        pattern [#type "1000000" #count "one" ! "0 miljon"] 
                        pattern [#type "1000000" #count "other" ! "0 miljonit"] 
                        pattern [#type "10000000" #count "one" ! "00 miljonit"] 
