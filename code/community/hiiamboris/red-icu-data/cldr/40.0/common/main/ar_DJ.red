
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ar"] 
            territory [#type "DJ"]
        ] 
        numbers [
            defaultNumberingSystem [! "arab"] 
            currencies [
                currency [
                    #type "DJF" 
                    symbol [! "Fdj"]
                ]
            ]
        ]
    ]

