                parseLenient [#sample "," ! "[,،٫、︐︑﹐﹑，､]"] 
                parseLenient [#sample "+" ! "[+⁺₊➕﬩﹢＋]"]
            ] 
            parseLenients [
                #scope "number" 
                #level "stricter" 
                parseLenient [#sample "," ! "[,٫︐﹐，]"] 
                parseLenient [#sample "." ! "[.․﹒．｡]"]
            ]
        ] 
