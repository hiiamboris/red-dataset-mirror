
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "sr"] 
            script [#type "Cyrl"] 
            territory [#type "XK"]
        ] 
        localeDisplayNames [
            languages [
                language [#type "bm" #draft "contributed" ! "бамананкан"] 
                language [#type "bn" #draft "contributed" ! "бангла"] 
                language [#type "ff" #draft "contributed" ! "фулах"] 
                language [#type "gsw" #draft "contributed" ! "швајцарски немачки"] 
                language [#type "ht" #draft "contributed" ! "хаићански креолски"] 
                language [#type "lo" #draft "contributed" ! "лаошки"] 
                language [#type "moh" #draft "contributed" ! "мохок"] 
                language [#type "nqo" #draft "contributed" ! "н’ко"] 
                language [#type "shi" #draft "contributed" ! "јужни шилха"] 
                language [#type "si" #draft "contributed" ! "синхалски"] 
                language [#type "tzm" #draft "contributed" ! "централноатласки тамашек"] 
                language [#type "xh" #draft "contributed" ! "исикоса"] 
                language [#type "zgh" #draft "contributed" ! "стандардни марокански тамашек"] 
                language [#type "zu" #draft "contributed" ! "исизулу"]
            ] 
            territories [
                territory [#type "CG" #draft "contributed" ! "Конго"] 
                territory [#type "CV" #draft "contributed" ! "Кабо Верде"] 
                territory [#type "CZ" #draft "contributed" ! "Чешка Република"] 
                territory [#type "HK" #draft "contributed" ! "САР Хонгконг"] 
                territory [#type "KN" #draft "contributed" ! "Свети Китс и Невис"] 
                territory [#type "MO" #draft "contributed" ! "САР Макао"] 
                territory [#type "PM" #draft "contributed" ! "Свети Пјер и Микелон"] 
                territory [#type "RE" #draft "contributed" ! "Реунион"] 
                territory [#type "UM" #draft "contributed" ! "Мања удаљена острва САД"] 
                territory [#type "VC" #draft "contributed" ! "Свети Винсент и Гренадини"]
            ]
        ] 
        dates [
            calendars [
                calendar [
                    #type "generic" 
                    dateTimeFormats [
                        intervalFormats [
                            intervalFormatItem [
                                #id "MMMEd" 
                                greatestDifference [#id "d" #draft "contributed" ! "E, d – E, d. MMM"] 
                                greatestDifference [#id "M" #draft "contributed" ! "E, d. MMM – E, d. MMM"]
                            ]
                        ]
                    ]
                ] 
                calendar [
                    #type "gregorian" 
                    months [
                        monthContext [
                            #type "format" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "јан"] 
                                month [#type "2" ! "феб"] 
                                month [#type "3" #draft "contributed" ! "март"] 
                                month [#type "4" ! "апр"] 
                                month [#type "5" #draft "contributed" ! "мај"] 
                                month [#type "6" #draft "contributed" ! "јун"] 
                                month [#type "7" #draft "contributed" ! "јул"] 
                                month [#type "8" ! "авг"] 
                                month [#type "9" ! "септ"] 
                                month [#type "10" ! "окт"] 
                                month [#type "11" ! "нов"] 
                                month [#type "12" ! "дец"]
                            ]
                        ] 
                        monthContext [
                            #type "stand-alone" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "јан"] 
                                month [#type "2" ! "феб"] 
                                month [#type "3" #draft "contributed" ! "март"] 
                                month [#type "4" ! "апр"] 
                                month [#type "5" #draft "contributed" ! "мај"] 
                                month [#type "6" #draft "contributed" ! "јун"] 
                                month [#type "7" #draft "contributed" ! "јул"] 
                                month [#type "8" ! "авг"] 
                                month [#type "9" ! "септ"] 
                                month [#type "10" ! "окт"] 
                                month [#type "11" ! "нов"] 
                                month [#type "12" ! "дец"]
                            ]
                        ]
                    ] 
                    dayPeriods [
                        dayPeriodContext [
                            #type "format" 
                            dayPeriodWidth [
                                #type "abbreviated" 
                                dayPeriod [#type "midnight" #draft "contributed" ! "поноћ"] 
                                dayPeriod [#type "noon" #draft "contributed" ! "подне"] 
                                dayPeriod [#type "morning1" #draft "contributed" ! "јутро"] 
                                dayPeriod [#type "afternoon1" #draft "contributed" ! "по под."] 
                                dayPeriod [#type "evening1" #draft "contributed" ! "увече"] 
                                dayPeriod [#type "night1" #draft "contributed" ! "ноћу"]
                            ] 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "midnight" #draft "contributed" ! "поноћ"] 
                                dayPeriod [#type "noon" #draft "contributed" ! "подне"] 
                                dayPeriod [#type "morning1" #draft "contributed" ! "јутро"] 
                                dayPeriod [#type "afternoon1" #draft "contributed" ! "по под."] 
                                dayPeriod [#type "evening1" #draft "contributed" ! "вече"] 
                                dayPeriod [#type "night1" #draft "contributed" ! "ноћ"]
                            ]
                        ] 
                        dayPeriodContext [
                            #type "stand-alone" 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "am" #draft "contributed" ! "a"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "p"]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]

