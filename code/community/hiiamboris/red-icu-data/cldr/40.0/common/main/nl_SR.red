
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "nl"] 
            territory [#type "SR"]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "Suriname" 
                    short [
                        standard [! "SRT"]
                    ]
                ]
            ]
        ] 
        numbers [
            currencies [
                currency [
                    #type "SRD" 
                    symbol [! "$"]
                ]
            ]
        ]
    ]

