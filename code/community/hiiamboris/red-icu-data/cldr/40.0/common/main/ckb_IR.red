
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ckb"] 
            territory [#type "IR"]
        ] 
        dates [
            calendars [
                calendar [
                    #type "gregorian" 
                    timeFormats [
                        timeFormatLength [
                            #type "full" 
                            timeFormat [
                                pattern [! "HH:mm:ss zzzz"] 
                                datetimeSkeleton [! "HHmmsszzzz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "long" 
                            timeFormat [
                                pattern [! "HH:mm:ss z"] 
                                datetimeSkeleton [! "HHmmssz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "medium" 
                            timeFormat [
                                pattern [! "HH:mm:ss"] 
                                datetimeSkeleton [! "HHmmss"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "short" 
                            timeFormat [
                                pattern [! "HH:mm"] 
                                datetimeSkeleton [! "HHmm"]
                            ]
                        ]
                    ]
                ] 
                calendar [
                    #type "persian" 
                    months [
                        monthContext [
                            #type "format" 
                            monthWidth [
                                #type "wide" 
                                month [#type "1" #draft "contributed" ! "خاکەلێوە"] 
                                month [#type "2" #draft "contributed" ! "گوڵان"] 
                                month [#type "3" #draft "contributed" ! "جۆزەردان"] 
                                month [#type "4" #draft "contributed" ! "پووشپەڕ"] 
                                month [#type "5" #draft "contributed" ! "گەلاوێژ"] 
                                month [#type "6" #draft "contributed" ! "خەرمانان"] 
                                month [#type "7" #draft "contributed" ! "ڕەزبەر"] 
                                month [#type "8" #draft "contributed" ! "گەڵاڕێزان"] 
                                month [#type "9" #draft "contributed" ! "سەرماوەز"] 
                                month [#type "10" #draft "contributed" ! "بەفرانبار"] 
                                month [#type "11" #draft "contributed" ! "ڕێبەندان"] 
                                month [#type "12" #draft "contributed" ! "ڕەشەمە"]
                            ]
                        ]
                    ] 
                    timeFormats [
                        timeFormatLength [
                            #type "full" 
                            timeFormat [
                                pattern [! "HH:mm:ss zzzz"] 
                                datetimeSkeleton [! "HHmmsszzzz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "long" 
                            timeFormat [
                                pattern [! "HH:mm:ss z"] 
                                datetimeSkeleton [! "HHmmssz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "medium" 
                            timeFormat [
                                pattern [! "HH:mm:ss"] 
                                datetimeSkeleton [! "HHmmss"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "short" 
                            timeFormat [
                                pattern [! "HH:mm"] 
                                datetimeSkeleton [! "HHmm"]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]

