
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ff"] 
            script [#type "Latn"] 
            territory [#type "NG"]
        ] 
        numbers [
            currencies [
                currency [
                    #type "NGN" 
                    symbol [! "₦"]
                ]
            ]
        ]
    ]

