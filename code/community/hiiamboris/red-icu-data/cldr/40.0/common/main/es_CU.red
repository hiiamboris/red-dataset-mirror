
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "es"] 
            territory [#type "CU"]
        ] 
        numbers [
            currencies [
                currency [
                    #type "CUP" 
                    symbol [! "$"]
                ] 
                currency [
                    #type "USD" 
                    symbol [! "US$"]
                ]
            ]
        ]
    ]

