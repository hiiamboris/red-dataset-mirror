        units [
            unitLength [
                #type "long" 
                unit [
                    #type "duration-year" 
                    displayName [#draft "provisional" ! "साल"] 
                    unitPattern [#count "one" ! "{0} साल"] 
                    unitPattern [#count "other" ! "{0} साल"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "provisional" ! "महीने"] 
                    unitPattern [#count "one" ! "{0} महीना"] 
                    unitPattern [#count "other" ! "{0} महीने"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [#draft "provisional" ! "सप्ताह"] 
                    unitPattern [#count "one" ! "{0} सप्ताह"] 
                    unitPattern [#count "other" ! "{0} सप्ताह"]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [#draft "provisional" ! "सान"] 
                    unitPattern [#count "one" ! "{0} सान"] 
                    unitPattern [#count "other" ! "{0} सान"]
                ] 
                unit [
                    #type "duration-hour" 
                    displayName [#draft "provisional" ! "घंटे"] 
                    unitPattern [#count "one" ! "{0} रिंगा"] 
                    unitPattern [#count "other" ! "{0} घंटे"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [#draft "provisional" ! "मिन."] 
                    unitPattern [#count "one" ! "{0} मिन."] 
                    unitPattern [#count "other" ! "{0} मिन."]
                ] 
                unit [
                    #type "duration-second" 
                    displayName [#draft "provisional" ! "सेकं."] 
                    unitPattern [#count "one" ! "{0} सेकं."] 
                    unitPattern [#count "other" ! "{0} सेकं."]
                ]
            ] 
            unitLength [
                #type "short" 
                unit [
                    #type "duration-year" 
                    displayName [#draft "provisional" ! "साल"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "provisional" ! "महीने"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [#draft "provisional" ! "सप्ताह"]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [#draft "provisional" ! "सान"]
                ] 
                unit [
                    #type "duration-hour" 
                    displayName [#draft "provisional" ! "घंटे"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [#draft "provisional" ! "मिन."]
                ] 
                unit [
                    #type "duration-second" 
                    displayName [#draft "provisional" ! "सेकं."]
                ]
            ]
        ] 
        posix [
            messages [
                yesstr [! "हाँ"] 
                nostr [! "नहीं"]
            ]
        ]
