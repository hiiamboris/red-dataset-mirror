        numbers [
            currencies [
                currency [
                    #type "BAM" 
                    displayName [#draft "contributed" ! "Босанскохерцеговачка конвертибилна марка"] 
                    displayName [#count "one" #draft "contributed" ! "босанскохерцеговачка конвертибилна марка"] 
                    displayName [#count "few" #draft "contributed" ! "босанскохерцеговачке конвертибилне маркe"] 
                    displayName [#count "other" #draft "contributed" ! "босанскохерцеговачких конвертибилних марака"]
                ] 
                currency [
                    #type "BYN" 
                    displayName [#draft "contributed" ! "Бјелоруска рубља"] 
                    displayName [#count "one" #draft "contributed" ! "бјелоруска рубља"] 
                    displayName [#count "few" #draft "contributed" ! "бјелоруске рубље"] 
                    displayName [#count "other" #draft "contributed" ! "бјелоруских рубљи"]
                ] 
                currency [
                    #type "KPW" 
                    displayName [#draft "contributed" ! "Сјевернокорејски вон"] 
                    displayName [#count "one" #draft "contributed" ! "сјевернокорејски вон"] 
                    displayName [#count "few" #draft "contributed" ! "сјевернокорејска вона"] 
                    displayName [#count "other" #draft "contributed" ! "сјевернокорејских вона"]
                ] 
                currency [
                    #type "NIO" 
                    displayName [! "Никарагванска златна кордоба"] 
                    displayName [#count "one" ! "никарагванска златна кордоба"] 
                    displayName [#count "few" ! "никарагванске златне кордобе"] 
                    displayName [#count "other" ! "никарагванских златних кордоба"]
                ]
            ]
        ] 
        units [
            unitLength [
                #type "long" 
                compoundUnit [
                    #type "1024p8" 
                    unitPrefixPattern [#draft "contributed" ! "јоби{0}"]
                ] 
                unit [
                    #type "duration-century" 
                    displayName [#draft "contributed" ! "вијекови"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} вијек"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} вијека"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} вијекова"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "contributed" ! "мјесеци"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} мјесец"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} мјесеца"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} мјесеци"] 
                    perUnitPattern [#draft "contributed" ! "{0} мјесечно"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [#draft "contributed" ! "недјеље"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} недјеља"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} недјеље"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} недјеља"] 
                    perUnitPattern [#draft "contributed" ! "{0} недјељно"]
                ] 
                unit [
                    #type "length-light-year" 
                    displayName [#draft "contributed" ! "свјетлосне године"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} свјетлосна година"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} свјетлосне године"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} свјетлосних година"]
                ] 
                unit [
                    #type "mass-grain" 
                    displayName [#draft "contributed" ! "гран"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} гран"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} грана"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} гранова"]
                ]
            ] 
            unitLength [
                #type "short" 
                unit [
                    #type "duration-month" 
                    displayName [#draft "contributed" ! "мјесеци"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} мјес."] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} мјес."] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} мјес."]
                ] 
                unit [
                    #type "length-light-year" 
                    displayName [#draft "contributed" ! "свјетлосне год."]
                ] 
                unit [
                    #type "mass-grain" 
                    displayName [#draft "contributed" ! "гран"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} гран"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} грана"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} гранова"]
                ] 
                unit [
                    #type "volume-dessert-spoon" 
                    displayName [#draft "contributed" ! "dstspn"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} dstspn"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} dstspn"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} dstspn"]
                ]
            ] 
            unitLength [
                #type "narrow" 
                unit [
                    #type "volume-barrel" 
                    displayName [#draft "contributed" ! "bbl"] 
                    unitPattern [#count "one" #draft "contributed" ! "{0}bbl"] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} bbl"] 
                    unitPattern [#count "other" #draft "contributed" ! "{0}bbl"]
                ] 
                unit [
                    #type "volume-dessert-spoon" 
                    displayName [#draft "contributed" ! "д. каш."] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} д. каш."] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} д. каш."] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} д. каш."]
                ] 
                unit [
                    #type "volume-dessert-spoon-imperial" 
                    displayName [#draft "contributed" ! "и. д. к."] 
                    unitPattern [#count "one" #draft "contributed" ! "{0} и. д. к."] 
                    unitPattern [#count "few" #draft "contributed" ! "{0} и. д. к."] 
                    unitPattern [#count "other" #draft "contributed" ! "{0} и. д. к."]
                ]
            ]
        ] 
        characterLabels [
            characterLabel [#type "body" ! "тијело"] 
            characterLabel [#type "bullets_stars" ! "Знакови за набрајање/звјездице"] 
            characterLabel [#type "downwards_arrows" ! "Стрелице надоље"] 
            characterLabel [#type "downwards_upwards_arrows" ! "Стрелице надоље и нагоре"] 
            characterLabel [#type "leftwards_arrows" ! "Стрелице налијево"] 
            characterLabel [#type "leftwards_rightwards_arrows" ! "Стрелице налијево и надесно"] 
            characterLabel [#type "place" ! "мјесто"] 
            characterLabel [#type "travel_places" ! "Путовања и мјеста"] 
            characterLabel [#type "weather" ! "вријеме"]
        ] 
        typographicNames [
            styleName [#type "slnt" #subtype "-12" ! "нагнут улијево"] 
            styleName [#type "wght" #subtype "200" ! "екстрасвијетао"] 
            styleName [#type "wght" #subtype "200" #alt "ultra" ! "ултрасвијетао"] 
            styleName [#type "wght" #subtype "300" ! "свијетао"] 
            styleName [#type "wght" #subtype "350" ! "полусвијетао"]
        ]
    ]

