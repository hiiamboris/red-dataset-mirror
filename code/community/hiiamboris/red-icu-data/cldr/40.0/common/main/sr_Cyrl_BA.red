
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "sr"] 
            script [#type "Cyrl"] 
            territory [#type "BA"]
        ] 
        localeDisplayNames [
            languages [
                language [#type "ar_001" #draft "contributed" ! "савремени стандардни арапски"] 
                language [#type "arn" #draft "contributed" ! "мапудунгун"] 
                language [#type "be" #draft "contributed" ! "бјелоруски"] 
                language [#type "bm" #draft "contributed" ! "бамананкан"] 
                language [#type "bn" #draft "contributed" ! "бангла"] 
                language [#type "de" #draft "contributed" ! "њемачки"] 
                language [#type "de_CH" ! "швајцарски високи њемачки"] 
                language [#type "en_GB" ! "енглески (Велика Британија)"] 
                language [#type "es_ES" ! "шпански (Европа)"] 
                language [#type "fa_AF" #draft "contributed" ! "дари"] 
                language [#type "gsw" ! "њемачки (Швајцарска)"] 
                language [#type "ht" #draft "contributed" ! "хаићански креолски"] 
                language [#type "lo" #draft "contributed" ! "лаошки"] 
                language [#type "lrc" ! "сјеверни лури"] 
                language [#type "moh" #draft "contributed" ! "мохок"] 
                language [#type "nd" ! "сјеверни ндебеле"] 
                language [#type "nds" #draft "contributed" ! "нискоњемачки"] 
                language [#type "nqo" #draft "contributed" ! "н’ко"] 
                language [#type "pt_PT" #draft "contributed" ! "португалски (Португал)"] 
                language [#type "se" ! "сјеверни сами"] 
                language [#type "shi" #draft "contributed" ! "јужни шилха"] 
                language [#type "si" #draft "contributed" ! "синхалски"] 
                language [#type "sw_CD" #draft "contributed" ! "кисвахили"] 
                language [#type "tzm" #draft "contributed" ! "централноатласки тамашек"] 
                language [#type "xh" #draft "contributed" ! "исикоса"] 
                language [#type "zgh" #draft "contributed" ! "стандардни марокански тамашек"] 
                language [#type "zh_Hans" #draft "contributed" ! "поједностављени кинески"] 
                language [#type "zh_Hant" #draft "contributed" ! "традиционални кинески"] 
                language [#type "zu" #draft "contributed" ! "исизулу"]
            ] 
            territories [
                territory [#type "001" #draft "contributed" ! "свијет"] 
                territory [#type "003" #draft "contributed" ! "Сјеверноамерички континент"] 
                territory [#type "015" #draft "contributed" ! "Сјеверна Африка"] 
                territory [#type "019" #draft "contributed" ! "Сјеверна и Јужна Америка"] 
                territory [#type "021" #draft "contributed" ! "Сјеверна Америка"] 
                territory [#type "154" #draft "contributed" ! "Сјеверна Европа"] 
                territory [#type "AC" #draft "contributed" ! "острво Асенсион"] 
                territory [#type "BY" #draft "contributed" ! "Бјелорусија"] 
                territory [#type "CC" ! "Кокосова (Килинг) острва"] 
                territory [#type "CG" #draft "contributed" ! "Конго"] 
                territory [#type "CP" #draft "contributed" ! "острво Клипертон"] 
                territory [#type "CV" #draft "contributed" ! "Кабо Верде"] 
                territory [#type "CZ" #draft "contributed" ! "Чешка Република"] 
                territory [#type "DE" #draft "contributed" ! "Њемачка"] 
                territory [#type "FK" #alt "variant" #draft "contributed" ! "Фолкландска (Малвинска) острва"] 
                territory [#type "GS" #draft "contributed" ! "Јужна Џорџија и Јужна Сендвичка острва"] 
                territory [#type "GU" ! "Гвам"] 
                territory [#type "HK" #draft "contributed" ! "Хонгконг (САО Кине)"] 
                territory [#type "HM" ! "острво Херд и острва Макдоналд"] 
                territory [#type "KN" #draft "contributed" ! "Свети Китс и Невис"] 
                territory [#type "KP" ! "Сјеверна Кореја"] 
                territory [#type "MK" #draft "contributed" ! "Сјеверна Македонија"] 
                territory [#type "MO" #draft "contributed" ! "САР Макао"] 
                territory [#type "MP" ! "Сјеверна Маријанска острва"] 
                territory [#type "NF" ! "острво Норфок"] 
                territory [#type "NU" ! "Нијуе"] 
                territory [#type "PM" #draft "contributed" ! "Свети Пјер и Микелон"] 
                territory [#type "PS" #draft "contributed" ! "палестинске територије"] 
                territory [#type "RE" #draft "contributed" ! "Реунион"] 
                territory [#type "UM" ! "Спољна острва САД"] 
                territory [#type "VC" #draft "contributed" ! "Свети Винсент и Гренадини"] 
                territory [#type "VG" #draft "contributed" ! "Британска Дјевичанска Острва"] 
                territory [#type "VI" #draft "contributed" ! "Америчка Дјевичанска Острва"]
            ] 
            keys [
                key [#type "collation" #draft "contributed" ! "редослијед сортирања"] 
                key [#type "ms" #draft "contributed" ! "систем мјерних јединица"]
            ] 
            types [
                type [#key "collation" #type "ducet" #draft "contributed" ! "подразумијевани Unicode редослијед сортирања"] 
                type [#key "collation" #type "search" #draft "contributed" ! "претрага опште намјене"] 
                type [#key "collation" #type "standard" #draft "contributed" ! "стандардни редослијед сортирања"] 
                type [#key "numbers" #type "mymr" #draft "contributed" ! "мјанмарске цифре"]
            ]
        ] 
        dates [
            calendars [
                calendar [
                    #type "generic" 
                    dateTimeFormats [
                        intervalFormats [
                            intervalFormatItem [
                                #id "MMMEd" 
                                greatestDifference [#id "d" #draft "contributed" ! "E, d. MMM – E, d. MMM"] 
                                greatestDifference [#id "M" #draft "contributed" ! "E, d. MMM – E, d. MMM"]
                            ] 
                            intervalFormatItem [
                                #id "yMd" 
                                greatestDifference [#id "M" #draft "contributed" ! "d.M.y. – d.M.y. GGGGG"]
                            ]
                        ]
                    ]
                ] 
                calendar [
                    #type "gregorian" 
                    days [
                        dayContext [
                            #type "format" 
                            dayWidth [
                                #type "wide" 
                                day [#type "sun" #draft "contributed" ! "недјеља"] 
                                day [#type "mon" ! "понедјељак"] 
                                day [#type "tue" #draft "contributed" ! "уторак"] 
                                day [#type "wed" #draft "contributed" ! "сриједа"] 
                                day [#type "thu" #draft "contributed" ! "четвртак"] 
                                day [#type "fri" #draft "contributed" ! "петак"] 
                                day [#type "sat" #draft "contributed" ! "субота"]
                            ]
                        ] 
                        dayContext [
                            #type "stand-alone" 
                            dayWidth [
                                #type "abbreviated" 
                                day [#type "sun" #draft "contributed" ! "нед"] 
                                day [#type "mon" #draft "contributed" ! "пон"] 
                                day [#type "tue" ! "уто"] 
                                day [#type "wed" ! "сри"] 
                                day [#type "thu" #draft "contributed" ! "чет"] 
                                day [#type "fri" #draft "contributed" ! "пет"] 
                                day [#type "sat" #draft "contributed" ! "суб"]
                            ] 
                            dayWidth [
                                #type "wide" 
                                day [#type "sun" #draft "contributed" ! "недјеља"] 
                                day [#type "mon" ! "понедјељак"] 
                                day [#type "tue" #draft "contributed" ! "уторак"] 
                                day [#type "wed" #draft "contributed" ! "сриједа"] 
                                day [#type "thu" #draft "contributed" ! "четвртак"] 
                                day [#type "fri" #draft "contributed" ! "петак"] 
                                day [#type "sat" #draft "contributed" ! "субота"]
                            ]
                        ]
                    ] 
                    dayPeriods [
                        dayPeriodContext [
                            #type "format" 
                            dayPeriodWidth [
                                #type "abbreviated" 
                                dayPeriod [#type "midnight" #draft "contributed" ! "поноћ"] 
                                dayPeriod [#type "am" #draft "contributed" ! "прије подне"] 
                                dayPeriod [#type "noon" #draft "contributed" ! "подне"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "по подне"] 
                                dayPeriod [#type "morning1" #draft "contributed" ! "јутро"] 
                                dayPeriod [#type "afternoon1" #draft "contributed" ! "по под."] 
                                dayPeriod [#type "evening1" #draft "contributed" ! "вече"] 
                                dayPeriod [#type "night1" ! "ноћу"]
                            ] 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "midnight" #draft "contributed" ! "поноћ"] 
                                dayPeriod [#type "noon" #draft "contributed" ! "подне"] 
                                dayPeriod [#type "morning1" #draft "contributed" ! "јутро"] 
                                dayPeriod [#type "afternoon1" #draft "contributed" ! "по под."] 
                                dayPeriod [#type "evening1" #draft "contributed" ! "вече"] 
                                dayPeriod [#type "night1" #draft "contributed" ! "ноћ"]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "am" #draft "contributed" ! "прије подне"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "по подне"]
                            ]
                        ] 
                        dayPeriodContext [
                            #type "stand-alone" 
                            dayPeriodWidth [
                                #type "abbreviated" 
                                dayPeriod [#type "am" #draft "contributed" ! "прије подне"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "по подне"]
                            ] 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "am" #draft "contributed" ! "а"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "p"]
                            ] 
                            dayPeriodWidth [
                                #type "wide" 
                                dayPeriod [#type "am" #draft "contributed" ! "прије подне"] 
                                dayPeriod [#type "pm" #draft "contributed" ! "по подне"]
                            ]
                        ]
                    ] 
                    eras [
                        eraNames [
                            era [#type "0" #draft "contributed" ! "прије нове ере"] 
                            era [#type "1" #alt "variant" #draft "contributed" ! "нове ере"]
                        ]
                    ] 
                    dateTimeFormats [
                        intervalFormats [
                            intervalFormatItem [
                                #id "Md" 
                                greatestDifference [#id "d" #draft "contributed" ! "MM-dd – MM-dd"] 
                                greatestDifference [#id "M" #draft "contributed" ! "MM-dd – MM-dd"]
                            ] 
                            intervalFormatItem [
                                #id "MEd" 
                                greatestDifference [#id "d" #draft "contributed" ! "E, MM-dd – E, MM-dd"] 
                                greatestDifference [#id "M" #draft "contributed" ! "E, MM-dd – E, MM-dd"]
                            ] 
                            intervalFormatItem [
                                #id "yM" 
                                greatestDifference [#id "M" #draft "contributed" ! "y-MM – y-MM"] 
                                greatestDifference [#id "y" #draft "contributed" ! "y-MM – y-MM"]
                            ] 
                            intervalFormatItem [
                                #id "yMd" 
                                greatestDifference [#id "d" #draft "contributed" ! "y-MM-dd – y-MM-dd"] 
                                greatestDifference [#id "M" #draft "contributed" ! "y-MM-dd – y-MM-dd"] 
                                greatestDifference [#id "y" #draft "contributed" ! "y-MM-dd – y-MM-dd"]
                            ] 
                            intervalFormatItem [
                                #id "yMEd" 
                                greatestDifference [#id "d" #draft "contributed" ! "E, y-MM-dd – E, y-MM-dd"] 
                                greatestDifference [#id "M" #draft "contributed" ! "E, y-MM-dd – E, y-MM-dd"] 
                                greatestDifference [#id "y" #draft "contributed" ! "E, y-MM-dd – E, y-MM-dd"]
                            ]
                        ]
                    ]
                ]
            ] 
            fields [
                field [
                    #type "year" 
                    relative [#type "-1" #draft "contributed" ! "прошле године"] 
                    relative [#type "0" #draft "contributed" ! "ове године"] 
                    relative [#type "1" #draft "contributed" ! "сљедеће године"] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} године"] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} године"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} година"]
                    ]
                ] 
                field [
                    #type "year-short" 
                    relative [#type "-1" #draft "contributed" ! "прошле год."] 
                    relative [#type "0" #draft "contributed" ! "ове год."] 
                    relative [#type "1" #draft "contributed" ! "сљедеће год."] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} год."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} год."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} год."]
                    ]
                ] 
                field [
                    #type "year-narrow" 
                    relative [#type "-1" #draft "contributed" ! "прошле г."] 
                    relative [#type "0" #draft "contributed" ! "ове г."] 
                    relative [#type "1" #draft "contributed" ! "сљедеће г."] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} г."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} г."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} г."]
                    ]
                ] 
                field [
                    #type "quarter" 
                    relative [#type "-1" #draft "contributed" ! "прошлог квартала"] 
                    relative [#type "0" #draft "contributed" ! "овог квартала"] 
                    relative [#type "1" #draft "contributed" ! "сљедећег квартала"] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} квартала"] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} квартала"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} квартала"]
                    ]
                ] 
                field [
                    #type "quarter-short" 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} кв."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} кв."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} кв."]
                    ]
                ] 
                field [
                    #type "quarter-narrow" 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} кв."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} кв."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} кв."]
                    ]
                ] 
                field [
                    #type "month" 
                    displayName [#draft "contributed" ! "мјесец"] 
                    relative [#type "-1" #draft "contributed" ! "прошлог мјесеца"] 
                    relative [#type "0" #draft "contributed" ! "овог мјесеца"] 
                    relative [#type "1" #draft "contributed" ! "сљедећег мјесеца"] 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "за {0} мјесец"] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "за {0} мјесеца"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "за {0} мјесеци"]
                    ] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} мјесеца"] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} мјесеца"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} мјесеци"]
                    ]
                ] 
                field [
                    #type "month-short" 
                    displayName [#draft "contributed" ! "мјес."] 
                    relative [#type "-1" #draft "contributed" ! "прошлог мјес."] 
                    relative [#type "0" #draft "contributed" ! "овог мјес."] 
                    relative [#type "1" #draft "contributed" ! "сљедећег мјес."] 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "за {0} мјес."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "за {0} мјес."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "за {0} мјес."]
                    ] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} мјес."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} мјес."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} мјес."]
                    ]
                ] 
                field [
                    #type "month-narrow" 
                    relative [#type "-1" #draft "contributed" ! "прошлог мјес."] 
                    relative [#type "0" #draft "contributed" ! "овог мјес."] 
                    relative [#type "1" #draft "contributed" ! "сљедећег м."] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} м."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} м."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} м."]
                    ]
                ] 
                field [
                    #type "week" 
                    displayName [#draft "contributed" ! "недјеља"] 
                    relative [#type "-1" #draft "contributed" ! "претходне недеље"] 
                    relative [#type "0" #draft "contributed" ! "ове недјеље"] 
                    relative [#type "1" #draft "contributed" ! "наредне недеље"] 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "за {0} недјељу"] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "за {0} недјеље"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "за {0} недјеља"]
                    ] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} недјеље"] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} недјеље"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} недјеља"]
                    ] 
                    relativePeriod [#draft "contributed" ! "недјеља која почиње {0}."]
                ] 
                field [
                    #type "week-short" 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} нед."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} нед."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} нед."]
                    ] 
                    relativePeriod [#draft "contributed" ! "недјеља која почиње {0}."]
                ] 
                field [
                    #type "week-narrow" 
                    relative [#type "-1" #draft "contributed" ! "прошле н."] 
                    relative [#type "0" #draft "contributed" ! "ове н."] 
                    relative [#type "1" #draft "contributed" ! "сљедеће н."] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} н."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} н."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} н."]
                    ] 
                    relativePeriod [#draft "contributed" ! "недјеља која почиње {0}."]
                ] 
                field [
                    #type "weekOfMonth" 
                    displayName [#draft "contributed" ! "недјеља у мјесецу"]
                ] 
                field [
                    #type "weekOfMonth-short" 
                    displayName [#draft "contributed" ! "нед. у мјес."]
                ] 
                field [
                    #type "weekOfMonth-narrow" 
                    displayName [#draft "contributed" ! "нед. у мјес."]
                ] 
                field [
                    #type "day" 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} дана"] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} дана"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} дана"]
                    ]
                ] 
                field [
                    #type "day-short" 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} д."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} д."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} д."]
                    ]
                ] 
                field [
                    #type "day-narrow" 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} д."] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} д."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} д."]
                    ]
                ] 
                field [
                    #type "weekday" 
                    displayName [#draft "contributed" ! "дан у недјељи"]
                ] 
                field [
                    #type "weekday-short" 
                    displayName [#draft "contributed" ! "дан у недјељи"]
                ] 
                field [
                    #type "weekday-narrow" 
                    displayName [#draft "contributed" ! "дан у недјељи"]
                ] 
                field [
                    #type "weekdayOfMonth" 
                    displayName [#draft "contributed" ! "дан у мјесецу"]
                ] 
                field [
                    #type "weekdayOfMonth-short" 
                    displayName [#draft "contributed" ! "дан у мјесецу"]
                ] 
                field [
                    #type "weekdayOfMonth-narrow" 
                    displayName [#draft "contributed" ! "дан у мјесецу"]
                ] 
                field [
                    #type "sun" 
                    relative [#type "-1" #draft "contributed" ! "прошле недјеље"] 
                    relative [#type "0" #draft "contributed" ! "у недјељу"] 
                    relative [#type "1" #draft "contributed" ! "сљедеће недјеље"] 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "за {0} недјељу"] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "за {0} недјеље"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "за {0} недјеља"]
                    ] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "прије {0} недјеље"] 
                        relativeTimePattern [#count "few" #draft "contributed" ! "прије {0} недјеље"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "прије {0} недјеља"]
                    ]
                ] 
                field [
                    #type "sun-short" 
                    relative [#type "-1" #draft "contributed" ! "пр. нед."] 
                    relative [#type "0" #draft "contributed" ! "у нед"] 
                    relative [#type "1" #draft "contributed" ! "сљ. нед."] 
                    relativeTime [
                        #type "future" 
