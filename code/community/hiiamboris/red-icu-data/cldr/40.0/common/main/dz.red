                ]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0} དང་ {1}"] 
                listPatternPart [#type "middle" ! "{0} དང་ {1}"] 
                listPatternPart [#type "end" ! "{0} དང་ {1}"] 
                listPatternPart [#type "2" ! "{0} དང་ {1}"]
            ]
        ] 
        posix [
