        units [
            unitLength [
                #type "long" 
                unit [
                    #type "duration-year" 
                    displayName [#draft "provisional" ! "ལོ་འཁོར་"] 
                    unitPattern [#count "other" ! "ལོ་འཁོར་ {0}"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "provisional" ! "ཟླཝ་"] 
                    unitPattern [#count "other" ! "ཟླཝ་ {0}"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [#draft "provisional" ! "བངུན་ཕྲག་"] 
                    unitPattern [#count "other" ! "བངུན་ཕྲག་ {0}"]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [#draft "provisional" ! "ཉིན་ཞག་"] 
                    unitPattern [#count "other" ! "ཉིན་ཞག་ {0}"]
                ] 
                unit [
