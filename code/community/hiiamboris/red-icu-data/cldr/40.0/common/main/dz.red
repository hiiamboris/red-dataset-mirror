                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "short" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        availableFormats [
                            dateFormatItem [#id "d" ! "d"] 
                            dateFormatItem [#id "Ed" ! "d E"] 
                            dateFormatItem [#id "Gy" ! "G y"] 
                            dateFormatItem [#id "GyMMM" ! "G y སྤྱི་ཟླ་MMM"] 
                            dateFormatItem [#id "GyMMMd" ! "G y MMM d"] 
                            dateFormatItem [#id "GyMMMEd" ! "གཟའ་E, G ལོy ཟླ་MMM ཚེ་d"] 
                            dateFormatItem [#id "h" ! "ཆུ་ཚོད་h a"] 
                            dateFormatItem [#id "H" ! "ཆུ་ཚོད་HH"] 
                            dateFormatItem [#id "hm" ! "h:mm a"] 
                            dateFormatItem [#id "Hm" ! "HH:mm"] 
                            dateFormatItem [#id "hms" ! "h:mm:ss a"] 
                            dateFormatItem [#id "Hms" ! "HH:mm:ss"] 
                            dateFormatItem [#id "M" ! "L"] 
