                    displayName [#draft "provisional" ! "སྐར་མ་"] 
                    unitPattern [#count "other" ! "སྐར་མ་ {0}"]
                ] 
                unit [
                    #type "duration-second" 
                    displayName [#draft "provisional" ! "སྐར་ཆ་"] 
                    unitPattern [#count "other" ! "སྐར་ཆ་ {0}"]
                ]
            ] 
            unitLength [
                #type "short" 
                unit [
                    #type "duration-year" 
                    displayName [#draft "provisional" ! "ལོ་འཁོར་"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "provisional" ! "ཟླཝ་"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [#draft "provisional" ! "བངུན་ཕྲག་"]
                ] 
                unit [
