        numbers [
            defaultNumberingSystem [! "tibt"] 
            otherNumberingSystems [
                native [! "tibt"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            symbols [
                #numberSystem "tibt" 
                decimal [! "."] 
                group [! ","] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                perMille [! "‰"] 
                infinity [! "གྲངས་མེད"] 
                nan [! "ཨང་མད"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "སྟོང་ཕྲག 0"] 
                        pattern [#type "10000" #count "other" ! "ཁྲི་ཕྲག 0"] 
                        pattern [#type "100000" #count "other" ! "འབུམ་ཕྲག 0"] 
                        pattern [#type "1000000" #count "other" ! "ས་ཡ་ 0"] 
                        pattern [#type "10000000" #count "other" ! "བྱེ་བ་ 0"] 
                        pattern [#type "100000000" #count "other" ! "དུང་ཕྱུར་ 0"] 
                        pattern [#type "1000000000" #count "other" ! "དུང་ཕྱུར་ 00"] 
                        pattern [#type "10000000000" #count "other" ! "དུང་ཕྱུར་བརྒྱ་ 0"] 
                        pattern [#type "100000000000" #count "other" ! "དུང་ཕྱུར་སྟོང 0"] 
                        pattern [#type "1000000000000" #count "other" ! "དུང་ཕྱུར་ཁྲི་ 0"] 
                        pattern [#type "10000000000000" #count "other" ! "དུང་ཕྱུར་འབུམ་ 0"] 
                        pattern [#type "100000000000000" #count "other" ! "དུང་ཕྱུར་ས་ཡ་ 0"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##,##0 %"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##,##0.00"]
                    ]
                ] 
