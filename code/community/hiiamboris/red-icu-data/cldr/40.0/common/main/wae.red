                    displayName [#count "one" #draft "contributed" ! "Indišä Rupie"] 
                    displayName [#count "other" #draft "contributed" ! "Indiši Rupie"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [#draft "contributed" ! "Yen"] 
                    displayName [#count "one" #draft "contributed" ! "Yen"] 
                    displayName [#count "other" #draft "contributed" ! "Yen"] 
                    symbol [#draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "RUB" 
                    displayName [#draft "contributed" ! "Rubel"] 
                    displayName [#count "one" #draft "contributed" ! "Rubel"] 
                    displayName [#count "other" #draft "contributed" ! "Rubel"]
                ] 
                currency [
                    #type "USD" 
                    displayName [#draft "contributed" ! "Dollar"] 
                    displayName [#count "one" #draft "contributed" ! "Dollar"] 
                    displayName [#count "other" #draft "contributed" ! "Dollar"] 
                    symbol [#draft "contributed" ! "$"]
                ] 
                currency [
                    #type "XXX" 
                    displayName [#draft "contributed" ! "Unbekannti Wãrig"] 
                    displayName [#count "one" #draft "contributed" ! "Unbekannti Wãrig"] 
                    displayName [#count "other" #draft "contributed" ! "Unbekannti Wãrig"]
                ]
            ]
        ] 
        units [
            unitLength [
                #type "long" 
                unit [
                    #type "duration-year" 
                    displayName [#draft "contributed" ! "jár"] 
                    unitPattern [#count "one" ! "{0} jár"] 
                    unitPattern [#count "other" ! "{0} jár"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "contributed" ! "mánet"] 
                    unitPattern [#count "one" ! "{0} mánet"] 
                    unitPattern [#count "other" ! "{0} mánet"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [#draft "contributed" ! "wučä"] 
                    unitPattern [#count "one" ! "{0} wuča"] 
                    unitPattern [#count "other" ! "{0} wučä"]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [#draft "contributed" ! "täg"] 
                    unitPattern [#count "one" ! "{0} täg"] 
                    unitPattern [#count "other" ! "{0} täg"]
                ] 
                unit [
                    #type "duration-hour" 
                    displayName [#draft "contributed" ! "stunde"] 
                    unitPattern [#count "one" ! "{0} stund"] 
                    unitPattern [#count "other" ! "{0} stunde"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [#draft "contributed" ! "minüte"] 
                    unitPattern [#count "one" ! "{0} minüta"] 
                    unitPattern [#count "other" ! "{0} minüte"]
                ] 
                unit [
                    #type "duration-second" 
                    displayName [#draft "contributed" ! "sekunde"] 
                    unitPattern [#count "one" ! "{0} sekund"] 
                    unitPattern [#count "other" ! "{0} sekunde"]
                ]
            ] 
            unitLength [
                #type "short" 
                unit [
                    #type "duration-year" 
                    displayName [#draft "contributed" ! "jár"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "contributed" ! "mánet"]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [#draft "contributed" ! "wučä"]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [#draft "contributed" ! "täg"]
                ] 
                unit [
                    #type "duration-hour" 
                    displayName [#draft "contributed" ! "stunde"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [#draft "contributed" ! "minüte"]
                ] 
                unit [
                    #type "duration-second" 
                    displayName [#draft "contributed" ! "sekunde"]
                ]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "end" #draft "contributed" ! "{0} und {1}"] 
                listPatternPart [#type "2" #draft "contributed" ! "{0} und {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [#draft "contributed" ! "ja:j:y"] 
                nostr [#draft "contributed" ! "nei:n"]
            ]
        ]
    ]

