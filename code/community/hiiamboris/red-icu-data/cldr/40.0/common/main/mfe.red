                            appendItem [#request "Era" ! "{1} {0}"] 
                            appendItem [#request "Hour" ! "{0} ({2}: {1})"] 
                            appendItem [#request "Minute" ! "{0} ({2}: {1})"] 
                            appendItem [#request "Month" ! "{0} ({2}: {1})"] 
