                        pattern [#type "1000000" #count "one" ! "0 ᎢᏳᏆᏗᏅᏛ"] 
                        pattern [#type "1000000" #count "other" ! "0 ᎢᏳᏆᏗᏅᏛ"] 
                        pattern [#type "10000000" #count "one" ! "00 ᎢᏳᏆᏗᏅᏛ"] 
                        pattern [#type "10000000" #count "other" ! "00 ᎢᏳᏆᏗᏅᏛ"] 
                        pattern [#type "100000000" #count "one" ! "000 ᎢᏳᏆᏗᏅᏛ"] 
                        pattern [#type "100000000" #count "other" ! "000 ᎢᏳᏆᏗᏅᏛ"] 
                        pattern [#type "1000000000" #count "one" ! "0 ᎢᏯᏔᎳᏗᏅᏛ"] 
                        pattern [#type "1000000000" #count "other" ! "0 ᎢᏯᏔᎳᏗᏅᏛ"] 
                        pattern [#type "10000000000" #count "one" ! "00 ᎢᏯᏔᎳᏗᏅᏛ"] 
                        pattern [#type "10000000000" #count "other" ! "00 ᎢᏯᏔᎳᏗᏅᏛ"] 
                        pattern [#type "100000000000" #count "one" ! "000 ᎢᏯᏔᎳᏗᏅᏛ"] 
                        pattern [#type "100000000000" #count "other" ! "000 ᎢᏯᏔᎳᏗᏅᏛ"] 
                        pattern [#type "1000000000000" #count "one" ! "0 ᎢᏯᏦᎠᏗᏅᏛ"] 
                        pattern [#type "1000000000000" #count "other" ! "0 ᎢᏯᏦᎠᏗᏅᏛ"] 
                        pattern [#type "10000000000000" #count "one" ! "00 ᎢᏯᏦᎠᏗᏅᏛ"] 
                        pattern [#type "10000000000000" #count "other" ! "00 ᎢᏯᏦᎠᏗᏅᏛ"] 
                        pattern [#type "100000000000000" #count "one" ! "000 ᎢᏯᏦᎠᏗᏅᏛ"] 
                        pattern [#type "100000000000000" #count "other" ! "000 ᎢᏯᏦᎠᏗᏅᏛ"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0K"] 
                        pattern [#type "1000" #count "other" ! "0K"] 
                        pattern [#type "10000" #count "one" ! "00K"] 
                        pattern [#type "10000" #count "other" ! "00K"] 
                        pattern [#type "100000" #count "one" ! "000K"] 
                        pattern [#type "100000" #count "other" ! "000K"] 
                        pattern [#type "1000000" #count "one" ! "0M"] 
                        pattern [#type "1000000" #count "other" ! "0M"] 
                        pattern [#type "10000000" #count "one" ! "00M"] 
                        pattern [#type "10000000" #count "other" ! "00M"] 
                        pattern [#type "100000000" #count "one" ! "000M"] 
                        pattern [#type "100000000" #count "other" ! "000M"] 
                        pattern [#type "1000000000" #count "one" ! "0B"] 
                        pattern [#type "1000000000" #count "other" ! "0B"] 
                        pattern [#type "10000000000" #count "one" ! "00B"] 
                        pattern [#type "10000000000" #count "other" ! "00B"] 
                        pattern [#type "100000000000" #count "one" ! "000B"] 
                        pattern [#type "100000000000" #count "other" ! "000B"] 
                        pattern [#type "1000000000000" #count "one" ! "0T"] 
                        pattern [#type "1000000000000" #count "other" ! "0T"] 
