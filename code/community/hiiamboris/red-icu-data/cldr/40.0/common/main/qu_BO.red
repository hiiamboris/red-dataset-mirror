
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "qu"] 
            territory [#type "BO"]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "Bolivia" 
                    short [
                        standard [! "BOT"]
                    ]
                ] 
                metazone [
                    #type "Peru" 
                    short [
                        generic [! "∅∅∅"] 
                        standard [! "∅∅∅"] 
                        daylight [! "∅∅∅"]
                    ]
                ]
            ]
        ] 
        numbers [
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."]
            ] 
            currencies [
                currency [
                    #type "BOB" 
                    symbol [! "Bs"]
                ] 
                currency [
                    #type "PEN" 
                    symbol [! "PEN"]
                ]
            ]
        ]
    ]

