        numbers [
            defaultNumberingSystem [#draft "contributed" ! "latn"] 
            otherNumberingSystems [
                native [#draft "contributed" ! "latn"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                list [#draft "contributed" ! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "−"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 túsund"] 
                        pattern [#type "1000" #count "other" ! "0 túsund"] 
                        pattern [#type "10000" #count "one" ! "00 túsund"] 
                        pattern [#type "10000" #count "other" ! "00 túsund"] 
                        pattern [#type "100000" #count "one" ! "000 túsund"] 
                        pattern [#type "100000" #count "other" ! "000 túsund"] 
                        pattern [#type "1000000" #count "one" ! "0 millión"] 
                        pattern [#type "1000000" #count "other" ! "0 milliónir"] 
                        pattern [#type "10000000" #count "one" ! "00 milliónir"] 
                        pattern [#type "10000000" #count "other" ! "00 milliónir"] 
                        pattern [#type "100000000" #count "one" ! "000 milliónir"] 
                        pattern [#type "100000000" #count "other" ! "000 milliónir"] 
                        pattern [#type "1000000000" #count "one" ! "0 milliard"] 
                        pattern [#type "1000000000" #count "other" ! "0 milliardir"] 
                        pattern [#type "10000000000" #count "one" ! "00 milliardir"] 
                        pattern [#type "10000000000" #count "other" ! "00 milliardir"] 
                        pattern [#type "100000000000" #count "one" ! "000 milliardir"] 
                        pattern [#type "100000000000" #count "other" ! "000 milliardir"] 
                        pattern [#type "1000000000000" #count "one" ! "0 billión"] 
                        pattern [#type "1000000000000" #count "other" ! "0 billiónir"] 
                        pattern [#type "10000000000000" #count "one" ! "00 billiónir"] 
                        pattern [#type "10000000000000" #count "other" ! "00 billiónir"] 
                        pattern [#type "100000000000000" #count "one" ! "000 billiónir"] 
                        pattern [#type "100000000000000" #count "other" ! "000 billiónir"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 tús'.'"] 
                        pattern [#type "1000" #count "other" ! "0 tús'.'"] 
                        pattern [#type "10000" #count "one" ! "00 tús'.'"] 
                        pattern [#type "10000" #count "other" ! "00 tús'.'"] 
                        pattern [#type "100000" #count "one" ! "000 tús'.'"] 
                        pattern [#type "100000" #count "other" ! "000 tús'.'"] 
                        pattern [#type "1000000" #count "one" ! "0 mió'.'"] 
                        pattern [#type "1000000" #count "other" ! "0 mió'.'"] 
                        pattern [#type "10000000" #count "one" ! "00 mió'.'"] 
                        pattern [#type "10000000" #count "other" ! "00 mió'.'"] 
                        pattern [#type "100000000" #count "one" ! "000 mió'.'"] 
                        pattern [#type "100000000" #count "other" ! "000 mió'.'"] 
                        pattern [#type "1000000000" #count "one" ! "0 mia'.'"] 
                        pattern [#type "1000000000" #count "other" ! "0 mia'.'"] 
                        pattern [#type "10000000000" #count "one" ! "00 mia'.'"] 
                        pattern [#type "10000000000" #count "other" ! "00 mia'.'"] 
                        pattern [#type "100000000000" #count "one" ! "000 mia'.'"] 
                        pattern [#type "100000000000" #count "other" ! "000 mia'.'"] 
                        pattern [#type "1000000000000" #count "one" ! "0 bió'.'"] 
                        pattern [#type "1000000000000" #count "other" ! "0 bió'.'"] 
                        pattern [#type "10000000000000" #count "one" ! "00 bió'.'"] 
                        pattern [#type "10000000000000" #count "other" ! "00 bió'.'"] 
                        pattern [#type "100000000000000" #count "one" ! "000 bió'.'"] 
                        pattern [#type "100000000000000" #count "other" ! "000 bió'.'"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0 %"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "#,##0.00 ¤"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "#,##0.00 ¤;(#,##0.00 ¤)"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "one" ! "0 tús'.' ¤"] 
                        pattern [#type "1000" #count "other" ! "0 tús'.' ¤"] 
