                        pattern [#type "1000000000" #count "one" ! "0 mia'.' ¤"] 
                        pattern [#type "1000000000" #count "other" ! "0 mia'.' ¤"] 
                        pattern [#type "10000000000" #count "one" ! "00 mia'.' ¤"] 
                        pattern [#type "10000000000" #count "other" ! "00 mia'.' ¤"] 
                        pattern [#type "100000000000" #count "one" ! "000 mia'.' ¤"] 
                        pattern [#type "100000000000" #count "other" ! "000 mia'.' ¤"] 
                        pattern [#type "1000000000000" #count "one" ! "0 bió'.' ¤"] 
