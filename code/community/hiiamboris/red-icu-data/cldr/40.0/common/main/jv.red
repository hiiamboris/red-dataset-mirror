        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "java"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                percentSign [! "%"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0 èwu"] 
                        pattern [#type "10000" #count "other" ! "00 èwu"] 
                        pattern [#type "100000" #count "other" ! "000 èwu"] 
                        pattern [#type "1000000" #count "other" ! "0 yuta"] 
                        pattern [#type "10000000" #count "other" ! "00 yuta"] 
                        pattern [#type "100000000" #count "other" ! "000 yuta"] 
                        pattern [#type "1000000000" #count "other" ! "0 milyar"] 
                        pattern [#type "10000000000" #count "other" ! "00 milyar"] 
                        pattern [#type "100000000000" #count "other" ! "000 milyar"] 
                        pattern [#type "1000000000000" #count "other" ! "0 trilyun"] 
                        pattern [#type "10000000000000" #count "other" ! "00 trilyun"] 
                        pattern [#type "100000000000000" #count "other" ! "000 trilyun"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0È"] 
                        pattern [#type "10000" #count "other" ! "00È"] 
                        pattern [#type "100000" #count "other" ! "000È"] 
                        pattern [#type "1000000" #count "other" ! "0Y"] 
                        pattern [#type "10000000" #count "other" ! "00Y"] 
                        pattern [#type "100000000" #count "other" ! "000Y"] 
                        pattern [#type "1000000000" #count "other" ! "0M"] 
                        pattern [#type "10000000000" #count "other" ! "00M"] 
                        pattern [#type "100000000000" #count "other" ! "000M"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤ #,##0.00"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "¤ #,##0.00"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "other" ! "¤0È"] 
                        pattern [#type "10000" #count "other" ! "¤00È"] 
                        pattern [#type "100000" #count "other" ! "¤000È"] 
                        pattern [#type "1000000" #count "other" ! "¤0Y"] 
                        pattern [#type "10000000" #count "other" ! "¤00Y"] 
                        pattern [#type "100000000" #count "other" ! "¤000Y"] 
                        pattern [#type "1000000000" #count "other" ! "¤0M"] 
                        pattern [#type "10000000000" #count "other" ! "¤00M"] 
                        pattern [#type "100000000000" #count "other" ! "¤000M"] 
                        pattern [#type "1000000000000" #count "other" ! "¤0T"] 
                        pattern [#type "10000000000000" #count "other" ! "¤00T"] 
                        pattern [#type "100000000000000" #count "other" ! "¤000T"]
                    ]
                ] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
