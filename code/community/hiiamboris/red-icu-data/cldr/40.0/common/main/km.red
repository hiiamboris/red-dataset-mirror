        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "khmr"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [#draft "contributed" ! "+"] 
                minusSign [#draft "contributed" ! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [#draft "contributed" ! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0 ពាន់"] 
                        pattern [#type "10000" #count "other" ! "00 ពាន់"] 
                        pattern [#type "100000" #count "other" ! "000ពាន់"] 
                        pattern [#type "1000000" #count "other" ! "0 លាន"] 
                        pattern [#type "10000000" #count "other" ! "00 លាន"] 
                        pattern [#type "100000000" #count "other" ! "000 លាន"] 
                        pattern [#type "1000000000" #count "other" ! "0 ប៊ីលាន"] 
                        pattern [#type "10000000000" #count "other" ! "00 ប៊ីលាន"] 
                        pattern [#type "100000000000" #count "other" ! "000 ប៊ីលាន"] 
                        pattern [#type "1000000000000" #count "other" ! "0 ទ្រីលាន"] 
                        pattern [#type "10000000000000" #count "other" ! "00 ទ្រីលាន"] 
                        pattern [#type "100000000000000" #count "other" ! "000 ទ្រីលាន"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0ពាន់"] 
                        pattern [#type "10000" #count "other" ! "00 ពាន់"] 
                        pattern [#type "100000" #count "other" ! "000 ពាន់"] 
                        pattern [#type "1000000" #count "other" ! "0 លាន"] 
                        pattern [#type "10000000" #count "other" ! "00 លាន"] 
                        pattern [#type "100000000" #count "other" ! "000 លាន"] 
                        pattern [#type "1000000000" #count "other" ! "0 ប៊ីលាន"] 
                        pattern [#type "10000000000" #count "other" ! "00 ប៊ីលាន"] 
                        pattern [#type "100000000000" #count "other" ! "000 ប៊ីលាន"] 
                        pattern [#type "1000000000000" #count "other" ! "0 ទ្រីលាន"] 
                        pattern [#type "10000000000000" #count "other" ! "00 ទ្រីលាន"] 
                        pattern [#type "100000000000000" #count "other" ! "000 ទ្រីលាន"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "#,##0.00¤"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "#,##0.00¤;(#,##0.00¤)"]
                    ]
                ] 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000" #count "other" ! "¤0 ពាន់"] 
                        pattern [#type "10000" #count "other" ! "¤00 ពាន់"] 
                        pattern [#type "100000" #count "other" ! "¤000 ពាន់"] 
                        pattern [#type "1000000" #count "other" ! "¤0 លាន"] 
                        pattern [#type "10000000" #count "other" ! "¤00 លាន"] 
                        pattern [#type "100000000" #count "other" ! "¤000 លាន"] 
                        pattern [#type "1000000000" #count "other" ! "¤0 ប៊ីលាន"] 
                        pattern [#type "10000000000" #count "other" ! "¤00 ប៊ីលាន"] 
                        pattern [#type "100000000000" #count "other" ! "¤000 ប៊ីលាន"] 
                        pattern [#type "1000000000000" #count "other" ! "¤0 ទ្រីលាន"] 
                        pattern [#type "10000000000000" #count "other" ! "¤00 ទ្រីលាន"] 
                        pattern [#type "100000000000000" #count "other" ! "¤000 ទ្រីលាន"]
