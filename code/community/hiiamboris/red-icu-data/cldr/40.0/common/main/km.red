                    #type "temperature-fahrenheit" 
                    unitPattern [#count "other" ! "{0}°F"]
                ] 
                unit [
                    #type "volume-cubic-kilometer" 
                    unitPattern [#count "other" ! "{0} គ.ម³."]
                ] 
                unit [
                    #type "volume-cubic-mile" 
                    unitPattern [#count "other" ! "{0} ម៉³."]
                ] 
                unit [
                    #type "volume-liter" 
                    displayName [! "លីត្រ"] 
                    unitPattern [#count "other" ! "{0}L"]
                ] 
                coordinateUnit [
                    displayName [! "ទិស"] 
                    coordinateUnitPattern [#type "east" ! "{0}កើត"] 
                    coordinateUnitPattern [#type "north" ! "{0}ជើង"] 
                    coordinateUnitPattern [#type "south" ! "{0}ត្បូង"] 
                    coordinateUnitPattern [#type "west" ! "{0}លិច"]
                ]
            ] 
            durationUnit [
                #type "hm" 
                durationUnitPattern [! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} និង {1}"] 
                listPatternPart [#type "2" ! "{0} និង​{1}"]
            ] 
            listPattern [
                #type "or" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} ឬ {1}"] 
                listPatternPart [#type "2" ! "{0} ឬ {1}"]
            ] 
            listPattern [
                #type "standard-narrow" 
                listPatternPart [#type "end" ! "{0}, {1}"] 
                listPatternPart [#type "2" ! "{0}, {1}"]
            ] 
            listPattern [
                #type "standard-short" 
                listPatternPart [#type "2" ! "{0} និង {1}"]
            ] 
            listPattern [
                #type "unit" 
                listPatternPart [#type "start" ! "{0} {1}"] 
                listPatternPart [#type "middle" ! "{0} {1}"] 
                listPatternPart [#type "end" ! "{0} {1}"] 
                listPatternPart [#type "2" ! "{0} {1}"]
