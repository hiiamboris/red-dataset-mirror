                            ] 
                            intervalFormatItem [
                                #id "M" 
                                greatestDifference [#id "M" ! "'Tháng' M – M"]
                            ] 
                            intervalFormatItem [
                                #id "Md" 
                                greatestDifference [#id "d" ! "dd/MM – dd/MM"] 
                                greatestDifference [#id "M" ! "dd/MM – dd/MM"]
                            ] 
                            intervalFormatItem [
                                #id "MEd" 
                                greatestDifference [#id "d" ! "EEEE, dd/MM – EEEE, dd/MM"] 
