                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0 nghìn"] 
                        pattern [#type "10000" #count "other" ! "00 nghìn"] 
                        pattern [#type "100000" #count "other" ! "000 nghìn"] 
                        pattern [#type "1000000" #count "other" ! "0 triệu"] 
