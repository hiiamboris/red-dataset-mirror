                        pattern [#type "100000" #count "other" ! "000 N"] 
                        pattern [#type "1000000" #count "other" ! "0 Tr"] 
                        pattern [#type "10000000" #count "other" ! "00 Tr"] 
                        pattern [#type "100000000" #count "other" ! "000 Tr"] 
                        pattern [#type "1000000000" #count "other" ! "0 T"] 
                        pattern [#type "10000000000" #count "other" ! "00 T"] 
                        pattern [#type "100000000000" #count "other" ! "000 T"] 
                        pattern [#type "1000000000000" #count "other" ! "0 NT"] 
                        pattern [#type "10000000000000" #count "other" ! "00 NT"] 
