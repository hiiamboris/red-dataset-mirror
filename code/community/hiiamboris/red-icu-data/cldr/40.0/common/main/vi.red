            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                approximatelySign [! "~"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
