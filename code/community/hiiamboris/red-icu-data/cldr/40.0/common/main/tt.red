        ] 
        numbers [
            defaultNumberingSystem [#draft "contributed" ! "latn"] 
            otherNumberingSystems [
                native [#draft "contributed" ! "latn"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! " "] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0 %"]
                    ]
                ]
            ] 
            currencyFormats [
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [#draft "unconfirmed" ! "#,##0.00¤"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "#,##0.00 ¤"]
                    ] 
                    currencyFormat [
                        #type "accounting" 
                        pattern [! "#,##0.00 ¤"]
                    ]
                ] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencies [
                currency [
                    #type "BRL" 
                    displayName [! "Бразилия реалы"] 
                    displayName [#count "other" ! "Бразилия реалы"] 
                    symbol [#draft "contributed" ! "R$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "R$"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "кытай юане"] 
                    displayName [#count "other" ! "юань"] 
                    symbol [#draft "contributed" ! "CN¥"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "EUR" 
                    displayName [! "евро"] 
                    displayName [#count "other" ! "евро"] 
                    symbol [#draft "contributed" ! "€"] 
                    symbol [#alt "narrow" #draft "contributed" ! "€"]
                ] 
                currency [
                    #type "GBP" 
                    displayName [! "фунт стерлинг"] 
                    displayName [#count "other" ! "фунт стерлинг"] 
                    symbol [#draft "contributed" ! "£"] 
                    symbol [#alt "narrow" #draft "contributed" ! "£"]
                ] 
                currency [
                    #type "INR" 
                    displayName [! "Индия рупиясе"] 
                    displayName [#count "other" ! "Индия рупиясе"] 
                    symbol [#draft "contributed" ! "₹"] 
                    symbol [#alt "narrow" #draft "contributed" ! "₹"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [! "япон иенасы"] 
                    displayName [#count "other" ! "иена"] 
                    symbol [#draft "contributed" ! "JP¥"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "RUB" 
                    displayName [! "Россия сумы"] 
                    displayName [#count "other" ! "сум"] 
                    symbol [#draft "contributed" ! "₽"] 
                    symbol [#alt "narrow" #draft "contributed" ! "₽"]
                ] 
                currency [
                    #type "RUR" 
                    symbol [#draft "unconfirmed" ! "р."]
                ] 
                currency [
                    #type "USD" 
                    displayName [! "АКШ доллары"] 
                    displayName [#count "other" ! "АКШ доллары"] 
                    symbol [#draft "contributed" ! "$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "$"]
                ] 
                currency [
                    #type "XXX" 
                    displayName [! "билгесез валюта"] 
                    displayName [#count "other" ! "(билгесез валюта)"]
                ]
            ] 
            miscPatterns [
                #numberSystem "latn" 
                pattern [#type "atLeast" ! "{0}+"] 
                pattern [#type "range" ! "{0}-{1}"]
            ]
        ] 
        units [
            durationUnit [
                #type "hm" 
                durationUnitPattern [! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} һәм {1}"] 
                listPatternPart [#type "2" ! "{0} һәм {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [! "әйе:әйе"] 
                nostr [! "юк:юк"]
            ]
        ]
    ]

