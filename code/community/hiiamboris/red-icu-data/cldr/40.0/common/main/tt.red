                    displayName [! "вакыт өлкәсе"]
                ]
            ] 
            timeZoneNames [
                hourFormat [! "+HH:mm;-HH:mm"] 
                gmtFormat [! "GMT{0}"] 
                gmtZeroFormat [! "GMT"] 
                regionFormat [! "{0} вакыты"] 
                regionFormat [#type "daylight" ! "{0} җәйге вакыты"] 
                regionFormat [#type "standard" ! "{0} гадәти вакыты"] 
                fallbackFormat [! "{1} ({0})"] 
                zone [
                    #type "Etc/UTC" 
                    long [
                        standard [! "Бөтендөнья килештерелгән вакыты"]
                    ]
                ] 
                zone [
                    #type "Etc/Unknown" 
                    exemplarCity [! "билгесез шәһәр"]
                ] 
                metazone [
                    #type "America_Central" 
                    long [
                        generic [! "Төньяк Америка үзәк вакыты"] 
                        standard [! "Төньяк Америка гадәти үзәк вакыты"] 
                        daylight [! "Төньяк Америка җәйге үзәк вакыты"]
                    ]
                ] 
                metazone [
                    #type "America_Eastern" 
                    long [
                        generic [! "Төньяк Америка көнчыгыш вакыты"] 
                        standard [! "Төньяк Америка гадәти көнчыгыш вакыты"] 
