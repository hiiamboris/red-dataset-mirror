
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ko"] 
            territory [#type "KP"]
        ] 
        localeDisplayNames [
            territories [
                territory [#type "KP" ! "조선민주주의인민공화국"]
            ]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "Korea" 
                    long [
                        generic [! "조선 시간"] 
                        standard [! "조선 표준시"] 
                        daylight [! "조선 하계 표준시"]
                    ]
                ]
            ]
        ]
    ]

