        numbers [
            defaultNumberingSystem [! "deva"] 
            otherNumberingSystems [
                native [! "deva"]
            ] 
            minimumGroupingDigits [#draft "contributed" ! "1"] 
            symbols [
                #numberSystem "deva" 
                decimal [#draft "contributed" ! "."] 
                group [#draft "contributed" ! ","] 
                percentSign [! "%"] 
                plusSign [#draft "contributed" ! "+"] 
                minusSign [#draft "contributed" ! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [#draft "contributed" ! "."] 
                group [#draft "contributed" ! ","] 
                list [#draft "contributed" ! ";"] 
                percentSign [! "%"] 
                plusSign [#draft "contributed" ! "+"] 
                minusSign [#draft "contributed" ! "-"] 
                approximatelySign [! "~"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [#draft "contributed" ! ":"]
            ] 
            decimalFormats [
                #numberSystem "deva" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [#draft "contributed" ! "#,##,##0.###"]
                    ]
                ]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [#draft "contributed" ! "#,##,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 हजार"] 
