                listPatternPart [#type "2" ! "{0} እና {1}"]
            ] 
            listPattern [
                #type "or" 
                listPatternPart [#type "start" ! "{0}፣ {1}"] 
                listPatternPart [#type "middle" ! "{0}፣ {1}"] 
                listPatternPart [#type "end" ! "{0}፣ ወይም {1}"] 
                listPatternPart [#type "2" ! "{0} ወይም {1}﻿"]
            ] 
            listPattern [
                #type "or-narrow" 
                listPatternPart [#type "end" ! "{0}፣ ወይም {1}"]
            ] 
            listPattern [
                #type "standard-narrow" 
                listPatternPart [#type "start" ! "{0}, {1}"]
            ] 
            listPattern [
                #type "standard-short" 
                listPatternPart [#type "start" ! "{0}፣ {1}"] 
                listPatternPart [#type "middle" ! "{0}፣ {1}"] 
                listPatternPart [#type "end" ! "{0}, እና {1}"] 
                listPatternPart [#type "2" ! "{0} እና {1}"]
            ] 
            listPattern [
                #type "unit" 
                listPatternPart [#type "start" ! "{0}፣ {1}"] 
                listPatternPart [#type "middle" ! "{0}፣ {1}"] 
                listPatternPart [#type "end" ! "{0}፣ {1}"] 
                listPatternPart [#type "2" ! "{0}፣ {1}"]
            ] 
