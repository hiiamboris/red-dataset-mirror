                        pattern [#type "10000000" #count "one" ! "00 ሚሊዮን"] 
                        pattern [#type "10000000" #count "other" ! "00 ሚሊዮን"] 
                        pattern [#type "100000000" #count "one" ! "000 ሚሊዮን"] 
                        pattern [#type "100000000" #count "other" ! "000 ሚሊዮን"] 
                        pattern [#type "1000000000" #count "one" ! "0 ቢሊዮን"] 
                        pattern [#type "1000000000" #count "other" ! "0 ቢሊዮን"] 
                        pattern [#type "10000000000" #count "one" ! "00 ቢሊዮን"] 
                        pattern [#type "10000000000" #count "other" ! "00 ቢሊዮን"] 
                        pattern [#type "100000000000" #count "one" ! "000 ቢሊዮን"] 
                        pattern [#type "100000000000" #count "other" ! "000 ቢሊዮን"] 
