            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 ሺ"] 
                        pattern [#type "1000" #count "other" ! "0 ሺ"] 
                        pattern [#type "10000" #count "one" ! "00 ሺ"] 
                        pattern [#type "10000" #count "other" ! "00 ሺ"] 
