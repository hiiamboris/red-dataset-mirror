                native [! "latn"] 
                traditional [! "jpan"] 
                finance [! "jpanfin"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                list [#draft "contributed" ! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                approximatelySign [! "約"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [! ":"]
