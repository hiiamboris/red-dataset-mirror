                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0"] 
                        pattern [#type "10000" #count "other" ! "0万"] 
                        pattern [#type "100000" #count "other" ! "00万"] 
                        pattern [#type "1000000" #count "other" ! "000万"] 
                        pattern [#type "10000000" #count "other" ! "0000万"] 
