                pluralMinimalPairs [#count "one" ! "{0} sat"] 
                pluralMinimalPairs [#count "few" ! "{0} sata"] 
                pluralMinimalPairs [#count "other" ! "{0} sati"] 
                ordinalMinimalPairs [#ordinal "other" ! "Skrenite u {0}. desno."] 
