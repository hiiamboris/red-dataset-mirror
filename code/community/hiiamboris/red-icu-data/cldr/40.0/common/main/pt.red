                        pattern [#type "1000000000" #count "other" ! "0 bi"] 
                        pattern [#type "10000000000" #count "one" ! "00 bi"] 
                        pattern [#type "10000000000" #count "other" ! "00 bi"] 
                        pattern [#type "100000000000" #count "one" ! "000 bi"] 
