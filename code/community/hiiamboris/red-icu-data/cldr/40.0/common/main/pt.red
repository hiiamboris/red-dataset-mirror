        numbers [
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 mil"] 
                        pattern [#type "1000" #count "other" ! "0 mil"] 
                        pattern [#type "10000" #count "one" ! "00 mil"] 
                        pattern [#type "10000" #count "other" ! "00 mil"] 
                        pattern [#type "100000" #count "one" ! "000 mil"] 
                        pattern [#type "100000" #count "other" ! "000 mil"] 
                        pattern [#type "1000000" #count "one" ! "0 milhão"] 
                        pattern [#type "1000000" #count "other" ! "0 milhões"] 
                        pattern [#type "10000000" #count "one" ! "00 milhão"] 
                        pattern [#type "10000000" #count "other" ! "00 milhões"] 
                        pattern [#type "100000000" #count "one" ! "000 milhão"] 
                        pattern [#type "100000000" #count "other" ! "000 milhões"] 
                        pattern [#type "1000000000" #count "one" ! "0 bilhão"] 
                        pattern [#type "1000000000" #count "other" ! "0 bilhões"] 
                        pattern [#type "10000000000" #count "one" ! "00 bilhão"] 
                        pattern [#type "10000000000" #count "other" ! "00 bilhões"] 
                        pattern [#type "100000000000" #count "one" ! "000 bilhão"] 
                        pattern [#type "100000000000" #count "other" ! "000 bilhões"] 
                        pattern [#type "1000000000000" #count "one" ! "0 trilhão"] 
                        pattern [#type "1000000000000" #count "other" ! "0 trilhões"] 
                        pattern [#type "10000000000000" #count "one" ! "00 trilhão"] 
                        pattern [#type "10000000000000" #count "other" ! "00 trilhões"] 
                        pattern [#type "100000000000000" #count "one" ! "000 trilhão"] 
                        pattern [#type "100000000000000" #count "other" ! "000 trilhões"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 mil"] 
                        pattern [#type "1000" #count "other" ! "0 mil"] 
                        pattern [#type "10000" #count "one" ! "00 mil"] 
                        pattern [#type "10000" #count "other" ! "00 mil"] 
                        pattern [#type "100000" #count "one" ! "000 mil"] 
                        pattern [#type "100000" #count "other" ! "000 mil"] 
                        pattern [#type "1000000" #count "one" ! "0 mi"] 
                        pattern [#type "1000000" #count "other" ! "0 mi"] 
