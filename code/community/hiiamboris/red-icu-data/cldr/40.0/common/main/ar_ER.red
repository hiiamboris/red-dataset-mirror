
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ar"] 
            territory [#type "ER"]
        ] 
        numbers [
            defaultNumberingSystem [! "arab"] 
            currencies [
                currency [
                    #type "ERN" 
                    symbol [! "Nfk"]
                ]
            ]
        ]
    ]

