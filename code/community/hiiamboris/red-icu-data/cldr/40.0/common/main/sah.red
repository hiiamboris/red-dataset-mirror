                            dateFormatItem [#id "Ed" #draft "unconfirmed" ! "d, E"] 
                            dateFormatItem [#id "Gy" #draft "unconfirmed" ! "G y"]
                        ] 
                        intervalFormats [
                            intervalFormatFallback [#draft "unconfirmed" ! "{0} – {1}"]
