        ] 
        delimiters [
            quotationStart [! "«"] 
            quotationEnd [! "»"] 
            alternateQuotationStart [! "„"] 
            alternateQuotationEnd [! "“"]
        ] 
        dates [
            calendars [
                calendar [
                    #type "generic" 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
