            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0 тыһыынча"] 
                        pattern [#type "10000" #count "other" ! "00 тыһыынча"] 
                        pattern [#type "100000" #count "other" ! "000 тыһыынча"] 
                        pattern [#type "1000000" #count "other" ! "0 мөлүйүөн"] 
                        pattern [#type "10000000" #count "other" ! "00 мөлүйүөн"] 
                        pattern [#type "100000000" #count "other" ! "000 мөлүйүөн"] 
                        pattern [#type "1000000000" #count "other" ! "0 миллиард"] 
                        pattern [#type "10000000000" #count "other" ! "00 миллиард"] 
                        pattern [#type "100000000000" #count "other" ! "000 миллиард"] 
                        pattern [#type "1000000000000" #count "other" ! "0 триллион"] 
                        pattern [#type "10000000000000" #count "other" ! "00 триллион"] 
                        pattern [#type "100000000000000" #count "other" ! "000 триллион"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "other" ! "0 тыһ'.'"] 
                        pattern [#type "10000" #count "other" ! "00 тыһ'.'"] 
                        pattern [#type "100000" #count "other" ! "000 тыһ'.'"] 
                        pattern [#type "1000000" #count "other" ! "0 мөл"] 
                        pattern [#type "10000000" #count "other" ! "00 мөл"] 
                        pattern [#type "100000000" #count "other" ! "000 мөл"] 
                        pattern [#type "1000000000" #count "other" ! "0 млрд"] 
                        pattern [#type "10000000000" #count "other" ! "00 млрд"] 
                        pattern [#type "100000000000" #count "other" ! "000 млрд"] 
                        pattern [#type "1000000000000" #count "other" ! "0 трлн"] 
                        pattern [#type "10000000000000" #count "other" ! "00 трлн"] 
                        pattern [#type "100000000000000" #count "other" ! "000 трлн"]
                    ]
                ]
