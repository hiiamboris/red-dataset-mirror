                            intervalFormatItem [
                                #id "MMMEd" 
                                greatestDifference [#id "d" ! "MMM d, E – MMM d, E"] 
                                greatestDifference [#id "M" ! "MMM d, E – MMM d, E"]
                            ] 
                            intervalFormatItem [
                                #id "y" 
                                greatestDifference [#id "y" ! "y–y"]
                            ] 
                            intervalFormatItem [
                                #id "yM" 
                                greatestDifference [#id "M" ! "y-MM – y-MM"] 
                                greatestDifference [#id "y" ! "y-MM – y-MM"]
                            ] 
                            intervalFormatItem [
                                #id "yMd" 
                                greatestDifference [#id "d" ! "y-MM-dd – y-MM-dd"] 
                                greatestDifference [#id "M" ! "y-MM-dd – y-MM-dd"] 
                                greatestDifference [#id "y" ! "y-MM-dd – y-MM-dd"]
                            ] 
                            intervalFormatItem [
                                #id "yMEd" 
                                greatestDifference [#id "d" ! "y-MM-dd, E – y-MM-dd, E"] 
                                greatestDifference [#id "M" ! "y-MM-dd, E – y-MM-dd, E"] 
                                greatestDifference [#id "y" ! "y-MM-dd, E – y-MM-dd, E"]
                            ] 
                            intervalFormatItem [
                                #id "yMMM" 
                                greatestDifference [#id "M" ! "y MMM–MMM"] 
                                greatestDifference [#id "y" ! "y MMM – y MMM"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMd" 
                                greatestDifference [#id "d" ! "y MMM d–d"] 
                                greatestDifference [#id "M" ! "y MMM d – MMM d"] 
                                greatestDifference [#id "y" ! "y MMM d – y MMM d"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMEd" 
                                greatestDifference [#id "d" ! "y MMM d, E – MMM d, E"] 
                                greatestDifference [#id "M" ! "y MMM d, E – MMM d, E"] 
                                greatestDifference [#id "y" ! "y MMM d, E – y MMM d, E"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMM" 
                                greatestDifference [#id "M" ! "y MMMM–MMMM"] 
                                greatestDifference [#id "y" ! "y MMMM – y MMMM"]
                            ]
                        ]
                    ]
                ]
            ]
        ] 
        numbers [
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! " "] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##0.00"]
                    ]
                ] 
                unitPattern [#count "one" ! "{0} {1}"] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencies [
                currency [
                    #type "ZAR" 
                    displayName [! "iRandi yaseMzanzi Afrika"] 
                    displayName [#count "one" ! "iRandi YaseMzanzi Afrika"] 
                    displayName [#count "other" ! "iRandi yaseMzanzi Afrika"] 
                    symbol [! "R"] 
                    symbol [#alt "narrow" #draft "contributed" ! "R"]
                ]
            ]
        ] 
        posix [
            messages [
                yesstr [#draft "unconfirmed" ! "ewe:e"] 
                nostr [#draft "unconfirmed" ! "hayi:h"]
            ]
        ]
    ]

