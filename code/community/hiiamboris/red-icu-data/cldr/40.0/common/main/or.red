                parseLenient [#sample "," #draft "contributed" ! "[,،٫、︐︑﹐﹑，､]"] 
                parseLenient [#sample "+" #draft "contributed" ! "[+⁺₊➕﬩﹢＋]"]
            ] 
            parseLenients [
                #scope "number" 
                #level "stricter" 
