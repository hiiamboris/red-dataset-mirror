        numbers [
            minimumGroupingDigits [#draft "contributed" ! "2"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! "."] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 mille"] 
                        pattern [#type "1000" #count "other" ! "0 milles"] 
                        pattern [#type "10000" #count "one" ! "00 mille"] 
                        pattern [#type "10000" #count "other" ! "00 milles"] 
                        pattern [#type "100000" #count "one" ! "000 mille"] 
                        pattern [#type "100000" #count "other" ! "000 milles"] 
                        pattern [#type "1000000" #count "one" ! "0 million"] 
                        pattern [#type "1000000" #count "other" ! "0 milliones"] 
                        pattern [#type "10000000" #count "one" ! "00 million"] 
                        pattern [#type "10000000" #count "other" ! "00 milliones"] 
                        pattern [#type "100000000" #count "one" ! "000 million"] 
                        pattern [#type "100000000" #count "other" ! "000 milliones"] 
                        pattern [#type "1000000000" #count "one" ! "0 milliardo"] 
                        pattern [#type "1000000000" #count "other" ! "0 milliardos"] 
                        pattern [#type "10000000000" #count "one" ! "00 milliardo"] 
                        pattern [#type "10000000000" #count "other" ! "00 milliardos"] 
                        pattern [#type "100000000000" #count "one" ! "000 milliardo"] 
                        pattern [#type "100000000000" #count "other" ! "000 milliardos"] 
                        pattern [#type "1000000000000" #count "one" ! "0 billion"] 
                        pattern [#type "1000000000000" #count "other" ! "0 billiones"] 
                        pattern [#type "10000000000000" #count "one" ! "00 billion"] 
                        pattern [#type "10000000000000" #count "other" ! "00 billiones"] 
                        pattern [#type "100000000000000" #count "one" ! "000 billion"] 
                        pattern [#type "100000000000000" #count "other" ! "000 billiones"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 mil"] 
                        pattern [#type "1000" #count "other" ! "0 mil"] 
                        pattern [#type "10000" #count "one" ! "00 mil"] 
                        pattern [#type "10000" #count "other" ! "00 mil"] 
                        pattern [#type "100000" #count "one" ! "000 mil"] 
                        pattern [#type "100000" #count "other" ! "000 mil"] 
                        pattern [#type "1000000" #count "one" ! "0 mln"] 
                        pattern [#type "1000000" #count "other" ! "0 mln"] 
                        pattern [#type "10000000" #count "one" ! "00 mln"] 
                        pattern [#type "10000000" #count "other" ! "00 mln"] 
                        pattern [#type "100000000" #count "one" ! "000 mln"] 
                        pattern [#type "100000000" #count "other" ! "000 mln"] 
                        pattern [#type "1000000000" #count "one" ! "0 mld"] 
                        pattern [#type "1000000000" #count "other" ! "0 mld"] 
                        pattern [#type "10000000000" #count "one" ! "00 mld"] 
                        pattern [#type "10000000000" #count "other" ! "00 mld"] 
                        pattern [#type "100000000000" #count "one" ! "000 mld"] 
                        pattern [#type "100000000000" #count "other" ! "000 mld"] 
                        pattern [#type "1000000000000" #count "one" ! "0 bln"] 
                        pattern [#type "1000000000000" #count "other" ! "0 bln"] 
                        pattern [#type "10000000000000" #count "one" ! "00 bln"] 
                        pattern [#type "10000000000000" #count "other" ! "00 bln"] 
                        pattern [#type "100000000000000" #count "one" ! "000 bln"] 
                        pattern [#type "100000000000000" #count "other" ! "000 bln"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
