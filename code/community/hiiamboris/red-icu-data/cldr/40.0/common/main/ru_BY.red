
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "ru"] 
            territory [#type "BY"]
        ] 
        numbers [
            currencies [
                currency [
                    #type "BYN" 
                    symbol [! "Br"] 
                    symbol [#alt "narrow" #draft "contributed" ! "Br"]
                ] 
                currency [
                    #type "RUR" 
                    symbol [! "RUR"]
                ]
            ]
        ]
    ]

