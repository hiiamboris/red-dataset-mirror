                #numberSystem "latn" 
                currencyFormatLength [
                    #type "short" 
                    currencyFormat [
                        #type "standard" 
                        pattern [#type "1000000" #count "one" ! "¤ M0;¤-M0"] 
                        pattern [#type "1000000" #count "other" ! "¤ M0"] 
                        pattern [#type "10000000" #count "one" ! "¤ M00;¤M-M00"] 
