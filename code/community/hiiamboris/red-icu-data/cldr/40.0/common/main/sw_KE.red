        numbers [
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "elfu 0;elfu -0"] 
                        pattern [#type "1000" #count "other" ! "elfu 0;elfu -0"] 
                        pattern [#type "10000" #count "one" ! "elfu 00;elfu -00"] 
                        pattern [#type "10000" #count "other" ! "elfu 00"] 
                        pattern [#type "100000" #count "one" ! "elfu 000"] 
                        pattern [#type "100000" #count "other" ! "elfu 000"] 
                        pattern [#type "1000000" #count "one" ! "milioni 0"] 
                        pattern [#type "1000000" #count "other" ! "milioni 0"] 
                        pattern [#type "10000000" #count "one" ! "milioni 00"] 
                        pattern [#type "10000000" #count "other" ! "milioni 00"] 
                        pattern [#type "100000000" #count "one" ! "milioni 000"] 
                        pattern [#type "100000000" #count "other" ! "milioni 000"] 
                        pattern [#type "1000000000" #count "one" ! "bilioni 0"] 
                        pattern [#type "1000000000" #count "other" ! "bilioni 0"] 
                        pattern [#type "10000000000" #count "one" ! "bilioni 00"] 
                        pattern [#type "10000000000" #count "other" ! "bilioni 00"] 
                        pattern [#type "100000000000" #count "one" ! "bilioni 000"] 
                        pattern [#type "100000000000" #count "other" ! "bilioni 000"] 
