                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "elfu 0"] 
                        pattern [#type "1000" #count "other" ! "elfu 0"] 
                        pattern [#type "10000" #count "one" ! "elfu 00"] 
                        pattern [#type "10000" #count "other" ! "elfu 00"] 
                        pattern [#type "100000" #count "one" ! "elfu 000"] 
                        pattern [#type "100000" #count "other" ! "elfu 000"] 
                        pattern [#type "1000000" #count "one" ! "M0"] 
                        pattern [#type "1000000" #count "other" ! "M0"] 
                        pattern [#type "10000000" #count "one" ! "M00"] 
                        pattern [#type "10000000" #count "other" ! "M00"] 
                        pattern [#type "100000000" #count "one" ! "M000"] 
                        pattern [#type "100000000" #count "other" ! "M000"] 
                        pattern [#type "1000000000" #count "one" ! "B0"] 
                        pattern [#type "1000000000" #count "other" ! "B0"] 
