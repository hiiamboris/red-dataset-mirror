                        pattern [#type "1000000000000" #count "other" ! "T0"] 
                        pattern [#type "10000000000000" #count "one" ! "T00"] 
                        pattern [#type "10000000000000" #count "other" ! "T00"] 
                        pattern [#type "100000000000000" #count "one" ! "T000"] 
                        pattern [#type "100000000000000" #count "other" ! "T000"]
                    ]
                ]
            ] 
