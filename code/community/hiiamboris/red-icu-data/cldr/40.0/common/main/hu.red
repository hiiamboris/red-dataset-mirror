        numbers [
            defaultNumberingSystem [! "latn"] 
            otherNumberingSystems [
                native [! "latn"]
            ] 
            minimumGroupingDigits [! "1"] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! " "] 
                list [! ";"] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "NaN"] 
                timeSeparator [! ":"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 ezer"] 
                        pattern [#type "1000" #count "other" ! "0 ezer"] 
                        pattern [#type "10000" #count "one" ! "00 ezer"] 
                        pattern [#type "10000" #count "other" ! "00 ezer"] 
                        pattern [#type "100000" #count "one" ! "000 ezer"] 
                        pattern [#type "100000" #count "other" ! "000 ezer"] 
                        pattern [#type "1000000" #count "one" ! "0 millió"] 
                        pattern [#type "1000000" #count "other" ! "0 millió"] 
                        pattern [#type "10000000" #count "one" ! "00 millió"] 
                        pattern [#type "10000000" #count "other" ! "00 millió"] 
                        pattern [#type "100000000" #count "one" ! "000 millió"] 
                        pattern [#type "100000000" #count "other" ! "000 millió"] 
                        pattern [#type "1000000000" #count "one" ! "0 milliárd"] 
                        pattern [#type "1000000000" #count "other" ! "0 milliárd"] 
                        pattern [#type "10000000000" #count "one" ! "00 milliárd"] 
                        pattern [#type "10000000000" #count "other" ! "00 milliárd"] 
                        pattern [#type "100000000000" #count "one" ! "000 milliárd"] 
                        pattern [#type "100000000000" #count "other" ! "000 milliárd"] 
                        pattern [#type "1000000000000" #count "one" ! "0 billió"] 
                        pattern [#type "1000000000000" #count "other" ! "0 billió"] 
                        pattern [#type "10000000000000" #count "one" ! "00 billió"] 
                        pattern [#type "10000000000000" #count "other" ! "00 billió"] 
                        pattern [#type "100000000000000" #count "one" ! "000 billió"] 
                        pattern [#type "100000000000000" #count "other" ! "000 billió"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 E"] 
                        pattern [#type "1000" #count "other" ! "0 E"] 
