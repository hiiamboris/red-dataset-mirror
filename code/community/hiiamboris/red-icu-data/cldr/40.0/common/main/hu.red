                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} és {1}"] 
                listPatternPart [#type "2" ! "{0} és {1}"]
            ] 
            listPattern [
                #type "or" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} vagy {1}"] 
                listPatternPart [#type "2" ! "{0} vagy {1}"]
            ] 
            listPattern [
                #type "standard-short" 
                listPatternPart [#type "end" ! "{0} és {1}"] 
                listPatternPart [#type "2" ! "{0} és {1}"]
            ] 
            listPattern [
                #type "unit" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} és {1}"] 
                listPatternPart [#type "2" ! "{0} és {1}"]
            ] 
            listPattern [
                #type "unit-narrow" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} és {1}"] 
                listPatternPart [#type "2" ! "{0} és {1}"]
            ] 
            listPattern [
                #type "unit-short" 
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} és {1}"] 
                listPatternPart [#type "2" ! "{0} és {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [! "igen:i"] 
                nostr [! "nem:n"]
            ]
        ] 
