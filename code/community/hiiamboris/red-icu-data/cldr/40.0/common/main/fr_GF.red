
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "fr"] 
            territory [#type "GF"]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "French_Guiana" 
                    short [
                        standard [! "GFT"]
                    ]
                ]
            ]
        ]
    ]

