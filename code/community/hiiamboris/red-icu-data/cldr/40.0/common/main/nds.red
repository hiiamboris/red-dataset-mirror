                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} mm"]
                ] 
                unit [
                    #type "mass-kilogram" 
                    displayName [#draft "unconfirmed" ! "kg"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} kg"]
                ] 
                unit [
                    #type "mass-gram" 
                    displayName [#draft "unconfirmed" ! "Gramm"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} Gramm"]
                ] 
                unit [
                    #type "speed-kilometer-per-hour" 
                    displayName [#draft "unconfirmed" ! "km/h"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} km/h"]
                ] 
                unit [
                    #type "temperature-celsius" 
                    displayName [#draft "unconfirmed" ! "°Cels."] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}°Cels."]
                ] 
                unit [
                    #type "volume-liter" 
                    displayName [#draft "unconfirmed" ! "L"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} L"]
                ]
            ] 
            unitLength [
                #type "narrow" 
                unit [
                    #type "duration-year" 
                    displayName [#draft "unconfirmed" ! "a"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}a"]
                ] 
                unit [
                    #type "duration-month" 
                    displayName [#draft "unconfirmed" ! "M."] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}M."]
                ] 
                unit [
                    #type "duration-week" 
                    displayName [#draft "unconfirmed" ! "W."] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}W."]
                ] 
                unit [
                    #type "duration-day" 
                    displayName [#draft "unconfirmed" ! "d"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}d"]
                ] 
                unit [
                    #type "duration-hour" 
                    displayName [#draft "unconfirmed" ! "h"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}h"]
                ] 
                unit [
                    #type "duration-minute" 
                    displayName [#draft "unconfirmed" ! "min"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}min"]
                ] 
                unit [
                    #type "duration-second" 
                    displayName [#draft "unconfirmed" ! "s"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}s"]
                ] 
                unit [
                    #type "duration-millisecond" 
                    displayName [#draft "unconfirmed" ! "ms"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}ms"]
                ] 
                unit [
                    #type "length-kilometer" 
                    displayName [#draft "unconfirmed" ! "km"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} km"]
                ] 
                unit [
                    #type "length-meter" 
                    displayName [#draft "unconfirmed" ! "m"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} m"]
                ] 
                unit [
                    #type "length-centimeter" 
                    displayName [#draft "unconfirmed" ! "cm"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} cm"]
                ] 
                unit [
                    #type "length-millimeter" 
                    displayName [#draft "unconfirmed" ! "mm"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} mm"]
                ] 
                unit [
                    #type "mass-kilogram" 
                    displayName [#draft "unconfirmed" ! "kg"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} kg"]
                ] 
                unit [
                    #type "mass-gram" 
                    displayName [#draft "unconfirmed" ! "g"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} g"]
                ] 
                unit [
                    #type "speed-kilometer-per-hour" 
                    displayName [#draft "unconfirmed" ! "km/h"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0} km/h"]
                ] 
                unit [
                    #type "temperature-celsius" 
                    displayName [#draft "unconfirmed" ! "°C"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}°C"]
                ] 
                unit [
                    #type "volume-liter" 
                    displayName [#draft "unconfirmed" ! "l"] 
                    unitPattern [#count "other" #draft "unconfirmed" ! "{0}l"]
                ]
            ] 
            durationUnit [
                #type "hm" 
                durationUnitPattern [#draft "unconfirmed" ! "h.mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [#draft "unconfirmed" ! "h.mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [#draft "unconfirmed" ! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" #draft "unconfirmed" ! "{0}, {1}"] 
                listPatternPart [#type "middle" #draft "unconfirmed" ! "{0}, {1}"] 
                listPatternPart [#type "end" #draft "unconfirmed" ! "{0} un {1}"] 
                listPatternPart [#type "2" #draft "unconfirmed" ! "{0} un {1}"]
