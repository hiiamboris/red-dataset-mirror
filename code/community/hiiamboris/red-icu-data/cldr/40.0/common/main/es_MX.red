
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "es"] 
            territory [#type "MX"]
        ] 
        localeDisplayNames [
            languages [
                language [#type "ace" ! "acehnés"] 
                language [#type "ar_001" ! "árabe estándar moderno"] 
                language [#type "arp" ! "arapaho"] 
                language [#type "bas" ! "basa"] 
                language [#type "bax" #draft "contributed" ! "bamun"] 
                language [#type "bho" ! "bhoshpuri"] 
                language [#type "bla" ! "siksika"] 
                language [#type "bua" #draft "contributed" ! "buriat"] 
                language [#type "ckb" #alt "menu" ! "kurdo del centro"] 
                language [#type "dum" #draft "contributed" ! "neerlandés medieval"] 
                language [#type "en_GB" #alt "short" ! "inglés (R. U.)"] 
                language [#type "enm" #draft "contributed" ! "inglés medieval"] 
                language [#type "eu" ! "euskera"] 
                language [#type "frm" #draft "contributed" ! "francés medieval"] 
                language [#type "gan" #draft "contributed" ! "gan (China)"] 
                language [#type "gmh" #draft "contributed" ! "alemán de la alta edad media"] 
                language [#type "grc" ! "griego antiguo"] 
                language [#type "hak" #draft "contributed" ! "kejia (China)"] 
                language [#type "hil" ! "hiligainón"] 
                language [#type "hsn" #draft "contributed" ! "xiang (China)"] 
                language [#type "inh" ! "ingusetio"] 
                language [#type "kbd" ! "kabardiano"] 
                language [#type "krc" ! "karachái bálkaro"] 
                language [#type "kum" ! "cumuco"] 
                language [#type "lo" ! "lao"] 
                language [#type "lus" #draft "contributed" ! "lushai"] 
                language [#type "mga" #draft "contributed" ! "irlandés medieval"] 
                language [#type "nan" #draft "contributed" ! "min nan (Chino)"] 
                language [#type "nl_BE" ! "flamenco"] 
                language [#type "nr" #draft "contributed" ! "ndebele meridional"] 
                language [#type "nso" ! "sotho septentrional"] 
                language [#type "pa" ! "punyabí"] 
                language [#type "shu" #draft "contributed" ! "árabe chadiano"] 
                language [#type "ss" ! "siswati"] 
                language [#type "sw" ! "suajili"] 
                language [#type "sw_CD" ! "suajili del Congo"] 
                language [#type "syr" ! "siriaco"] 
                language [#type "tet" ! "tetún"] 
                language [#type "tn" ! "setswana"] 
                language [#type "tyv" #draft "contributed" ! "tuviniano"] 
                language [#type "ug" #alt "variant" ! "uyghur"] 
                language [#type "wuu" ! "chino wu"] 
                language [#type "xal" #draft "contributed" ! "kalmyk"] 
                language [#type "zgh" ! "tamazight marroquí estándar"] 
                language [#type "zh_Hans" ! "chino simplificado"] 
                language [#type "zh_Hans" #alt "long" ! "chino mandarín simplificado"] 
                language [#type "zh_Hant" ! "chino tradicional"] 
                language [#type "zh_Hant" #alt "long" ! "chino mandarín tradicional"]
            ] 
            scripts [
                script [#type "Mlym" #draft "contributed" ! "malayálam"]
            ] 
            territories [
                territory [#type "011" ! "África Occidental"] 
                territory [#type "014" ! "África Oriental"] 
                territory [#type "015" ! "África septentrional"] 
                territory [#type "018" ! "África meridional"] 
                territory [#type "030" ! "Asia Oriental"] 
                territory [#type "034" ! "Asia meridional"] 
                territory [#type "035" ! "Sudeste Asiático"] 
                territory [#type "039" ! "Europa meridional"] 
                territory [#type "145" ! "Asia Occidental"] 
                territory [#type "151" ! "Europa Oriental"] 
                territory [#type "154" ! "Europa septentrional"] 
                territory [#type "155" ! "Europa Occidental"] 
                territory [#type "BA" ! "Bosnia y Herzegovina"] 
                territory [#type "CI" ! "Côte d’Ivoire"] 
                territory [#type "EZ" ! "zona euro"] 
                territory [#type "GB" #alt "short" ! "RU"] 
                territory [#type "GG" ! "Guernsey"] 
                territory [#type "RO" ! "Rumania"] 
                territory [#type "SA" ! "Arabia Saudita"] 
                territory [#type "SZ" ! "Eswatini"] 
                territory [#type "TA" ! "Tristán de Acuña"] 
                territory [#type "UM" ! "Islas menores alejadas de EE. UU."] 
                territory [#type "UN" ! "ONU"]
            ] 
            types [
                type [#key "calendar" #type "roc" ! "calendario minguo"] 
                type [#key "collation" #type "ducet" ! "orden de clasificación de Unicode predeterminado"] 
                type [#key "numbers" #type "gujr" ! "dígitos en gujarati"]
            ] 
            measurementSystemNames [
                measurementSystemName [#type "UK" ! "imperial"]
            ]
        ] 
        characters [
            moreInformation [! "[...]"]
        ] 
        dates [
            calendars [
                calendar [
                    #type "generic" 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
                            dateFormat [
                                pattern [! "EEEE, d 'de' MMMM 'de' y G"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [! "d 'de' MMMM 'de' y G"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "medium" 
                            dateFormat [
                                pattern [! "d MMM, y G"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "short" 
                            dateFormat [
                                pattern [! "d/M/y GGGGG"]
                            ]
                        ]
                    ] 
                    dateTimeFormats [
                        dateTimeFormatLength [
                            #type "full" 
                            dateTimeFormat [
                                pattern [! "{1}, {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "long" 
                            dateTimeFormat [
                                pattern [! "{1}, {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "medium" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "short" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        availableFormats [
                            dateFormatItem [#id "h" ! "hh a"] 
                            dateFormatItem [#id "hm" ! "hh:mm a"] 
                            dateFormatItem [#id "hms" ! "hh:mm:ss a"] 
                            dateFormatItem [#id "MMMEd" #draft "contributed" ! "E d MMM"] 
                            dateFormatItem [#id "yyyyMEd" ! "E, d/M/y GGGGG"] 
                            dateFormatItem [#id "yyyyMMM" ! "MMM y G"] 
                            dateFormatItem [#id "yyyyMMMd" #draft "contributed" ! "d MMM y G"] 
                            dateFormatItem [#id "yyyyMMMEd" #draft "contributed" ! "EEE, d MMM y G"] 
                            dateFormatItem [#id "yyyyQQQ" ! "QQQ y G"]
                        ] 
                        intervalFormats [
                            intervalFormatFallback [! "{0} – {1}"] 
                            intervalFormatItem [
                                #id "Md" 
                                greatestDifference [#id "d" #draft "contributed" ! "d/M – d/M"] 
                                greatestDifference [#id "M" #draft "contributed" ! "d/M – d/M"]
                            ] 
                            intervalFormatItem [
                                #id "yM" 
                                greatestDifference [#id "M" #draft "contributed" ! "M/y – M/y G"] 
                                greatestDifference [#id "y" #draft "contributed" ! "M/y – M/y G"]
                            ] 
                            intervalFormatItem [
                                #id "yMd" 
                                greatestDifference [#id "d" #draft "contributed" ! "d/M/y – d/M/y G"] 
                                greatestDifference [#id "M" #draft "contributed" ! "d/M/y – d/M/y G"] 
                                greatestDifference [#id "y" #draft "contributed" ! "d/M/y – d/M/y G"]
                            ] 
                            intervalFormatItem [
                                #id "yMEd" 
                                greatestDifference [#id "d" #draft "contributed" ! "E, d/M/y–E, d/M/y G"] 
                                greatestDifference [#id "M" #draft "contributed" ! "E, d/M/y–E, d/M/y G"] 
                                greatestDifference [#id "y" #draft "contributed" ! "E, d/M/y–E, d/M/y G"]
                            ]
                        ]
                    ]
                ] 
                calendar [
                    #type "gregorian" 
                    days [
                        dayContext [
                            #type "format" 
                            dayWidth [
                                #type "narrow" 
                                day [#type "sun" ! "D"] 
                                day [#type "mon" ! "L"] 
                                day [#type "tue" ! "M"] 
                                day [#type "wed" ! "M"] 
                                day [#type "thu" ! "J"] 
                                day [#type "fri" ! "V"] 
                                day [#type "sat" ! "S"]
                            ]
                        ]
                    ] 
                    quarters [
                        quarterContext [
                            #type "format" 
                            quarterWidth [
                                #type "wide" 
                                quarter [#type "1" ! "1.er trimestre"] 
                                quarter [#type "2" ! "2.º trimestre"] 
                                quarter [#type "3" ! "3.er trimestre"] 
                                quarter [#type "4" ! "4.º trimestre"]
                            ]
                        ] 
                        quarterContext [
                            #type "stand-alone" 
                            quarterWidth [
                                #type "narrow" 
                                quarter [#type "1" #draft "contributed" ! "1T"] 
                                quarter [#type "2" #draft "contributed" ! "2T"] 
                                quarter [#type "3" #draft "contributed" ! "3T"] 
                                quarter [#type "4" #draft "contributed" ! "4T"]
                            ] 
                            quarterWidth [
                                #type "wide" 
                                quarter [#type "1" ! "1.er trimestre"] 
                                quarter [#type "2" ! "2.º trimestre"] 
                                quarter [#type "3" ! "3.er trimestre"] 
                                quarter [#type "4" ! "4.º trimestre"]
                            ]
                        ]
                    ] 
                    dayPeriods [
                        dayPeriodContext [
                            #type "format" 
                            dayPeriodWidth [
                                #type "narrow" 
                                dayPeriod [#type "noon" ! "del mediodía"] 
                                dayPeriod [#type "morning1" ! "de la madrugada"] 
                                dayPeriod [#type "morning2" ! "mañana"] 
                                dayPeriod [#type "evening1" ! "de la tarde"] 
                                dayPeriod [#type "night1" ! "de la noche"]
                            ]
                        ]
                    ] 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
                            dateFormat [
                                pattern [! "EEEE, d 'de' MMMM 'de' y"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [! "d 'de' MMMM 'de' y"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "medium" 
                            dateFormat [
                                pattern [#draft "contributed" ! "d MMM y"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "short" 
                            dateFormat [
                                pattern [#draft "contributed" ! "dd/MM/yy"] 
                                datetimeSkeleton [#draft "contributed" ! "yyMMdd"]
                            ]
                        ]
                    ] 
                    timeFormats [
                        timeFormatLength [
                            #type "full" 
                            timeFormat [
                                pattern [! "HH:mm:ss zzzz"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "long" 
                            timeFormat [
                                pattern [! "HH:mm:ss z"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "medium" 
                            timeFormat [
                                pattern [! "HH:mm:ss"]
                            ]
                        ] 
                        timeFormatLength [
                            #type "short" 
                            timeFormat [
                                pattern [! "HH:mm"]
                            ]
                        ]
                    ] 
                    dateTimeFormats [
                        dateTimeFormatLength [
                            #type "full" 
                            dateTimeFormat [
                                pattern [! "{1}, {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "long" 
                            dateTimeFormat [
                                pattern [! "{1}, {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "medium" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "short" 
                            dateTimeFormat [
                                pattern [! "{1}, {0}"]
                            ]
                        ] 
                        availableFormats [
                            dateFormatItem [#id "Ehm" ! "E h:mm a"] 
                            dateFormatItem [#id "EHm" ! "E HH:mm"] 
                            dateFormatItem [#id "Ehms" ! "E h:mm:ss a"] 
                            dateFormatItem [#id "EHms" ! "E HH:mm:ss"] 
                            dateFormatItem [#id "GyMMMd" ! "d MMM y G"] 
                            dateFormatItem [#id "Hmsvvvv" ! "HH:mm:ss (vvvv)"] 
                            dateFormatItem [#id "MMd" ! "d/MM"] 
                            dateFormatItem [#id "MMdd" ! "dd/MM"] 
                            dateFormatItem [#id "MMMEd" ! "E d 'de' MMM"] 
                            dateFormatItem [#id "yMEd" ! "E, d/M/y"] 
                            dateFormatItem [#id "yMM" ! "MM/y"] 
                            dateFormatItem [#id "yMMMEd" ! "EEE, d 'de' MMM 'de' y"] 
                            dateFormatItem [#id "yQQQ" #draft "contributed" ! "QQQ y"]
                        ] 
                        intervalFormats [
                            intervalFormatFallback [! "{0} – {1}"] 
                            intervalFormatItem [
                                #id "GyMMM" 
                                greatestDifference [#id "G" #draft "contributed" ! "MMM 'de' y G – MMM 'de' y G"] 
                                greatestDifference [#id "M" #draft "contributed" ! "MMM–MMM 'de' y G"] 
                                greatestDifference [#id "y" #draft "contributed" ! "MMM 'de' y – MMM 'de' y G"]
                            ] 
                            intervalFormatItem [
                                #id "GyMMMd" 
                                greatestDifference [#id "d" ! "d–d 'de' MMM 'de' y G"] 
                                greatestDifference [#id "G" #draft "contributed" ! "d 'de' MMM 'de' y G – d 'de' MMM 'de' y G"] 
                                greatestDifference [#id "M" ! "d 'de' MMM – d 'de' MMM 'de' y G"] 
                                greatestDifference [#id "y" #draft "contributed" ! "d 'de' MMM 'de' y – d 'de' MMM 'de' y G"]
                            ] 
                            intervalFormatItem [
                                #id "GyMMMEd" 
                                greatestDifference [#id "d" ! "E d 'de' MMM – E d 'de' MMM 'de' y G"] 
                                greatestDifference [#id "G" #draft "contributed" ! "E d 'de' MMM 'de' y G – E d 'de' MMM 'de' y G"] 
                                greatestDifference [#id "M" #draft "contributed" ! "E d 'de' MMM – E d 'de' MMM 'de' y G"] 
                                greatestDifference [#id "y" #draft "contributed" ! "E d 'de' MMM 'de' y – E d 'de' MMM 'de' y G"]
                            ] 
                            intervalFormatItem [
                                #id "h" 
                                greatestDifference [#id "a" ! "h a – h a"]
                            ] 
                            intervalFormatItem [
                                #id "H" 
                                greatestDifference [#id "H" ! "HH–HH"]
                            ] 
                            intervalFormatItem [
                                #id "hm" 
                                greatestDifference [#id "h" ! "h:mm–h:mm a"] 
                                greatestDifference [#id "m" ! "h:mm–h:mm a"]
                            ] 
                            intervalFormatItem [
                                #id "Hm" 
                                greatestDifference [#id "H" ! "HH:mm–HH:mm"] 
                                greatestDifference [#id "m" ! "HH:mm–HH:mm"]
                            ] 
                            intervalFormatItem [
                                #id "hmv" 
                                greatestDifference [#id "a" ! "h:mm a – h:mm a v"]
                            ] 
                            intervalFormatItem [
                                #id "Hmv" 
                                greatestDifference [#id "H" ! "HH:mm–HH:mm v"] 
                                greatestDifference [#id "m" ! "HH:mm–HH:mm v"]
                            ] 
                            intervalFormatItem [
                                #id "hv" 
                                greatestDifference [#id "a" ! "h a – h a v"]
                            ] 
                            intervalFormatItem [
                                #id "Hv" 
                                greatestDifference [#id "H" ! "HH–HH v"]
                            ] 
                            intervalFormatItem [
                                #id "Md" 
                                greatestDifference [#id "d" ! "d/M – d/M"] 
                                greatestDifference [#id "M" ! "d/M – d/M"]
                            ] 
                            intervalFormatItem [
                                #id "MEd" 
                                greatestDifference [#id "d" ! "E, d/M – E, d/M"] 
                                greatestDifference [#id "M" ! "E, M/d–E, M/d"]
                            ] 
                            intervalFormatItem [
                                #id "MMMd" 
                                greatestDifference [#id "d" ! "d–d 'de' MMM"]
                            ] 
                            intervalFormatItem [
                                #id "MMMEd" 
                                greatestDifference [#id "d" ! "E d 'de' MMM – E d 'de' MMM"] 
                                greatestDifference [#id "M" ! "E d 'de' MMM – E d 'de' MMM"]
                            ] 
                            intervalFormatItem [
                                #id "yM" 
                                greatestDifference [#id "M" ! "M/y – M/y"] 
                                greatestDifference [#id "y" ! "M/y – M/y"]
                            ] 
                            intervalFormatItem [
                                #id "yMd" 
                                greatestDifference [#id "d" ! "d/M/y – d/M/y"] 
                                greatestDifference [#id "M" ! "d/M/y – d/M/y"] 
                                greatestDifference [#id "y" ! "d/M/y – d/M/y"]
                            ] 
                            intervalFormatItem [
                                #id "yMEd" 
                                greatestDifference [#id "d" ! "E, d/M/y – E, d/M/y"] 
                                greatestDifference [#id "M" ! "E, d/M/y – E, d/M/y"] 
                                greatestDifference [#id "y" ! "E, d/M/y – E, d/M/y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMM" 
                                greatestDifference [#id "M" ! "MMM–MMM 'de' y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMd" 
                                greatestDifference [#id "d" ! "d–d 'de' MMM 'de' y"] 
                                greatestDifference [#id "M" ! "d 'de' MMM – d 'de' MMM y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMEd" 
                                greatestDifference [#id "d" ! "E d 'de' MMM – E d 'de' MMM 'de' y"] 
                                greatestDifference [#id "M" ! "E d 'de' MMM – E d 'de' MMM 'de' y"] 
                                greatestDifference [#id "y" ! "E d 'de' MMM 'de' y – E d 'de' MMM 'de' y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMM" 
                                greatestDifference [#id "y" ! "MMMM 'de' y – MMMM 'de' y"]
                            ]
                        ]
                    ]
                ]
            ] 
            fields [
                field [
                    #type "year" 
                    relative [#type "-1" ! "el año pasado"] 
                    relative [#type "0" ! "este año"] 
                    relative [#type "1" ! "el año próximo"]
                ] 
                field [
                    #type "year-short" 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "en {0} a"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "en {0} a"]
                    ]
                ] 
                field [
                    #type "year-narrow" 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" ! "en {0} a"] 
                        relativeTimePattern [#count "other" ! "en {0} a"]
                    ]
                ] 
                field [
                    #type "quarter" 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" ! "en {0} trimestre"] 
                        relativeTimePattern [#count "other" ! "dentro de {0} trimetres"]
                    ]
                ] 
                field [
                    #type "quarter-short" 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" ! "en {0} trim."] 
                        relativeTimePattern [#count "other" ! "en {0} trim"]
                    ]
                ] 
                field [
                    #type "quarter-narrow" 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" ! "en {0} trim."] 
                        relativeTimePattern [#count "other" ! "en {0} trim."]
                    ]
                ] 
                field [
                    #type "month" 
                    relative [#type "-1" ! "el mes pasado"] 
                    relative [#type "0" ! "este mes"] 
                    relative [#type "1" ! "el mes próximo"] 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "en {0} mes"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "en {0} meses"]
                    ]
                ] 
                field [
                    #type "month-short" 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" ! "en {0} m"] 
                        relativeTimePattern [#count "other" ! "en {0} m"]
                    ]
                ] 
                field [
                    #type "week" 
                    relative [#type "-1" ! "la semana pasada"] 
                    relative [#type "0" ! "esta semana"] 
                    relative [#type "1" ! "la semana próxima"]
                ] 
                field [
                    #type "week-short" 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "en {0} sem."] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "en {0} sem."]
                    ]
                ] 
                field [
                    #type "weekOfMonth-short" 
                    displayName [! "sem. de m"]
                ] 
                field [
                    #type "weekOfMonth-narrow" 
                    displayName [! "sem. de m"]
                ] 
                field [
                    #type "day-short" 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" #draft "contributed" ! "en {0} día"] 
                        relativeTimePattern [#count "other" #draft "contributed" ! "en {0} días"]
                    ]
                ] 
                field [
                    #type "day-narrow" 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" ! "dentro de {0} día"] 
                        relativeTimePattern [#count "other" ! "en {0} días"]
                    ]
                ] 
                field [
                    #type "dayOfYear-short" 
                    displayName [! "día del a"]
                ] 
                field [
                    #type "dayOfYear-narrow" 
                    displayName [! "día del a"]
                ] 
                field [
                    #type "sun" 
                    relative [#type "-1" ! "el domingo pasado"] 
                    relative [#type "0" ! "este domingo"] 
                    relative [#type "1" ! "el domingo próximo"] 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" ! "dentro de {0} domingo"] 
                        relativeTimePattern [#count "other" ! "dentro de {0} domingos"]
                    ]
                ] 
                field [
                    #type "mon" 
                    relative [#type "-1" ! "el lunes pasado"] 
                    relative [#type "0" ! "este lunes"] 
                    relative [#type "1" ! "el lunes próximo"]
                ] 
                field [
                    #type "tue" 
                    relative [#type "-1" ! "el martes pasado"] 
                    relative [#type "0" ! "este martes"] 
                    relative [#type "1" ! "el martes próximo"] 
                    relativeTime [
                        #type "future" 
                        relativeTimePattern [#count "one" ! "dentro de {0} martes"] 
                        relativeTimePattern [#count "other" ! "dentro de {0} martes"]
                    ]
                ] 
                field [
                    #type "wed" 
                    relative [#type "-1" ! "el miércoles pasado"] 
                    relative [#type "0" ! "este miércoles"] 
                    relative [#type "1" ! "el miércoles próximo"]
                ] 
                field [
                    #type "wed-short" 
                    relative [#type "-1" ! "el miér. pasado"] 
                    relative [#type "0" ! "este miér."] 
                    relative [#type "1" ! "el próximo miér."]
                ] 
                field [
                    #type "thu" 
                    relative [#type "-1" ! "el jueves pasado"] 
                    relative [#type "0" ! "este jueves"] 
                    relative [#type "1" ! "el jueves próximo"]
                ] 
                field [
                    #type "fri" 
                    relative [#type "-1" ! "el viernes pasado"] 
                    relative [#type "0" ! "este viernes"] 
                    relative [#type "1" ! "el viernes próximo"]
                ] 
                field [
                    #type "fri-short" 
                    relative [#type "-1" ! "el vier. pasado"] 
                    relative [#type "0" ! "este vier."] 
                    relative [#type "1" ! "el próximo vier."] 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" ! "hace {0} vie."] 
                        relativeTimePattern [#count "other" ! "hace {0} vie."]
                    ]
                ] 
                field [
                    #type "fri-narrow" 
                    relativeTime [
                        #type "past" 
                        relativeTimePattern [#count "one" ! "hace {0} VI"] 
                        relativeTimePattern [#count "other" ! "hace {0} VI"]
                    ]
                ] 
                field [
                    #type "sat" 
