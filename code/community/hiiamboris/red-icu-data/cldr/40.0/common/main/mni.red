                                month [#type "4" ! "এপ"] 
                                month [#type "5" ! "মে"] 
                                month [#type "6" ! "জুন"] 
                                month [#type "7" ! "জুল"] 
                                month [#type "8" ! "আ"] 
                                month [#type "9" ! "সে"] 
                                month [#type "10" ! "ও"] 
                                month [#type "11" ! "নব"] 
                                month [#type "12" ! "ডি"]
                            ] 
                            monthWidth [
                                #type "wide" 
                                month [#type "1" ! "জানুৱারি"] 
                                month [#type "2" ! "ফেব্রুৱারি"] 
                                month [#type "3" ! "মার্চ"] 
                                month [#type "4" ! "এপ্রিল"] 
                                month [#type "5" ! "মে"] 
                                month [#type "6" ! "জুন"] 
