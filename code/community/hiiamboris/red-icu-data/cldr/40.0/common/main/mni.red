                                day [#type "thu" ! "শগোলশেন"] 
                                day [#type "fri" ! "ইরাই"] 
                                day [#type "sat" ! "থাংজ"]
                            ] 
                            dayWidth [
                                #type "narrow" 
                                day [#type "sun" ! "নো"] 
                                day [#type "mon" ! "নিং"] 
                                day [#type "tue" ! "লৈ"] 
                                day [#type "wed" ! "য়ুম"] 
                                day [#type "thu" ! "শগ"] 
                                day [#type "fri" ! "ইরা"] 
                                day [#type "sat" ! "থাং"]
                            ] 
                            dayWidth [
                                #type "wide" 
                                day [#type "sun" ! "নোংমাইজিং"] 
                                day [#type "mon" ! "নিংথৌকাবা"] 
                                day [#type "tue" ! "লৈবাকপোকপা"] 
                                day [#type "wed" ! "য়ুমশকৈশা"] 
                                day [#type "thu" ! "শগোলশেন"] 
                                day [#type "fri" ! "ইরাই"] 
                                day [#type "sat" ! "থাংজ"]
                            ]
