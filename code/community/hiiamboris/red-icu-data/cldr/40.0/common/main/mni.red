                territory [#type "DE" ! "জর্মনি"] 
                territory [#type "FR" ! "ফ্রান্স"] 
                territory [#type "GB" ! "য়ুনাইটেদ কিংদম"] 
                territory [#type "IN" ! "ইন্দিয়া"] 
                territory [#type "IT" ! "ইটালি"] 
                territory [#type "JP" ! "জাপান"] 
                territory [#type "RU" ! "রুসিয়া"] 
                territory [#type "US" ! "য়ুনাইটেদ ষ্টেটস"] 
                territory [#type "ZZ" ! "মশকখংদবা লমদম"]
            ] 
            types [
                type [#key "calendar" #type "gregorian" ! "গ্রিগোরিয়ান কেলেন্দর"] 
                type [#key "collation" #type "standard" ! "ষ্টেন্দর্দ সোর্ট ওর্দর"] 
                type [#key "numbers" #type "beng" ! "বাংলা দিজিট"] 
                type [#key "numbers" #type "latn" ! "ৱেস্তর্ন দিজিট"]
            ] 
            measurementSystemNames [
                measurementSystemName [#type "metric" ! "মেত্রিক"] 
                measurementSystemName [#type "UK" ! "য়ু কে"] 
                measurementSystemName [#type "US" ! "য়ু এস"]
            ] 
            codePatterns [
                codePattern [#type "language" ! "লোল: {0}"] 
                codePattern [#type "script" ! "স্ক্রিপ্ট: {0}"] 
                codePattern [#type "territory" ! "লমদম: {0}"]
            ]
        ] 
        characters [
            exemplarCharacters [#draft "contributed" ! {[\u09BC \u0981 ং ঃ অ আ ই ঈ উ ঊ ঋ এ ঐ ও ঔ ক খ গ ঘ ঙ চ ছ জ ঝ ঞ ট ঠ ড {ড\u09BC} ঢ {ঢ\u09BC} ণ ত থ দ ধ ন প ফ ব ভ ম য {য\u09BC} র ল ৱ শ ষ স হ া ি ী \u09C1 \u09C2 \u09C3 ে ৈ ো ৌ \u09CD]}] 
            exemplarCharacters [#type "auxiliary" ! "[\u200C\u200D]"] 
            exemplarCharacters [#type "numbers" #draft "contributed" ! "[\- ‑ , . % ‰ + 0০ 1১ 2২ 3৩ 4৪ 5৫ 6৬ 7৭ 8৮ 9৯]"] 
            exemplarCharacters [#type "punctuation" #draft "contributed" ! {[\- ‐ ‑ – — , ; \: ! ? . … ' ‘ ’ &quot; “ ” ( ) \[ \] § @ * / \&amp; # † ‡ ′ ″]}]
        ] 
        dates [
            calendars [
                calendar [
                    #type "generic" 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
                            dateFormat [
                                pattern [! "MMMM d, y G, EEEE"] 
                                datetimeSkeleton [! "GyMMMMEEEEd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "long" 
                            dateFormat [
                                pattern [! "MMMM d, y G"] 
                                datetimeSkeleton [! "GyMMMMd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "medium" 
                            dateFormat [
                                pattern [! "MMM d, y G"] 
                                datetimeSkeleton [! "GyMMMd"]
                            ]
                        ] 
                        dateFormatLength [
                            #type "short" 
                            dateFormat [
                                pattern [! "M/d/y GGGGG"] 
                                datetimeSkeleton [! "GGGGGyMd"]
                            ]
                        ]
                    ] 
                    dateTimeFormats [
                        dateTimeFormatLength [
                            #type "full" 
                            dateTimeFormat [
                                pattern [! "{1} গী {0} দা"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "long" 
                            dateTimeFormat [
                                pattern [! "{1} গী {0} দা"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "medium" 
                            dateTimeFormat [
                                pattern [! "{1} {0}"]
                            ]
                        ] 
                        dateTimeFormatLength [
                            #type "short" 
                            dateTimeFormat [
                                pattern [! "{1}, {0}"]
                            ]
                        ] 
                        intervalFormats [
                            intervalFormatFallback [! "{0} - {1}"]
                        ]
                    ]
                ] 
                calendar [
                    #type "gregorian" 
                    months [
                        monthContext [
                            #type "format" 
                            monthWidth [
                                #type "abbreviated" 
                                month [#type "1" ! "জানুৱারি"] 
