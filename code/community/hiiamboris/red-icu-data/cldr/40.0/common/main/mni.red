                    ] 
                    eras [
                        eraAbbr [
                            era [#type "0" ! "খৃ: মমাং"] 
                            era [#type "0" #alt "variant" ! "বি সি ই"] 
                            era [#type "1" ! "খৃ: মতুং"] 
                            era [#type "1" #alt "variant" ! "সি ই"]
                        ]
                    ] 
                    dateFormats [
                        dateFormatLength [
                            #type "full" 
