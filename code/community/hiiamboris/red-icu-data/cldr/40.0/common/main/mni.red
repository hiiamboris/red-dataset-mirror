
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "mni"]
        ] 
        localeDisplayNames [
            localeDisplayPattern [
                localePattern [! "{0} ({1})"] 
                localeSeparator [! "{0}, {1}"] 
                localeKeyTypePattern [! "{0}: {1}"]
            ] 
            languages [
                language [#type "de" ! "জর্মন"] 
                language [#type "de_AT" ! "ওষ্ট্রিয়ান জর্মন"] 
                language [#type "de_CH" ! "স্বিজ হায় জর্মন"] 
                language [#type "en" ! "ইংলিস"] 
                language [#type "en_AU" ! "ওষ্ট্রেলিয়ান ইংলিস"] 
                language [#type "en_CA" ! "কানাদিয়ান ইংলিস"] 
                language [#type "en_GB" ! "ব্রিটিশ ইংলিস"] 
                language [#type "en_GB" #alt "short" ! "য়ু কে ইংলিস"] 
                language [#type "en_US" ! "অমেরিকান ইংলিস"] 
                language [#type "en_US" #alt "short" ! "য়ু এস ইংলিস"] 
                language [#type "es" ! "স্পেনিস"] 
                language [#type "es_419" ! "লেটিন অমেরিকান স্পেনিস"] 
                language [#type "es_ES" ! "য়ুরোপিয়ান স্পেনিস"] 
                language [#type "es_MX" ! "মেক্সিকান স্পেনিস"] 
                language [#type "fr" ! "ফ্রেঞ্চ"] 
                language [#type "fr_CA" ! "কানাদিয়ান ফ্রেঞ্চ"] 
                language [#type "fr_CH" ! "স্বিজ ফ্রেঞ্চ"] 
                language [#type "it" ! "ইটালিয়ন"] 
                language [#type "ja" ! "জাপানিজ"] 
                language [#type "mni" ! "মৈতৈলোন্"] 
                language [#type "pt" ! "পোর্টুগিজ"] 
                language [#type "pt_BR" ! "ব্রাজিলিয়ান পোর্টুগিজ"] 
                language [#type "pt_PT" ! "য়ুরোপিয়ান পোর্টুগিজ"] 
                language [#type "ru" ! "রুসিয়ান"] 
                language [#type "und" ! "মশকখংদবা লোল"] 
                language [#type "zh" ! "চাইনিজ"] 
                language [#type "zh" #alt "menu" ! "চাইনিজ মন্দারিন"] 
                language [#type "zh_Hans" ! "সিমপ্লিফাইদ চাইনিজ"] 
                language [#type "zh_Hans" #alt "long" ! "সিমপ্লিফাইদ মন্দারিন চাইনিজ"] 
                language [#type "zh_Hant" ! "ত্রেদিস্নেল চাইনিজ"] 
                language [#type "zh_Hant" #alt "long" ! "ত্রেদিস্নেল মন্দারিন চাইনিজ"]
            ] 
            scripts [
                script [#type "Arab" ! "আরবিক"] 
                script [#type "Beng" ! "বাংলা"] 
                script [#type "Cyrl" ! "সিরিলিক"] 
                script [#type "Hans" ! "লাইথোকহল্লবা"] 
                script [#type "Hans" #alt "stand-alone" ! "লাইথোকহল্লবা চাইনিজ"] 
                script [#type "Hant" ! "ত্রেদিস্নেল"] 
                script [#type "Hant" #alt "stand-alone" ! "ত্রেদিস্নেল চাইনিজ"] 
                script [#type "Latn" ! "লেটিন"] 
                script [#type "Mtei" #draft "contributed" ! "মেইটেই মায়েক"] 
                script [#type "Zxxx" ! "ইদবা"] 
                script [#type "Zzzz" ! "মশকখংদবা স্ক্রিপ্ট"]
