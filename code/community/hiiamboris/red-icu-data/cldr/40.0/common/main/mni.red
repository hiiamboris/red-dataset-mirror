                ] 
                field [
                    #type "day-narrow" 
                    displayName [! "নুমিৎ"] 
                    relative [#type "-1" ! "ঙরাং"] 
                    relative [#type "0" ! "ঙসি"] 
                    relative [#type "1" ! "হয়েং"]
                ] 
                field [
                    #type "weekday" 
                    displayName [! "চয়োলগী নুমিৎ"]
                ] 
                field [
                    #type "dayperiod" 
                    displayName [! "এ এম/পি এম"]
                ] 
                field [
                    #type "hour" 
                    displayName [! "পুং"]
                ] 
                field [
                    #type "minute" 
                    displayName [! "মিনট"]
                ] 
                field [
                    #type "minute-short" 
                    displayName [! "মিনট"]
                ] 
                field [
                    #type "minute-narrow" 
                    displayName [! "মিনট"]
                ] 
                field [
                    #type "second" 
                    displayName [! "সেকেণ্ড"]
                ] 
                field [
                    #type "zone" 
                    displayName [! "টাইম জোন"]
                ]
            ] 
            timeZoneNames [
                hourFormat [! "+HH:mm;-HH:mm"] 
                gmtFormat [! "জি এম টি {0}"] 
                gmtZeroFormat [! "জি এম টি"] 
                regionFormat [! "{0} টাইম"] 
                regionFormat [#type "daylight" ! "{0} (+1) দেলাইট টাইম"] 
                regionFormat [#type "standard" ! "{0} (+0) ষ্টেন্দর্দ টাইম"] 
                fallbackFormat [! "{1} ({0})"] 
                zone [
                    #type "Etc/UTC" 
                    long [
                        standard [! "কোওর্দিনেটেদ য়ুনিভর্সেল টাইম"]
                    ]
                ] 
                zone [
                    #type "Etc/Unknown" 
                    exemplarCity [! "মশকখংদবা সিটী"]
                ] 
                metazone [
                    #type "America_Central" 
                    long [
                        generic [! "নোর্থ অমেরিকান সেন্ত্রেল টাইম"] 
                        standard [! "নোর্থ অমেরিকান সেন্ত্রেল ষ্টেন্দর্দ টাইম"] 
                        daylight [! "নোর্থ অমেরিকান সেন্ত্রেল দেলাইট টাইম"]
                    ]
                ] 
                metazone [
                    #type "America_Eastern" 
                    long [
                        generic [! "নোর্থ অমেরিকান ইষ্টর্ন টাইম"] 
                        standard [! "নোর্থ অমেরিকান ইষ্টর্ন ষ্টেন্দর্দ টাইম"] 
                        daylight [! "নোর্থ অমেরিকান ইষ্টর্ন দেলাইট টাইম"]
                    ]
                ] 
                metazone [
                    #type "America_Mountain" 
                    long [
                        generic [! "নোর্থ অমেরিকান মাউন্টেন টাইম"] 
                        standard [! "নোর্থ অমেরিকান মাউন্টেন ষ্টেন্দর্দ টাইম"] 
                        daylight [! "নোর্থ অমেরিকান মাউন্টেন দেলাইট টাইম"]
                    ]
                ] 
                metazone [
                    #type "America_Pacific" 
                    long [
                        generic [! "নোর্থ অমেরিকান পেসিফিক টাইম"] 
                        standard [! "নোর্থ অমেরিকান পেসিফিক ষ্টেন্দর্দ টাইম"] 
                        daylight [! "নোর্থ অমেরিকান পেসিফিক দেলাইট টাইম"]
                    ]
                ] 
                metazone [
                    #type "Atlantic" 
                    long [
                        generic [! "অটলান্টিক টাইম"] 
                        standard [! "অটলান্টিক ষ্টেন্দর্দ টাইম"] 
                        daylight [! "অটলান্টিক দেলাইট টাইম"]
                    ]
                ] 
                metazone [
                    #type "Europe_Central" 
                    long [
                        generic [! "সেন্ত্রেল য়ুরোপিয়ান টাইম"] 
                        standard [! "সেন্ত্রেল য়ুরোপিয়ান ষ্টেন্দর্দ টাইম"] 
                        daylight [! "সেন্ত্রেল য়ুরোপিয়ান সমর টাইম"]
                    ]
                ] 
                metazone [
                    #type "Europe_Eastern" 
                    long [
                        generic [! "ইষ্টর্ন য়ুরোপিয়ান টাইম"] 
                        standard [! "ইষ্টর্ন য়ুরোপিয়ান ষ্টেন্দর্দ টাইম"] 
                        daylight [! "ইষ্টর্ন য়ুরোপিয়ান সমর টাইম"]
                    ]
                ] 
                metazone [
                    #type "Europe_Western" 
                    long [
                        generic [! "ৱেষ্টর্ন য়ুরোপিয়ান টাইম"] 
                        standard [! "ৱেষ্টর্ন য়ুরোপিয়ান ষ্টেন্দর্দ টাইম"] 
                        daylight [! "ৱেষ্টর্ন য়ুরোপিয়ান সমর টাইম"]
                    ]
                ] 
                metazone [
                    #type "GMT" 
                    long [
                        standard [! "গ্রিনৱিচ মিন টাইম"]
                    ]
                ]
            ]
        ] 
        numbers [
            defaultNumberingSystem [! "beng"] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"]
            ] 
            currencies [
                currency [
                    #type "BRL" 
                    displayName [! "ব্রাজিলিয়ান রেয়াল"] 
                    displayName [#count "other" ! "ব্রাজিলিয়ান রেয়াল"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "চাইনিজ য়ুআন"] 
                    displayName [#count "other" ! "চাইনিজ য়ুআন"]
                ] 
                currency [
                    #type "EUR" 
                    displayName [! "য়ুরো"] 
                    displayName [#count "other" ! "য়ুরো"]
                ] 
                currency [
                    #type "GBP" 
                    displayName [! "ব্রিটিশ পাউন্দ"] 
                    displayName [#count "other" ! "ব্রিটিশ পাউন্দ"]
                ] 
                currency [
                    #type "INR" 
                    displayName [! "ইন্দিয়ান রুপী"] 
                    displayName [#count "other" ! "ইন্দিয়ান রুপী"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [! "জাপানিজ য়েন"] 
                    displayName [#count "other" ! "জাপানিজ য়েন"]
                ] 
                currency [
                    #type "RUB" 
                    displayName [! "রুসিয়ান রুবল"] 
                    displayName [#count "other" ! "রুসিয়ান রুবল"]
                ] 
                currency [
                    #type "USD" 
                    displayName [! "য়ু এস দি"] 
                    displayName [#count "other" ! "য়ু এস দি"] 
                    symbol [#draft "contributed" ! "$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "$"]
                ] 
                currency [
                    #type "XXX" 
                    displayName [! "মশকখংদবা করেন্সি"] 
                    displayName [#count "other" ! "মশকখংদবা করেন্সি"]
                ]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0} অমসুং {1}"] 
                listPatternPart [#type "2" ! "{0} অমসুং {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [! "য়েস:y"] 
                nostr [! "নো:n"]
            ]
        ]
    ]

