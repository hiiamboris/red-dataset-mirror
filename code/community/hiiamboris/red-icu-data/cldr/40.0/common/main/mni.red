                    quarters [
                        quarterContext [
                            #type "format" 
                            quarterWidth [
                                #type "abbreviated" 
                                quarter [#type "1" ! "অহানবা মসুং"] 
                                quarter [#type "2" ! "অনীশুবা মসুং"] 
                                quarter [#type "3" ! "অহুমশুবা মসুং"] 
                                quarter [#type "4" ! "মরীশুবা মসুং"]
                            ] 
                            quarterWidth [
                                #type "wide" 
                                quarter [#type "1" ! "অহানবা মসুং"] 
                                quarter [#type "2" ! "অনীশুবা মসুং"] 
                                quarter [#type "3" ! "অহুমশুবা মসুং"] 
                                quarter [#type "4" ! "মরীশুবা মসুং"]
