                                day [#type "tue" ! "লৈবাকপোকপা"] 
                                day [#type "wed" ! "য়ুমশকৈশা"] 
                                day [#type "thu" ! "শগোলশেন"] 
                                day [#type "fri" ! "ইরাই"] 
                                day [#type "sat" ! "থাংজ"]
                            ]
                        ] 
                        dayContext [
