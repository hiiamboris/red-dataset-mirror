            scripts [
                script [#type "Arab" ! "अरबी"] 
                script [#type "Cyrl" ! "सिरिलिक"] 
                script [#type "Deva" ! "देवनागरी"] 
                script [#type "Hans" ! "सरलीकृत"] 
