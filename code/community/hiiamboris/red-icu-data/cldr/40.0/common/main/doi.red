            types [
                type [#key "calendar" #type "gregorian" ! "ग्रेगोरी कैलेन्डर"] 
                type [#key "collation" #type "standard" ! "मानक ताल तरतीब"] 
                type [#key "numbers" #type "arab" ! "अरबी-इंडिक अंक"] 
                type [#key "numbers" #type "deva" ! "देवनागरी अंक"] 
