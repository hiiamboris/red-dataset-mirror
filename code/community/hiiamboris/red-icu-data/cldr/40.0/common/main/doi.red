
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "doi"]
        ] 
        localeDisplayNames [
            localeDisplayPattern [
                localePattern [! "{0} ({1})"] 
                localeSeparator [! "{0}, {1}"] 
                localeKeyTypePattern [! "{0}: {1}"]
            ] 
            languages [
                language [#type "de" ! "जर्मन"] 
                language [#type "de_AT" ! "आस्ट्रियाई जर्मन"] 
                language [#type "de_CH" ! "स्विस हाई जर्मन"] 
                language [#type "doi" ! "डोगरी"] 
                language [#type "en" ! "अंगरेजी"] 
                language [#type "en_CA" ! "कैनेडियन अंगरेजी"] 
                language [#type "en_GB" ! "ब्रिटिश अंगरेजी"] 
                language [#type "en_GB" #alt "short" ! "यूके अंगरेजी"] 
                language [#type "en_US" ! "अमरीकी अंगरेजी"] 
                language [#type "en_US" #alt "short" ! "यूएस अंगरेजी"] 
                language [#type "es" ! "स्पैनिश"] 
                language [#type "es_419" ! "लैटिन अमरीकी स्पैनिश"] 
                language [#type "es_ES" ! "यूरोपी स्पैनिश"] 
                language [#type "es_MX" ! "मैक्सिन स्पैनिश"] 
                language [#type "fr" ! "फ्रेंच"] 
                language [#type "fr_CA" ! "कैनेडियन फ्रेंच"] 
                language [#type "fr_CH" ! "स्विस फ्रेंच"] 
                language [#type "it" ! "इटालियन"] 
                language [#type "ja" ! "जापानी"] 
                language [#type "pt" ! "पुर्तगाली"] 
                language [#type "pt_BR" ! "ब्राजीली पुर्तगाली"] 
                language [#type "pt_PT" ! "यूरोपी पुर्तगाली"] 
                language [#type "ru" ! "रूसी"] 
                language [#type "und" ! "अनजांती भाशा"] 
                language [#type "zh" ! "चीनी"] 
                language [#type "zh" #alt "menu" ! "चीनी, मंदारिन"] 
                language [#type "zh_Hans" ! "सरलीकृत चीनी"] 
                language [#type "zh_Hans" #alt "long" ! "सरलीकृत मंदारिन चीनी"] 
