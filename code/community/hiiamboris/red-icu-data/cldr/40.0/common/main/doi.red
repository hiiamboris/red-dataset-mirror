                            dateFormatItem [#id "yMd" ! "d/M/y"] 
                            dateFormatItem [#id "yMEd" ! "E, d/M/y"] 
                            dateFormatItem [#id "yMMM" ! "MMM y"] 
                            dateFormatItem [#id "yMMMd" ! "d, MMM y"] 
                            dateFormatItem [#id "yMMMEd" ! "E, d, MMM y"] 
                            dateFormatItem [#id "yMMMM" ! "MMMM y"] 
                            dateFormatItem [#id "yQQQ" ! "QQQ y"] 
                            dateFormatItem [#id "yQQQQ" ! "QQQQ y"] 
                            dateFormatItem [#id "yw" #count "one" ! "Y दा हफ्ता w"] 
                            dateFormatItem [#id "yw" #count "other" ! "Y दा हफ्ता w"]
                        ] 
                        appendItems [
                            appendItem [#request "Timezone" ! "{0} {1}"]
                        ] 
                        intervalFormats [
                            intervalFormatFallback [! "{0} – {1}"] 
                            intervalFormatItem [
                                #id "Bh" 
                                greatestDifference [#id "B" ! "h B – h B"] 
                                greatestDifference [#id "h" ! "h – h B"]
                            ] 
                            intervalFormatItem [
                                #id "Bhm" 
                                greatestDifference [#id "B" ! "h:mm B – h:mm B"] 
                                greatestDifference [#id "h" ! "h:mm – h:mm B"] 
                                greatestDifference [#id "m" ! "h:mm – h:mm B"]
                            ] 
                            intervalFormatItem [
                                #id "d" 
                                greatestDifference [#id "d" ! "d – d"]
                            ] 
                            intervalFormatItem [
                                #id "Gy" 
                                greatestDifference [#id "G" ! "y G – y G"] 
                                greatestDifference [#id "y" ! "y – y G"]
                            ] 
                            intervalFormatItem [
                                #id "GyM" 
                                greatestDifference [#id "G" ! "M/y GGGGG – M/y GGGGG"] 
                                greatestDifference [#id "M" ! "M/y – M/y GGGGG"] 
                                greatestDifference [#id "y" ! "M/y – M/y GGGGG"]
                            ] 
                            intervalFormatItem [
                                #id "GyMd" 
                                greatestDifference [#id "d" ! "M/d/y – M/d/y GGGGG"] 
                                greatestDifference [#id "G" ! "M/d/y GGGGG – M/d/y GGGGG"] 
                                greatestDifference [#id "M" ! "M/d/y – M/d/y GGGGG"] 
                                greatestDifference [#id "y" ! "M/d/y – M/d/y GGGGG"]
                            ] 
                            intervalFormatItem [
                                #id "GyMEd" 
                                greatestDifference [#id "d" ! "E, M/d/y – E, M/d/y GGGGG"] 
                                greatestDifference [#id "G" ! "E, M/d/y GGGGG – E, M/d/y GGGGG"] 
                                greatestDifference [#id "M" ! "E, M/d/y – E, M/d/y GGGGG"] 
                                greatestDifference [#id "y" ! "E, M/d/y – E, M/d/y GGGGG"]
                            ] 
                            intervalFormatItem [
                                #id "GyMMM" 
                                greatestDifference [#id "G" ! "MMM y G – MMM y G"] 
                                greatestDifference [#id "M" ! "MMM – MMM y G"] 
                                greatestDifference [#id "y" ! "MMM y – MMM y G"]
                            ] 
                            intervalFormatItem [
                                #id "GyMMMd" 
                                greatestDifference [#id "d" ! "MMM d – d, y G"] 
                                greatestDifference [#id "G" ! "MMM d, y G – MMM d, y G"] 
                                greatestDifference [#id "M" ! "MMM d – MMM d, y G"] 
                                greatestDifference [#id "y" ! "MMM d, y – MMM d, y G"]
                            ] 
                            intervalFormatItem [
                                #id "GyMMMEd" 
                                greatestDifference [#id "d" ! "E, MMM d – E, MMM d, y G"] 
                                greatestDifference [#id "G" ! "E, MMM d, y G – E, MMM d, y G"] 
                                greatestDifference [#id "M" ! "E, MMM d – E, MMM d, y G"] 
                                greatestDifference [#id "y" ! "E, MMM d, y – E, MMM d, y G"]
                            ] 
                            intervalFormatItem [
                                #id "h" 
                                greatestDifference [#id "a" ! "h a – h a"] 
                                greatestDifference [#id "h" ! "h – h a"]
                            ] 
                            intervalFormatItem [
                                #id "H" 
                                greatestDifference [#id "H" ! "HH – HH"]
                            ] 
                            intervalFormatItem [
                                #id "hm" 
                                greatestDifference [#id "a" ! "h:mm a – h:mm a"] 
                                greatestDifference [#id "h" ! "h:mm – h:mm a"] 
                                greatestDifference [#id "m" ! "h:mm – h:mm a"]
                            ] 
                            intervalFormatItem [
                                #id "Hm" 
                                greatestDifference [#id "H" ! "HH:mm – HH:mm"] 
                                greatestDifference [#id "m" ! "HH:mm – HH:mm"]
                            ] 
                            intervalFormatItem [
                                #id "hmv" 
                                greatestDifference [#id "a" ! "h:mm a – h:mm a v"] 
                                greatestDifference [#id "h" ! "h:mm – h:mm a v"] 
                                greatestDifference [#id "m" ! "h:mm – h:mm a v"]
                            ] 
                            intervalFormatItem [
                                #id "Hmv" 
                                greatestDifference [#id "H" ! "HH:mm – HH:mm v"] 
                                greatestDifference [#id "m" ! "HH:mm – HH:mm v"]
                            ] 
                            intervalFormatItem [
                                #id "hv" 
                                greatestDifference [#id "a" ! "h a – h a v"] 
                                greatestDifference [#id "h" ! "h – h a v"]
                            ] 
                            intervalFormatItem [
                                #id "Hv" 
                                greatestDifference [#id "H" ! "HH – HH v"]
                            ] 
                            intervalFormatItem [
                                #id "M" 
                                greatestDifference [#id "M" ! "M – M"]
                            ] 
                            intervalFormatItem [
                                #id "Md" 
                                greatestDifference [#id "d" ! "M/d – M/d"] 
                                greatestDifference [#id "M" ! "M/d – M/d"]
                            ] 
                            intervalFormatItem [
                                #id "MEd" 
                                greatestDifference [#id "d" ! "E, M/d – E, M/d"] 
                                greatestDifference [#id "M" ! "E, M/d – E, M/d"]
                            ] 
                            intervalFormatItem [
                                #id "MMM" 
                                greatestDifference [#id "M" ! "MMM – MMM"]
                            ] 
                            intervalFormatItem [
                                #id "MMMd" 
                                greatestDifference [#id "d" ! "MMM d – d"] 
                                greatestDifference [#id "M" ! "MMM d – MMM d"]
                            ] 
                            intervalFormatItem [
                                #id "MMMEd" 
                                greatestDifference [#id "d" ! "E, MMM d – E, MMM d"] 
                                greatestDifference [#id "M" ! "E, MMM d – E, MMM d"]
                            ] 
                            intervalFormatItem [
                                #id "y" 
                                greatestDifference [#id "y" ! "y – y"]
                            ] 
                            intervalFormatItem [
                                #id "yM" 
                                greatestDifference [#id "M" ! "M/y – M/y"] 
                                greatestDifference [#id "y" ! "M/y – M/y"]
                            ] 
                            intervalFormatItem [
                                #id "yMd" 
                                greatestDifference [#id "d" ! "M/d/y – M/d/y"] 
                                greatestDifference [#id "M" ! "M/d/y – M/d/y"] 
                                greatestDifference [#id "y" ! "M/d/y – M/d/y"]
                            ] 
                            intervalFormatItem [
                                #id "yMEd" 
                                greatestDifference [#id "d" ! "E, M/d/y – E, M/d/y"] 
                                greatestDifference [#id "M" ! "E, M/d/y – E, M/d/y"] 
                                greatestDifference [#id "y" ! "E, M/d/y – E, M/d/y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMM" 
                                greatestDifference [#id "M" ! "MMM – MMM y"] 
                                greatestDifference [#id "y" ! "MMM y – MMM y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMd" 
                                greatestDifference [#id "d" ! "MMM d – d, y"] 
                                greatestDifference [#id "M" ! "MMM d – MMM d, y"] 
                                greatestDifference [#id "y" ! "MMM d, y – MMM d, y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMEd" 
                                greatestDifference [#id "d" ! "E, MMM d – E, MMM d, y"] 
                                greatestDifference [#id "M" ! "E, MMM d – E, MMM d, y"] 
                                greatestDifference [#id "y" ! "E, MMM d, y – E, MMM d, y"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMM" 
                                greatestDifference [#id "M" ! "MMMM – MMMM y"] 
                                greatestDifference [#id "y" ! "MMMM y – MMMM y"]
                            ]
                        ]
                    ]
                ]
            ] 
            fields [
                field [
                    #type "era" 
                    displayName [! "जुग"]
                ] 
                field [
                    #type "year" 
                    displayName [! "ब’रा"]
                ] 
                field [
                    #type "year-short" 
                    displayName [! "ब."]
                ] 
                field [
                    #type "year-narrow" 
                    displayName [! "ब."]
                ] 
                field [
                    #type "quarter" 
                    displayName [! "त्रमाही"]
                ] 
                field [
                    #type "quarter-short" 
                    displayName [! "त्रमा."]
                ] 
                field [
                    #type "quarter-narrow" 
                    displayName [! "त्रमा."]
                ] 
                field [
                    #type "month" 
                    displayName [! "म्हीना"]
                ] 
                field [
                    #type "month-short" 
                    displayName [! "म्ही."]
                ] 
                field [
                    #type "month-narrow" 
                    displayName [! "म्ही."]
                ] 
                field [
                    #type "week" 
                    displayName [! "हफ्ता"]
                ] 
                field [
                    #type "week-short" 
                    displayName [! "ह."]
                ] 
                field [
                    #type "week-narrow" 
                    displayName [! "ह."]
                ] 
                field [
                    #type "day" 
                    displayName [! "दिन"] 
                    relative [#type "-1" ! "जंदा कल"] 
                    relative [#type "0" ! "अज्ज"] 
                    relative [#type "1" ! "औंदे कल"]
                ] 
                field [
                    #type "day-short" 
                    displayName [! "दिन"] 
                    relative [#type "-1" ! "जंदा कल"] 
                    relative [#type "0" ! "अज्ज"] 
                    relative [#type "1" ! "औंदे कल"]
                ] 
                field [
                    #type "day-narrow" 
                    displayName [! "दिन"] 
                    relative [#type "-1" ! "जंदा कल"] 
                    relative [#type "0" ! "अज्ज"] 
                    relative [#type "1" ! "औंदे कल"]
                ] 
                field [
                    #type "weekday" 
                    displayName [! "हफ्ते दा दिन"]
                ] 
                field [
                    #type "dayperiod" 
                    displayName [! "सवेर/बा.दपै."]
                ] 
                field [
                    #type "hour" 
                    displayName [! "घैंटा"]
                ] 
                field [
                    #type "hour-short" 
                    displayName [! "घैं."]
                ] 
                field [
                    #type "hour-narrow" 
                    displayName [! "घैं."]
                ] 
                field [
                    #type "minute" 
                    displayName [! "मिंट्‌ट"]
                ] 
                field [
                    #type "minute-short" 
                    displayName [! "मिं."]
                ] 
                field [
                    #type "minute-narrow" 
                    displayName [! "मिं."]
                ] 
                field [
                    #type "second" 
                    displayName [! "सकैंट"]
                ] 
                field [
                    #type "second-short" 
                    displayName [! "सकैं."]
                ] 
                field [
                    #type "second-narrow" 
                    displayName [! "सकैं."]
                ] 
                field [
                    #type "zone" 
                    displayName [! "समां खेत्तर"]
                ]
            ] 
            timeZoneNames [
                hourFormat [! "+HH:mm;-HH:mm"] 
                gmtFormat [! "GMT{0}"] 
                gmtZeroFormat [! "GMT"] 
                regionFormat [! "{0} समां"] 
                regionFormat [#type "daylight" ! "{0} डेलाइट समां"] 
                regionFormat [#type "standard" ! "{0} मानक समां"] 
                fallbackFormat [! "{1} ({0})"] 
                zone [
                    #type "Etc/UTC" 
                    long [
                        standard [! "तालमेली आलमी समां"]
                    ]
                ] 
                zone [
                    #type "Etc/Unknown" 
                    exemplarCity [! "अनजांता शैह्‌र"]
                ] 
                zone [
                    #type "Europe/London" 
                    long [
                        daylight [! "ब्रिटिश गर्मियें दा समां"]
                    ]
                ] 
                zone [
                    #type "Europe/Dublin" 
                    long [
                        daylight [! "आयरिश मानक समां"]
                    ]
                ] 
                metazone [
                    #type "America_Central" 
                    long [
                        generic [! "उत्तरी अमरीकी केंदरी समां"] 
                        standard [! "उत्तरी अमरीकी मानक केंदरी समां"] 
                        daylight [! "उत्तरी अमरीकी डेलाइट केंदरी समां"]
                    ]
                ] 
                metazone [
                    #type "America_Eastern" 
                    long [
                        generic [! "उत्तरी अमरीकी पूर्वी समां"] 
                        standard [! "उत्तरी अमरीकी मानक पूर्वी समां"] 
                        daylight [! "उत्तरी अमरीकी डेलाइट पूर्वी समां"]
                    ]
                ] 
                metazone [
                    #type "America_Mountain" 
                    long [
                        generic [! "उत्तरी अमरीकी माउंटेन समां"] 
                        standard [! "उत्तरी अमरीकी मानक माउंटेन समां"] 
                        daylight [! "उत्तरी अमरीकी डेलाइट माउंटेन समां"]
                    ]
                ] 
                metazone [
                    #type "America_Pacific" 
                    long [
                        generic [! "उत्तरी अमरीकी प्रशांत समां"] 
                        standard [! "उत्तरी अमरीकी मानक प्रशांत समां"] 
                        daylight [! "उत्तरी अमरीकी डेलाइट प्रशांत समां"]
                    ]
                ] 
                metazone [
                    #type "Atlantic" 
                    long [
                        generic [! "अटलांटिक समां"] 
                        standard [! "अटलांटिक मानक समां"] 
                        daylight [! "अटलांटिक डेलाइट समां"]
                    ]
                ] 
                metazone [
                    #type "Europe_Central" 
                    long [
                        generic [! "केंदरी यूरोपी समां"] 
                        standard [! "केंदरी यूरोपी मानक समां"] 
                        daylight [! "केंदरी यूरोपी गर्मियें दा समां"]
                    ]
                ] 
                metazone [
                    #type "Europe_Eastern" 
                    long [
                        generic [! "उत्तरी यूरोपी समां"] 
                        standard [! "उत्तरी यूरोपी मानक समां"] 
                        daylight [! "उत्तरी यूरोपी गर्मियें दा समां"]
                    ]
                ] 
                metazone [
                    #type "Europe_Western" 
                    long [
                        generic [! "पच्छमी यूरोपी समां"] 
                        standard [! "पच्छमी यूरोपी मानक समां"] 
                        daylight [! "पच्छमी यूरोपी गर्मियें दा समां"]
                    ]
                ] 
                metazone [
                    #type "GMT" 
                    long [
                        standard [! "ग्रीनविच मीन टाइम"]
                    ]
                ]
            ]
        ] 
        numbers [
            defaultNumberingSystem [#draft "contributed" ! "latn"] 
            otherNumberingSystems [
                native [! "deva"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [! "."] 
                group [! ","] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ]
            ] 
            scientificFormats [
                #numberSystem "latn" 
                scientificFormatLength [
                    scientificFormat [
                        pattern [! "#E0"]
                    ]
                ]
            ] 
            percentFormats [
                #numberSystem "latn" 
                percentFormatLength [
                    percentFormat [
                        pattern [! "#,##0%"]
                    ]
                ]
            ] 
            currencyFormats [
                #numberSystem "latn" 
                currencyFormatLength [
                    currencyFormat [
                        #type "standard" 
                        pattern [! "¤#,##0.00"]
                    ]
                ] 
                unitPattern [#count "one" ! "{0} {1}"] 
                unitPattern [#count "other" ! "{0} {1}"]
            ] 
            currencies [
                currency [
                    #type "BRL" 
                    displayName [! "ब्राजीली रियाल"] 
                    displayName [#count "one" ! "ब्राजीली रियाल"] 
                    displayName [#count "other" ! "ब्राजीली रियाल"] 
                    symbol [#draft "contributed" ! "R$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "R$"]
                ] 
                currency [
                    #type "CNY" 
                    displayName [! "चीनी युआन"] 
                    displayName [#count "one" ! "चीनी युआन"] 
                    displayName [#count "other" ! "चीनी युआन"] 
                    symbol [#draft "contributed" ! "CN¥"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "EUR" 
                    displayName [! "यूरो"] 
                    displayName [#count "one" ! "यूरो"] 
                    displayName [#count "other" ! "यूरो"] 
                    symbol [#draft "contributed" ! "€"] 
                    symbol [#alt "narrow" #draft "contributed" ! "€"]
                ] 
                currency [
                    #type "GBP" 
                    displayName [! "ब्रिटिश पाउंड"] 
                    displayName [#count "one" ! "ब्रिटिश पाउंड"] 
                    displayName [#count "other" ! "ब्रिटिश पाउंड"] 
                    symbol [#draft "contributed" ! "£"] 
                    symbol [#alt "narrow" #draft "contributed" ! "£"]
                ] 
                currency [
                    #type "INR" 
                    displayName [! "भारती रपेऽ"] 
                    displayName [#count "one" ! "भारती रपेऽ"] 
                    displayName [#count "other" ! "भारती रपेऽ"] 
                    symbol [#draft "contributed" ! "₹"] 
                    symbol [#alt "narrow" #draft "contributed" ! "₹"]
                ] 
                currency [
                    #type "JPY" 
                    displayName [! "जापानी येन"] 
                    displayName [#count "one" ! "जापानी येन"] 
                    displayName [#count "other" ! "जापानी येन"] 
                    symbol [#draft "contributed" ! "¥"] 
                    symbol [#alt "narrow" #draft "contributed" ! "¥"]
                ] 
                currency [
                    #type "RUB" 
                    displayName [! "रूसी रूबल"] 
                    displayName [#count "one" ! "रूसी रूबल"] 
                    displayName [#count "other" ! "रूसी रूबल"] 
                    symbol [#draft "contributed" ! "RUB"] 
                    symbol [#alt "narrow" #draft "contributed" ! "₽"]
                ] 
                currency [
                    #type "USD" 
                    displayName [! "यूएस डालर"] 
                    displayName [#count "one" ! "यूएस डालर"] 
                    displayName [#count "other" ! "यूएस डालर"] 
                    symbol [#draft "contributed" ! "$"] 
                    symbol [#alt "narrow" #draft "contributed" ! "$"]
                ] 
                currency [
                    #type "XXX" 
                    displayName [! "अनजांती करंसी"] 
                    displayName [#count "one" ! "(अनजांती करंसी)"] 
                    displayName [#count "other" ! "(अनजांती करंसी)"]
                ]
            ]
        ] 
        units [
            unitLength [
                #type "narrow" 
                unit [
                    #type "consumption-mile-per-gallon-imperial" 
                    unitPattern [#count "one" ! "{0}m/gUK"] 
                    unitPattern [#count "other" ! "{0}m/gUK"]
                ] 
                unit [
                    #type "force-kilowatt-hour-per-100-kilometer" 
                    unitPattern [#count "one" ! "{0}किल्लोवाट/100किमी"] 
                    unitPattern [#count "other" ! "{0} किल्लोवाट/100किमी"]
                ] 
                unit [
                    #type "volume-gallon-imperial" 
                    unitPattern [#count "one" ! "{0}galIm"] 
                    unitPattern [#count "other" ! "{0}galIm"]
                ] 
                unit [
                    #type "volume-fluid-ounce-imperial" 
                    unitPattern [#count "one" ! "{0}fl oz Im"] 
                    unitPattern [#count "other" ! "{0}fl oz Im"]
                ] 
                unit [
                    #type "volume-dessert-spoon-imperial" 
                    unitPattern [#count "one" ! "{0}dsp-Imp"] 
                    unitPattern [#count "other" ! "{0}dsp-Imp"]
                ]
            ] 
            durationUnit [
                #type "hm" 
                durationUnitPattern [! "h:mm"]
            ] 
            durationUnit [
                #type "hms" 
                durationUnitPattern [! "h:mm:ss"]
            ] 
            durationUnit [
                #type "ms" 
                durationUnitPattern [! "m:ss"]
            ]
        ] 
        listPatterns [
            listPattern [
                listPatternPart [#type "start" ! "{0}, {1}"] 
                listPatternPart [#type "middle" ! "{0}, {1}"] 
                listPatternPart [#type "end" ! "{0}, ते {1}"] 
                listPatternPart [#type "2" ! "{0} ते {1}"]
            ]
        ] 
        posix [
            messages [
                yesstr [! "हां"] 
                nostr [! "नेईं"]
            ]
        ]
    ]

