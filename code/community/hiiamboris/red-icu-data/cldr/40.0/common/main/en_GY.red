
    ldml [
        identity [
            version [#number "$Revision$"] 
            language [#type "en"] 
            territory [#type "GY"]
        ] 
        dates [
            timeZoneNames [
                metazone [
                    #type "Guyana" 
                    short [
                        standard [! "GYT"]
                    ]
                ]
            ]
        ] 
        numbers [
            currencies [
                currency [
                    #type "GYD" 
                    symbol [! "$"]
                ]
            ]
        ]
    ]

