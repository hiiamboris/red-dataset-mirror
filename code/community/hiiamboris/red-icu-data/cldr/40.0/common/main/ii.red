                            monthWidth [
                                #type "wide" 
                                month [#type "1" ! "ꋍꆪ"] 
                                month [#type "2" ! "ꑍꆪ"] 
                                month [#type "3" ! "ꌕꆪ"] 
                                month [#type "4" ! "ꇖꆪ"] 
                                month [#type "5" ! "ꉬꆪ"] 
                                month [#type "6" ! "ꃘꆪ"] 
                                month [#type "7" ! "ꏃꆪ"] 
                                month [#type "8" ! "ꉆꆪ"] 
                                month [#type "9" ! "ꈬꆪ"] 
                                month [#type "10" ! "ꊰꆪ"] 
                                month [#type "11" ! "ꊰꊪꆪ"] 
                                month [#type "12" ! "ꊰꑋꆪ"]
                            ]
                        ] 
                        monthContext [
                            #type "stand-alone" 
