                            dateFormatItem [#id "GyMMMd" ! "G y MMM d"] 
                            dateFormatItem [#id "GyMMMEd" ! "G y MMM d, E"] 
                            dateFormatItem [#id "h" ! "h a"] 
                            dateFormatItem [#id "H" ! "HH"] 
                            dateFormatItem [#id "hm" ! "h:mm a"] 
                            dateFormatItem [#id "Hm" ! "HH:mm"] 
                            dateFormatItem [#id "hms" ! "h:mm:ss a"] 
                            dateFormatItem [#id "Hms" ! "HH:mm:ss"] 
                            dateFormatItem [#id "M" ! "L"] 
                            dateFormatItem [#id "Md" ! "MM-dd"] 
                            dateFormatItem [#id "MEd" ! "MM-dd, E"] 
                            dateFormatItem [#id "MMM" ! "LLL"] 
                            dateFormatItem [#id "MMMd" ! "MMM d"] 
                            dateFormatItem [#id "MMMEd" ! "MMM d, E"] 
                            dateFormatItem [#id "MMMMd" ! "MMMM d"] 
                            dateFormatItem [#id "ms" ! "mm:ss"] 
                            dateFormatItem [#id "y" ! "y"] 
                            dateFormatItem [#id "yM" ! "y-MM"] 
                            dateFormatItem [#id "yMd" ! "y-MM-dd"] 
                            dateFormatItem [#id "yMEd" ! "y-MM-dd, E"] 
                            dateFormatItem [#id "yMMM" ! "y MMM"] 
                            dateFormatItem [#id "yMMMd" ! "y MMM d"] 
                            dateFormatItem [#id "yMMMEd" ! "y MMM d, E"] 
                            dateFormatItem [#id "yMMMM" ! "y MMMM"] 
                            dateFormatItem [#id "yQQQ" ! "y QQQ"] 
                            dateFormatItem [#id "yQQQQ" ! "y QQQQ"]
                        ] 
                        appendItems [
                            appendItem [#request "Timezone" ! "{0} {1}"]
                        ] 
                        intervalFormats [
                            intervalFormatFallback [! "{0} – {1}"] 
                            intervalFormatItem [
                                #id "d" 
                                greatestDifference [#id "d" ! "d–d"]
                            ] 
                            intervalFormatItem [
                                #id "h" 
                                greatestDifference [#id "a" ! "h a – h a"] 
                                greatestDifference [#id "h" ! "h–h a"]
                            ] 
                            intervalFormatItem [
