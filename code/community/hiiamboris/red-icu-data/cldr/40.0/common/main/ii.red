                                quarter [#type "3" ! "3"] 
                                quarter [#type "4" ! "4"]
                            ] 
                            quarterWidth [
                                #type "wide" 
                                quarter [#type "1" ! "ꃅꑌ"] 
                                quarter [#type "2" ! "ꃅꎸ"] 
                                quarter [#type "3" ! "ꃅꍵ"] 
                                quarter [#type "4" ! "ꃅꋆ"]
                            ]
                        ] 
                        quarterContext [
                            #type "stand-alone" 
                            quarterWidth [
                                #type "abbreviated" 
                                quarter [#type "1" ! "ꃅꑌ"] 
                                quarter [#type "2" ! "ꃅꎸ"] 
                                quarter [#type "3" ! "ꃅꍵ"] 
                                quarter [#type "4" ! "ꃅꋆ"]
                            ] 
                            quarterWidth [
