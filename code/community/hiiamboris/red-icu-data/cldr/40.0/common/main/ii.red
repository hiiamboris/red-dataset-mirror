                            ] 
                            intervalFormatItem [
                                #id "y" 
                                greatestDifference [#id "y" ! "y–y"]
                            ] 
                            intervalFormatItem [
                                #id "yM" 
                                greatestDifference [#id "M" ! "y-MM – y-MM"] 
                                greatestDifference [#id "y" ! "y-MM – y-MM"]
                            ] 
                            intervalFormatItem [
                                #id "yMd" 
                                greatestDifference [#id "d" ! "y-MM-dd – y-MM-dd"] 
