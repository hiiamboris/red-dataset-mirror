                            #type "format" 
                            quarterWidth [
                                #type "abbreviated" 
                                quarter [#type "1" ! "ꃅꑌ"] 
                                quarter [#type "2" ! "ꃅꎸ"] 
                                quarter [#type "3" ! "ꃅꍵ"] 
                                quarter [#type "4" ! "ꃅꋆ"]
                            ] 
                            quarterWidth [
