                                greatestDifference [#id "y" ! "y MMMM – y MMMM"]
                            ]
                        ]
                    ]
                ]
            ] 
            fields [
                field [
                    #type "era" 
                    displayName [! "ꃅꋊ"]
                ] 
                field [
                    #type "year" 
                    displayName [! "ꈎ"]
                ] 
                field [
                    #type "month" 
                    displayName [! "ꆪ"]
                ] 
                field [
                    #type "week" 
                    displayName [! "ꑭꆏ"]
                ] 
                field [
                    #type "day" 
