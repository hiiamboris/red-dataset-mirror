                                month [#type "11" ! "ꊰꊪꆪ"] 
                                month [#type "12" ! "ꊰꑋꆪ"]
                            ] 
                            monthWidth [
                                #type "narrow" 
                                month [#type "1" ! "1"] 
                                month [#type "2" ! "2"] 
                                month [#type "3" ! "3"] 
                                month [#type "4" ! "4"] 
                                month [#type "5" ! "5"] 
                                month [#type "6" ! "6"] 
                                month [#type "7" ! "7"] 
                                month [#type "8" ! "8"] 
                                month [#type "9" ! "9"] 
