                                greatestDifference [#id "y" ! "y MMM – y MMM"]
                            ] 
                            intervalFormatItem [
                                #id "yMMMd" 
                                greatestDifference [#id "d" ! "y MMM d–d"] 
                                greatestDifference [#id "M" ! "y MMM d – MMM d"] 
                                greatestDifference [#id "y" ! "y MMM d – y MMM d"]
