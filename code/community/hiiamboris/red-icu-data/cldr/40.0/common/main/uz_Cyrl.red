        numbers [
            symbols [
                #numberSystem "arabext" 
                decimal [! "٫"] 
                group [! "٬"] 
                percentSign [! "٪"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "×۱۰^^"] 
                superscriptingExponent [! "×"] 
                perMille [! "؉"] 
                infinity [! "∞"] 
                nan [! "ҳақиқий сон эмас"]
            ] 
            symbols [
                #numberSystem "latn" 
                decimal [! ","] 
                group [! " "] 
                percentSign [! "%"] 
                plusSign [! "+"] 
                minusSign [! "-"] 
                exponential [! "E"] 
                superscriptingExponent [! "×"] 
                perMille [! "‰"] 
                infinity [! "∞"] 
                nan [! "ҳақиқий сон эмас"]
            ] 
            decimalFormats [
                #numberSystem "arabext" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ]
            ] 
            decimalFormats [
                #numberSystem "latn" 
                decimalFormatLength [
                    decimalFormat [
                        pattern [! "#,##0.###"]
                    ]
                ] 
                decimalFormatLength [
                    #type "long" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0 минг"] 
                        pattern [#type "1000" #count "other" ! "0 минг"] 
                        pattern [#type "10000" #count "one" ! "00 минг"] 
                        pattern [#type "10000" #count "other" ! "00 минг"] 
                        pattern [#type "100000" #count "one" ! "000 минг"] 
                        pattern [#type "100000" #count "other" ! "000 минг"] 
                        pattern [#type "1000000" #count "one" ! "0 миллион"] 
                        pattern [#type "1000000" #count "other" ! "0 миллион"] 
                        pattern [#type "10000000" #count "one" ! "00 миллион"] 
                        pattern [#type "10000000" #count "other" ! "00 миллион"] 
                        pattern [#type "100000000" #count "one" ! "000 миллион"] 
                        pattern [#type "100000000" #count "other" ! "000 миллион"] 
                        pattern [#type "1000000000" #count "one" ! "0 миллиард"] 
                        pattern [#type "1000000000" #count "other" ! "0 миллиард"] 
                        pattern [#type "10000000000" #count "one" ! "00 миллиард"] 
                        pattern [#type "10000000000" #count "other" ! "00 миллиард"] 
                        pattern [#type "100000000000" #count "one" ! "000 миллиард"] 
                        pattern [#type "100000000000" #count "other" ! "000 миллиард"] 
                        pattern [#type "1000000000000" #count "one" ! "0 трилион"] 
                        pattern [#type "1000000000000" #count "other" ! "0 трилион"] 
                        pattern [#type "10000000000000" #count "one" ! "00 трилион"] 
                        pattern [#type "10000000000000" #count "other" ! "00 трилион"] 
                        pattern [#type "100000000000000" #count "one" ! "000 трилион"] 
                        pattern [#type "100000000000000" #count "other" ! "000 трилион"]
                    ]
                ] 
                decimalFormatLength [
                    #type "short" 
                    decimalFormat [
                        pattern [#type "1000" #count "one" ! "0минг"] 
                        pattern [#type "1000" #count "other" ! "0минг"] 
                        pattern [#type "10000" #count "one" ! "00минг"] 
                        pattern [#type "10000" #count "other" ! "00минг"] 
                        pattern [#type "100000" #count "one" ! "000минг"] 
                        pattern [#type "100000" #count "other" ! "000минг"] 
                        pattern [#type "1000000" #count "one" ! "0млн"] 
                        pattern [#type "1000000" #count "other" ! "0млн"] 
                        pattern [#type "10000000" #count "one" ! "00млн"] 
                        pattern [#type "10000000" #count "other" ! "00млн"] 
                        pattern [#type "100000000" #count "one" ! "000млн"] 
                        pattern [#type "100000000" #count "other" ! "000млн"] 
                        pattern [#type "1000000000" #count "one" ! "0млрд"] 
                        pattern [#type "1000000000" #count "other" ! "0млрд"] 
                        pattern [#type "10000000000" #count "one" ! "00млрд"] 
                        pattern [#type "10000000000" #count "other" ! "00млрд"] 
                        pattern [#type "100000000000" #count "one" ! "000млрд"] 
                        pattern [#type "100000000000" #count "other" ! "000млрд"] 
                        pattern [#type "1000000000000" #count "one" ! "0трлн"] 
                        pattern [#type "1000000000000" #count "other" ! "0трлн"] 
                        pattern [#type "10000000000000" #count "one" ! "00трлн"] 
                        pattern [#type "10000000000000" #count "other" ! "00трлн"] 
                        pattern [#type "100000000000000" #count "one" ! "000трлн"] 
                        pattern [#type "100000000000000" #count "other" ! "000трлн"]
                    ]
